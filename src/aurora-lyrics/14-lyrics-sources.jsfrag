  // ---- Spicy Lyrics API integration (publishable key, client-side) ----
  // ---- Spicy Lyrics API cache -----------------------------------------------
  // The /v1/lyrics endpoint is rate-limited, and every play of a song we've
  // already resolved would otherwise re-run the track search plus the API
  // round-trip.
  //
  // RETENTION — Terms of Service s7. Caching and storage are allowed, and they
  // ask that we do NOT hit the API for every view, on one hard condition:
  // "anything you store must be refetched or discarded within 30 days". That
  // cap is the entire mechanism by which a contributor's withdrawal takes
  // effect (a sync can be pulled at any time, with no removal notice), so it is
  // a CEILING, not a target. We sit at exactly the cap: long enough that a
  // replay almost never re-fetches, and never past the point where a withdrawn
  // sync stops propagating. (Was 3 days — upstream's window — until.)
  //
  // Storage is chrome.storage.local (bridged through window.YTMod) rather than
  // localStorage: the localStorage lyrics cache is capped at 15 entries and is
  // shared with LRCLIB results, which would evict these far too eagerly.
  const SPICY_CACHE_TTL_MS = 30 * 24 * 60 * 60 * 1000; // 30 days — ToS s7 cap.
  // Bump whenever the stored ENTRY SHAPE or the parsing that fills it changes.
  // `sweepSpicyCache` drops anything whose `v` differs, so a bump clears the
  // whole cache on the next page load. v2 added the Line-body parser and the
  // rule that only a 404 may write a negative entry.
  //
  // v3 — the cached value is the TTML STRING that `parseSpicyLyrics` SERIALIZES
  // from the API's JSON, so it is only ever as current as the serializer that
  // wrote it. `parseSpicyLyrics` is new (it does not exist in any backup older
  // than), so every entry predating it was produced by a different
  // code path and carries a SHAPE WE NO LONGER EMIT — most visibly, one span
  // per LINE instead of one per syllable, which the renderer then fills as a
  // single unit. Symptom: "the lyrics are line by line, not word by word"
  // on a track whose API body is `Type: "Syllable"` with real per-word times.
  // Re-serializing on read would avoid this class entirely; until then, bump.
  //
  // v4 — the cached `attribution` SHAPE changed: it used to be the flattened
  // uploader ({ id, username, avatar, url, songwriters }) and is now
  // { source, provider, uploader, maker, songwriters }. ⚠️ Anything written
  // between the v3 bump and this one is tagged v3 but holds the OLD shape, so
  // it would never be swept AND would render no credit at all. Hence v4, not
  // "v3 is already new enough".
  const SPICY_CACHE_VERSION = 4;
  const SPICY_CACHE_LIMIT = 80;
  // Negative results expire far sooner than positive ones: "this song has no
  // synced lyrics" is far more likely to change (someone uploads it) than an
  // already-uploaded TTML is. Keeps us from re-hitting the resolver for every
  // unsynced track forever, without pinning a miss for the full 30-day window.
  const SPICY_CACHE_NEGATIVE_TTL_MS = 12 * 60 * 60 * 1000; // 12 hours

  // LRCLIB is CORS-open, so the page world can call it directly. That matters
  // for cancellation: the content-script bridge cannot carry an AbortSignal
  // across the world boundary, so a skipped track used to leave the request
  // running. Every caller passes its own controller signal.
  async function fetchLrclibJson(url, signal) {
    try {
      const res = await fetch(url, {
        headers: { Accept: "application/json" },
        credentials: "omit",
        signal,
      });
      return { ok: res.ok, status: res.status, data: res.ok ? await res.json().catch(() => null) : null };
    } catch (error) {
      if (signal && signal.aborted) return { ok: false, status: 0, data: null, aborted: true };
      // A blocked CORS response / dropped connection arrives as a TypeError
      // with no status. Tag it so a down LRCLIB is not mistaken for a track
      // that simply has no lyrics.
      if (error && typeof error === "object") error.lrclibUnreachable = true;
      throw error;
    }
  }

  // True when the current lookup failed because LRCLIB itself was unreachable
  // (5xx or a CORS/network rejection), rather than because the track has no
  // lyrics. Reset at the start of every fetchLRCLyrics.
  let lrclibOutage = false;

  function isLrclibOutage(error) {
    if (!error) return false;
    const status = Number(error.status) || 0;
    if (status >= 500 && status <= 599) return true;
    return !status && error.lrclibUnreachable === true;
  }

  // ---- Spicy Lyrics API cache (in-memory mirror) ----------------------------
  // The persisted object is read once per page load and then served from this
  // map, so a cache hit costs no storage round-trip. Writes go through to
  // storage in the background so the next page load sees them.
  let spicyCache = null;
  let spicyCacheLoad = null;
  let spicyCacheDirty = false;
  let spicyCacheFlushTimer = 0;

  async function loadSpicyCache() {
    if (spicyCache) {
      alLog(`lyrics in cache: ${Object.keys(spicyCache).length}`);
      return Promise.resolve(spicyCache);
    }
    if (spicyCacheLoad) return spicyCacheLoad;
    if (!window.YTMod || typeof window.YTMod.getSpicyCache !== "function") {
      // Without the bridge every lookup is a guaranteed miss and every result
      // is thrown away — a failure mode that looks exactly like a working
      // resolver feeding a broken API call.
      alWarn("cache unavailable; nothing will be saved this session.");
      spicyCache = {};
      return Promise.resolve(spicyCache);
    }
    spicyCacheLoad = window.YTMod.getSpicyCache().then((stored) => {
      spicyCache = (stored && typeof stored === "object" && !Array.isArray(stored)) ? stored : {};
      invalidateStaleSpicyEntries();
      return spicyCache;
    }).catch((error) => {
      alWarn("cache read failed; starting empty:", error && error.message);
      spicyCache = {};
      return spicyCache;
    });
    return spicyCacheLoad;
  }

  // Writes are coalesced: a burst of cache operations (e.g. the sweep below
  // pruning several entries) collapses into one storage write.
  function flushSpicyCache() {
    if (!spicyCache || !spicyCacheDirty) return;
    spicyCacheDirty = false;
    if (!window.YTMod || typeof window.YTMod.setSpicyCache !== "function") return;
    const snapshot = spicyCache;
    Promise.resolve(window.YTMod.setSpicyCache(snapshot)).catch((error) => {
      alWarn("cache save failed:", error);
    });
  }

  function markSpicyCacheDirty() {
    spicyCacheDirty = true;
    if (spicyCacheFlushTimer) return;
    spicyCacheFlushTimer = setTimeout(() => {
      spicyCacheFlushTimer = 0;
      flushSpicyCache();
    }, 1500);
  }

  // Drops every entry whose `exp` has passed. Called on each read so expired
  // data can never be served, which is what makes the retention window a real
  // guarantee rather than a best-effort one.
  function sweepSpicyCache(now) {
    if (!spicyCache) return false;
    let removed = false;
    for (const [k, entry] of Object.entries(spicyCache)) {
      if (!entry || typeof entry !== "object" || entry.v !== SPICY_CACHE_VERSION || !Number.isFinite(entry.exp) || entry.exp <= now) {
        delete spicyCache[k];
        removed = true;
      }
    }
    return removed;
  }

  // LRU-ish cap: entries carry `at` (write time) so the oldest go first.
  function trimSpicyCache() {
    if (!spicyCache) return false;
    const keys = Object.keys(spicyCache);
    if (keys.length <= SPICY_CACHE_LIMIT) return false;
    keys
      .sort((a, b) => (spicyCache[a].at || 0) - (spicyCache[b].at || 0))
      .slice(0, keys.length - SPICY_CACHE_LIMIT)
      .forEach((k) => { delete spicyCache[k]; });
    return true;
  }

  // Drops every `sp:` entry that does NOT carry a TTML payload.
  //
  // Bumping SPICY_CACHE_VERSION is supposed to invalidate the whole cache when
  // this file's parsing changes — but the cache lives in chrome.storage.local
  // and SURVIVES a code edit, so the two got out of step: a version bump ships
  // the new parser, yet `sp:` entries the old parser wrote keep short-circuiting
  // the API call forever. That is what made a fixed Line-body parser still show
  // "no synced lyrics" for a track it could now render.
  //
  // Negative entries are pure disposable optimisation, so re-deriving them costs
  // one API call at worst. Resolver entries (`r:*`) are NOT touched — they
  // record a stable fact that spending a search round-trip would only
  // re-learn. Runs once per page load, and only when the stored version differs.
  function invalidateStaleSpicyEntries() {
    if (!spicyCache) return 0;
    const keys = Object.keys(spicyCache);
    if (!keys.length) return 0;
    const drops = keys.filter((k) => k.startsWith("sp:") && !(spicyCache[k] && spicyCache[k].ttml));
    if (!drops.length) return 0;
    drops.forEach((k) => { delete spicyCache[k]; });
    markSpicyCacheDirty();
    alLog(`cache: dropped ${drops.length} stale ${drops.length === 1 ? "entry" : "entries"}.`);
    return drops.length;
  }

  // Cache key. A resolved Spotify id is the song's real identity, so prefer it
  // whenever we have one — it survives the title/artist drift that YTM's
  // metadata is prone to. Falls back to the track key for negative entries
  // (where no id was ever resolved).
  function spicyCacheKeyFor(track, spotifyId) {
    if (spotifyId) return `sp:${spotifyId}`;
    const title = track && track.title;
    const artist = track && track.artist;
    if (!title) return null;
    return `t:${String(title).toLowerCase()}|${String(artist || "").toLowerCase()}`;
  }

  async function getSpicyCacheEntry(key) {
    if (!key) return null;
    const cache = await loadSpicyCache();
    const now = Date.now();
    const swept = sweepSpicyCache(now);
    const entry = cache[key];
    if (entry) {
      // Refresh recency for the LRU trim.
      entry.at = now;
      markSpicyCacheDirty();
    }
    if (swept) markSpicyCacheDirty();
    return entry || null;
  }

  function setSpicyCacheEntry(key, value) {
    if (!key || !spicyCache) return;
    const now = Date.now();
    // A "positive" entry carries a usable payload: either TTML to render or a
    // resolved Spotify id to reuse. Anything else is a negative result.
    const negative = !value || (!value.ttml && !value.spotifyId);
    spicyCache[key] = Object.assign({}, value, {
      v: SPICY_CACHE_VERSION,
      at: now,
      exp: now + (negative ? SPICY_CACHE_NEGATIVE_TTL_MS : SPICY_CACHE_TTL_MS),
    });
    trimSpicyCache();
    markSpicyCacheDirty();
  }

  // Number of live (non-expired) entries — used only to report a useful result
  // back to the settings UI when the cache is cleared.
  async function spicyCacheEntryCount() {
    const cache = await loadSpicyCache();
    if (sweepSpicyCache(Date.now())) markSpicyCacheDirty();
    return Object.keys(cache).length;
  }

  // Clears the whole Spicy Lyrics cache (settings "Clear cache" and the
  // storage-permission/consent path both route through here).
  async function clearSpicyLyricsCache() {
    spicyCache = {};
    spicyCacheDirty = false;
    if (spicyCacheFlushTimer) {
      clearTimeout(spicyCacheFlushTimer);
      spicyCacheFlushTimer = 0;
    }
    if (!window.YTMod || typeof window.YTMod.clearSpicyCache !== "function") return;
    try {
      await window.YTMod.clearSpicyCache();
    } catch (error) {
      alWarn("cache clear failed:", error);
    }
  }

  // ---- one song's cache entries ----------------------------------------------
  // A song owns up to three entries: the canonical `sp:<spotifyId>` payload (once
  // an id is resolved), the `t:<title>|<artist>` entry used before that, and the
  // `r:t:<title>|<artist>` resolver mapping that points the second at the first.
  // Dropping only one leaves the song half-cached, and the next play then either
  // re-hits the API through the id entry or serves the stale TTML from it.
  async function spicyCacheKeysForTrack(track) {
    const titleKey = spicyCacheKeyFor(track, "");
    if (!titleKey) return [];
    const cache = await loadSpicyCache();
    const keys = [titleKey, `r:${titleKey}`];
    const resolver = cache[`r:${titleKey}`];
    if (resolver && resolver.spotifyId) keys.push(`sp:${resolver.spotifyId}`);
    return keys;
  }

  // What the options panel shows for the song on screen. Only live entries count,
  // so a swept or expired one reads as "not cached" here exactly as it would to
  // the resolver.
  async function spicyCacheStatusForTrack(track) {
    const cache = await loadSpicyCache();
    const keys = await spicyCacheKeysForTrack(track);
    const now = Date.now();
    let exp = 0;
    for (const key of keys) {
      const entry = cache[key];
      if (!entry || entry.v !== SPICY_CACHE_VERSION) continue;
      if (!Number.isFinite(entry.exp) || entry.exp <= now) continue;
      if (entry.exp > exp) exp = entry.exp;
    }
    return {
      cached: exp > 0,
      daysLeft: exp > 0 ? Math.max(1, Math.ceil((exp - now) / 86400000)) : 0,
    };
  }

  async function clearSpicyCacheForTrack(track) {
    const cache = await loadSpicyCache();
    const keys = await spicyCacheKeysForTrack(track);
    let removed = 0;
    for (const key of keys) {
      if (!cache[key]) continue;
      delete cache[key];
      removed++;
    }
    if (removed) markSpicyCacheDirty();
    return removed;
  }

  // Brings one song's expiry forward to `afterMs` from now. The panel's "cleared
  // after this song ends" has to survive a reload to be honest: the in-memory
  // delete runs at the next track change, but a reload before that would
  // otherwise restore the entry's full 30-day window from storage.
  async function deferSpicyCacheForTrack(track, afterMs) {
    const cache = await loadSpicyCache();
    const keys = await spicyCacheKeysForTrack(track);
    const exp = Date.now() + Math.max(0, Number(afterMs) || 0);
    let touched = 0;
    for (const key of keys) {
      const entry = cache[key];
      if (!entry) continue;
      entry.exp = Math.min(Number.isFinite(entry.exp) ? entry.exp : exp, exp);
      touched++;
    }
    if (touched) markSpicyCacheDirty();
    return touched;
  }

  /** Loose normalisation — Unicode-aware, used for comparing titles/artists. */
  const normLoose = (v) => String(v || "").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim();

  /* Uploader-styled titles carry distribution labels that are not part of the
     song's name. Strip those, but ONLY those: "(u want it)" is the title, and
     "(feat. blackbear)" is a different recording from the solo cut. The old
     rule dropped every bracket, which turned "tell me (u want it)" into
     "tell me" and matched the wrong song. */
  const TITLE_NOISE_WORDS = new Set([
    "official", "music", "video", "audio", "lyric", "lyrics", "visualizer",
    "visualiser", "amv", "mv", "hd", "hq", "4k", "8k", "explicit", "clean",
  ]);
  const TITLE_BRACKET_RE = /[\(\[]([^\)\]]*)[\)\]]/g;
  // A trailing " - Official Video" / " - Lyrics" label, outside brackets.
  const TITLE_NOISE_TAIL_RE =
    /\s*[-–—]\s*(?:(?:official\s*)?(?:music\s*)?(?:video|audio)|lyric\s*video|lyrics?|visuali[sz]er|amv|mv|hd|hq|4k|8k)\s*$/i;

  function cleanSearchTitle(title, artist) {
    let s = String(title || "");
    // "Song | Channel" — everything after the pipe is uploader branding.
    s = s.split("|")[0];
    // Drop a bracketed label only when the whole bracket is label words:
    // "(Official Video)", "[Lyrics / AMV]", "(prod. X)". Keep "(u want it)",
    // "(feat. blackbear)", "(Remix)", "(Live)", "(Acoustic)", "(Extended)".
    s = s.replace(TITLE_BRACKET_RE, (match, inner) => {
      const text = String(inner || "").trim();
      if (!text) return " ";
      if (/^prod(?:uced)?\.?\b/i.test(text)) return " ";
      const words = text.toLowerCase().split(/[^a-z0-9]+/).filter(Boolean);
      return words.length && words.every((word) => TITLE_NOISE_WORDS.has(word)) ? " " : match;
    });
    s = s.replace(/\{[^}]*\}/g, " ");
    // YTM sometimes truncates a title mid-bracket: "Song (Official ...".
    s = s.replace(/[\(\[]\s*[^\)\]]*$/, " ");
    s = s.replace(TITLE_NOISE_TAIL_RE, " ");
    s = s.replace(/\s*[-–—]\s*$/, " ");
    // "Artist - Song" -> "Song" when the prefix is the artist we already know.
    const dash = /^(.+?)\s*[-–—]\s*(.+)$/.exec(s);
    if (dash && artist) {
      const left = dash[1].toLowerCase().replace(/\s+/g, " ").trim();
      const known = String(artist).toLowerCase().replace(/\s+/g, " ").trim();
      if (known && (left === known || known.indexOf(left) !== -1 || left.indexOf(known) !== -1)) {
        s = dash[2];
      }
    }
    return s.replace(/\s{2,}/g, " ").trim();
  }

  // ---- YTM -> Spotify id ------------------------------------------------------
  // The Spicy Lyrics API is keyed by a Spotify track id, which YouTube Music
  // does not expose. /tracks/search answers that question directly: give it the
  // title, artist, album and duration and it returns ranked Spotify tracks with
  // a `tier` saying how well each one matches. This replaced the old
  // metadata-mapping ladder: one request instead of up to twelve, and no second
  // catalogue to keep in sync.
  //
  // Tier behaviour, measured live: `exact` requires the duration within about
  // 3s; a 4-10s drift is still `likely`; past that every result becomes
  // `version`, where live/remix/cover look-alikes live (and the live recording
  // is often ranked first). That is why the accepted window is deliberately
  // small — a wider one would silently adopt the wrong recording.

  function spicySearchSeconds(track) {
    const ms = Number(track && track.durationMs);
    return Number.isFinite(ms) && ms > 0 ? Math.round(ms / 1000) : 0;
  }

  function spicyResultArtistMatches(result, artist) {
    const wanted = normLoose(artist);
    if (!wanted) return true;
    const names = Array.isArray(result && result.artists) ? result.artists : [];
    return names.some((name) => {
      const got = normLoose(name);
      return got && (got === wanted || got.includes(wanted) || wanted.includes(got));
    });
  }

  /**
   * One request against /tracks/search. `duration` is seconds, or 0 to omit it.
   * Returns { results, transient, aborted } — `transient` means the answer is
   * unknowable right now (timeout, 429, 5xx), not that the track has no match.
   */
  async function spicySearchTracks(title, artist, album, duration, controller) {
    const params = new URLSearchParams();
    params.set("title", title);
    if (artist) params.set("artist", artist);
    if (album) params.set("album", album);
    if (duration > 0) params.set("duration", String(duration));
    params.set("limit", String(SPICY_SEARCH_LIMIT));

    const timeout = new AbortController();
    const timer = setTimeout(() => timeout.abort(), SPICY_SEARCH_TIMEOUT_MS);
    const onAbort = () => timeout.abort();
    if (controller && controller.signal) {
      if (controller.signal.aborted) {
        clearTimeout(timer);
        return { results: [], transient: false, aborted: true };
      }
      controller.signal.addEventListener("abort", onAbort, { once: true });
    }

    let response;
    try {
      response = await fetch(`${SPICY_LYRICS_BASE}/tracks/search?${params.toString()}`, {
        headers: { Authorization: "Bearer " + SPICY_LYRICS_PUBLISHABLE_KEY },
        credentials: "omit",
        signal: timeout.signal,
      });
    } catch (error) {
      const userAborted = !!(controller && controller.signal && controller.signal.aborted);
      if (!userAborted) alWarn("Spicy search failed:", error && error.message);
      return { results: [], transient: !userAborted, aborted: userAborted };
    } finally {
      clearTimeout(timer);
      if (controller && controller.signal) controller.signal.removeEventListener("abort", onAbort);
    }

    if (response.status === 429) {
      const retryAfter = Number(response.headers.get("Retry-After"));
      const waitMs = Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter * 1000 : 30_000;
      spicySearchThrottledUntil = Date.now() + Math.min(waitMs, 60_000);
      alWarn("Spicy search rate-limited; backing off.");
      return { results: [], transient: true };
    }
    if (response.status === 0 || response.status >= 500) {
      return { results: [], transient: true };
    }
    if (response.status === 401 || response.status === 403) {
      // Revoked key, disabled application, or this origin left the allowlist.
      // Falling through is right, but staying quiet would hide a permanently
      // broken key behind a working fallback path.
      alWarn(`Spicy search rejected the key (HTTP ${response.status}); lyrics calls will fail too.`);
      return { results: [], transient: false };
    }
    if (!response.ok) return { results: [], transient: false };

    const json = await response.json().catch(() => null);
    const results = json && json.Body && Array.isArray(json.Body.results) ? json.Body.results : [];
    return { results, transient: false };
  }

  /** First result that is safe to take automatically, or null. */
  function pickSpicySearchResult(results, track, duration) {
    if (!Array.isArray(results) || !results.length) return null;
    const wantedMs = Number(track && track.durationMs) || 0;
    for (const result of results) {
      if (!result || typeof result.id !== "string" || !/^[A-Za-z0-9]{22}$/.test(result.id)) continue;
      if (!spicyResultArtistMatches(result, track && track.artist)) continue;
      const gotMs = Number(result.duration) * 1000;
      const delta = wantedMs > 0 && Number.isFinite(gotMs) ? Math.abs(gotMs - wantedMs) : 0;
      const durationAgrees =
        duration > 0 && wantedMs > 0 && Number.isFinite(gotMs) && delta <= SPICY_SEARCH_EXACT_DELTA_MS;
      if (result.tier === "exact") {
        // The API already applies roughly this window; the second check only
        // guards against a result whose duration is absent or malformed.
        if (duration > 0 && wantedMs > 0 && Number.isFinite(gotMs) && !durationAgrees) continue;
        return { result, delta };
      }
      // `version` normally means another cut, but the API also uses it when the
      // title differs only in how the credit is written — "dropout (feat.
      // blackbear)" vs Spotify's "dropout (w/ blackbear)". A live/remix take
      // drifts by tens of seconds, so a version whose duration still agrees is
      // the same recording.
      if (result.tier === "version" && durationAgrees) return { result, delta };
      // `likely` means the title and artist matched but the duration did not.
      // Take it for small padding, never for another cut.
      if (result.tier === "likely" && duration > 0 && delta <= SPICY_SEARCH_LIKELY_DELTA_MS) {
        return { result, delta };
      }
    }
    return null;
  }

  async function resolveSpotifyIdViaSpicySearch(track, controller, key, options = null) {
    const prefetching = !!(options && options.prefetch);
    const stale = () => controller.signal.aborted || (!prefetching && key !== currentTrackKey);
    if (stale()) return { id: null, transient: false };
    if (spicySearchThrottledUntil > Date.now()) {
      alWarn("Spicy search still backing off; skipping this lookup.");
      return { id: null, transient: true };
    }

    const artist = (track && track.artist) || "";
    const album = (track && track.album) || "";
    const title = cleanSearchTitle(track && track.title, artist) || (track && track.title) || "";
    if (!title) return { id: null, transient: false };
    const duration = spicySearchSeconds(track);

    let out = await spicySearchTracks(title, artist, album, duration, controller);
    if (out.aborted) return { id: null, transient: false };
    if (stale()) return { id: null, transient: false };

    let picked = out.transient ? null : pickSpicySearchResult(out.results, track, duration);

    // A long music video can be a minute past the Spotify cut, which the API
    // reports as `version` for every result. Duration is what caused that, so
    // the one retry worth spending drops it: without a duration the API can
    // still answer `exact` when every release of the recording agrees.
    let retriedWithoutDuration = false;
    if (!picked && duration > 0 && !out.transient) {
      retriedWithoutDuration = true;
      out = await spicySearchTracks(title, artist, album, 0, controller);
      if (out.aborted || stale()) return { id: null, transient: false };
      if (!out.transient) picked = pickSpicySearchResult(out.results, track, 0);
    }

    if (!picked) {
      if (out.transient) return { id: null, transient: true };
      alWarn(`Spicy search: no safe match for "${title}" / "${artist || "?"}".`);
      return { id: null, transient: false };
    }

    const id = picked.result.id;
    const delta = duration > 0 ? `, ${Math.round(picked.delta / 1000)}s off` : "";
    alLog(`Spotify id ${id} via Spicy search (${picked.result.tier}${delta}${retriedWithoutDuration ? ", duration omitted" : ""}).`);
    return { id, transient: false };
  }

  async function resolveSpotifyIdUncached(track, controller, key, options = null) {
    if (!track || !track.title) {
      alWarn("no track title; Spotify lookup skipped.");
      return { id: null, transient: false };
    }
    return resolveSpotifyIdViaSpicySearch(track, controller, key, options);
  }

  /**
   * Cached wrapper around the raw lookup. The resolution result is a stable
   * property of the song, so a hit here skips the network entirely.
   */
  async function resolveSpotifyId(track, controller, key, options = null) {
    const prefetching = !!(options && options.prefetch);
    const cacheKey = spicyCacheKeyFor(track, "");
    // Only HITS are cached. A miss used to be recorded for 12 hours and then
    // short-circuit this function, which meant a Spotify mapping the
    // user added afterwards stayed invisible for half a day — the mapping is
    // exactly what these lookups exist to find, and it can change at any time
    // without our knowing. A lookup that fails now simply fails
    // again next time; the search is one request per play, not a loop.
    if (cacheKey) {
      const cached = await getSpicyCacheEntry(`r:${cacheKey}`);
      if (cached && cached.spotifyId) {
        alLog(`Spotify id ${cached.spotifyId} from cache (resolver).`);
        return cached.spotifyId;
      }
    }
    const outcome = await resolveSpotifyIdUncached(track, controller, key, options);
    const resolved = outcome && outcome.id ? outcome.id : null;
    // The lookup can outlive its reason for existing: a manual upload bumps
    // trackRequestSeq, switching tracks rewrites currentTrackKey, clearing the
    // cache swaps spicyCache out, and track changes / unload abort the
    // controller. Any of those means this answer describes a world we've left,
    // so return it to the caller but never persist it.
    const stale =
      controller.signal.aborted ||
      (!prefetching && key !== currentTrackKey) ||
      !spicyCache;
    if (cacheKey && !stale && resolved) {
      // A resolved id is durable — give it the full TTL and mark the entry
      // positive (`hit`) so it isn't treated as a negative result.
      setSpicyCacheEntry(`r:${cacheKey}`, { spotifyId: resolved, hit: true });
    }
    return resolved;
  }

  function escapeSpicyText(value) {
    return String(value == null ? "" : value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  // Attribution is a BINDING condition of using the API — section 6 of the Terms
  // makes developers.spicylyrics.org/md/attribution part of the terms you accept.
  // The rule is conditional on `source`, so it must never be hardcoded:
  //
  //   * ALWAYS display the provider.
  //   * When source is `spicy_lyrics`, ALSO display and link the UPLOADER and
  //     the MAKER — the people who actually made the sync.
  //   * For every OTHER source (apple_music, spotify, ...) those fields do not
  //     exist. Rendering them anyway is explicitly called out as wrong: it
  //     produces an empty or broken credit line.
  //
  // "Wherever the lyrics appear" — so this goes in the panel footer, not on an
  // about page or in a tooltip nobody opens.
  const SPICY_PROVIDER_LABELS = {
    spicy_lyrics: "Spicy Lyrics",
    apple_music: "Apple Music",
    spotify: "Spotify",
    musixmatch: "Musixmatch",
    lrclib: "LRCLIB",
    genius: "Genius",
    netease: "NetEase",
  };

  // Unknown sources still have to be credited, so fall back to a prettified
  // version of the raw string rather than showing nothing.
  function spicyProviderLabel(source) {
    if (!source) return "";
    if (SPICY_PROVIDER_LABELS[source]) return SPICY_PROVIDER_LABELS[source];
    return source
      .replace(/[_-]+/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase());
  }

  // One credited person (an uploader or a maker). The API returns a Discord
  // identity; we only keep the display name, the avatar, and the profile URL.
  function attributionPerson(raw) {
    if (!raw || typeof raw !== "object") return null;
    const username = typeof raw.username === "string" ? raw.username.trim() : "";
    const id = raw.id != null ? String(raw.id) : "";
    if (!username && !id) return null;
    const url = typeof raw.url === "string" && /^https?:\/\//i.test(raw.url)
      ? raw.url
      : (id ? `https://spicylyrics.org/uid/${id}` : "");
    return {
      id,
      username: username || "Unknown",
      avatar: typeof raw.avatar === "string" ? raw.avatar : "",
      url,
    };
  }

  function parseUploadAttribution(body) {
    // No body means there is nothing to credit. Without this the provider
    // fallback below would invent a "Spicy Lyrics" credit for a result that
    // carries no attribution at all.
    if (!body || typeof body !== "object") return null;
    const source = typeof body.source === "string" ? body.source.trim().toLowerCase() : "";
    const attr = body && body.UploadAttribution;
    // Only a community sync carries people, and only a response that SAYS it is
    // one may be credited as one. An absent `source` means we do not know what
    // answered, so we do not guess: ToS s6 says to call the source unknown
    // rather than attribute the data to anyone, and that includes assuming it
    // came through Spicy Lyrics just because that is the API we called.
    const community = source === "spicy_lyrics";
    // "Always display the provider" is the binding half of the rule, so the
    // credit must never come back empty. It may not be invented either, hence
    // the explicit unknown label when the response names no source.
    const provider = source ? spicyProviderLabel(source) : "Unknown source";
    const uploader = community ? attributionPerson(attr && attr.Uploader) : null;
    const maker = community ? attributionPerson(attr && attr.Maker) : null;
    if (!provider && !uploader && !maker) return null;
    return {
      source,
      provider,
      uploader,
      maker,
      songwriters: Array.isArray(body && body.SongWriters)
        ? body.SongWriters.filter((n) => typeof n === "string" && n.trim()).map((n) => n.trim())
        : [],
    };
  }

  // Converts the Spicy Lyrics API `Body` (times in seconds) into the compact
  // TTML form parseTTML already understands: <p> lines, lead <span begin end>
  // syllables, background <span ttm:role="x-bg">. isPartOfWord is encoded as the
  // absence of whitespace between adjacent spans — parseTTML infers it that way.
  // Returns { ttml, attribution } so the caller can surface the uploader credit.
  //
  // TWO BODY SHAPES, AND BOTH ARE COMMON (verified live)
  // ---------------------------------------------------------------
  // `Body.Type === "Syllable"` — each Content entry carries
  //   Lead: { StartTime, EndTime, Syllables: [{ Text, StartTime, EndTime,
  //   IsPartOfWord }] } and optional Background: [{ Syllables: [...] }].
  //   This is the word-by-word karaoke case we were built for.
  //
  // `Body.Type === "Line"` — each Content entry carries a PLAIN `Text` string
  //   and a line-level StartTime/EndTime, with **no Syllables array at all**.
  //   underscores' "Music" is served this way: 59 lines, zero syllables.
  //
  // Reading only the syllable shape silently discarded every Line-type body,
  // and because the caller then cached that emptiness as a 12h negative, those
  // songs looked permanently lyric-less. Both shapes are read here now.
  function parseSpicyLyrics(body) {
    if (!body || !Array.isArray(body.Content) || !body.Content.length) return null;
    const fst = (v) => (typeof v === "number" && isFinite(v)) ? v : null;
    const lines = [];
    let hasWordTiming = false;
    for (const content of body.Content) {
      if (!content) continue;
      const lead = content.Lead;
      const leadSyls = (lead && Array.isArray(lead.Syllables)) ? lead.Syllables : [];
      const bg = Array.isArray(content.Background) ? content.Background : [];
      const plainText = (typeof content.Text === "string" && content.Text.trim())
        ? content.Text.trim()
        : "";

      // A Line-type entry: no syllable data anywhere, but a real text line with
      // a line-level window. Emit ONE untimed span for the whole line.
      //
      // Do NOT split this into per-word spans. A Line body carries no per-word
      // ground truth, so split words would be *invented* timing dressed up as
      // word sync — and worse, it fights the renderer: a line-synced lyric is
      // supposed to light up as a line. One span keeps the line on the
      // LineTimed path (whole-line fill, letter reveal), while a Syllable body
      // keeps its hand-timed word-by-word karaoke. Two bodies, two behaviours.
      if (!leadSyls.length && !bg.length) {
        if (!plainText) continue;
        const ls = fst(content.StartTime);
        const le = fst(content.EndTime);
        const lineTimed = ls != null && le != null && le > ls + 0.001;
        const agent = content.OppositeAligned ? ` ttm:agent="v2"` : ` ttm:agent="v1"`;
        const lineTiming = lineTimed ? ` begin="${ls}s" end="${le}s"` : "";
        lines.push(`<p${agent}${lineTiming}><span>${escapeSpicyText(plainText)}</span></p>`);
        continue;
      }

      let lineStart = fst(lead && lead.StartTime);
      if (lineStart == null && leadSyls.length) lineStart = fst(leadSyls[0].StartTime);
      let lineEnd = fst(lead && lead.EndTime);
      if (lineEnd == null && leadSyls.length) lineEnd = fst(leadSyls[leadSyls.length - 1].EndTime);
      const lineTimed = lineStart != null && lineEnd != null && lineEnd > lineStart + 0.001;

      const parts = [];
      let prevWord = false;
      for (let i = 0; i < leadSyls.length; i++) {
        const syl = leadSyls[i];
        const text = syl.Text;
        if (text == null || !String(text).length) continue;
        const s = fst(syl.StartTime);
        const e = fst(syl.EndTime);
        const timed = s != null && e != null && e > s + 0.001;
        if (timed) hasWordTiming = true;
        if (i > 0 && !prevWord) parts.push(" ");
        const timing = timed ? ` begin="${s}s" end="${e}s"` : "";
        parts.push(`<span${timing}>${escapeSpicyText(text)}</span>`);
        prevWord = !!syl.IsPartOfWord;
      }
      let prevBgWord = false;
      const bgInner = [];
      for (const bgItem of bg) {
        if (!bgItem || !Array.isArray(bgItem.Syllables)) continue;
        const bgSyls = bgItem.Syllables;
        for (let i = 0; i < bgSyls.length; i++) {
          const syl = bgSyls[i];
          const text = syl.Text;
          if (text == null || !String(text).length) continue;
          const s = fst(syl.StartTime);
          const e = fst(syl.EndTime);
          const timed = s != null && e != null && e > s + 0.001;
          if (timed) hasWordTiming = true;
          if (i > 0 && !prevBgWord) bgInner.push(" ");
          const timing = timed ? ` begin="${s}s" end="${e}s"` : "";
          bgInner.push(`<span${timing}>${escapeSpicyText(text)}</span>`);
          prevBgWord = !!syl.IsPartOfWord;
        }
      }
      if (bgInner.length) parts.push(`<span ttm:role="x-bg">${bgInner.join("")}</span>`);
      if (!parts.length) continue;
      const agent = content.OppositeAligned ? ` ttm:agent="v2"` : ` ttm:agent="v1"`;
      const lineTiming = lineTimed ? ` begin="${lineStart}s" end="${lineEnd}s"` : "";
      lines.push(`<p${agent}${lineTiming}>${parts.join("")}</p>`);
    }
    if (!lines.length) return null;
    const ttml = `<?xml version="1.0" encoding="UTF-8"?><tt xmlns="http://www.w3.org/ns/ttml"><body><div>${lines.join("")}</div></body></tt>`;
    return { ttml, attribution: parseUploadAttribution(body), wordByWord: hasWordTiming };
  }

  // ---- Aurora Community (read-only client) ---------------------------------
  // Community rows are keyed by the exact YouTube video id. Positive results
  // live for 30 days; a test row's server-supplied cacheTtlSeconds is shorter.
  const COMMUNITY_CACHE_TTL_MS = 30 * 24 * 60 * 60 * 1000;
  // Bump this whenever the cache shape or a matching rule changes. Older entries
  // are dropped on load; v8 drops stale community entries from before the cache
  // controls covered this store. v7 carries maker profile URLs into self-upload
  // credits, and v5 lacks the upload id used for views.
  const COMMUNITY_CACHE_VERSION = 8;
  // Negative entries are short: a newly approved upload should reach someone
  // who previously missed the track without making them wait long.
  const COMMUNITY_CACHE_NEGATIVE_TTL_MS = 2 * 60 * 1000;
  const COMMUNITY_CACHE_LIMIT = 80;
  // A cold Worker isolate can spend a couple of seconds on the D1 schema
  // check before the public lookup runs. Give the active track enough room to
  // finish instead of aborting a request that is about to return its TTML. The
  // next-track prefetch stays short because a miss there is harmless.
  const COMMUNITY_REQUEST_TIMEOUT_MS = 6000;
  const COMMUNITY_PREFETCH_TIMEOUT_MS = 3000;

  let communityCache = null;
  let communityCacheLoad = null;
  // In-flight fetches must not repopulate a cache the reader just cleared.
  let communityCacheEpoch = 0;

  async function loadCommunityCache() {
    if (communityCache) return communityCache;
    if (communityCacheLoad) return communityCacheLoad;
    if (!window.YTMod || typeof window.YTMod.getCommunityCache !== "function") {
      alWarn("community cache bridge unavailable; nothing will be cached this session.");
      communityCache = {};
      return communityCache;
    }
    communityCacheLoad = window.YTMod.getCommunityCache().then((stored) => {
      communityCache = (stored && typeof stored === "object" && !Array.isArray(stored)) ? stored : {};
      const now = Date.now();
      for (const [videoId, entry] of Object.entries(communityCache)) {
        if (!entry || !Number.isFinite(entry.exp) || entry.exp <= now
          || entry.v !== COMMUNITY_CACHE_VERSION) {
          delete communityCache[videoId];
        }
      }
      return communityCache;
    }).catch((error) => {
      alWarn("community cache read failed; starting empty:", error && error.message);
      communityCache = {};
      return communityCache;
    });
    return communityCacheLoad;
  }

  function persistCommunityCache() {
    if (!communityCache || !window.YTMod || typeof window.YTMod.setCommunityCache !== "function") return;
    const entries = Object.entries(communityCache)
      .filter(([, entry]) => entry && Number.isFinite(entry.exp) && entry.exp > Date.now())
      .sort((a, b) => b[1].exp - a[1].exp)
      .slice(0, COMMUNITY_CACHE_LIMIT);
    communityCache = Object.fromEntries(entries);
    window.YTMod.setCommunityCache(communityCache).catch((error) => {
      alWarn("could not persist community cache:", error && error.message);
    });
  }

  async function getCommunityCacheEntry(videoId) {
    if (!videoId) return null;
    const cache = await loadCommunityCache();
    const entry = cache[videoId];
    if (!entry) return null;
    if (!Number.isFinite(entry.exp) || entry.exp <= Date.now()
      || entry.v !== COMMUNITY_CACHE_VERSION) {
      delete cache[videoId];
      persistCommunityCache();
      return null;
    }
    return entry;
  }

  function setCommunityCacheEntry(videoId, entry, ttlMs) {
    if (!videoId) return;
    const epoch = communityCacheEpoch;
    loadCommunityCache().then((cache) => {
      if (epoch !== communityCacheEpoch) return;
      const ttl = Number.isFinite(ttlMs) && ttlMs > 0 ? ttlMs : COMMUNITY_CACHE_TTL_MS;
      cache[videoId] = Object.assign({}, entry, {
        v: COMMUNITY_CACHE_VERSION,
        exp: Date.now() + Math.min(ttl, COMMUNITY_CACHE_TTL_MS),
      });
      persistCommunityCache();
    }).catch(() => {});
  }

  // The settings cache controls used to clear only Spicy Lyrics. Community
  // entries are a separate storage key, so they survived a purge for 30 days.
  async function communityCacheEntryCount() {
    const cache = await loadCommunityCache();
    const now = Date.now();
    return Object.keys(cache).filter((videoId) => {
      const entry = cache[videoId];
      return entry && entry.v === COMMUNITY_CACHE_VERSION
        && Number.isFinite(entry.exp) && entry.exp > now;
    }).length;
  }

  async function clearCommunityLyricsCache() {
    const cache = await loadCommunityCache();
    const count = Object.keys(cache).length;
    communityCacheEpoch += 1;
    for (const videoId of Object.keys(cache)) delete cache[videoId];
    communityCache = cache;
    if (!window.YTMod || typeof window.YTMod.setCommunityCache !== "function") return count;
    try {
      await window.YTMod.setCommunityCache({});
    } catch (error) {
      alWarn("could not clear Aurora Community cache:", error);
    }
    return count;
  }

  async function clearCommunityCacheForTrack(track) {
    const videoId = track && track.videoId ? String(track.videoId) : "";
    if (!videoId) return 0;
    const cache = await loadCommunityCache();
    const hadEntry = !!cache[videoId];
    // Even a miss can be re-cached by a fetch already in flight.
    communityCacheEpoch += 1;
    if (hadEntry) {
      delete cache[videoId];
      persistCommunityCache();
    }
    return hadEntry ? 1 : 0;
  }

  function communityPerson(raw) {
    if (!raw || typeof raw !== "object") return null;
    const person = {
      id: raw.id != null ? String(raw.id) : "",
      username: typeof raw.username === "string" ? raw.username.trim() : "",
      avatar: typeof raw.avatar === "string" ? raw.avatar : "",
      // Aurora profiles are public at /community?maker=<id>; the API fills this
      // for makers. Uploader profile links are still deliberately empty.
      url: typeof raw.url === "string"
        && (raw.url.startsWith("http://") || raw.url.startsWith("https://"))
        ? raw.url
        : "",
    };
    return person.username || person.id ? person : null;
  }

  function normalizeCommunityAttribution(raw) {
    const attr = raw && typeof raw === "object" ? raw : {};
    return {
      source: typeof attr.source === "string" && attr.source.trim() ? attr.source.trim() : "aurora_community",
      provider: typeof attr.provider === "string" && attr.provider.trim() ? attr.provider.trim() : "Aurora Community",
      uploader: communityPerson(attr.uploader),
      maker: communityPerson(attr.maker),
      songwriters: [],
    };
  }

  async function fetchCommunityLyrics(track, key, controller, options = null) {
    if (!track || !track.videoId) return null;
    const videoId = String(track.videoId);
    const cached = await getCommunityCacheEntry(videoId);
    if (cached) {
      if (cached.hit === false) {
        alLog(`cached Aurora Community miss for ${videoId}; skipping API.`);
        return null;
      }
      if (cached.ttml) {
        alLog(`served TTML from Aurora Community cache (${videoId}).`);
        return {
          ttml: cached.ttml,
          attribution: cached.attribution || null,
          uploadId: cached.uploadId || "",
          test: cached.test === true,
          fromCache: true,
        };
      }
    }

    const requestUrl = `${AURORA_COMMUNITY_API}/v1/ttml?v=${encodeURIComponent(videoId)}`;
    let response;
    try {
      let signal = controller.signal;
      try {
        if (typeof AbortSignal !== "undefined"
          && typeof AbortSignal.any === "function"
          && typeof AbortSignal.timeout === "function") {
          const timeoutMs = options && options.prefetch
            ? COMMUNITY_PREFETCH_TIMEOUT_MS
            : COMMUNITY_REQUEST_TIMEOUT_MS;
          signal = AbortSignal.any([controller.signal, AbortSignal.timeout(timeoutMs)]);
        }
      } catch (_) {}
      response = await fetch(requestUrl, {
        headers: { Accept: "application/json" },
        credentials: "omit",
        signal,
        // The API sends a five-minute public cache header. Reuse it instead of
        // forcing every track change through a fresh Worker/D1 lookup.
        cache: "default",
      });
    } catch (error) {
      if (controller.signal.aborted || (error && error.name === "AbortError")) return null;
      alWarn("Aurora Community request failed:", error);
      return null;
    }
    if (controller.signal.aborted || ((!options || options.prefetch !== true) && key !== currentTrackKey)) return null;
    if (response.status === 404) {
      setCommunityCacheEntry(videoId, { hit: false }, COMMUNITY_CACHE_NEGATIVE_TTL_MS);
      return null;
    }
    if (!response.ok) {
      alWarn(`Aurora Community returned HTTP ${response.status}.`);
      return null;
    }
    const json = await response.json().catch(() => null);
    const data = json && json.data ? json.data : null;
    if (!data || typeof data.ttml !== "string" || !data.ttml.trim()) {
      alWarn("Aurora Community returned no usable TTML.");
      return null;
    }
    const attribution = normalizeCommunityAttribution(data.attribution);
    const ttlSeconds = Number(data.cacheTtlSeconds);
    const ttlMs = Number.isFinite(ttlSeconds) && ttlSeconds > 0
      ? ttlSeconds * 1000
      : COMMUNITY_CACHE_TTL_MS;
    setCommunityCacheEntry(videoId, {
      hit: true,
      ttml: data.ttml,
      attribution,
      uploadId: typeof data.uploadId === "string" ? data.uploadId : "",
      test: data.test === true,
      updatedAt: typeof data.updatedAt === "string" ? data.updatedAt : "",
    }, ttlMs);
    alLog(`fetched Aurora Community TTML for ${videoId}.`);
    return {
      ttml: data.ttml,
      attribution,
      uploadId: typeof data.uploadId === "string" ? data.uploadId : "",
      test: data.test === true,
      fromCache: false,
    };
  }

  async function fetchSpicyLyrics(track, key, controller, options = null) {
    if (!SPICY_LYRICS_PUBLISHABLE_KEY) return null;
    if (!track || !track.title) { alWarn("no track title; skipping."); return null; }
    const prefetching = !!(options && options.prefetch);
    alLog(`resolving for "${track.title}" / "${track.artist || "?"}"…`);
    const spotifyId = await resolveSpotifyId(track, controller, key, options);
    if (controller.signal.aborted || (!prefetching && key !== currentTrackKey)) return null;
    if (!spotifyId) {
      alWarn("no Spotify track id resolved; falling back.");
      return null;
    }

    // Cache lookup happens AFTER resolution because the Spotify id is the
    // canonical key — it survives the title/artist drift that would otherwise
    // strand a cached TTML under a key we no longer compute.
    const cacheKey = spicyCacheKeyFor(track, spotifyId);
    const cached = await getSpicyCacheEntry(cacheKey);
    if (cached) {
      if (cached.ttml) {
        alLog(`served TTML from cache (${spotifyId}).`);
        return {
          ttml: cached.ttml,
          attribution: cached.attribution || null,
          songwriters: cached.songwriters || [],
          wordByWord: cached.wordByWord === true || ttmlHasWordTiming(cached.ttml),
          fromCache: true,
        };
      }
      if (cached.hit === false) {
        alLog(`cached "no sync available" for ${spotifyId}; skipping API.`);
        return null;
      }
      // An entry that is neither TTML nor a recorded miss is a half-written
      // record — exactly what a cache written while the page was being torn
      // down looks like. Log it, because otherwise this path is a silent
      // fall-through to the API and reads as "the cache did nothing".
      alWarn(`cache entry for ${spotifyId} is incomplete; re-querying the API.`);
    }
    alLog(`querying ${SPICY_LYRICS_API}/${spotifyId}`);

    // Every exit from here on logs. This function used to have several silent
    // `return null` paths, and because those are indistinguishable in the console
    // from "the request never happened", a resolved id followed by nothing at all
    // sent us chasing the resolver twice. A drop-in replacement for the guard
    // below, used everywhere so no branch can go quiet again.
    const bail = (why) => {
      alWarn(`giving up on ${spotifyId} — ${why}`);
      return null;
    };

    let response;
    try {
      response = await fetch(`${SPICY_LYRICS_API}/${spotifyId}`, {
        headers: { Authorization: "Bearer " + SPICY_LYRICS_PUBLISHABLE_KEY },
        credentials: "omit",
        // The controller is the track-change guard: passing it to fetch (not
        // just checking it afterwards) is what actually cancels the request on
        // a skip, instead of leaving a rate-limited call running to completion.
        signal: controller.signal,
      });
    } catch (e) {
      if (controller.signal.aborted) return bail("request was aborted (a newer track/request superseded it)");
      alWarn("request failed:", e);
      return null;
    }
    // Report WHICH condition dropped the answer — aborted vs a changed track are
    // very different bugs and used to be one silent `return null`.
    if (controller.signal.aborted) {
      return bail("request was aborted (a newer track/request superseded it)");
    }
    if (!prefetching && key !== currentTrackKey) {
      return bail(`track key moved (\`${key}\` -> \`${currentTrackKey}\`)`);
    }
    alLog(`answered HTTP ${response.status} for ${spotifyId}`);
    if (response.status === 404) {
      // The API itself says it has no TTML for this id. That is a real answer
      // and safe to remember.
      setSpicyCacheEntry(cacheKey, { hit: false });
      return bail("API returned 404 (no TTML for this id) — cached as a 12h miss");
    }
    if (!response.ok) {
      return bail(`API returned HTTP ${response.status}`);
    }

    /* ---------------------------------------------------------------------
       Read the body BEFORE touching the cache.

       This ordering is load-bearing. These failure branches used to call
       setSpicyCacheEntry(cacheKey, { hit: false }) on the way out, which meant
       a TENTATIVE failure — an unreadable body, or a TTML string our own parser
       could not render — was banked as a durable 12h negative keyed by
       `sp:<spotifyId>`. The next play then short-circuited on
       `cached.hit === false` and the API was never asked again, so a hiccup or
       a parser gap became a permanent "this song has no synced lyrics" even
       though the API was serving real TTML the whole time.

       A negative entry may now only be written when the API tells us there is
       nothing to fetch (404). Everything else is a miss for THIS attempt and
       gets retried on the next play.
    --------------------------------------------------------------------- */
    const json = await response.json().catch(() => null);
    if (!json) {
      return bail("response body was not valid JSON");
    }
    if (!json.Body) {
      return bail(`answer had no Body (top-level keys: ${Object.keys(json).join(", ") || "none"})`);
    }
    const parsed = parseSpicyLyrics(json.Body);
    if (!parsed) {
      return bail(`Body parse produced nothing (Body.Type=${json.Body.Type}, Content=${Array.isArray(json.Body.Content) ? json.Body.Content.length : "n/a"} ` +
        `with ${Array.isArray(json.Body.Content) ? json.Body.Content.filter((c) => (c && ((c.Lead && Array.isArray(c.Lead.Syllables) && c.Lead.Syllables.length) || (Array.isArray(c.Background) && c.Background.length) || (typeof c.Text === "string" && c.Text.trim())))).length : 0} usable entr(ies))`);
    }
    if (!parsed.ttml) {
      return bail("parser produced no TTML string");
    }
    if (parsed.attribution && parsed.attribution.songwriters.length) {
      parsed.songwriters = parsed.attribution.songwriters;
    }
    // Only now — a Body that parsed into a non-empty TTML — is the result
    // trustworthy enough to persist.
    const wordByWord = parsed.wordByWord === true || ttmlHasWordTiming(parsed.ttml);
    setSpicyCacheEntry(cacheKey, {
      hit: true,
      ttml: parsed.ttml,
      attribution: parsed.attribution || null,
      songwriters: parsed.songwriters || [],
      wordByWord,
      spotifyId,
    });
    parsed.wordByWord = wordByWord;
    alLog(`parsed ${parsed.ttml.length}-byte TTML for ${spotifyId} (${wordByWord ? "word" : "line"}-level); handing to the renderer.`);
    return parsed;
  }

  // Loads a payload that prefetch already resolved for this exact track. This
  // is deliberately the only place prefetch data enters the renderer: the
  // normal source runners and their cache/priority rules are untouched.
  function applyPrefetchedLyrics(entry, track) {
    if (!entry) return false;
    try {
      if (entry.source === "community") {
        pendingSpicyCredits = {
          attribution: entry.attribution || null,
          songwriters: [],
          uploadId: entry.uploadId || "",
          test: entry.test === true,
        };
        if (loadTTML(entry.ttml, "external")) return true;
        pendingSpicyCredits = null;
        return false;
      }
      if (entry.source === "spicy") {
        pendingSpicyCredits = {
          attribution: entry.attribution || null,
          songwriters: Array.isArray(entry.songwriters) ? entry.songwriters : [],
        };
        if (loadTTML(entry.ttml, "external")) return true;
        pendingSpicyCredits = null;
        return false;
      }
      if (entry.source === "unison") {
        const attribution = {
          source: "unison",
          provider: "Unison",
          uploader: entry.submitter || null,
          maker: null,
          songwriters: [],
        };
        if (entry.format === "lrc") {
          return loadLRCLyrics({ syncedLyrics: entry.lyrics }, track.durationMs, "Unison", attribution);
        }
        pendingSpicyCredits = { attribution, songwriters: [] };
        if (loadTTML(entry.lyrics, "external")) return true;
        pendingSpicyCredits = null;
        return false;
      }
      if (entry.source === "lrclib") {
        // LRCLIB sets its own attribution; do not let a staged TTML credit leak
        // into the next external load.
        pendingSpicyCredits = null;
        return loadLRCLyrics(entry.data, track.durationMs);
      }
    } catch (error) {
      pendingSpicyCredits = null;
      alWarn("prefetched lyrics could not be rendered:", error);
    }
    return false;
  }

  async function fetchLRCLyrics(track, key) {
    const requestId = ++trackRequestSeq;
    lrclibOutage = false;
    if (activeTrackAbort) activeTrackAbort.abort();
    const controller = new AbortController();
    activeTrackAbort = controller;

    // Skeleton rather than a text message: this covers the network wait AND the
    // synchronous DOM build that follows it (see showLyricsSkeleton). The AMLL
    // engine is a separate renderer, so its skeleton goes up alongside.
    showLyricsSkeleton();
    amllShowSkeleton();

    const stale = () =>
      controller.signal.aborted || requestId !== trackRequestSeq || key !== currentTrackKey;

    /* A result the user picked in Search lyrics is not a suggestion — it is the
       answer. It outranks every source, including Spicy, because the pick only
       exists when the automatic resolver already failed for this track. Served
       from the persistent cache before any runner runs, so a replay or a page
       reload loads it instantly instead of searching and landing on "no
       lyrics" again. */
    const manualPick = getManualLyricsPersistent(key);
    if (manualPick) {
      if (stale()) return;
      if (loadLRCLyrics(manualPick, track.durationMs)) {
        alLog("manual search pick served from cache.");
        return;
      }
      // The entry no longer parses (corrupt or older shape): drop it and let
      // the normal order try rather than failing the track silently.
      removeLyricsPersistent(key);
    }

    /* A next-track prefetch already resolved this exact key. Load its winner
       before any source runs; the payload was chosen in the same Community ->
       Spicy -> Unison -> LRCLIB order (including the line-level Spicy hold). */
    const prefetched = prefetchedLyrics.get(key);
    if (prefetched) {
      prefetchedLyrics.delete(key);
      if (stale()) return;
      if (applyPrefetchedLyrics(prefetched, track)) {
        alLog(`prefetched ${prefetched.source} lyrics rendered.`);
        return;
      }
      alWarn("prefetched lyrics could not be rendered; resolving normally.");
    }

    /* One LRCLIB fetch, shared by the lrclib runner. It stays RAW (not a load)
       so the caller can tell a synced result from a plain-only one. */
    const fetchLrclibData = async () => {
      const cached = lrclibCache.get(key);
      if (cached) {
        lrclibCache.delete(key);
        lrclibCache.set(key, cached);
        return cached;
      }
      const persisted = getLyricsPersistent(key);
      if (persisted) {
        lrclibCache.set(key, persisted);
        return persisted;
      }
      const params = new URLSearchParams();
      params.set("track_name", track.title);
      if (track.artist) params.set("artist_name", track.artist);
      if (Number.isFinite(track.durationMs) && track.durationMs > 0) {
        params.set("duration", String(Math.round(track.durationMs / 1000)));
      }
      const response = await fetchLrclibJson(`${LRCLIB_API}?${params.toString()}`, controller.signal);
      if (response.aborted) return null;
      if (!response.ok && response.status !== 404) {
        const error = new Error("LRCLIB returned HTTP " + response.status);
        error.status = response.status;
        throw error;
      }
      let data = response.ok ? response.data : null;
      if (!data || (!data.syncedLyrics && !data.lyricsfile)) {
        const searchParams = new URLSearchParams({
          q: [track.title, track.artist].filter(Boolean).join(" "),
        });
        if (stale()) return null;
        const searchResponse = await fetchLrclibJson(
          `${LRCLIB_SEARCH_API}?${searchParams.toString()}`,
          controller.signal
        );
        if (searchResponse.aborted) return null;
        if (!searchResponse.ok) {
          const error = new Error("LRCLIB search returned HTTP " + searchResponse.status);
          error.status = searchResponse.status;
          throw error;
        }
        // Prefer a synced match; fall back to a plain (unsynced) match so the
        // panel shows lyrics automatically instead of "No lyrics found"
        //. Both are scored against the current track on the
        // same search response — no second request.
        data = selectLRCLIBResult(searchResponse.data, track)
          || selectLRCLIBPlainResult(searchResponse.data, track);
      }
      if (!data || (!data.syncedLyrics && !data.plainLyrics && !data.lyricsfile)) return null;
      cacheLRCLyrics(key, data);
      cacheLyricsPersistent(key, data);
      return data;
    };

    /* Each source is a runner that returns true when it produced lyrics (or
       when the request went stale). The resolver walks the fixed priority
       Community -> Spicy -> Unison -> LRCLIB. A line-level Spicy result is
       held by its runner while Unison gets one chance to supply word-level
       timing; a line-level or missing Unison result falls back to that exact
       Spicy payload. Runners never show a terminal "no lyrics" message
       themselves; the tail of this function does, so a source that misses
       early cannot flash a message before the next one has had its turn. */
    let pendingSpicyLineResult = null;
    const loadSpicyResult = (result) => {
      pendingSpicyCredits = {
        attribution: result.attribution || null,
        songwriters: Array.isArray(result.songwriters) ? result.songwriters : [],
      };
      if (loadTTML(result.ttml, "external")) return true;
      pendingSpicyCredits = null;
      return false;
    };
    const loadPendingSpicy = () => {
      const result = pendingSpicyLineResult;
      pendingSpicyLineResult = null;
      return result ? loadSpicyResult(result) : false;
    };
    // Unison credits the person who submitted the sync, not a separate maker.
    // Its public API exposes the contributor in `submitter`.
    const unisonCredits = (data) => ({
      attribution: {
        source: "unison",
        provider: "Unison",
        uploader: data && data.submitter ? data.submitter : null,
        maker: null,
        songwriters: [],
      },
      songwriters: [],
    });

    const runners = {
      community: async () => {
        try {
          const communityResult = await fetchCommunityLyrics(track, key, controller);
          if (stale()) return true;
          if (communityResult && communityResult.ttml) {
            pendingSpicyCredits = {
              attribution: communityResult.attribution || null,
              songwriters: [],
              uploadId: communityResult.uploadId || "",
              test: communityResult.test === true,
            };
            if (loadTTML(communityResult.ttml, "external")) {
              alLog("TTML rendered from Aurora Community.");
              return true;
            }
            pendingSpicyCredits = null;
            alWarn("Aurora Community returned TTML we could not parse; trying the next source.");
          } else {
            alLog("no Aurora Community TTML for this track; trying the next source.");
          }
        } catch (error) {
          if (error && error.name === "AbortError") return true;
          alWarn("Aurora Community lookup failed; trying the next source:", error);
        }
        return false;
      },

      spicy: async () => {
        try {
          const spicyResult = await fetchSpicyLyrics(track, key, controller);
          if (stale()) {
            // Silence here was a real dead end: the TTML was fetched and parsed,
            // then dropped on the floor with no output, which reads as "the fetch
            // failed".
            alWarn(`discarding the Spicy result — ${
              controller.signal.aborted ? "request aborted" : "a newer lyrics request superseded this one"}.`);
            return true;
          }
          if (spicyResult && spicyResult.ttml) {
            // Hold line-level Spicy until Unison has had one chance to supply
            // word-level timing. A miss or a line-level Unison result falls
            // back to this exact Spicy payload, not to LRCLIB.
            if (spicyResult.wordByWord !== true) {
              pendingSpicyLineResult = spicyResult;
              alLog("Spicy returned line-level timing; checking Unison for word-level.");
              return false;
            }
            if (loadSpicyResult(spicyResult)) {
              alLog("word-level TTML rendered from the Spicy Lyrics API.");
              return true;
            }
            alWarn("API returned TTML we could not parse; trying the next source.");
          } else {
            alWarn("no Spicy TTML for this track; trying the next source.");
          }
        } catch (error) {
          if (error && error.name === "AbortError") return true;
          alWarn("lookup failed; trying the next source:", error);
        }
        return false;
      },

      unison: async () => {
        try {
          const pendingSpicy = pendingSpicyLineResult;
          const unisonData = await fetchUnisonLyrics(track, key, controller);
          if (stale()) return true;
          const credits = unisonData ? unisonCredits(unisonData) : null;

          // Spicy produced line-level lyrics. Only word-level Unison may replace
          // it; a line-level, plain or missing Unison result keeps Spicy.
          if (pendingSpicy && unisonData && unisonData.wordByWord === true && unisonData.format === "ttml") {
            pendingSpicyCredits = credits;
            if (loadTTML(unisonData.lyrics, "external")) {
              pendingSpicyLineResult = null;
              alLog("word-level TTML rendered from Unison instead of line-level Spicy.");
              return true;
            }
            pendingSpicyCredits = null;
            alWarn("Unison returned word-level TTML we could not parse; keeping Spicy.");
            return loadPendingSpicy();
          }

          if (pendingSpicy) {
            alLog("Unison did not have word-level timing; keeping Spicy line-level lyrics.");
            return loadPendingSpicy();
          }

          if (unisonData && unisonData.format === "ttml") {
            pendingSpicyCredits = credits;
            if (loadTTML(unisonData.lyrics, "external")) {
              alLog("TTML rendered from Unison.");
              return true;
            }
            pendingSpicyCredits = null;
            alWarn("Unison returned TTML we could not parse; trying the next source.");
          }
          if (unisonData && unisonData.format === "lrc") {
            if (loadLRCLyrics({ syncedLyrics: unisonData.lyrics }, track.durationMs, "Unison", credits.attribution)) {
              alLog("synced lyrics rendered from Unison.");
              return true;
            }
            alWarn("Unison returned LRC that could not be parsed; trying the next source.");
          }
        } catch (error) {
          if (error && error.name === "AbortError") return true;
          alWarn("Unison lookup failed; trying the next source:", error);
        }
        // Never paint a held result from the old track after a track change.
        if (stale()) return true;
        // A held Spicy result must not be skipped just because Unison errored.
        if (pendingSpicyLineResult) return loadPendingSpicy();
        return false;
      },

      lrclib: async () => {
        try {
          const data = await fetchLrclibData();
          if (stale()) return true;
          if (!data) return false;
          loadLRCLyrics(data, track.durationMs);
          return true;
        } catch (error) {
          if (error && error.name === "AbortError") return true;
          if (stale()) return true;
          alWarn("LRCLIB lookup failed:", error);
          lrclibOutage = isLrclibOutage(error);
          return false;
        }
      },
    };

    // Fixed source priority: Aurora Community is curated per exact video id and
    // wins when it has the track. Spicy is next; if it only has line-level
    // timing, the spicy runner holds it while Unison gets one word-level check.
    // Unison line-level or a miss falls back to Spicy. LRCLIB is last.
    // lrc.red was retired on.
    const order = ["community", "spicy", "unison", "lrclib"];
    for (const id of order) {
      const runner = runners[id];
      if (!runner) continue;
      if (await runner()) return;
      if (stale()) return;
    }
    // Safety net: if a line-level Spicy result was held and the Unison runner
    // could not consume it, load it before declaring the track a miss.
    if (pendingSpicyLineResult && loadPendingSpicy()) return;
    // Every runner missed (or failed) for this track, so there is nothing for
    // the panel to resume with after an ad. Recorded for the ad notice's retry.
    adBreakNoteResult("none", "");
    showLyricsMessage(lrclibOutage ? LRCLIB_OUTAGE_MESSAGE : NO_LYRICS_MESSAGE);
  }

