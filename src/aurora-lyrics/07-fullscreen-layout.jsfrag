  function findPlayerVideo() {
    // NEVER fall back to a document-wide `document.querySelector("video")`.
    // While fullscreen is open, YTM's video has been reparented into
    // fsMediaHost — so both container selectors below stop matching, and that
    // fallback picked up the FIRST <video> in the document instead. On AJ's
    // Chrome that is another extension's 720x960 element, which reports
    // videoWidth > 0, so findPlayerVideo() claimed "a video is live" forever
    // (AJ, 2026-09-28; the trace caught vids[0] as a chrome-extension: source
    // alongside our own pane node at 0x0).
    // Consequence of the false positive: syncFsVideoMode() never got past its
    // `liveVideo && hasAttached` early return, so the MV -> cover-art detach
    // never ran — no cover card, no Kawarp, and the band never re-anchored.
    // ORDER MATTERS: our own reparented node first (it is the only candidate
    // once it is outside ytmusic-player), then YTM's containers for the case
    // where we do not own a video yet (the cover -> MV attach path).
    const video =
      (fsSavedVideo && fsSavedVideo.node) ||
      document.querySelector("ytmusic-player video") ||
      document.querySelector("#movie_player video");
    // A song with no music video still leaves an empty <video> in the DOM, so
    // only treat it as real media once it actually has frame dimensions. The
    // trace confirms YTM's recycled element drops to 0x0 on an audio-only
    // track, and that is exactly what lets the MV -> cover detach fire.
    return video && video.videoWidth > 0 ? video : null;
  }

  // Publish the live video's aspect ratio so the side-by-side media pane can
  // match it exactly. drawBgFrame() also writes these, but the entry and attach
  // paths must seed them before the first paint or the pane starts at 16:9.
  function publishFsVideoAspect(video) {
    if (!fsOverlay || !video) return;
    const width = Number(video.videoWidth) || 0;
    const height = Number(video.videoHeight) || 0;
    if (!width || !height) return;
    fsOverlay.style.setProperty("--ym-sl-fs-video-ar", width + " / " + height);
    fsOverlay.style.setProperty("--ym-sl-fs-video-ratio", String(width / height));
  }

  // Bump a YouTube image CDN URL to a larger size so the cover art fills the
  // fullscreen pane crisply instead of rendering as a tiny thumbnail. The CDN
  // accepts a trailing =wWIDTH-hHEIGHT hint and resizes server-side.
  function hiResArt(url) {
    if (!url || typeof url !== "string") return url;
    if (/=w\d+(-h\d+)?/.test(url)) return url.replace(/=w\d+(-h\d+)?/, "=w1024-h1024");
    return url + "=w1024-h1024";
  }

  // Full strength for the always-on readability layer. The gradient inside it
  // does the shaping (transparent at the column's left edge, near-solid black at
  // the screen edge), so this is the layer's own opacity, not a black level.
  // Keep it at 1: a translucent layer composites the SHARP backdrop over the
  // blurred one, which is what makes a deep blur read as a tint instead of a
  // frost. The fade in/out still runs through the opacity transition.
  const FS_LYRICS_SHADE_ON = 1;

  function setFullscreenLyricsShadeTarget(target) {
    // Do not smooth this in JavaScript: the CSS opacity transition already
    // provides the fade, and this layer now carries a backdrop blur whose
    // strength must fade in lockstep with the black gradient.
    const next = Math.max(0, Math.min(1, target));
    if (next === fsLyricsShadeTarget) return;
    fsLyricsShadeTarget = next;
    fsLyricsShadeLevel = next;
    if (fsOverlay) {
      const opacity = fsLyricsShadeLevel.toFixed(3);
      fsOverlay.style.setProperty("--ym-sl-fs-lyrics-shade-opacity", opacity);
      if (fsLyricsShade) fsLyricsShade.style.opacity = opacity;
    }
  }

  // Count "bright" pixels of ANY hue, not just near-white.
  // Perceptual luma weights green heavily (0.7152), so a vivid red scores only
  // ~54 and a vivid blue ~18 — both would be missed by a luma test even though
  // they wash out lyric text just as badly as white. HSV value (the max RGB
  // channel) treats saturated bright colours and near-white the same way, which
  // is the behaviour that actually protects readability.
  function getBrightResponse(pixels) {
    const BRIGHT_CHANNEL = 190;
    let bright = 0;
    let count = 0;
    for (let i = 0; i < pixels.length; i += 4) {
      const red = pixels[i];
      const green = pixels[i + 1];
      const blue = pixels[i + 2];
      const max = red > green ? (red > blue ? red : blue) : (green > blue ? green : blue);
      if (max > BRIGHT_CHANNEL) bright++;
      count++;
    }
    return count ? bright / count : 0;
  }

  // The sample's only remaining job is the controls scrim. The lyric shade used
  // to be driven by this same reading, which is why it vanished on a dark frame
  // and pumped on gradients; it is now a constant layer (see
  // syncFullscreenLyricsShade) so it never has to chase the picture.
  function applyFullscreenBrightPixels(pixels) {
    setFullscreenBrightVideo(getBrightResponse(pixels));
  }

  // Toggle the controls scrim with hysteresis: ON above 0.5 bright-pixel share,
  // OFF below 0.38. The gap keeps a video that sits near the threshold from
  // flickering the scrim on and off every sample.
  function setFullscreenBrightVideo(response) {
    // The scrim is a Video Background thing only; the sampler also runs nowhere
    // else, but keep this guard so a layout switch cannot leave it behind.
    if (fsLayoutMode !== "background") { clearFullscreenBrightVideo(); return; }
    let on = fsBrightVideo;
    if (!on && response > 0.5) on = true;
    else if (on && response < 0.38) on = false;
    if (on === fsBrightVideo) return;
    fsBrightVideo = on;
    if (fsOverlay) fsOverlay.classList.toggle("ym-sl-fs-bright-video", on);
  }

  function clearFullscreenBrightVideo() {
    if (!fsBrightVideo) return;
    fsBrightVideo = false;
    if (fsOverlay) fsOverlay.classList.remove("ym-sl-fs-bright-video");
  }

  // The lyric shade is unconditional now, in BOTH layouts where lyrics float
  // over a picture: Video Background (full-bleed video) and Video + Lyrics (the
  // column sits on the Kawarp / blurred-frame backdrop, which can be just as
  // bright). Portrait side compositions drop the column and hide the layer in
  // CSS; leaving the target on costs nothing there.
  function fsShadeLayoutActive() {
    return fsLayoutMode === "background" || fsLayoutMode === "side";
  }

  // Drive the shade from STATE, not from a brightness sample. Always on while
  // the lyrics are actually visible; fades out for the hide toggle and for the
  // intro / gap / final dim states, where there is nothing to protect. The CSS
  // opacity transition (and the blur riding on the same element) does the fade.
  function syncFullscreenLyricsShade() {
    // fsLyricsHidden only hides the column in Video Background (the class is
    // scoped there), so in Video + Lyrics the words are still on screen and the
    // shade must stay with them.
    const lyricsHidden = fsLayoutMode === "background" && fsLyricsHidden;
    const visible =
      !!fsActive &&
      !!fsOverlay &&
      fsShadeLayoutActive() &&
      !lyricsHidden &&
      !fsLyricsGapDimmed &&
      !fsLyricsIntroDimmed &&
      !fsLyricsFinalDimmed;
    setFullscreenLyricsShadeTarget(visible ? FS_LYRICS_SHADE_ON : 0);
  }

  // Map the on-screen lyric band to sample-canvas coordinates.
  // The <video> fills the overlay and paints with object-fit: cover (changed
  // from contain on 2026-09-27 so the fullscreen MV pane no longer shows the
  // two black letterbox bands). Cover means the frame OVERFLOWS the overlay
  // instead of being letterboxed, so the scale factor is max() rather than
  // min() and the horizontal offset is negative. Sampling the raw frame by
  // screen percentage alone still drifts whenever the video aspect differs
  // from the overlay's, so convert the screen band (53%..100%, full height)
  // into frame pixels first, then scale into the canvas, which always holds
  // the whole frame. Only Video Background samples now, and there the video
  // does fill the overlay.
  function getShadeSampleRect() {
    const fallback = { x: FS_SHADE_SAMPLE_X, y: 0, w: FS_SHADE_SAMPLE_SW, h: FS_SHADE_SAMPLE_H };
    const video = fsSavedVideo && fsSavedVideo.node;
    if (!fsOverlay || !video || !video.videoWidth || !video.videoHeight) return fallback;
    const overlayW = fsOverlay.clientWidth;
    const overlayH = fsOverlay.clientHeight;
    if (!overlayW || !overlayH) return fallback;

    // cover: the frame is scaled until it covers the overlay on both axes, so
    // the larger ratio wins and at least one axis overflows.
    const scale = Math.max(overlayW / video.videoWidth, overlayH / video.videoHeight);
    if (!(scale > 0)) return fallback;
    const contentW = video.videoWidth * scale;
    const offsetX = (overlayW - contentW) / 2;

    // Frame pixels covered by the on-screen lyric band.
    const fx0 = Math.max(0, Math.min(video.videoWidth, (overlayW * FS_SHADE_REGION_LEFT - offsetX) / scale));
    const fx1 = Math.max(0, Math.min(video.videoWidth, (overlayW - offsetX) / scale));
    if (fx1 <= fx0) return fallback;

    // Frame pixels -> canvas pixels (canvas is the whole frame, stretched).
    const sx = Math.floor((fx0 / video.videoWidth) * FS_SHADE_SAMPLE_W);
    const ex = Math.ceil((fx1 / video.videoWidth) * FS_SHADE_SAMPLE_W);
    const x = Math.max(0, Math.min(FS_SHADE_SAMPLE_W - 1, sx));
    const w = Math.max(1, Math.min(FS_SHADE_SAMPLE_W - x, ex - x));
    // Full height: the lyric band runs bottom to top.
    return { x, y: 0, w, h: FS_SHADE_SAMPLE_H };
  }

  function ensureFullscreenShadeCapture() {
    const video = fsSavedVideo && fsSavedVideo.node;
    if (!video || fsLyricsShadeStream || typeof video.captureStream !== "function") return false;
    try {
      fsLyricsShadeStream = video.captureStream();
      fsLyricsShadeTrack = fsLyricsShadeStream.getVideoTracks()[0] || null;
      if (!fsLyricsShadeTrack) return false;
      if (typeof MediaStreamTrackProcessor === "function") {
        fsLyricsShadeReader = new MediaStreamTrackProcessor({ track: fsLyricsShadeTrack }).readable.getReader();
      }
      if (typeof ImageCapture === "function") fsLyricsShadeCapture = new ImageCapture(fsLyricsShadeTrack);
      return !!(fsLyricsShadeReader || fsLyricsShadeCapture);
    } catch (_) {
      fsLyricsShadeReader = null;
      fsLyricsShadeCapture = null;
      fsLyricsShadeTrack = null;
      fsLyricsShadeStream = null;
      return false;
    }
  }

  async function sampleFullscreenLyricsBrightness() {
    if (fsLyricsShadeSampleInFlight) return;
    // Sampling now feeds the CONTROLS scrim only, and that scrim only exists in
    // Video Background. The lyric shade is a constant layer driven by state, so
    // nothing else reads the sample any more.
    if (!fsActive || fsLayoutMode !== "background" || !fsSavedVideo) {
      clearFullscreenBrightVideo();
      return;
    }
    const now = performance.now();
    if (now - fsLyricsShadeLastSampleAt < FS_LYRICS_SHADE_SAMPLE_MS) return;
    fsLyricsShadeLastSampleAt = now;
    const video = fsSavedVideo.node;
    if (!video.videoWidth || !video.videoHeight) return;
    if (!fsLyricsShadeCanvas) {
      fsLyricsShadeCanvas = document.createElement("canvas");
      fsLyricsShadeCanvas.width = FS_SHADE_SAMPLE_W;
      fsLyricsShadeCanvas.height = FS_SHADE_SAMPLE_H;
      fsLyricsShadeCtx = fsLyricsShadeCanvas.getContext("2d", { willReadFrequently: true });
    }
    fsLyricsShadeSampleInFlight = true;
    try {
      if (!fsLyricsShadeCanvasTainted && fsLyricsShadeCtx) {
        try {
          fsLyricsShadeCtx.drawImage(video, 0, 0, FS_SHADE_SAMPLE_W, FS_SHADE_SAMPLE_H);
          const rect = getShadeSampleRect();
          applyFullscreenBrightPixels(
            fsLyricsShadeCtx.getImageData(rect.x, rect.y, rect.w, rect.h).data
          );
          return;
        } catch (_) {
          fsLyricsShadeCanvasTainted = true;
        }
      }
      if (!ensureFullscreenShadeCapture()) {
        clearFullscreenBrightVideo();
        return;
      }
      let frame = null;
      if (fsLyricsShadeReader) {
        const result = await fsLyricsShadeReader.read();
        frame = result && result.value;
      } else if (fsLyricsShadeCapture) {
        frame = await fsLyricsShadeCapture.grabFrame();
      }
      if (!frame) {
        clearFullscreenBrightVideo();
        return;
      }
      fsLyricsShadeCtx.drawImage(frame, 0, 0, FS_SHADE_SAMPLE_W, FS_SHADE_SAMPLE_H);
      const rect = getShadeSampleRect();
      applyFullscreenBrightPixels(
        fsLyricsShadeCtx.getImageData(rect.x, rect.y, rect.w, rect.h).data
      );
      if (typeof frame.close === "function") frame.close();
    } catch (_) {
      clearFullscreenBrightVideo();
    } finally {
      fsLyricsShadeSampleInFlight = false;
    }
  }

  function formatFullscreenOffset(ms) {
    const sign = ms > 0 ? "+" : "";
    return sign + (ms / 1000).toFixed(1) + "s";
  }

  // Paint the live <video> into the ambient backdrop canvas at ~1/6 overlay
  // resolution. The CSS blur on the canvas then smooths + scales it to fill
  // the entire overlay as the ambient backdrop. One drawImage per video frame
  // is all this costs; the heavy blur is applied once to a static layer
  // instead of re-blurring the live video every compositor frame. At a 64px
  // blur the 1/6 backing store is invisible, so this is free quality to trade
  // away for performance.
  function drawBgFrame() {
    if (!fsActive || !fsBgCanvas || !fsBgCtx || !fsSavedVideo || !fsSavedVideo.node) return;
    // Hits paints Kawarp (or the blurred-cover fallback), not the video
    // canvas, so do not keep copying decoded frames into a canvas nobody sees.
    if (fsLayoutMode === "hits") return;
    // Kawarp OWNS the backdrop while it is up, and the stylesheet hides this
    // canvas behind it (.ym-sl-fs-has-kawarp .ym-sl-fs-bg-canvas: display none).
    // Drawing into it anyway was the most expensive thing in portrait music
    // video: assigning ctx.filter takes the 2D canvas off the GPU path, and
    // drawImage(<video>) copies each decoded frame back out of GPU memory.
    // Measured in a 1080x1920 window, same overlay, same lyrics, same canvas:
    // 14.8 fps playing vs 121 fps paused, with 0.3ms of our own JS per frame.
    // Every music video starts Kawarp from the live video, so this is the
    // normal branch, not a fallback.
    if (fsKawarpActive) return;
    const now = performance.now();
    if (now - fsBgLastDrawAt < FS_BG_FRAME_INTERVAL_MS) return;
    fsBgLastDrawAt = now;
    const v = fsSavedVideo.node;
    if (!v.videoWidth || !v.videoHeight) return;
    // Publish the real frame aspect ratio so the CSS can size the media pane to
    // match it (see the .ym-sl-fs-has-video .ym-sl-fs-media rule). Matching the
    // ratios makes object-fit: cover a no-op, which is what removes the side
    // cropping without bringing back letterbox bars. Only written when it
    // changes, so this is not a per-frame style invalidation.
    if (fsOverlay) {
      const ar = v.videoWidth + " / " + v.videoHeight;
      if (fsOverlay.style.getPropertyValue("--ym-sl-fs-video-ar") !== ar) {
        fsOverlay.style.setProperty("--ym-sl-fs-video-ar", ar);
        // ⭐ A plain NUMBER alongside the ratio (AJ, 2026-10-21). CSS can divide
        // by a number but NOT by a "1920 / 960" token, so without this the chrome
        // could not be anchored to the video's bottom edge — it had to be
        // bottom-anchored to the viewport, which is why the gap under the video
        // changed with its aspect ratio. The pane is 50% wide and centred, so its
        // bottom edge is `50% + 25vw / ratio`.
        if (v.videoWidth > 0 && v.videoHeight > 0) {
          fsOverlay.style.setProperty(
            "--ym-sl-fs-video-ratio",
            String(v.videoWidth / v.videoHeight)
          );
        }
        // No re-measure here any more (AJ, 2026-10-20): the chrome positions are
        // fixed lengths, so a new aspect ratio only resizes the pane itself.
      }
    }
    const targetW = Math.max(2, Math.round(fsBgCanvas.clientWidth / 6));
    const targetH = Math.max(2, Math.round(fsBgCanvas.clientHeight / 6));
    if (fsBgCanvas.width !== targetW || fsBgCanvas.height !== targetH) {
      fsBgCanvas.width = targetW;
      fsBgCanvas.height = targetH;
    }
    try {
      // Bake the blur into the canvas instead of applying it with CSS. A
      // stylesheet filter on a <canvas> was being silently dropped in the live
      // build; ctx.filter is a canvas API and cannot be overridden by CSS, so
      // the result is deterministic. Blurring a ~320x180 backing store costs
      // almost nothing, and the upscale to fullscreen multiplies the radius:
      // 10px here renders as roughly 70px of blur on a 1080p overlay (turned
      // down from 18px / ~130px at AJ's request — still clearly blurred but
      // less heavy). Brightness is now user-controlled: the "Music video
      // backdrop brightness" slider in AURORA BLOOM feeds
      // currentSettings.backdropBrightness (default 1.15), delivered
      // cross-add-on via handleHostMessage.
      fsBgCtx.filter = "blur(10px) saturate(1.4) brightness(" + currentSettings.backdropBrightness + ")";
      fsBgCtx.drawImage(v, 0, 0, targetW, targetH);
      fsBgCtx.filter = "none";
    } catch (_) {
      try { fsBgCtx.filter = "none"; } catch (_e) {}
      // Direct draw can be blocked by cross-origin taint. The canvas keeps
      // its last frame, which is fine for an ambient backdrop.
    }
  }

  // Drive the backdrop redraw from the video's actual paint cadence so we
  // only do work when a new frame is available, and never compete with the
  // 60Hz lyrics animation loop.
  function startBgDrawLoop() {
    if (fsBgRaf) return;
    const v = fsSavedVideo && fsSavedVideo.node;
    if (v && typeof v.requestVideoFrameCallback === "function") {
      const loop = () => {
        if (!fsActive) return;
        drawBgFrame();
        fsBgRaf = v.requestVideoFrameCallback(loop);
      };
      fsBgRaf = v.requestVideoFrameCallback(loop);
    } else {
      const step = () => {
        fsBgRaf = null;
        if (!fsActive) return;
        drawBgFrame();
        fsBgRaf = requestAnimationFrame(step);
      };
      fsBgRaf = requestAnimationFrame(step);
    }
  }

  function stopBgDrawLoop() {
    const v = fsSavedVideo && fsSavedVideo.node;
    if (fsBgRaf) {
      if (v && typeof v.cancelVideoFrameCallback === "function") {
        try { v.cancelVideoFrameCallback(fsBgRaf); } catch (_) {}
      } else {
        cancelAnimationFrame(fsBgRaf);
      }
    }
    fsBgRaf = null;
  }

  function updateFullscreenGapDimming(lyricPositionMs, activeIndex) {
    if (!fsOverlay) return;
    const canDim = fsLayoutMode === "background" && !!fsSavedVideo;
    if (!canDim || !modelLines.length || !scrollCandidateIndices.length) {
      if (fsLyricsGapDimmed || fsLyricsIntroDimmed || fsLyricsFinalDimmed) {
        fsOverlay.classList.remove("ym-sl-fs-gap-dim", "ym-sl-fs-intro-dim", "ym-sl-fs-final-dim");
        fsLyricsGapDimmed = false;
        fsLyricsIntroDimmed = false;
        fsLyricsFinalDimmed = false;
      }
      syncFullscreenLyricsShade();
      return;
    }

    const activeLine = activeIndex >= 0 ? modelLines[activeIndex] : null;
    const finalHideDelay = currentLyricsIsTTML ? 0 : FS_FINAL_LYRICS_HIDE_MS;
    const finalExpired = cachedLastRealLyricEndMs > 0 &&
      lyricPositionMs >= cachedLastRealLyricEndMs + finalHideDelay;
    const beforeFirstLyric = Number.isFinite(cachedFirstRealLyricStartMs) &&
      lyricPositionMs < cachedFirstRealLyricStartMs;
    let shouldDim = beforeFirstLyric || finalExpired;

    if (!finalExpired && !beforeFirstLyric && activeLine && activeLine.DotLine) {
      // Later generated dot lines span instrumental gaps. Keep the lyrics
      // hidden until shortly before the next real lyric starts.
      shouldDim = activeLine.EndTime - lyricPositionMs > FS_LYRICS_RESTORE_LEAD_MS;
    } else if (!finalExpired && !beforeFirstLyric && !activeLine) {
      // A gap without generated dots: only dim when there is no active line AND a real next line.
      const previousLine = activeIndex > 0 ? modelLines[activeIndex - 1] : null;
      const nextLine = activeIndex >= 0 ? modelLines[activeIndex + 1] : null;
      const previousEnd = previousLine ? previousLine.EndTime : lyricPositionMs;
      const nextStart = nextLine ? nextLine.StartTime : Infinity;
      const gapMs = nextStart - previousEnd;
      shouldDim = Number.isFinite(nextStart) &&
        gapMs >= FS_LYRICS_GAP_DIM_MS &&
        nextStart - lyricPositionMs > FS_LYRICS_RESTORE_LEAD_MS;
    }

    if (shouldDim !== fsLyricsGapDimmed) {
      fsLyricsGapDimmed = shouldDim;
      fsOverlay.classList.toggle("ym-sl-fs-gap-dim", shouldDim);
    }
    if (beforeFirstLyric !== fsLyricsIntroDimmed) {
      fsLyricsIntroDimmed = beforeFirstLyric;
      fsOverlay.classList.toggle("ym-sl-fs-intro-dim", beforeFirstLyric);
    }
    if (finalExpired !== fsLyricsFinalDimmed) {
      fsLyricsFinalDimmed = finalExpired;
      fsOverlay.classList.toggle("ym-sl-fs-final-dim", finalExpired);
    }
    // No lyrics are on screen in any hidden / intro / gap / final state, so the
    // readability layer has nothing to protect. It is state-driven, so this
    // clears it on the same frame instead of waiting for a brightness sample.
    syncFullscreenLyricsShade();
  }

  const FS_LAYOUT_NAMES = {
    hits: "Hits",
    side: "Video + Lyrics",
    background: "Video Background",
  };
  // Hits is the cover-art default: artwork, title and actions at the top,
  // lyrics directly beneath. Music videos deliberately do NOT get it — the
  // side-by-side composition is the clean framing there, so a video cycles
  // only between Video + Lyrics and Video Background.
  const FS_LAYOUT_KEY = "better_lyrics_fullscreen_layout_v2";
  const FS_LAYOUT_VIDEO_KEY = "better_lyrics_fullscreen_layout_video_v1";
  // Remembered across entries like the layout mode itself: the side is a
  // preference, not a per-song state.
  const FS_COVER_SIDE_KEY = "better_lyrics_fullscreen_cover_side_v1";

  function hasFsVideo() {
    return !!(fsOverlay && fsOverlay.classList.contains("ym-sl-fs-has-video"));
  }

  // Each track type has its own two-mode cycle: music videos go Video + Lyrics
  // <-> Video Background, cover art goes Hits <-> Video + Lyrics. Hits is never
  // offered for a video, and Background has no backdrop without one.
  function nextFsLayoutMode(current) {
    const order = hasFsVideo() ? ["side", "background"] : ["hits", "side"];
    const i = order.indexOf(current);
    return order[i < 0 ? 0 : (i + 1) % order.length];
  }

  /**
   * Spell out the current layout AND the next one in the cycle button's
   * tooltip. A cycle button has no open state to browse, so without this the
   * order would be unguessable.
   */
  function updateFsLayoutButtonTitle() {
    if (!fsLayoutSelect) return;
    const current = FS_LAYOUT_NAMES[fsLayoutMode] || fsLayoutMode;
    const nextMode = nextFsLayoutMode(fsLayoutMode);
    const next = FS_LAYOUT_NAMES[nextMode] || nextMode;
    const text = "Layout: " + current + " - click for " + next;
    fsLayoutSelect.title = text;
    fsLayoutSelect.setAttribute("aria-label", text);
    // Keep the text label in step too: music videos show the label rather than
    // the glyph, so it has to name the mode the user is actually on.
    const label = fsLayoutSelect.querySelector(".ym-sl-fs-btn-label");
    if (label) label.textContent = current;
  }

  /* ---- Layout handoff (cover art) ---------------------------------------
     One flying card carries the artwork between the small Hits header
     thumbnail and the larger side cover. It is positioned against whichever
     endpoint is larger and animated with transforms only, so the bitmap is
     never re-rasterized at a growing size and border-radius does not repaint
     on every frame. The real side card stays hidden until the clone lands.
     MVs never enter Hits, so this is cover art only. */
  function cleanupFsHitsToSide() {
    if (fsHitsArtFlyTimer) {
      window.clearTimeout(fsHitsArtFlyTimer);
      fsHitsArtFlyTimer = 0;
    }
    if (fsLyricsFlipAnim) {
      try { fsLyricsFlipAnim.cancel(); } catch (_) {}
      fsLyricsFlipAnim = null;
    }
    if (fsLyricsHost) fsLyricsHost.style.translate = "";
    const fly = fsHitsArtFly;
    fsHitsArtFly = null;
    if (fly) {
      try { if (fly.anim) fly.anim.cancel(); } catch (_) {}
      if (fly.node && fly.node.parentElement) fly.node.parentElement.removeChild(fly.node);
      if (fly.art) fly.art.style.opacity = fly.opacity;
    }
    if (fsOverlay) {
      fsOverlay.classList.remove(
        "ym-sl-fs-hits-to-side",
        "ym-sl-fs-side-to-hits",
        "ym-sl-fs-lyrics-flip"
      );
    }
    // The reverse flight lands on a smaller corner radius than the header
    // card's native one. Let the card grow its corners back once the clone is
    // gone instead of snapping there.
    if (fly && fly.headerArt) {
      fly.headerArt.style.borderRadius = fly.headerArtRadius;
    }
  }

  function startFsArtHandoff(startRect, endRect, src, options) {
    if (!fsOverlay || !fsArtImg || !src || !startRect || !endRect ||
        !startRect.width || !startRect.height ||
        !endRect.width || !endRect.height) {
      cleanupFsHitsToSide();
      return;
    }
    const opts = options || {};
    // Rasterize at the larger endpoint and scale down at the smaller one. This
    // keeps the artwork crisp in both directions (a reverse flight would
    // otherwise scale the 148px header bitmap up to the 583px side card).
    const startArea = startRect.width * startRect.height;
    const endArea = endRect.width * endRect.height;
    const base = startArea >= endArea ? startRect : endRect;
    const startSX = startRect.width / base.width;
    const startSY = startRect.height / base.height;
    const endSX = endRect.width / base.width;
    const endSY = endRect.height / base.height;
    const startX = startRect.left - base.left;
    const startY = startRect.top - base.top;
    const endX = endRect.left - base.left;
    const endY = endRect.top - base.top;
    const startTransform =
      "translate(" + startX + "px, " + startY + "px) scale(" + startSX + ", " + startSY + ")";
    const endTransform =
      "translate(" + endX + "px, " + endY + "px) scale(" + endSX + ", " + endSY + ")";
    const sideRadius = parseFloat(getComputedStyle(fsArtImg).borderTopLeftRadius) || 16;
    const fly = h("img", { class: "ym-sl-fs-art-fly", src, alt: "" });
    fly.style.left = base.left + "px";
    fly.style.top = base.top + "px";
    fly.style.width = base.width + "px";
    fly.style.height = base.height + "px";
    // A fixed base radius on the larger card; it scales down with the clone.
    // Animating border-radius to compensate repainted the large bitmap every
    // frame and was the main source of the jank.
    fly.style.borderRadius = sideRadius + "px";
    // Same bitmap, same box: hold the real card invisible so there is never a
    // second cover on screen while the clone travels.
    const previousOpacity = fsArtImg.style.opacity;
    fsArtImg.style.opacity = "0";
    let headerArt = null;
    let headerArtRadius = "";
    if (opts.matchHeaderRadius && fsHits && fsHits.artWrap) {
      // The clone ends at endSX; make the real header card meet its corner
      // radius and then transition back to the card's native radius.
      headerArt = fsHits.artWrap;
      headerArtRadius = headerArt.style.borderRadius;
      headerArt.style.borderRadius = (sideRadius * endSX) + "px";
    }
    fsOverlay.appendChild(fly);
    let anim = null;
    try {
      anim = fly.animate([
        { transform: startTransform },
        { transform: endTransform },
      ], {
        duration: 560,
        easing: "cubic-bezier(.22, .61, .36, 1)",
        fill: "forwards",
      });
    } catch (_) {}
    fsHitsArtFly = {
      node: fly, anim, art: fsArtImg, opacity: previousOpacity,
      headerArt, headerArtRadius,
    };
    // WAAPI is the animation; this timer is the belt for a throttled/cancelled
    // animation and the moment the real card takes over.
    fsHitsArtFlyTimer = window.setTimeout(cleanupFsHitsToSide, 620);
  }

  function startFsHitsToSide(startRect, src) {
    if (!fsOverlay || !fsArtImg || !src || !startRect ||
        !startRect.width || !startRect.height) {
      cleanupFsHitsToSide();
      return;
    }
    const target = fsArtImg.getBoundingClientRect();
    if (!target.width || !target.height) {
      cleanupFsHitsToSide();
      return;
    }
    startFsArtHandoff(startRect, target, src);
  }

  function startFsSideToHits(startRect, targetRect, src) {
    if (!startRect || !targetRect || !src) {
      cleanupFsHitsToSide();
      return;
    }
    startFsArtHandoff(startRect, targetRect, src, { matchHeaderRadius: true });
  }

  function measureFsHitsArtTarget() {
    if (!fsHits || !fsHits.root || !fsHits.artWrap) return null;
    const root = fsHits.root;
    const prevDisplay = root.style.display;
    const prevVisibility = root.style.visibility;
    root.style.display = "block";
    root.style.visibility = "hidden";
    const rect = fsHits.artWrap.getBoundingClientRect();
    root.style.display = prevDisplay;
    root.style.visibility = prevVisibility;
    return rect;
  }

  function applyFullscreenLayout(mode, persist) {
    if (!fsOverlay) return;
    // A second switch can land while the card is still flying; finish/cancel
    // the previous handoff before choosing new geometry.
    cleanupFsHitsToSide();
    // A fast switch back into Video Background must not leave the outgoing
    // media transition class (or its timer) attached to the new layout.
    if (fsMediaLayoutAnimTimer) {
      window.clearTimeout(fsMediaLayoutAnimTimer);
      fsMediaLayoutAnimTimer = 0;
    }
    fsOverlay.classList.remove("ym-sl-fs-media-layout-out");
    const video = hasFsVideo();
    // Saved "lyrics" (or any value this build no longer knows) falls through
    // to the right default for the track type.
    if (mode !== "hits" && mode !== "side" && mode !== "background") {
      mode = video ? "side" : "hits";
    }
    // Music videos are side-by-side only: a saved Hits (from before this rule)
    // must not bring the video composition back. Without a video there is no
    // backdrop for Video Background, so that also falls back to side.
    if (video && mode === "hits") mode = "side";
    if (!video && mode === "background") mode = "side";

    // Capture both ends before the class flip hides either one. The handoff is
    // cover art only; a video that just appeared must cut straight to its side
    // composition. fsLayoutApplied excludes the first paint, where the side
    // layout has no mode class of its own.
    const wasHits = fsOverlay.classList.contains("ym-sl-fs-mode-hits");
    const wasBackground = fsOverlay.classList.contains("ym-sl-fs-mode-background");
    const wasSide = fsLayoutApplied && !wasHits &&
      !fsOverlay.classList.contains("ym-sl-fs-mode-background") && !video;
    const reduceMotion = window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let hitsArtStart = null;
    let hitsArtSrc = "";
    let animateHitsToSide = false;
    let sideArtStart = null;
    let sideArtSrc = "";
    let hitsArtTarget = null;
    let animateSideToHits = false;
    let lyricsFlipStart = null;
    if (wasHits && !video && mode === "side" && !reduceMotion &&
        fsHits && fsHits.art && fsHits.artWrap &&
        fsArtImg && fsArtImg.isConnected) {
      hitsArtSrc = fsHits.art.currentSrc || fsHits.art.getAttribute("src") || "";
      const sideSrc = fsArtImg.getAttribute("src") || "";
      if (hitsArtSrc && sideSrc) {
        hitsArtStart = fsHits.artWrap.getBoundingClientRect();
        animateHitsToSide = hitsArtStart.width > 0 && hitsArtStart.height > 0;
      }
    } else if (wasSide && mode === "hits" && !reduceMotion &&
        fsHits && fsHits.art && fsHits.artWrap &&
        fsArtImg && fsArtImg.isConnected) {
      sideArtSrc = fsArtImg.currentSrc || fsArtImg.getAttribute("src") || "";
      const hitsSrc = fsHits.art.currentSrc || fsHits.art.getAttribute("src") || "";
      if (sideArtSrc && hitsSrc) {
        sideArtStart = fsArtImg.getBoundingClientRect();
        hitsArtTarget = measureFsHitsArtTarget();
        animateSideToHits = !!hitsArtTarget &&
          sideArtStart.width > 0 && sideArtStart.height > 0 &&
          hitsArtTarget.width > 0 && hitsArtTarget.height > 0;
      }
    }
    fsLayoutMode = mode;
    if (fsLayoutMode !== "background") {
      // The controls scrim only exists in Video Background; drop it at once
      // rather than waiting up to a sample tick to clear it.
      clearFullscreenBrightVideo();
      fsLyricsGapDimmed = false;
      fsLyricsIntroDimmed = false;
      fsLyricsFinalDimmed = false;
      fsOverlay.classList.remove("ym-sl-fs-gap-dim", "ym-sl-fs-intro-dim", "ym-sl-fs-final-dim");
    }
    // Spicy draws real DOM text. Animating the lyrics column's width, padding
    // or height makes every line re-wrap and re-measure on every frame, which
    // is the panel-only stutter in the Hits handoff. Snap the final geometry
    // once, then FLIP a compositor-only translate from the old box below.
    // AMLL is a canvas and keeps the existing full geometry transition.
    if (!reduceMotion && (animateHitsToSide || animateSideToHits) &&
        fsLyricsHost && !document.body.classList.contains("amll-active")) {
      lyricsFlipStart = fsLyricsHost.getBoundingClientRect();
      fsOverlay.classList.add("ym-sl-fs-lyrics-flip");
    }
    if (animateHitsToSide || animateSideToHits) {
      fsOverlay.classList.add(
        animateHitsToSide ? "ym-sl-fs-hits-to-side" : "ym-sl-fs-side-to-hits"
      );
      // Read the starting style once so the header/side chrome starts from the
      // current composition and the lyrics animate from the current geometry.
      // No paint happens between this flush and the class flip below.
      void fsOverlay.offsetWidth;
    }
    // Leaving Video Background is the asymmetric case: entry to the full-bleed
    // video reads as a fill, but removing the class used to cut the video back
    // to its side column in one frame. Arm the media host's geometry transition
    // while it is still full-bleed, then flip the layout class below.
    if (wasBackground && mode !== "background" && !reduceMotion) {
      fsOverlay.classList.add("ym-sl-fs-media-layout-out");
      void fsOverlay.offsetWidth;
    }
    // The column's left/width are CSS-transitioned (no frost re-measure needed).
    fsOverlay.classList.toggle("ym-sl-fs-mode-background", fsLayoutMode === "background");
    fsOverlay.classList.toggle("ym-sl-fs-mode-hits", fsLayoutMode === "hits");
    if (lyricsFlipStart && fsLyricsHost) {
      // Hits positions the column from its measured header height. Make sure
      // that height exists before measuring the final lyrics box, or the FLIP
      // target would be the pre-header geometry.
      if (fsLayoutMode === "hits") {
        syncFsHitsCredits();
        syncFsHitsGeometry();
      }
      const lyricsFlipEnd = fsLyricsHost.getBoundingClientRect();
      const flipX = lyricsFlipStart.left - lyricsFlipEnd.left;
      const flipY = lyricsFlipStart.top - lyricsFlipEnd.top;
      if (Math.abs(flipX) > 0.5 || Math.abs(flipY) > 0.5) {
        try {
          fsLyricsFlipAnim = fsLyricsHost.animate(
            [
              { translate: flipX + "px " + flipY + "px" },
              { translate: "0px 0px" },
            ],
            { duration: 550, easing: "cubic-bezier(.22, .61, .36, 1)" }
          );
        } catch (_) {
          fsLyricsFlipAnim = null;
        }
      }
    }
    // The flying card targets the side artwork's final box, measured after the
    // layout classes are in place. It keeps the real card hidden until landing.
    if (animateHitsToSide) startFsHitsToSide(hitsArtStart, hitsArtSrc);
    else if (animateSideToHits) startFsSideToHits(sideArtStart, hitsArtTarget, sideArtSrc);
    // Background and Video + Lyrics both keep the readability layer on.
    syncFullscreenLyricsShade();
    // The volume group's home and the edge buttons follow the composition, so
    // re-home them once per layout switch (AJ, 2026-10-20). Positions themselves
    // are static — this only moves the volume node between the chip and the
    // scrubber row, and re-pins the two edge buttons. Skip it during the reverse
    // handoff: Hits hides this chrome anyway, and pulling the title out of the
    // fading side column (or the volume into the scrubber) would rearrange it
    // visibly mid-flight.
    if (!animateSideToHits) syncFsChromeStructure();
    // The Hits dock stays in the cover-art header flow; music videos never use
    // this composition, so there is no bottom-left placement any more.
    placeFsHitsDock();
    if (fsLayoutSelect) {
      // Now a button rather than a <select>, so the mode rides on the dataset
      // instead of .value, and the tooltip is refreshed so the announced
      // "current - next" pair stays accurate after every switch.
      if (fsLayoutSelect.dataset.layoutMode !== fsLayoutMode) {
        fsLayoutSelect.dataset.layoutMode = fsLayoutMode;
      }
      updateFsLayoutButtonTitle();
    }
    // Separate preferences by track type: picking Video Background for an MV
    // must not change the cover-art composition, and an MV must never inherit
    // the audio Hits choice. Automatic fallbacks pass persist=false so dropping
    // out of a mode the track no longer supports leaves the stored choice alone.
    if (persist !== false) {
      try {
        localStorage.setItem(video ? FS_LAYOUT_VIDEO_KEY : FS_LAYOUT_KEY, fsLayoutMode);
      } catch (_) {}
    }
    recomputeActiveOffsetMode(true);
    // Switching layout resizes and moves the lyrics column with a CSS transition,
    // so the old scrollTop no longer centres the active line — and nothing
    // corrected it until the next line change happened to retarget the spring.
    // Hence "the camera doesn't stay on the active line". The window keeps
    // re-placing it for the length of the transition.
    recentreActiveLine();
    // AMLL owns its own scroll offset, so keep its focal line in step with this
    // layout switch too.
    amllSyncAlignPosition();
    // Hits places the lyrics column from the header's measured height. The
    // header is display:none until the class above lands, so the measurement
    // has to wait for the frame that actually shows it.
    if (fsLayoutMode === "hits") {
      // The header mirrors the attribution when the Spicy renderer owns the
      // lyrics. Refresh it on every switch back into Hits, then re-measure the
      // header now that the credit block can be present.
      syncFsHitsCredits();
      requestAnimationFrame(syncFsHitsGeometry);
    }
    fsLayoutApplied = true;
    if (wasBackground && mode !== "background" && !reduceMotion) {
      fsMediaLayoutAnimTimer = window.setTimeout(() => {
        fsMediaLayoutAnimTimer = 0;
        if (fsOverlay) fsOverlay.classList.remove("ym-sl-fs-media-layout-out");
      }, 540);
    }
  }

  /* ---- cover-art side (AJ, 2026-10-26) -----------------------------------
     The cover-art side layout has two mirror images, and the artwork's own
     hover surface is where the choice belongs: pointing at the cover dims it a
     touch and fades in ONE round button at its top edge. The button cycles -
     click moves the lyrics to the other side, click again brings them back -
     and its glyph swaps the two panes with it, so the icon is the animation
     rather than two labels spelling the state out. Music videos never get the
     switch: a video frame is tied to its own composition, and the edge rating
     buttons already own its sides. */
  function readStoredFsCoverSide() {
    try {
      return localStorage.getItem(FS_COVER_SIDE_KEY) === "left" ? "left" : "right";
    } catch (_) {
      return "right";
    }
  }

  function syncFsCoverSwitch() {
    if (!fsCoverSwitch) return;
    const left = fsCoverSide === "left";
    // The class is what animates the glyph; the label names what a click will
    // do next, which is the only thing a single toggle can usefully announce.
    fsCoverSwitch.btn.classList.toggle("is-left", left);
    fsCoverSwitch.btn.setAttribute("aria-pressed", left ? "true" : "false");
    const label = "Move the lyrics to the " + (left ? "right" : "left");
    fsCoverSwitch.btn.title = label;
    fsCoverSwitch.btn.setAttribute("aria-label", label);
  }

  // Built once per fullscreen entry and parked inside the media host, so it
  // moves with the artwork for free — the hover box mirrors the cover's box
  // (see the art-ui rules in 05-styles).
  // Spicy Lyrics' own heart (their Icons.Heart outline + HeartFill ellipses),
  // rebuilt with DOM calls rather than innerHTML: YouTube Music enforces
  // Trusted Types, so assigning markup throws and aborts the whole fullscreen
  // entry (AJ, 2026-10-30). currentColor lets the CSS own the colour; the fill
  // group's opacity is what animates between outline, hover hint and liked.
  function fsHeartSvg() {
    const NS = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(NS, "svg");
    svg.setAttribute("viewBox", "0 0 1000 1000");
    svg.setAttribute("fill", "none");
    svg.setAttribute("aria-hidden", "true");
    svg.setAttribute("focusable", "false");
    const outline = document.createElementNS(NS, "g");
    outline.setAttribute("class", "ym-sl-fs-heart-outline");
    const path = document.createElementNS(NS, "path");
    path.setAttribute("d", "M982.995 324.097C982.995 180.45 866.598 64 723.02 64C628.493 64 545.998 114.641 500.496 190.119C454.992 114.641 372.499 64 277.973 64C134.394 64 18 180.45 18 324.097C18 356.935 24.3385 388.224 35.436 417.155C121.399 664.536 500.499 936 500.499 936C500.499 936 879.595 664.536 965.562 417.155C976.659 388.226 982.995 356.935 982.995 324.097Z");
    path.setAttribute("stroke", "currentColor");
    path.setAttribute("stroke-width", "22");
    path.setAttribute("stroke-linecap", "round");
    path.setAttribute("stroke-linejoin", "round");
    outline.appendChild(path);
    svg.appendChild(outline);
    const fill = document.createElementNS(NS, "g");
    fill.setAttribute("class", "ym-sl-fs-heart-fill");
    const ellipse = (cx, cy, rx, ry, rotate) => {
      const node = document.createElementNS(NS, "ellipse");
      node.setAttribute("cx", cx);
      node.setAttribute("cy", cy);
      node.setAttribute("rx", rx);
      node.setAttribute("ry", ry);
      if (rotate) node.setAttribute("transform", rotate);
      node.setAttribute("fill", "currentColor");
      return node;
    };
    fill.append(
      ellipse("276.5", "285.5", "244.5", "215.5"),
      ellipse("725", "285.5", "247", "217.5"),
      ellipse("189", "325.5", "165", "214.5"),
      ellipse("234.335", "472.198", "150", "272", "rotate(-34.3576 234.335 472.198)"),
      ellipse("298.508", "629.28", "97.5117", "183.378", "rotate(-42.2757 298.508 629.28)"),
      ellipse("390.743", "718.138", "102.44", "192.646", "rotate(-42.2757 390.743 718.138)"),
      ellipse("669.263", "652.69", "102.44", "328.343", "rotate(42.28 669.263 652.69)"),
      ellipse("788.346", "447.149", "150", "262.498", "rotate(-143.364 788.346 447.149)"),
      ellipse("500", "588", "150", "327"),
      ellipse("499.5", "914.5", "24.5", "13.5"),
      ellipse("822.516", "623.447", "55.9753", "13.5", "rotate(-52.0641 822.516 623.447)")
    );
    svg.appendChild(fill);
    return svg;
  }

  function buildFsCoverSwitch() {
    if (!fsMediaHost || fsCoverSwitch) return;
    const NS = "http://www.w3.org/2000/svg";
    // Two panes, one filled: the filled pane IS the lyrics, so swapping them is
    // the same gesture as the layout change underneath.
    const pane = (cls, x) => {
      const rect = document.createElementNS(NS, "rect");
      rect.setAttribute("class", cls);
      rect.setAttribute("x", String(x));
      rect.setAttribute("y", "5.75");
      rect.setAttribute("width", "8");
      rect.setAttribute("height", "12.5");
      rect.setAttribute("rx", "2");
      return rect;
    };
    const icon = document.createElementNS(NS, "svg");
    icon.setAttribute("viewBox", "0 0 24 24");
    icon.setAttribute("class", "ym-sl-fs-art-swap-icon");
    icon.setAttribute("aria-hidden", "true");
    icon.setAttribute("focusable", "false");
    // Source order is the "lyrics right" rest state: outline (art) on the left,
    // filled (words) on the right.
    icon.appendChild(pane("ym-sl-fs-art-swap-art", 3.25));
    icon.appendChild(pane("ym-sl-fs-art-swap-words", 12.75));
    const btn = h("button", {
      type: "button",
      class: "ym-sl-fs-art-swap",
      "aria-pressed": "false",
    }, icon);
    btn.addEventListener("click", (ev) => {
      // The media pane sits under the overlay's own pointer handling; a button
      // click is a layout choice, never a play/seek.
      ev.preventDefault();
      ev.stopPropagation();
      applyFsCoverSide(fsCoverSide === "left" ? "right" : "left", true);
    });
    // The cover layout's like affordance (AJ, 2026-10-30). Unlike the edge
    // thumbs, this belongs to the ARTWORK, so it is hidden with the rest of
    // the hover surface for music videos and portrait.
    const heart = h("button", {
      type: "button",
      class: "ym-sl-fs-art-like",
      "aria-pressed": "false",
      "aria-label": "Add to liked songs",
      title: "Add to liked songs",
    });
    heart.appendChild(fsHeartSvg());
    fsArtLikeButton = heart;
    heart.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      const videoId = getCurrentFsVideoId();
      if (!videoId) return;
      const wasLiked = getFsRating(videoId) === "like";
      // Spicy's one-shot pop: grow on like, shrink on un-like, then release
      // the class so the spring transition carries the glyph back to rest.
      heart.classList.remove("is-press", "is-release");
      heart.classList.add(wasLiked ? "is-release" : "is-press");
      window.setTimeout(() => heart.classList.remove("is-press", "is-release"), 160);
      clickFsRating("like");
    });
    const ui = h("div", { class: "ym-sl-fs-art-ui" }, btn, heart);
    fsMediaHost.appendChild(ui);
    fsCoverSwitch = { ui, btn };
    syncFsCoverSwitch();
    applyFsRatingToButtons(getCurrentFsVideoId());
  }

  // The shade changes sides on its OWN clock, after it has faded out. Flipping
  // it with the layout would move the gradient's dark end to the panel's other
  // edge on the first frame - at 44% of the screen, i.e. the middle - while the
  // panel is still opaque, which reads as the shadow jumping to the centre
  // before it disappears. 120ms is just past the 96ms fade-out.
  const FS_SHADE_SIDE_DELAY_MS = 120;
  function setFsShadeSide(side) {
    if (fsLyricsShade) fsLyricsShade.classList.toggle("ym-sl-fs-shade-left", side === "left");
  }

  function applyFsCoverSide(side, animate) {
    if (!fsOverlay) return;
    const next = side === "left" ? "left" : "right";
    // The helper class is what gives the chrome column its left transition; it
    // is only present for the length of the move, so a mode change or the entry
    // paint can never animate a column it is restructuring.
    const canAnimate = !!animate && fsMotionOK() &&
      !fsOverlay.classList.contains("ym-sl-fs-no-anim");
    if (canAnimate) {
      // Remove-then-add, with a reflow in between: on a rapid second click the
      // helper classes are still there, and a class that never left does not
      // restart the shade's dissolve - the flip would land without it.
      // Removing them first also republishes the panes' start values.
      fsOverlay.classList.remove("ym-sl-fs-flipping", "ym-sl-fs-shade-swap");
      // Commit the transition's start value before the flip classes move the
      // column, or the first frame jumps instead of gliding.
      void fsOverlay.offsetWidth;
      fsOverlay.classList.add("ym-sl-fs-flipping", "ym-sl-fs-shade-swap");
      void fsOverlay.offsetWidth;
    }
    fsCoverSide = next;
    fsOverlay.classList.toggle("ym-sl-fs-cover-left", next === "left");
    syncFsCoverSwitch();
    try { localStorage.setItem(FS_COVER_SIDE_KEY, next); } catch (_) {}
    // Clear any pending side change first: on a rapid second click the timer
    // from the first could otherwise fire mid-fade and move a visible panel.
    if (fsCoverShadeSideTimer) { window.clearTimeout(fsCoverShadeSideTimer); fsCoverShadeSideTimer = 0; }
    if (!canAnimate) {
      setFsShadeSide(next);
      return;
    }
    fsCoverShadeSideTimer = window.setTimeout(() => {
      fsCoverShadeSideTimer = 0;
      // Read the state, not the captured value: a second click may have landed
      // while this was pending, and the shade must end up matching what is on.
      setFsShadeSide(fsCoverSide);
    }, FS_SHADE_SIDE_DELAY_MS);
    // No recentre call here, unlike the layout switch: only the column's LEFT
    // changes, so the active line keeps its vertical position and the scroll
    // needs no correction.
    if (fsCoverFlipTimer) window.clearTimeout(fsCoverFlipTimer);
    fsCoverFlipTimer = window.setTimeout(() => {
      fsCoverFlipTimer = 0;
      if (fsOverlay) fsOverlay.classList.remove("ym-sl-fs-flipping");
    }, 480);
    // The shade outlives the move on purpose: it stays away until the columns
    // have landed, then fades back in on the new side (see the dissolve
    // keyframes in 05-styles). 0.8s is the animation; the class is dropped just
    // after it so the element cannot keep a finished animation attached.
    if (fsCoverShadeTimer) window.clearTimeout(fsCoverShadeTimer);
    fsCoverShadeTimer = window.setTimeout(() => {
      fsCoverShadeTimer = 0;
      if (fsOverlay) fsOverlay.classList.remove("ym-sl-fs-shade-swap");
    }, 820);
  }

  function findPlayerButton(labels) {
    // Both bottom bars: the new one is a Wiz surface whose buttons carry the
    // same aria-labels, so the label scan below works unchanged.
    const bar = document.querySelector("ytmusic-miniplayer") ||
      document.querySelector("ytmusic-player-bar");
    if (!bar) return null;
    const buttons = Array.from(bar.querySelectorAll("button, tp-yt-paper-icon-button"));
    return buttons.find((button) => {
      const text = [button.getAttribute("aria-label"), button.getAttribute("title"), button.id, button.textContent]
        .filter(Boolean).join(" ");
      return labels.some((label) => new RegExp(label, "i").test(text));
    }) || null;
  }

  function clickPlayerButton(kind) {
    // Shuffle / Repeat are ANCHORED with ^: the player bar holds unrelated
    // controls whose text can contain these words, whereas YTM's own buttons are
    // labelled "Shuffle" and "Repeat off" / "Repeat all" / "Repeat one" — so the
    // aria-label is always at the START of the joined text findPlayerButton builds.
    const labels = kind === "previous"
      ? ["previous", "back", "prev"]
      : kind === "next"
        ? ["next", "skip"]
        : kind === "shuffle"
          ? ["^shuffle"]
          : kind === "repeat"
            ? ["^repeat"]
            : ["play", "pause"];
    const button = findPlayerButton(labels);
    if (button) button.click();
  }

  function findPlayerVolumeRange() {
    return document.querySelector("ytmusic-player-bar tp-yt-paper-slider[aria-label*='volume' i]") ||
      document.querySelector("ytmusic-player-bar input[type='range'][aria-label*='volume' i]") ||
      document.querySelector("ytmusic-miniplayer input[type='range'][aria-label*='volume' i]");
  }

  function setPlayerVolume(value) {
    const range = findPlayerVolumeRange();
    if (range) {
      range.value = String(clamp(value, 0, 100));
      range.dispatchEvent(new Event("input", { bubbles: true }));
      range.dispatchEvent(new Event("change", { bubbles: true }));
    }
  }

  // One write path for the fullscreen volume, shared by the slider's own handler
  // and the overlay's arrow keys (handleFsKeydown in 10-fullscreen-entry): the
  // custom track, its ARIA value and YTM's real volume move together, clamped the
  // same way in both places.
  function setFullscreenVolumePercent(value) {
    const n = Number(value);
    if (!Number.isFinite(n)) return;
    const v = clamp(Math.round(n), 0, 100);
    fsPlayerVolumeValue = v;
    if (fsPlayerVolumeRange) {
      fsPlayerVolumeRange.style.setProperty("--vol-fill", v + "%");
      fsPlayerVolumeRange.setAttribute("aria-valuenow", String(v));
    }
    setPlayerVolume(v);
  }

  function syncFullscreenVolumeControl() {
    if (!fsPlayerVolumeRange) return;
    const source = findPlayerVolumeRange();
    if (!source) return;
    const sourceValue = Number(source.value);
    const sourceMax = Number(source.max);
    if (!Number.isFinite(sourceValue) || !Number.isFinite(sourceMax) || sourceMax <= 0) return;
    const percent = clamp((sourceValue / sourceMax) * 100, 0, 100);
    // The track is a <div> (no .value). Skip while the user is driving it so the
    // 500ms refresh loop doesn't fight an in-progress drag/focus.
    if (document.activeElement !== fsPlayerVolumeRange) {
      fsPlayerVolumeValue = percent;
      fsPlayerVolumeRange.style.setProperty("--vol-fill", percent + "%");
      fsPlayerVolumeRange.setAttribute("aria-valuenow", String(percent));
    }
  }

  function formatClock(ms) {
    const total = Math.max(0, Math.floor(Number(ms) / 1000));
    const m = Math.floor(total / 60);
    const s = total % 60;
    return m + ":" + String(s).padStart(2, "0");
  }

  // While the user is driving the seek bar the 500ms sync must not fight them.
  // This used to key off `document.activeElement !== fsPlayerSeekRange`, but a
  // range KEEPS focus after a click, so the guard never lifted: the thumb froze
  // wherever it was clicked while --slider-fill (written outside the guard)
  // kept advancing underneath it. Exactly AJ's 2026-09-28 report - "the dot
  // just stays there and doesnt follow the fill". A short timestamp window is
  // self-healing: a real drag refreshes it through the input event, and it
  // expires on its own if the pointerup is missed.
  const FS_SEEK_USER_GRACE_MS = 1200;
  let fsSeekUserAt = 0;

  function syncFullscreenSeekControl() {
    if (!fsPlayerSeekRange || !window.YTMod || !window.YTMod.player) return;
    const position = Number(window.YTMod.player.getPositionMs());
    const duration = Number(window.YTMod.player.getDurationMs());
    if (!Number.isFinite(position) || !Number.isFinite(duration) || duration <= 0) return;
    const percent = clamp((position / duration) * 100, 0, 100);
    if (performance.now() - fsSeekUserAt > FS_SEEK_USER_GRACE_MS) {
      fsPlayerSeekRange.value = String(position);
    }
    fsPlayerSeekRange.max = String(duration);
    fsPlayerSeekRange.style.setProperty("--slider-fill", percent + "%");
    if (fsTimeCurrent) fsTimeCurrent.textContent = formatClock(position);
    if (fsTimeTotal) fsTimeTotal.textContent = formatClock(duration);
  }

  /* ---- fullscreen loading spinner ----------------------------------------
     A track change can take a while (the lyrics fetch over the network, or the
     video buffering), and the fullscreen overlay has no other affordance for
     it - the lyrics skeleton only covers the lyrics column. So: after
     FS_SPINNER_DELAY_MS show a centred spinner, and fade it out the moment the
     lyrics land. 2s delay and a 0.4s fade are exactly what Spicy Lyrics uses
     for its own loader (fetchLyrics.ts: setTimeout(..., 2000), and
     LoaderContainer.css: transition opacity 0.4s ease-in-out), and the icon +
     spin are theirs too.
     Driven from the lyrics skeleton's lifecycle because that is the only
     reliable "this track is loading" signal the extension has. */
