  /* ===================== AMLL (Apple-Music-style) renderer =====================
   * Simple lyrics mode renders through the REAL @applemusic-like-lyrics engine
   * (DomLyricPlayer), bundled into src/extensions/amll-core.js. We do NOT
   * re-implement the look — we import the upstream player, adapt Aurora's parsed
   * lyrics into its LyricLine[] model (seconds -> ms), force the SpicyLyrics font
   * on the host, and drive it every frame. That makes the scroll physics, spring
   * motion, per-word emphasis (>1s words) and the karaoke mask byte-for-byte the
   * engine's own behaviour, exactly like the AMLL preview.
   *
   * Any failure (engine import error, bad lyrics, drive exception) flips a flag
   * and falls back to Aurora's built-in glow-free Simple renderer, so the mode
   * can never break. The fallback Simple CSS already carries `text-shadow:none`
   * so there is no whole-line glow either way.
   */

  let amllActive = false;             // user intent: Simple lyrics is ON
  let amllReady = false;              // engine imported + player built
  let amllFailed = false;             // engine failed once -> stay on Aurora
  let amllPlayer = null;              // LyricPlayer instance
  let amllHost = null;                // #ym-sl-amll-host container
  let amllEnginePromise = null;       // cached dynamic-import promise
  let amllLastContent = null;         // last parsed lyrics (to re-sync on activate)
  let amllLastPositionMs = 0;
  let amllPrevTime = 0;
  let amllWasPlaying = false;
  let amllCssInjected = false;
  /* Apple-style lyrics is ONE SETTING, TWO RENDERERS (AJ, 2026-10-23):
   *  - by default, word-synced lyrics render through Aurora's own Spicy
   *    renderer exactly as they always have (same DOM, springs, glow, scroll),
   *    and line-synced ones through the AMLL engine.
   *
   * WHICH renderer takes which kind of track is now the user's choice, not a
   * hard rule any more: the two Renderer rows in the panel (`amllWordTracks` /
   * `spicyLineTracks`, content.js) point either kind of track at either
   * renderer. See amllContentGoesToSpicy.
   *
   * Two earlier attempts are gone and should not come back: (1) taking over the
   * engine's line contents to get Spicy words inside AMLL's scroll, which could
   * never be byte-identical to the Spicy renderer, and (2) grafting the Apple
   * stack (per-line focus blur, scale, staggered rows) onto the Spicy side. Each
   * renderer is left to do its own thing.
   *
   * `amllSpicyTrack` = "the built-in renderer owns the content currently loaded",
   * whatever the reason. It decides the LOOK too: the AMLL body class, the
   * gentle spline set and every `amllSimpleLookActive()` call follow it. */
  let amllSpicyTrack = false;
  function amllSimpleLookActive() {
    return !amllSpicyTrack;
  }
  function amllContentHasWordTiming(content) {
    if (!Array.isArray(content)) return false;
    for (const line of content) {
      const lead = line && line.Lead;
      const syls = lead && Array.isArray(lead.Syllables) ? lead.Syllables : null;
      if (!syls) continue;
      const windows = new Set();
      for (const syl of syls) {
        const start = Number(syl && syl.StartTime) || 0;
        const end = Number(syl && syl.EndTime) || 0;
        if (end > start + 0.001) windows.add(Math.round(start * 1000) + ":" + Math.round(end * 1000));
      }
      // Two or more syllables with DIFFERENT windows = word karaoke. A line
      // whose word spans all carry the line's own window is line-timed.
      if (windows.size >= 2) return true;
    }
    return false;
  }
  // Does THIS content belong to the built-in Spicy renderer? Each kind of track
  // has its own Renderer row, and each row names the renderer it SELECTS, so the
  // two are independent rather than inverses of one another.
  function amllContentGoesToSpicy(content) {
    if (amllContentHasWordTiming(content)) return currentSettings.amllWordTracks !== true;
    return currentSettings.spicyLineTracks === true;
  }

  function amllSetSpicyTrack(spicy) {
    const next = !!spicy;
    if (next === amllSpicyTrack) return;
    amllSpicyTrack = next;
    try {
      document.body.classList.toggle("ym-sl-simple-lyrics", amllSimpleLookActive());
    } catch (e) {}
    // The spline set follows the renderer, not the setting: the Spicy renderer
    // must get the real (bouncing) curves back, and the AMLL look gets the
    // gentle ones.
    try { applySimpleLyricsSplines(); } catch (e) {}
    // Consumers (the PiP) hold the spline OBJECTS, and applySimpleLyricsSplines()
    // REPLACES them. Re-publish when the owner changes, or the next Spicy track
    // is built from the AMLL curves - which read as words floating up instead of
    // bouncing.
    try { publishRendererKit(true); } catch (e) {}
    // Anything the look may have written inline belongs to the other renderer's
    // frame; drop it so a rebuilt line never starts from a stale value.
    try {
      if (typeof modelLines !== "undefined" && modelLines) {
        for (const ln of modelLines) {
          const el = ln && ln.HTMLElement;
          if (!el) continue;
          el.style.removeProperty("filter");
          el.style.removeProperty("--ym-sl-line-alpha");
          el.style.removeProperty("--amll-depth-scale");
          el.__ymSpicyStyleCache = {};
        }
      }
    } catch (e) {}
  }
  /* Decide the renderer for the loaded content and make the engine agree.
     Returns true when the OWNER changed, so the caller can rebuild the Spicy
     lines and re-sync. Safe to call any time: it no-ops when nothing moved.

     The engine may never have been started for the previous track (a word track
     that went to Spicy does not load it), so handing the next track to the
     engine has to START it here — waiting for a settings change was the "stays
     on Spicy until I toggle the mode" bug. */
  // Which renderer actually OWNS this content right now — published to consumers
  // (the PiP) so they run the same one instead of guessing from the timings.
  // "amll" means the engine is drawing timed, line-by-line content; everything
  // else (word tracks pointed at Spicy, static lyrics, no content) is the
  // built-in renderer, even while the engine object exists.
  function amllTrackUsesEngine(content) {
    if (!content || amllSpicyTrack) return false;
    if (amllContentGoesToSpicy(content)) return false;
    return amllContentIsTimed(content);
  }

  function amllApplyTrackRenderer(content) {
    const spicy = !content || amllContentGoesToSpicy(content);
    const changed = spicy !== amllSpicyTrack;
    amllSetSpicyTrack(spicy);
    if (spicy) {
      amllHideSkeleton();
      if (amllActive) amllHide();
      return changed;
    }
    if (!amllActive) amllActivate();          // async; it syncs amllLastContent
    else if (changed && content) amllSyncLyrics(content);
    return changed;
  }

  let amllLastFrameTime = 0;
  let amllGen = 0;                     // invalidates in-flight activations on toggle
  // Focal line as a fraction of the player height. The loading skeleton reads
  // the same number through --amll-align-y, so nudging this moves both.
  const AMLL_ALIGN_POSITION = 0.42;

  // YouTube Music loads its own Web Animations polyfill
  // (web-animations-next-lite.min.js), and its Animation.effect objects do NOT
  // implement getComputedTiming(). The AMLL engine calls it in enable() and
  // resume() to work out an animation's end time:
  //     const timing = a.effect?.getComputedTiming();
  //     const endTime = Number(timing?.delay ?? 0) + Number(timing?.duration ?? 0);
  // With the polyfill that line THROWS, and because it sits inside enable()'s
  // word loop the whole loop aborts partway through - which is exactly why only
  // the FIRST word of a line ever animated. The same throw in resume() then fed
  // the drive loop's error counter until it forced a fallback to the built-in
  // renderer.
  //
  // Supply the missing method. Only ever ADD it, and only when it is absent, so
  // nothing about YTM's own animations changes.
  (function amllPatchAnimate() {
    try {
      const proto = window.Element && window.Element.prototype;
      if (!proto || typeof proto.animate !== "function") return;
      if (proto.animate.__amllPatched) return;
      const original = proto.animate;
      function patched(keyframes, options) {
        const anim = original.call(this, keyframes, options);
        try {
          const effect = anim && anim.effect;
          if (effect && typeof effect.getComputedTiming !== "function") {
            const opts = options || {};
            const duration = Number(opts.duration);
            const delay = Number(opts.delay);
            const dur = Number.isFinite(duration) ? duration : 0;
            const del = Number.isFinite(delay) ? delay : 0;
            effect.getComputedTiming = function () {
              return {
                delay: del,
                endDelay: 0,
                duration: dur,
                activeDuration: dur,
                fill: opts.fill || "none",
                playbackRate: 1,
                currentIteration: null,
                progress: null,
                easing: "linear",
                direction: "normal",
                iterations: 1,
              };
            };
          }
        } catch (e) {}
        return anim;
      }
      patched.__amllPatched = true;
      proto.animate = patched;
    } catch (e) {}
  })();
  let amllDriveErrors = 0;             // consecutive update() failures; 0 = healthy

  const AMLL_ENGINE_CSS = `.amll-lyric-player {
  width: 100%;
  max-width: 100%;
  height: 100%;
  color: var(--amll-lp-color, white);
  contain: strict;
  mix-blend-mode: plus-lighter;
  /* Sized off the lyric HOST's width, not the viewport. The same card renders
     in a 1920 fullscreen pane, a tab that shrinks when the NPV rail opens, and
     a ~380px NPV lyric box; 5vh stayed at full-screen size in the small ones,
     so the rail's words blew past its card edges (AJ, 2026-10-21). 7.5cqw is
     tuned to land on the SAME size as the standard renderer, whose
     --DefaultLyricsSize is 7cqw of .ym-sl-panel (measured: 522px panel -> 36.5px,
     this host 487px -> 36.5px), so the two renderers agree in the tab; the 5vh
     term still caps it in fullscreen, where the old look is unchanged. The bare
     5vh line is the fallback for a browser without container query units. */
  font-size: var(--amll-lp-font-size, 5vh);
  font-size: var(--amll-lp-font-size, clamp(12px, min(5vh, 7.5cqw), 64px));
  overflow: hidden;

  &.dom {
    /* Inset of the line box inside the player, and the ONLY lever that decides
       where a row wraps. The engine wraps at the wrapper's CONTENT width while
       the highlight box paints the wrapper's full width, so the upstream 1em
       per side broke rows at 696px inside an 804px player and left a dead
       strip on the right of every wrapped line (measured live, AJ 2026-10-21).
       .2em keeps the box off the glyphs and hands ~86px back to the text. */
    --lyric-line-padding-x: .2em;
    --amll-lp-bg-line-scale: .7;
    user-select: none;
    box-sizing: content-box;
    z-index: 1;
    line-height: 1.2;
  }
}

@property --bright-mask-alpha {
  syntax: "<number>";
  inherits: true;
  initial-value: 1;
}

@property --dark-mask-alpha {
  syntax: "<number>";
  inherits: true;
  initial-value: .2;
}

.FmKaba_lyricLineWrapper {
  box-sizing: border-box;
  width: 100%;
  padding: .4em var(--lyric-line-padding-x);
  will-change: transform;
  border-radius: .25em;
  flex-direction: column;
  align-items: flex-start;
  gap: .3em;
  transition: opacity .4s, filter .4s, background-color .25s;
  display: flex;
  position: absolute;
  top: 0;
  left: 0;

  &:not(.FmKaba_bottomLineWrapper):hover {
    background-color: var(--amll-lp-hover-bg-color, #fff1);
  }

  &:not(.FmKaba_bottomLineWrapper):active {
    background-color: var(--amll-lp-hover-bg-color, #ffffff05);
  }
}

.FmKaba_lyricLine {
  box-sizing: border-box;
  width: var(--amll-lp-width, 100%);
  min-width: var(--amll-lp-width, 100%);
  max-width: var(--amll-lp-width, 100%);
  contain: layout style paint;
  content-visibility: auto;
  contain-intrinsic-size: auto 40px;
  backface-visibility: hidden;
  transform-origin: 0;
  --mask-alpha-duration: .45s;
  --bright-mask-alpha: .2;
  --dark-mask-alpha: .2;
  height: fit-content;
  transition: box-shadow .25s,
		--bright-mask-alpha var(--mask-alpha-duration) ease-out,
		--dark-mask-alpha var(--mask-alpha-duration) ease-out;
  margin: -.2em;
  padding: .2em;
  position: relative;

  &.FmKaba_gradientMask {
    --mask-alpha-duration: .3s;
    --bright-mask-alpha: 1;
    --dark-mask-alpha: .4;
  }
}

.FmKaba_lyricDuetLine {
  text-align: right;
  transform-origin: 100%;
}

.FmKaba_lyricMainLine {
  contain: layout style;
  margin: -1em;
  padding: 1em;
  transition: opacity .3s .1s;

  & span {
    text-align: start;
    vertical-align: bottom;
    display: inline-block;
  }

  & .FmKaba_romanWord {
    padding-inline-end: .3em;
    font-size: .5em;
    line-height: 1em;
    display: flex;
  }

  & .FmKaba_rubyWord {
    justify-content: center;
    min-height: 1em;
    font-size: .5em;
    line-height: 1em;
    display: flex;
  }

  & .FmKaba_wordWithRuby {
    vertical-align: bottom;
    flex-direction: column;
    align-items: center;
    display: inline-flex;
  }

  & .FmKaba_wordBody {
    flex-direction: column;
    display: flex;
  }

  & .FmKaba_rubyBaseWord {
    white-space: nowrap;
    flex-wrap: nowrap;
    justify-content: center;
    display: inline-flex;
  }

  & > span, & span.FmKaba_emphasizeWrapper {
    white-space: pre-wrap;
    vertical-align: bottom;
    contain: layout style;
    margin: -1em;
    padding: 1em;
    display: inline-block;

    & > span {
      margin: -1em;
      padding: 1em;
    }

    &.FmKaba_emphasize, & span.FmKaba_emphasize {
      backface-visibility: hidden;

      & > span {
        backface-visibility: hidden;
        margin: -1em;
        padding: 1em;
      }
    }
  }
}

.FmKaba_lyricBgLine {
  opacity: .4;
  font-size: max(calc(1em * var(--amll-lp-bg-line-scale, .7)), 10px);
  transition: background-color .25s,
		box-shadow .25s,
		--bright-mask-alpha var(--mask-alpha-duration) ease-out,
		--dark-mask-alpha var(--mask-alpha-duration) ease-out;

  & .FmKaba_lyricMainLine {
    padding: 1.2em 1em;
  }

  &.FmKaba_active {
    opacity: .4;
    transition: background-color .25s,
			box-shadow .25s,
			--bright-mask-alpha var(--mask-alpha-duration) ease-out,
			--dark-mask-alpha var(--mask-alpha-duration) ease-out;
  }
}

.FmKaba_lyricSubLine {
  opacity: .3;
  font-size: max(.5em, 10px);
  line-height: 1.5em;
  transition: opacity .2s .25s;

  @supports (mix-blend-mode: plus-lighter) {
    opacity: .3;
  }
}

.FmKaba_bottomLine {
  font-size: var(--amll-lp-bottom-line-font-size, max(.7em, 10px));
  cursor: default;
  opacity: .2;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 1.8em;
  transition: opacity .4s;

  &.FmKaba_gradientMask {
    opacity: .85;
  }

  &:empty {
    height: 0;
    margin: 0;
    padding: 0;
    display: none;
  }
}

.FmKaba_bgWrapper {
  top: 100%;
  left: var(--lyric-line-padding-x);
  z-index: -1;
  align-items: inherit;
  width: calc(100% - var(--lyric-line-padding-x) * 2);
  visibility: visible;
  pointer-events: auto;
  opacity: 0;
  transform-origin: 0 0;
  flex-direction: column;
  transition: opacity .3s;
  display: flex;
  position: absolute;
}

.FmKaba_bgWrapperTop {
  transform-origin: 0 100%;
  width: 100%;
  position: relative;
  top: auto;
  bottom: auto;
  left: 0;
}

.FmKaba_bgWrapperActive {
  opacity: 1;
  width: 100%;
  position: relative;
  top: auto;
  bottom: auto;
  left: 0;
}

.FmKaba_bgWrapperHidden {
  visibility: hidden;
  pointer-events: none;
}

.FmKaba_interludeDots {
  width: fit-content;
  height: clamp(.5em, 1vh, 3em);
  padding: .4em var(--lyric-line-padding-x);
  transform-origin: center;
  align-items: center;
  gap: .18em;
  display: flex;
  position: absolute;
  left: 0;

  & > * {
    background-color: var(--amll-lp-color, white);
    aspect-ratio: 1;
    border-radius: 50%;
    width: .3em;
    height: .3em;
    display: inline-block;
  }
}

.FmKaba_disableSpring > *, .FmKaba_disableSpring .FmKaba_lyricLine {
  transition: filter .25s, transform .5s, background-color .25s, box-shadow .25s;
}

.FmKaba_tmpDisableTransition {
  transition: none !important;
}

.amll-lyric-player {
  --lyric-line-padding-x: 1em;
  touch-action: pan-x;

  @media screen and (width <= 500px) {
    --lyric-line-padding-x: 20px;
  }

  &:hover .FmKaba_lyricLine, &:hover .FmKaba_lyricLineWrapper {
    filter: unset !important;
  }

  &:not(.FmKaba_playing) .FmKaba_bgWrapper {
    opacity: 1;
    width: 100%;
    position: relative;
    top: auto;
    bottom: auto;
    left: 0;
  }

  &.FmKaba_hasDuetLine {
    & .FmKaba_lyricLine:not(.FmKaba_lyricDuetLine) {
      padding-right: 15%;
    }

    & .FmKaba_lyricDuetLine {
      padding-left: 15%;
    }

    & .FmKaba_isDuetWrapper {
      align-items: flex-end;

      & .FmKaba_bgWrapper {
        transform-origin: 100% 0;
      }

      & .FmKaba_bgWrapperTop {
        transform-origin: 100% 100%;
      }
    }
  }
}
`;

  // Host + fallback rules layered on top of the engine stylesheet. The engine's
  // own CSS has NO text-shadow glow; the only "bloom" is the intended Apple
  // Music karaoke bright layer (mix-blend-mode: plus-lighter), which we keep.
  const AMLL_HOST_CSS = `
/* Register the mask alpha custom properties so the engine's transition on them
   actually runs. The engine declares
     transition: --bright-mask-alpha var(--mask-alpha-duration) ease-out, ...
   but an UNREGISTERED custom property cannot be animated, so the change is
   instant. That is the "snap": when a line becomes active its alphas jump from
   the dim base (.2) to bright/dim (1 / .4) in one frame instead of cross-fading
   over the 0.3s the engine asks for. Registering them with @property makes the
   transition real, so a line fades up as it takes over.
   initial-value matches the engine's own base so nothing changes before the
   engine sets anything. */
@property --bright-mask-alpha {
  syntax: "<number>";
  inherits: true;
  initial-value: 0.2;
}
@property --dark-mask-alpha {
  syntax: "<number>";
  inherits: true;
  initial-value: 0.2;
}
#ym-sl-amll-host {
  position: absolute;
  inset: 0;
  z-index: 4;
  /* Query container for the engine's font size (6.7cqw in the player rule):
     this host is the lyric surface, so its width IS the column the text has to
     fit. inset:0 already fixes its size, so the containment costs nothing. */
  container-type: inline-size;
  overflow: hidden;
  pointer-events: auto;
  /* The SAME face the built-in renderer uses, including a user-supplied custom
     font (--ym-sl-lyric-font). Hardcoding "SpicyLyrics" here meant a custom font
     applied everywhere except Apple-style lyrics (AJ, 2026-10-23). */
  font-family: var(--ym-sl-lyric-font, "SpicyLyrics"), "Noto Sans Georgian", "Vazirmatn", "Roboto", system-ui, sans-serif;
  /* 700 = LyricsBold.woff2 — the same weight the built-in renderer uses for
     lyric lines, so Simple lyrics doesn't look lighter than the other modes. */
  font-weight: 700;
  /* The bundled face stops at 700 (LyricsBold), which is as heavy as the real
     font goes. To get a chunkier karaoke look without a faux-bold fudge, stroke
     the glyphs by a fraction of a pixel. -webkit-text-stroke is inherited, so
     every word element gets it, and the engine's mask clips the stroke exactly
     like the fill. */
  -webkit-text-stroke: var(--amll-bold-stroke, 0.6px) currentColor;
  color: var(--amll-lp-color, #fff);
  line-height: 1.2;
  /* Written every frame by the engine on the CalcMaskAnimator path. Seed it so
     the clamp() in each word's mask-position always evaluates - an unset var
     would make the whole declaration invalid and the word would render at full
     brightness before the first frame. */
  --amll-player-time: 0;
}
#ym-sl-amll-host .amll-lyric-player { pointer-events: auto; height: 100%; }
/* Make the lyrics area the positioning context so the host fills it. */
.LyricsContainer { position: relative; }
/* When AMLL owns the panel, hide Aurora's own (glow-free) Simple lines. */
body.amll-active #ym-sl-panel.SpicyRenderer .VirtualLyricsContainer { display: none !important; }
#ym-sl-amll-host { visibility: hidden; pointer-events: none; }
body.amll-active #ym-sl-amll-host { visibility: visible; pointer-events: auto; }
/* The engine draws every line twice: the real one, plus a blurred backdrop copy
   that scrolls between the lines. That copy sets visibility:visible on itself,
   and a visible descendant still paints inside a visibility:hidden ancestor -
   so once a word-by-word track handed the panel back to the built-in renderer,
   the engine's leftover backdrop lines kept drawing as ghosts behind the real
   ones (AJ, 2026-10-26). Hide them whenever the engine is not the active
   renderer; the host's own visibility still governs everything while it is. */
body:not(.amll-active) #ym-sl-amll-host :is(.FmKaba_bgWrapper, .FmKaba_lyricBgLine) {
  visibility: hidden !important;
}
/* Credits footer (Written By / Lyrics provided by / Uploaded by / Made by) goes
   into the engine's own bottom-line slot, so it scrolls with the lyrics as the
   last block - the same behaviour as the built-in renderer. The engine watches
   that element with a MutationObserver and re-lays-out when its content
   changes. The slot is laid out as a distant lyric line, so it would otherwise
   inherit the deepest blur, the dimmest mask alphas and the line's own negative
   margins. */
#ym-sl-amll-host .FmKaba_bottomLine,
#ym-sl-amll-host .FmKaba_bottomLineWrapper {
  filter: none !important;
  opacity: 1 !important;
}
/* In a duet song the engine reserves 15% on the opposite side of every line that
   is NOT a duet line, so the two voices never collide. The bottom line is not a
   lyric line - it carries the credits - but it matched that selector too, so the
   footer stopped 15% short of the right-aligned last line above it. Give it the
   same right padding a duet line has, and the credits line up with the words. */
#ym-sl-amll-host .FmKaba_hasDuetLine .FmKaba_bottomLine {
  /* The normal line's .2em, but the bottom line sets its own font size to .7em,
     so divide by that to land on the same pixel value the duet line uses. */
  padding-right: calc(.2em / .7) !important;
}
/* The host stamps its karaoke face onto EVERYTHING inside it: 700 weight plus a
   0.6px text stroke, in a 1.2 line box. That is right for the lyrics and wrong
   for the footer - the built-in renderer draws this same shared markup as a
   plain footnote at 400/600, so here it read bold and airy (AJ, 2026-10-23).
   Opt the credits out and give them that footnote's pitch. :is() covers both
   mountings: the engine's bottom-line slot when it has one, the host when it
   does not. */
#ym-sl-amll-host :is(.FmKaba_bottomLine .ym-sl-credits, .ym-sl-credits) {
  --bright-mask-alpha: 1;
  --dark-mask-alpha: 1;
  filter: none !important;
  -webkit-text-stroke: 0 !important;
  text-shadow: none !important;
  font-weight: 400 !important;
  line-height: 1.35 !important;
  letter-spacing: 0 !important;
  opacity: .85 !important;
  margin: 24px 0 10px !important;
  padding: 10px 0 0 !important;
}
/* A song that ends on a duet line leaves the reader on the right-hand side, so
   the credits follow the last line there. Same rule as the built-in renderer. */
#ym-sl-amll-host .ym-sl-credits.align-right {
  text-align: right !important;
}
#ym-sl-amll-host .ym-sl-credits.align-right :is(.ym-sl-provider, .ym-sl-uploader) {
  justify-content: flex-end !important;
}
#ym-sl-amll-host :is(.FmKaba_bottomLine .ym-sl-credits, .ym-sl-credits) > * {
  -webkit-text-stroke: 0 !important;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}
/* The label/name/provider weights are the footer's own; only the gaps differ
   here, so the three lines read as one block instead of drifting apart in the
   engine's taller line box. */
#ym-sl-amll-host :is(.FmKaba_bottomLine .ym-sl-credits, .ym-sl-credits) .ym-sl-credits-label {
  margin-bottom: 4px !important;
  line-height: 1.2 !important;
}
#ym-sl-amll-host :is(.FmKaba_bottomLine .ym-sl-credits, .ym-sl-credits) .ym-sl-credits-names {
  line-height: 1.4 !important;
}
#ym-sl-amll-host :is(.FmKaba_bottomLine .ym-sl-credits, .ym-sl-credits) :is(.ym-sl-provider, .ym-sl-provider-block, .ym-sl-uploader) {
  margin-top: 10px !important;
}
/* Inside the pill+note block the block owns the gap (flex gap 7px). */
#ym-sl-amll-host :is(.FmKaba_bottomLine .ym-sl-credits, .ym-sl-credits) .ym-sl-provider-block .ym-sl-provider {
  margin-top: 0 !important;
}
#ym-sl-amll-host :is(.FmKaba_bottomLine .ym-sl-credits, .ym-sl-credits) :is(.ym-sl-provider + .ym-sl-uploader, .ym-sl-uploader + .ym-sl-uploader) {
  margin-top: 4px !important;
}
#ym-sl-amll-host .FmKaba_bottomLine .FmKaba_lyricMainLine,
#ym-sl-amll-host .FmKaba_bottomLine .FmKaba_lyricSubLine {
  margin: 0 !important;
  padding: 0 !important;
}
/* Loading skeleton. The engine keeps the previous track's lines on screen until
   the new ones arrive, so a track change would otherwise show the wrong song.
   Hiding the player outright is the only thing that actually removes them - a
   translucent scrim still lets the old words read through. The bars sit on the
   engine's focal line at the same pitch as the built-in skeleton, so the panel
   does not jump when the real lines land. */
#ym-sl-amll-host.ym-sl-amll-loading .amll-lyric-player { visibility: hidden; }
#ym-sl-amll-host .ym-sl-amll-skeleton {
  position: absolute;
  left: 0;
  right: 0;
  top: var(--amll-align-y, 42%);
  transform: translateY(-50%);
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: calc(var(--DefaultLyricsSize, 32px) * .95);
  padding: 0 6%;
  pointer-events: none;
}
#ym-sl-amll-host .ym-sl-amll-skeleton-bar {
  position: relative;
  flex: 0 0 auto;
  height: calc(var(--DefaultLyricsSize, 32px) * .6);
  border-radius: 6px;
  background: rgba(255,255,255,.075);
  overflow: hidden;
}
#ym-sl-amll-host .ym-sl-amll-skeleton-bar::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.10), transparent);
  animation: ym-sl-amll-skeleton-sweep 1.15s ease-in-out infinite;
}
@keyframes ym-sl-amll-skeleton-sweep {
  from { transform: translateX(-100%); }
  to   { transform: translateX(100%); }
}
@media (prefers-reduced-motion: reduce) {
  #ym-sl-amll-host .ym-sl-amll-skeleton-bar::after { display: none; }
}
/* Middle-click autoscroll marker. It sits in the middle of the lyrics panel
   rather than under the cursor, so the pointer is free to pull in any direction
   without the marker trailing it. Centred with the translate property (not
   transform) so
   the scale-in animation can own transform. A chevron brightens for the
   direction the pointer is pulling. */
#ym-sl-amll-host .ym-sl-amll-autoscroll {
  position: absolute;
  z-index: 9;
  left: 50%;
  top: 50%;
  translate: -50% -50%;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: rgba(18, 18, 20, .7);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.32), 0 2px 10px rgba(0,0,0,.4);
  backdrop-filter: blur(6px);
  pointer-events: none;
  animation: ym-sl-amll-auto-in .13s ease-out;
}
#ym-sl-amll-host .ym-sl-amll-autoscroll::before,
#ym-sl-amll-host .ym-sl-amll-autoscroll::after {
  content: "";
  position: absolute;
  left: 50%;
  width: 6px;
  height: 6px;
  border-top: 1.5px solid currentColor;
  border-left: 1.5px solid currentColor;
  color: rgba(255,255,255,.42);
  transition: color .12s ease;
}
#ym-sl-amll-host .ym-sl-amll-autoscroll::before {
  top: 8px;
  transform: translateX(-50%) rotate(45deg);
}
#ym-sl-amll-host .ym-sl-amll-autoscroll::after {
  bottom: 8px;
  transform: translateX(-50%) rotate(225deg);
}
#ym-sl-amll-host .ym-sl-amll-autoscroll[data-dir="up"]::before,
#ym-sl-amll-host .ym-sl-amll-autoscroll[data-dir="down"]::after {
  color: #fff;
}
@keyframes ym-sl-amll-auto-in {
  from { opacity: 0; transform: scale(.8); }
  to   { opacity: 1; transform: scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  #ym-sl-amll-host .ym-sl-amll-autoscroll { animation: none; }
}
/* Fullscreen: the lyrics pane keeps clamp() vertical padding for the built-in
   renderer's header and safe bands. AMLL has no header there, so drop it and let
   the engine's viewport reach the monitor's top and bottom edges. Deliberately
   no mask: the lines stay visible all the way to the edge instead of fading. */
body.amll-active .ym-sl-fs-overlay .ym-sl-fs-lyrics {
  padding-top: 0;
  padding-bottom: 0;
}
/* Loading skeleton in the docked NPV rail: its bars and pitch are em-of-32px
   tuned for the tab and read as slabs in the small card. */
#ym-npv .ym-npv-lyrics .ym-sl-amll-skeleton {
  gap: 14px;
  padding: 0 4%;
}
#ym-npv .ym-npv-lyrics .ym-sl-amll-skeleton-bar {
  height: 12px;
  border-radius: 4px;
}
`;

  function amllInjectCss() {
    if (amllCssInjected) return;
    const style = document.createElement("style");
    style.id = "ym-sl-amll-css";
    style.textContent = AMLL_ENGINE_CSS + "\n" + AMLL_HOST_CSS;
    (document.head || document.documentElement).appendChild(style);
    amllCssInjected = true;
  }

  function amllLyricsContainer() {
    if (!panelEl) return null;
    return panelEl.querySelector(".LyricsContainer") || panelEl;
  }

  function amllShow() {
    if (!amllPlayer || !amllHost) return;
    const c = amllLyricsContainer();
    if (c && amllHost.parentNode !== c) c.appendChild(amllHost);
    document.body.classList.add("amll-active");
  }

  function amllHide() {
    document.body.classList.remove("amll-active");
    amllStopAutoScroll();
  }

  /* ---- middle-click autoscroll --------------------------------------------
     Chrome's autoscroll drives a NATIVE scroll container. The built-in
     renderer's pane is one (a real overflow box), which is why a middle click
     there and a mouse move scroll the lyrics; this engine has no scroll box at
     all — it moves its lines with transforms and listens for wheel. So the
     gesture had nothing to drive here. Reproduce it: hold the middle button
     down and move the pointer, and every frame feeds the engine the wheel
     events a real wheel would, at a speed set by how far the pointer sits from
     the press point. Releasing the middle button ends it at once (press-and-
     hold, not Chrome's toggle — AJ asked for the release to stop it), as does
     any other press, a real wheel, Escape or losing the window. Links keep
     their own middle-click (open in a new tab). */
  let amllAuto = null;

  function amllStopAutoScroll() {
    if (!amllAuto) return;
    const auto = amllAuto;
    amllAuto = null;
    if (auto.raf) cancelAnimationFrame(auto.raf);
    window.removeEventListener("mousemove", auto.move, true);
    window.removeEventListener("mousedown", auto.press, true);
    window.removeEventListener("mouseup", auto.up, true);
    window.removeEventListener("wheel", auto.wheel, true);
    window.removeEventListener("keydown", auto.key, true);
    window.removeEventListener("blur", auto.blur);
    if (auto.indicator && auto.indicator.parentNode) {
      auto.indicator.parentNode.removeChild(auto.indicator);
    }
  }

  function amllStartAutoScroll(event) {
    if (event.button !== 1 || !amllPlayer || !amllHost) return;
    if (!document.body.classList.contains("amll-active")) return;
    if (event.target && event.target.closest && event.target.closest("a")) {
      amllStopAutoScroll();
      return;
    }
    // Already running (a middle press whose release was never delivered): stop
    // rather than stack a second loop. The press is suppressed so Chrome does
    // not start its own page autoscroll on the way out.
    if (amllAuto) {
      event.preventDefault();
      amllStopAutoScroll();
      return;
    }
    const playerEl = amllPlayer.getElement();
    if (!playerEl) return;
    // Chrome would start its own autoscroll on the page here. The lyrics are not
    // a native scroller, so the gesture is ours.
    event.preventDefault();

    const anchorY = event.clientY;
    const indicator = document.createElement("div");
    indicator.className = "ym-sl-amll-autoscroll";
    indicator.setAttribute("aria-hidden", "true");
    amllHost.appendChild(indicator);

    let mouseY = anchorY;
    // Sub-pixel remainder: a wheel event can only carry whole pixels, so the
    // fraction is kept for the next frame instead of being thrown away.
    let carry = 0;
    let lastFrame = performance.now();
    let shownDir = "";

    const move = (e) => {
      // The button state is the authority: if the release happened outside the
      // window (where no mouseup reaches us), the next move with the middle
      // button no longer held ends the gesture instead of scrolling forever.
      if (typeof e.buttons === "number" && (e.buttons & 4) === 0) {
        amllStopAutoScroll();
        return;
      }
      mouseY = e.clientY;
    };
    // The arming press is already propagating when these land on window, so it
    // has to be excluded by identity or the mode would end on itself. A middle
    // press inside the lyrics is handled above (stop/arm); every other press,
    // including middle presses elsewhere, ends the mode.
    const press = (e) => {
      if (e === event) return;
      if (e.button === 1 && amllHost.contains(e.target)) return;
      amllStopAutoScroll();
    };
    // Press-and-hold: the middle button coming up is the end of the gesture.
    const up = (e) => { if (e.button === 1) amllStopAutoScroll(); };
    // Our own wheel events bubble to window too; they must not count as the
    // user scrolling.
    const wheel = (e) => { if (!e.__auroraAutoScroll) amllStopAutoScroll(); };
    const key = (e) => { if (e.key === "Escape") amllStopAutoScroll(); };
    const blur = () => amllStopAutoScroll();

    const tick = (now) => {
      if (!amllAuto) return;
      // The panel can be torn down under the gesture (track change, mode
      // switch); stop rather than scroll a detached element.
      if (!playerEl.isConnected) { amllStopAutoScroll(); return; }
      // Per-second speed, not per-frame: a 144Hz screen must not scroll more
      // than twice as fast as a 60Hz one. The delta is clamped so a stalled tab
      // cannot resume with one huge jump.
      const dt = Math.min(50, Math.max(0, (now || lastFrame) - lastFrame));
      lastFrame = now || lastFrame;
      const dy = mouseY - anchorY;
      // A dead zone, like Chrome's: the first few pixels arm nothing, so a
      // click that did not move does not creep.
      const power = Math.abs(dy) - 8;
      if (power > 0) {
        const sign = dy > 0 ? 1 : -1;
        // Speed tracks the pull, and keeps tracking it well past the panel:
        // a 50px pull is a slow creep, 150px is a brisk run, ~270px is the
        // 4400px/s cap. Linear like Chrome's, so the change is felt at every
        // distance instead of flattening out early.
        carry += sign * Math.min(4400, 150 + power * 16) * dt / 1000;
        const whole = Math.trunc(carry);
        if (whole) {
          carry -= whole;
          const synthetic = new WheelEvent("wheel", {
            deltaY: whole,
            deltaMode: 0,
            bubbles: true,
            cancelable: true,
          });
          synthetic.__auroraAutoScroll = true;
          playerEl.dispatchEvent(synthetic);
        }
        const dir = sign > 0 ? "down" : "up";
        if (dir !== shownDir) { indicator.dataset.dir = dir; shownDir = dir; }
      } else if (shownDir) {
        delete indicator.dataset.dir;
        shownDir = "";
      }
      if (amllAuto) amllAuto.raf = requestAnimationFrame(tick);
    };

    window.addEventListener("mousemove", move, true);
    window.addEventListener("mousedown", press, true);
    window.addEventListener("mouseup", up, true);
    window.addEventListener("wheel", wheel, true);
    window.addEventListener("keydown", key, true);
    window.addEventListener("blur", blur);
    amllAuto = { raf: 0, indicator, move, press, up, wheel, key, blur };
    amllAuto.raf = requestAnimationFrame(tick);
  }

  function amllEnsureEngine() {
    if (amllEnginePromise) return amllEnginePromise;
    amllEnginePromise = (async () => {
      // NOTE: never write `typeof import` here — `import` is an always-reserved
      // keyword, so the parser treats it as the start of an import declaration /
      // dynamic-import call and throws "Cannot use import statement outside a
      // module", killing the WHOLE classic-script bundle (panel included).
      //
      // Use AMLL_CORE_URL (resolved from document.currentScript.src), NOT
      // chrome.runtime.getURL: this bundle runs in the page's MAIN world where
      // chrome.runtime is undefined, so getURL() throws "extension URL
      // unavailable" and the engine silently falls back to the built-in
      // renderer — which looks like "same as before, just without the glow".
      if (!AMLL_CORE_URL) throw new Error("AMLL: module URL unavailable");
      const mod = await import(/* @vite-ignore */ AMLL_CORE_URL);
      if (!mod || typeof mod.LyricPlayer !== "function") {
        throw new Error("AMLL: LyricPlayer export missing");
      }
      return mod;
    })();
    return amllEnginePromise;
  }

  async function amllActivate() {
    if (amllActive) { amllShow(); return; }
    amllActive = true;
    if (amllFailed) { amllActive = false; return; }
    const myGen = ++amllGen;
    try {
      amllInjectCss();
      const mod = await amllEnsureEngine();
      if (myGen !== amllGen) return;          // toggled off during import
      // The panel may not be mounted yet on the very first settings apply; wait
      // briefly (bounded) for the lyrics container to appear.
      let container = amllLyricsContainer();
      let tries = 0;
      while (!container && tries < 25) {
        await new Promise((r) => setTimeout(r, 200));
        if (myGen !== amllGen) return;
        container = amllLyricsContainer();
        tries++;
      }
      if (!container) { amllActive = false; return; }
      if (myGen !== amllGen) return;          // toggled off while waiting

      amllHost = document.createElement("div");
      amllHost.id = "ym-sl-amll-host";
      // Keep the skeleton on the same focal line as the real lines.
      amllHost.style.setProperty("--amll-align-y", (AMLL_ALIGN_POSITION * 100) + "%");
      // Middle-click autoscroll: the gesture Chrome gives a native scroller.
      amllHost.addEventListener("mousedown", amllStartAutoScroll);
      container.appendChild(amllHost);

      const player = new mod.LyricPlayer();
      // Force the engine's CalcMaskAnimator path (a CSS clamp() that reads
      // --amll-player-time, which update() rewrites EVERY frame) instead of
      // WebMaskAnimator (per-word Web Animations keyframes).
      //
      // The WAAPI path only re-plays a line's animation at the moment that line
      // becomes active, and it decides whether to play from the engine's own
      // isPlaying flag. When that flag is ever stale the animation stays paused
      // at a fixed mask-position and the word never fills - the mask sits far
      // enough left that the whole word renders at the 0.4 "dim" alpha, which
      // looks exactly like "no left-to-right fill" even though the mask is
      // correct. The calc path has no such dependency: mask-position is
      // recomputed from the current time on every frame, so the sweep tracks
      // playback no matter what the play-state plumbing does.
      player.supportMaskImage = false;
      player.setEnableSpring(true);
      player.setWordFadeWidth(0.5);          // Apple Music for iPad karaoke width
      // Focal line sits a little further down than AMLL's own 0.35 default, so
      // the active line reads lower in the panel.
      player.setAlignPosition(AMLL_ALIGN_POSITION);
      // Halve the render buffer. The engine defaults to 300px of overscan, which
      // on a ~950px panel means it builds roughly twice the viewport's worth of
      // lines - and every one of those words re-resolves its CSS mask every
      // frame, because the calc mask path reads --amll-player-time. Word-by-word
      // lyrics carry ~5 words per line, so that is 5x the per-frame style work
      // of line-by-line, which is exactly the fps gap being seen. Overscan is
      // only a buffer: lines inside the viewport are unaffected, so the look
      // does not change.
      player.setOverscanPx(150);
      // The host is inset:0 of .LyricsContainer, so the player element fills it.
      // The credits footer goes in the engine's own bottom-line slot, so this
      // stays a plain full-height fill.
      player.getElement().style.height = "100%";
      amllHost.appendChild(player.getElement());
      // amllPlayer must be assigned BEFORE the size seed: amllSeedEngineSize()
      // bails on a missing player, so seeding first was a silent no-op.
      amllPlayer = player;
      amllGuardEngineSize();
      amllSeedEngineSize();

      amllReady = true;
      // Take over driving the engine from Aurora's render loop, which gates on
      // panelVisible/modelLines and stops feeding us when that gate closes.
      amllStartOwnLoop();
      // Show BEFORE handing it lyrics: the engine measures every word with
      // clientWidth when setLyricLines() runs, and a display:none host (or one
      // still hidden) measures 0 for all of them. A zero width degenerates the
      // karaoke mask gradient, so the text renders fully lit with no
      // left-to-right sweep — the "no fill" bug.
      amllShow();
      amllHideSkeleton();
      player.resume();
      amllAttachSeekHandler();

      if (amllLastContent) amllSyncLyrics(amllLastContent);
    } catch (e) {
      console.warn("[AuroraLyrics] AMLL engine failed to load; using built-in Simple renderer.", e);
      amllFailed = true;
      // Leave the built-in renderer visible: amllActive drives the body class
      // that HIDES .VirtualLyricsContainer, so it must be cleared on failure or
      // the fallback would render into a hidden node.
      amllActive = false;
      amllReady = false;
      amllHide();
      if (amllHost && amllHost.parentNode) amllHost.parentNode.removeChild(amllHost);
      amllHost = null;
      amllPlayer = null;
    }
  }

  // Full teardown of the engine (host, player, drive loop, latches). Nothing in
  // the settings path calls it any more — the renderer is chosen per track and
  // a loaded engine is reused across tracks — so it stays as the subsystem's
  // dispose primitive rather than being lost.
  function amllDeactivate() {
    // Always clear the failure latch and the cached import promise, so a later
    // activation retries. This must happen BEFORE the early return below:
    // after a failed activation amllActive/amllReady are both false, and the
    // early return would otherwise leave the latch stuck for the whole session.
    amllFailed = false;
    amllEnginePromise = null;
    amllDriveErrors = 0;
    // With the engine gone the built-in renderer owns whatever is loaded, so the
    // look has to follow it on the next activation's first sync.
    amllSpicyTrack = false;
    if (!amllActive && !amllReady) return;
    amllGen++;                               // invalidate any in-flight activation
    amllActive = false;
    amllHide();
    // The engine owned the pill's state; without it there is nothing to jump
    // back to, and leaving it up would fake a suspended scroll.
    setJumpButtonVisible(false);
    try { if (amllPlayer) amllPlayer.dispose(); } catch (e) {}
    amllPlayer = null;
    amllReady = false;
    amllWasPlaying = false;
    amllPrevTime = 0;
    amllStopOwnLoop();
    if (amllTimeHosts && amllTimeHosts.length) {
      for (const el of amllTimeHosts) {
        amllReleaseTimeHold(el);
        try { el.style.removeProperty("--amll-player-time"); } catch (e) {}
      }
      amllTimeHosts = [];
    }
    for (const el of amllTimeHoldTimers.keys()) {
      amllReleaseTimeHold(el);
      try { el.style.removeProperty("--amll-player-time"); } catch (e) {}
    }
    if (amllSizeObserver) { try { amllSizeObserver.disconnect(); } catch (e) {} amllSizeObserver = null; }
    amllSizeSeeded = false;
    if (amllHost && amllHost.parentNode) amllHost.parentNode.removeChild(amllHost);
    amllHost = null;
    amllHideSkeleton();
    if (amllCreditsEl) { try { amllCreditsEl.remove(); } catch (e) {} amllCreditsEl = null; }
  }

  // AMLL treats whitespace as its own word atom. chunkAndSplitLyricWords()
  // groups every run of consecutive non-space atoms into ONE word element, so a
  // words array with no spaces collapses the entire line into a single element
  // whose text is the syllables concatenated ("everywordlookslikethis") — and
  // the karaoke mask then sweeps the line as a whole instead of word by word.
  // Aurora's TTML syllables carry no whitespace (it lives between the <span>s),
  // so rebuild the space atoms here.
  const AMLL_CJK_RE = /[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uac00-\ud7af\uff00-\uffef]/;
  function amllWordAtoms(syllables) {
    const atoms = [];
    const list = Array.isArray(syllables) ? syllables : [];
    // Prefer HasSpaceBefore (measured from the actual markup between the two
    // <span>s). Fall back to IsPartOfWord only when the source never recorded
    // spacing at all (line-synced LRC), where it is the best signal available.
    const spacingKnown = list.some((s) => s && s.HasSpaceBefore === true);
    for (let i = 0; i < list.length; i++) {
      const syl = list[i];
      const text = syl && syl.Text != null ? String(syl.Text) : "";
      if (!text) continue;
      const start = (syl.StartTime || 0) * 1000;
      const end = (syl.EndTime || 0) * 1000;
      atoms.push({ word: text, startTime: start, endTime: end });
      // Decide whether a space belongs AFTER this syllable.
      let spaceAfter;
      if (spacingKnown) {
        // The next syllable tells us: if it had whitespace before it, there is
        // a gap here. "digni"+"fied" has no space before "fied" -> one word.
        const nextSyl = list[i + 1];
        spaceAfter = !!(nextSyl && nextSyl.HasSpaceBefore === true);
      } else {
        // No spacing metadata: a space goes after a word that isn't continued.
        const nextSyl = list[i + 1];
        spaceAfter = !!nextSyl && !nextSyl.IsPartOfWord;
      }
      if (!spaceAfter) continue;
      const nextText = list[i + 1] && list[i + 1].Text != null ? String(list[i + 1].Text) : "";
      if (!nextText) continue;
      if (/\s$/.test(text) || /^\s/.test(nextText)) continue;
      if (AMLL_CJK_RE.test(text) || AMLL_CJK_RE.test(nextText)) continue;
      atoms.push({ word: " ", startTime: end, endTime: end });
    }
    return atoms;
  }

  // Aurora's parsed line model -> AMLL LyricLine[]. Times are in SECONDS in
  // Aurora's model; AMLL wants MILLISECONDS.
  function amllLinesFromContent(content) {
    const out = [];
    if (!Array.isArray(content)) return out;
    for (let index = 0; index < content.length; index++) {
      const line = content[index];
      const lead = line && line.Lead;
      if (!lead) continue;
      const words = amllWordAtoms(lead.Syllables);
      out.push({
        words,
        // The translation plan is keyed by the CONTENT index, not by time, so a
        // lead line and a background line that start together never collide.
        // Both renderers use the same key, which is what makes their output
        // identical (see 23-auto-translate).
        translatedLyric: autoTranslateAmllText(index, -1),
        romanLyric: "",
        __ymTransKey: autoTranslateKey(index, -1),
        startTime: (lead.StartTime || 0) * 1000,
        endTime: (lead.EndTime || 0) * 1000,
        isBG: false,
        isDuet: !!line.OppositeAligned,
      });
      const bgs = line.Background || [];
      bgs.forEach((bg, bgIndex) => {
        const bgWords = amllWordAtoms(bg.Syllables);
        out.push({
          words: bgWords,
          translatedLyric: autoTranslateAmllText(index, bgIndex),
          romanLyric: "",
          __ymTransKey: autoTranslateKey(index, bgIndex),
          startTime: (bg.StartTime || 0) * 1000,
          endTime: (bg.EndTime || 0) * 1000,
          isBG: true,
          isDuet: false,
        });
      });
    }
    return out;
  }

  function amllContentIsTimed(content) {
    if (!Array.isArray(content)) return false;
    for (const line of content) {
      const lead = line && line.Lead;
      if (lead && (lead.EndTime > 0 || (lead.Syllables || []).some((s) => s && s.EndTime > 0))) {
        return true;
      }
    }
    return false;
  }


  // Credits footer. Aurora already builds a full "Written By / Lyrics provided by
  // / Uploaded by / Made by" block for the built-in renderer (buildCreditsFooter
  // in 16-lyric-dom), and it reads the same shared state, so the
  // Apple-Music-style panel can simply reuse it rather than duplicating the
  // markup, the provider links, the warning pill or the avatar-glow theming.
  // It is pinned to the bottom of the host, over the engine's own scroll area.
  let amllCreditsEl = null;
  function amllSyncCredits() {
    if (!amllHost) return;
    const hasCredits =
      (typeof currentSongwriters !== "undefined" && currentSongwriters && currentSongwriters.length) ||
      (typeof currentProvider !== "undefined" && currentProvider) ||
      (typeof currentUploader !== "undefined" && currentUploader) ||
      (typeof currentMaker !== "undefined" && currentMaker);
    if (!hasCredits) {
      if (amllCreditsEl) { try { amllCreditsEl.remove(); } catch (e) {} amllCreditsEl = null; }
      return;
    }
    if (amllCreditsEl) { try { amllCreditsEl.remove(); } catch (e) {} amllCreditsEl = null; }
    try {
      const names = (typeof currentSongwriters !== "undefined" && currentSongwriters) ? currentSongwriters : [];
      amllCreditsEl = buildCreditsFooter(names, contentEndsOnDuet(amllLastContent));
      // The engine's bottom-line slot, not the host: it is laid out as the last
      // item of the scrollable content, so the credits sit under all the lyrics
      // exactly like the built-in renderer. Appending (rather than setting
      // innerHTML) also trips the engine's MutationObserver, which resets the
      // bottom line's position and re-runs layout.
      let slot = null;
      try { slot = amllPlayer.getBottomLineElement(); } catch (e) {}
      (slot || amllHost).appendChild(amllCreditsEl);
    } catch (e) {}
  }

  function amllSyncLyrics(content) {
    amllLastContent = content;
    // The engine was never started for the previous track (it belonged to
    // Spicy), so this track has to start it rather than silently staying on
    // Spicy until the mode is toggled. amllActivate re-syncs from
    // amllLastContent once it is ready.
    if (!amllSpicyTrack && !amllActive && !amllFailed) {
      amllActivate();
      return;
    }
    if (!amllActive || !amllReady || !amllPlayer) return;
    // A track the user pointed at Spicy: hide the engine (the body class is what
    // makes the built-in container visible again) and leave the line model alone
    // - it is already built in full Spicy mode.
    if (amllSpicyTrack) {
      amllHideSkeleton();
      amllHide();
      return;
    }
    try {
      const lines = amllLinesFromContent(content);
      // Untimed / plain lyrics: the engine can't place them on a timeline, so
      // fall back to Aurora's own (glow-free) Simple render for this content.
      if (!lines.length || !amllContentIsTimed(content)) {
        // No timeline for the engine: hand the track to Aurora's own renderer,
        // but take the loading skeleton down first or it would sit on top of
        // the static lines (and hide the empty state on the next failure).
        amllHideSkeleton();
        amllHide();
        return;
      }
      amllPlayer.setLyricLines(lines, amllLastPositionMs || 0);
      // Cached translations were already in the line objects; this fills the
      // sub-line of any line the engine built before the translation landed.
      autoTranslateRefreshAmll();
      amllShow();
      amllHideSkeleton();
      amllSyncCredits();
    } catch (e) {
      console.warn("[AuroraLyrics] AMLL setLyricLines failed; falling back.", e);
      amllFailed = true;
      amllHideSkeleton();
      amllHide();
    }
  }

  // The engine derives its virtual viewport from a ResizeObserver it attaches to
  // its own element inside the constructor - i.e. while that element is still
  // detached - so the first callback reports 0x0 and, as observed live, nothing
  // ever corrects it. A zero viewport is worse than it sounds:
  //   defaultLineHeight = size[1] / 5        -> 0
  //   isInRenderRange() bails on viewportHeight <= 0
  //   => commitChanges() returns early for EVERY line
  //   => no transform, no scale, no opacity is ever written
  // The panel still draws and the karaoke fill still sweeps (both are written
  // from show()/update(), not commitChanges), which is exactly why it looks
  // "rendered but lifeless". Seed the size from the host we actually control and
  // keep it in sync ourselves instead of trusting that observer.
  let amllSizeObserver = null;
  let amllSizeSeeded = false;
  let amllMeasured = [0, 0];
  // The host is inset:0 inside .LyricsContainer, so the container's box IS the
  // host's box. Walking up also covers the moment of activation, when the panel
  // has not been laid out yet and the host itself still measures 0x0.
  function amllMeasureHost() {
    let el = amllHost;
    while (el && el !== document.body) {
      const r = el.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) { amllMeasured = [r.width, r.height]; return r; }
      el = el.parentElement;
    }
    return null;
  }
  // Wrap player.size so a write of 0 is ignored. The engine's own ResizeObserver
  // reports 0x0 the first time (it observes its still-detached root element), and
  // once the viewport is zero the engine never recovers on its own. With this
  // guard a real viewport, once known, can never be lost again.
  //
  // The SAME observer also measures every line, and that report is just as
  // destructive: switching away from the Lyrics tab (Comments, Related) makes
  // the panel display:none, so every measured line height is written back as 0.
  // The layout is then recalculated from zero-height lines, isInRenderRange()
  // fails for all of them, and commitChanges() removes their elements. Removal
  // is the part that makes it permanent: a removed line is unobserved (hide()
  // calls unobserve), so it can never be measured again and never comes back —
  // the panel returns with a collapsed, half-empty list and no active line.
  // Verified live against the bundled engine: with only the size guard in
  // place, 44 of 50 lines are in range before the tab switch and 6 after; with
  // this second guard, 45 before and 46 after. Lines always carry text, so a
  // non-positive height is never a real measurement.
  function amllGuardEngineSize() {
    try {
      const guarded = [0, 0];
      let w = 0;
      let h = 0;
      Object.defineProperty(guarded, "0", {
        get() { return w; },
        set(v) { if (v > 0) w = v; },
        enumerable: true,
        configurable: true,
      });
      Object.defineProperty(guarded, "1", {
        get() { return h; },
        set(v) { if (v > 0) h = v; },
        enumerable: true,
        configurable: true,
      });
      amllPlayer.size = guarded;
      const calc = amllPlayer.layoutCalculator;
      if (calc && typeof calc.setLineHeight === "function" && !calc.setLineHeight.__amllGuarded) {
        const setLineHeight = calc.setLineHeight.bind(calc);
        const guardedSetLineHeight = (index, height) => {
          if (height > 0) setLineHeight(index, height);
        };
        // initHeights() writes the per-song defaults straight into the heights
        // array and clears the measured flags, so resetting a new track does not
        // depend on this setter and is unaffected by the guard.
        guardedSetLineHeight.__amllGuarded = true;
        calc.setLineHeight = guardedSetLineHeight;
      }
    } catch (e) {}
  }
  function amllSeedEngineSize() {
    if (!amllPlayer || !amllHost) return false;
    const rect = amllMeasureHost();
    if (rect) {
      amllPlayer.size[0] = rect.width;
      amllPlayer.size[1] = rect.height;
      amllSizeSeeded = true;
    }
    if (amllSizeObserver) { try { amllSizeObserver.disconnect(); } catch (e) {} }
    amllSizeObserver = new ResizeObserver((entries) => {
      if (!amllPlayer) return;
      const last = entries[entries.length - 1];
      if (!last) return;
      const w = last.contentRect.width;
      const h = last.contentRect.height;
      if (w <= 0 || h <= 0) return;
      if (amllPlayer.size[0] === w && amllPlayer.size[1] === h) return;
      amllPlayer.size[0] = w;
      amllPlayer.size[1] = h;
      amllSizeSeeded = true;
      // Lines that were never measured still carry the old default height, and
      // the engine's own layout pass has to run again with the real viewport.
      try { amllPlayer.layoutCalculator.updateUnmeasuredHeights(amllPlayer.defaultLineHeight); } catch (e) {}
      try { if (typeof amllPlayer.calcLayout === "function") amllPlayer.calcLayout("resize"); } catch (e) {}
    });
    try { amllSizeObserver.observe(amllHost); } catch (e) {}
    return amllSizeSeeded;
  }

  // The engine must be driven every frame, but Aurora's own loop gates on
  // panelVisible/modelLines before it ever reaches amllDrive() - and when that
  // gate closes the engine stops being fed entirely. That froze the karaoke fill
  // (--amll-player-time stuck at 0) and parked every word animation, because
  // setCurrentTime() is what makes the engine highlight a new line and run
  // enable() on it. Live measurement: drives === 3 over a whole track.
  // Run our own loop so the engine is fed regardless of Aurora's render state.
  let amllRaf = 0;
  function amllStartOwnLoop() {
    if (amllRaf) return;
    const step = () => {
      amllRaf = requestAnimationFrame(step);
      try {
        if (!amllActive || !amllReady || !amllPlayer) return;
        if (!window.YTMod || !window.YTMod.player) return;
        const pos = window.YTMod.player.getPositionMs();
        if (Number.isFinite(pos)) amllDrive(pos);
      } catch (e) {}
    };
    amllRaf = requestAnimationFrame(step);
  }
  function amllStopOwnLoop() {
    if (amllRaf) cancelAnimationFrame(amllRaf);
    amllRaf = 0;
  }

  // Tap a lyric line to jump the player there. The engine renders its own DOM, so
  // Aurora's existing line-click handling never sees these nodes - wire the host
  // directly and map the clicked element back to the group that owns it.
  function amllAttachSeekHandler() {
    if (!amllHost || amllHost.__amllSeekBound) return;
    amllHost.__amllSeekBound = true;
    amllHost.addEventListener("click", (ev) => {
      try {
        if (!amllPlayer) return;
        let el = ev.target;
        while (el && el !== amllHost) {
          if (el.classList && el.classList.contains("FmKaba_lyricLine")) break;
          el = el.parentElement;
        }
        if (!el || el === amllHost) return;
        const groups = amllPlayer.currentLyricGroups || [];
        for (const group of groups) {
          // Compare against the LINE element, not group.element: the group's own
          // element is the .FmKaba_lyricLineWrapper that WRAPS the line, so
          // matching on it never succeeded and every click fell through.
          if (!group || !group.mainLine) continue;
          let lineEl = null;
          try { lineEl = group.mainLine.getElement(); } catch (err) {}
          if (lineEl !== el) continue;
          const ln = group.mainLine.getLine();
          const at = Number(ln.startTime);
          if (!Number.isFinite(at) || at < 0) return;
          // `at` is LYRIC time (amllLinesFromContent passes Aurora's raw line
          // times straight through, and amllDrive feeds the engine pos - offset).
          // The media has to travel `offset` ms past it to reach that lyric, so
          // seeking to `at` alone landed the whole offset away from the line and
          // read as "the line has no sync". Same rule as the panel's own line
          // click in 17-lyric-events and the PiP's seekToLyricTime.
          let seekTo = at;
          try {
            if (typeof getOffsetForLine === "function") seekTo = at + getOffsetForLine(at);
          } catch (err) {}
          seekTo = Math.max(0, seekTo);
          // Try every seek entry point we know of; YTMod.player.seek() is the
          // documented one but builds differ in what they expose.
          const p = window.YTMod && window.YTMod.player;
          const attempts = [
            () => { if (p && typeof p.seek === "function") p.seek(seekTo); },
            () => { if (p && typeof p.seekTo === "function") p.seekTo(seekTo); },
            () => {
              const el = document.querySelector("video");
              if (el) el.currentTime = seekTo / 1000;
            },
          ];
          for (const attempt of attempts) {
            try { attempt(); return; } catch (err) {}
          }
          return;
        }
      } catch (e) {}
    });
  }

  // Loading skeleton for track changes. The engine holds the previous track's
  // lines until the new ones arrive, which reads as "the wrong song". While the
  // skeleton is up the player is hidden (.ym-sl-amll-loading), so the old words
  // cannot show through; it comes down the instant real lyrics are handed over,
  // whether they came from a provider or from a local TTML file.
  // Fixed ragged widths, like the built-in skeleton: random ones reshuffle on
  // every load and read as a glitch.
  const AMLL_SKELETON_WIDTHS = [86, 62, 94, 71, 88, 55, 92, 66];
  let amllSkeletonEl = null;
  function amllShowSkeleton() {
    if (!amllActive || !amllReady || !amllHost) return;
    // Reveal the host too. A previous no-lyrics result calls amllHide(), which
    // takes body.amll-active off, and the host is visibility:hidden until it is
    // back - so without this the skeleton would be built but never painted.
    amllShow();
    if (amllSkeletonEl) return;
    try {
      const wrap = document.createElement("div");
      wrap.className = "ym-sl-amll-skeleton";
      for (let i = 0; i < AMLL_SKELETON_WIDTHS.length; i++) {
        const bar = document.createElement("div");
        bar.className = "ym-sl-amll-skeleton-bar";
        bar.style.width = AMLL_SKELETON_WIDTHS[i] + "%";
        wrap.appendChild(bar);
      }
      amllHost.appendChild(wrap);
      amllHost.classList.add("ym-sl-amll-loading");
      amllSkeletonEl = wrap;
    } catch (e) {}
  }
  function amllHideSkeleton() {
    if (amllHost) amllHost.classList.remove("ym-sl-amll-loading");
    if (!amllSkeletonEl) return;
    try { amllSkeletonEl.remove(); } catch (e) {}
    amllSkeletonEl = null;
  }

  function amllMediaIsPlaying() {
    // YTMusic knows whether it is playing; time deltas lie during buffering and
    // right after a seek, which used to leave the engine's own isPlaying flag
    // stale and freeze the karaoke sweep mid-word.
    try {
      if (typeof window !== "undefined" && window.YTMod && window.YTMod.player) {
        if (typeof window.YTMod.player.isPaused === "function") {
          return !window.YTMod.player.isPaused();
        }
      }
    } catch (e) {}
    return null;
  }

  // The engine positions a line's word animations (the per-word float, and the
  // per-character glow/float on long words) exactly ONCE, inside enable(), at
  // the instant the line becomes active - and it gates play() on its own
  // isPlaying flag. After that they run on wall-clock and are never re-synced,
  // so if that flag was ever stale the animations stay parked at whatever
  // currentTime they were given: the first word (whose delay is 0) happens to
  // show its float while every later word sits frozen at its start value.
  //
  // Re-run enable() for the active line every frame. It rewrites every word
  // animation's currentTime from the media time we already feed the engine, so
  // the floats track the song instead of the clock. Idempotent and cheap - it
  // only touches the handful of words on the active line.
  // enable() and resume() are async, so a throw inside them becomes a rejected
  // promise rather than a sync error - which is why the getComputedTiming
  // failure showed up as "Unhandled rejection" and slipped past every try/catch.
  // Swallow it here so one bad word cannot spam the console.
  function amllCallMaybeAsync(fn, thisArg) {
    try {
      const p = fn.call(thisArg, ...[].slice.call(arguments, 2));
      if (p && typeof p.catch === "function") p.catch(() => {});
      return p;
    } catch (err) { return null; }
  }

  // Re-seek the active line's word animations from the media clock. The engine
  // positions them once, when the line becomes active, and after that they run
  // on wall-clock - which is fine until anything seeks or stalls.
  //
  // Two rules learned the hard way:
  //  - ONLY the line whose window currently contains the playhead. An earlier
  //    +/-1500ms window re-enabled lines that had already ended, fighting the
  //    engine's own disable(): the line never went dim, the fill never released,
  //    and the panel looked stuck on a finished line.
  //  - Throttled. enable() walks every word and writes currentTime on each of
  //    its animations, so doing it every frame is pure waste; ~10x a second is
  //    far below the threshold of perception for a 1s ease-out.
  let amllLastKickTime = 0;
  function amllKickActiveLine(now) {
    if (now - amllLastKickTime < 100) return;
    amllLastKickTime = now;
    try {
      const groups = amllPlayer.currentLyricGroups || [];
      const t = amllPlayer.getCurrentTime();
      const playing = amllPlayer.getIsPlaying();
      for (const group of groups) {
        if (!group || !group.mainLine) continue;
        let s = -1;
        let e = -1;
        try {
          const ln = group.mainLine.getLine();
          s = ln.startTime;
          e = ln.endTime;
        } catch (err) { continue; }
        if (t < s || t > e) continue;
        amllCallMaybeAsync(group.mainLine.enable, group.mainLine, t, playing);
        amllCallMaybeAsync(group.mainLine.resume, group.mainLine);
        if (group.bgLine) {
          amllCallMaybeAsync(group.bgLine.enable, group.bgLine);
          amllCallMaybeAsync(group.bgLine.resume, group.bgLine);
        }
      }
    } catch (e) {}
  }

  // The engine builds a line's word elements - and one Web Animation per word,
  // plus per-character animations for every long word - the first time that line
  // scrolls into the render range, and only releases them when the TRACK changes.
  // hide() merely detaches the DOM node; it never disposes. So every line you
  // have ever scrolled past keeps its animations alive for the rest of the song.
  // With word-by-word syncs that is hundreds of live animations, which is why the
  // panel gets laggier the longer you listen. (This reproduces in the upstream
  // AMLL preview too, so it is an engine issue, not something we introduced.)
  //
  // Release anything well outside the render range. show() rebuilds a line from
  // scratch when it comes back (built === false forces rebuildElement()), so
  // nothing is lost - the words, the masks and the animations are all recreated.
  // Reap anything the engine itself has scrolled out of its render range. That is
  // the exact set hide() has detached, and it is what bounds the number of live
  // word animations to roughly the viewport instead of the whole song.
  let amllLastReapTime = 0;
  function amllReapDistantLines(now) {
    if (now - amllLastReapTime < 1000) return;
    amllLastReapTime = now;
    try {
      const groups = amllPlayer.currentLyricGroups || [];
      for (const group of groups) {
        if (!group || !group.mainLine) continue;
        let inRange = false;
        try { inRange = group.isInRenderRange ? group.isInRenderRange() : false; } catch (err) {}
        if (inRange) continue;
        for (const line of [group.mainLine, group.bgLine]) {
          if (!line) continue;
          let alreadyBare = false;
          try { alreadyBare = (line.splittedWords || []).length === 0; } catch (err) {}
          if (alreadyBare) continue;
          try { line.built = false; } catch (err) {}
          try { line.disposeElements(); } catch (err) {}
        }
      }
    } catch (e) {}
  }

  // The engine retires a finished line ONLY when the next line starts in the same
  // sync - its timeline controller guards the removal with
  //     if (addedPlayingCount > 0) { ...delete expired highlights... }
  // so a line whose window has passed stays in GRADIENT (fully lit) mode until
  // the following line begins. That is exactly "the fill never releases and the
  // line never goes down". Retire it ourselves: anything the playhead has left
  // gets disable(), which drops it back to the dim base and releases the fill.
  // Only ever force disable() - the engine's own enable() path is left alone.
  function amllRetireFinishedLines() {
    try {
      const groups = amllPlayer.currentLyricGroups || [];
      const t = amllPlayer.getCurrentTime();
      // Work out the scroll target ONCE, before retiring anything. Retiring
      // line-by-line and re-targeting on each one made the camera walk forward
      // a line per frame, which read as "scrolls too far" - especially after a
      // seek, when several finished lines are all still enabled.
      let targetIdx = -1;
      for (let i = 0; i < groups.length; i++) {
        try {
          const ln = groups[i].mainLine.getLine();
          if (ln.startTime > t) { targetIdx = i; break; }
          if (t >= ln.startTime && t <= ln.endTime) { targetIdx = i; break; }
        } catch (err) {}
      }
      let retired = false;
      for (const group of groups) {
        if (!group || !group.mainLine) continue;
        let s = -1;
        let e = -1;
        try {
          const ln = group.mainLine.getLine();
          s = ln.startTime;
          e = ln.endTime;
        } catch (err) { continue; }
        if (t >= s && t <= e) continue;      // still the line under the playhead
        let enabled = false;
        try { enabled = !!group.mainLine.isEnabled; } catch (err) {}
        if (!enabled) continue;
        amllCallMaybeAsync(group.mainLine.disable, group.mainLine);
        if (group.bgLine) amllCallMaybeAsync(group.bgLine.disable, group.bgLine);
        try {
          const tc = amllPlayer.timelineController;
          const idx = groups.indexOf(group);
          if (tc && idx !== -1 && tc.highlightedGroupsSet &&
              typeof tc.highlightedGroupsSet.delete === "function") {
            tc.highlightedGroupsSet.delete(idx);
          }
        } catch (err) {}
        retired = true;
      }
      if (retired && targetIdx !== -1) {
        try {
          const tc = amllPlayer.timelineController;
          if (tc && tc.snapshot && tc.snapshot.scrollToIndex !== targetIdx) {
            tc.snapshot.scrollToIndex = targetIdx;
            if (typeof amllPlayer.calcLayout === "function") amllPlayer.calcLayout("playback-tick");
          }
        } catch (err) {}
      }
    } catch (e) {}
  }

  // The calc mask path reads --amll-player-time to place each word's sweep. While
  // that variable sat on the player root, changing it once per frame invalidated
  // computed style for every word in the panel - about 80 recalculations to move
  // the 5 words on the active line. Scope it to the lines that actually need it.
  //
  // Selection is by the ENGINE's own state, not by time window. When two lines
  // overlap, the engine enables BOTH - measured live, two lines carried
  // FmKaba_active FmKaba_gradientMask at the same time. Picking only the line
  // whose window contains the playhead (and breaking out of the loop) left the
  // second one clockless: highlighted, but its words sat at the 0 default and
  // never filled. That is exactly the reported bug.
  // The next line that has not started yet is included too, so it is already at
  // 0% and continues rather than snapping when it takes over.
  let amllTimeHosts = [];
  // A line that retires must NOT lose its mask clock the same frame it goes
  // inactive. Each word's mask is a gradient POSITIONED by --amll-player-time;
  // without the property the clamp falls back to time 0, which is the "not sung"
  // end, so every word snaps from the lit end of its sweep to the dim one. The
  // theme's --bright-mask-alpha easing (.45s) was already fading the line down -
  // the mask jump overrode it, which is what read as "the white fill just
  // disappears". Hold the last clock value for longer than that easing so the
  // words stay lit where they finished and only the alpha fades out.
  const amllTimeHoldTimers = new Map();
  const AMLL_TIME_HOLD_MS = 600;
  function amllHoldTime(el, t) {
    const pending = amllTimeHoldTimers.get(el);
    if (pending) clearTimeout(pending);
    try { el.style.setProperty("--amll-player-time", String(t)); } catch (err) {}
    const timer = setTimeout(() => {
      amllTimeHoldTimers.delete(el);
      try { el.style.removeProperty("--amll-player-time"); } catch (err) {}
    }, AMLL_TIME_HOLD_MS);
    amllTimeHoldTimers.set(el, timer);
  }
  function amllReleaseTimeHold(el) {
    const pending = amllTimeHoldTimers.get(el);
    if (!pending) return;
    clearTimeout(pending);
    amllTimeHoldTimers.delete(el);
  }
  function amllScopePlayerTime(t) {
    try {
      const groups = amllPlayer.currentLyricGroups || [];
      const hosts = [];
      let lastEnabled = -1;
      for (let i = 0; i < groups.length; i++) {
        const group = groups[i];
        if (!group || !group.mainLine || !group.element) continue;
        let enabled = false;
        try { enabled = !!group.mainLine.isEnabled; } catch (err) {}
        if (!enabled) continue;
        hosts.push(group.element);
        lastEnabled = i;
      }
      // The next line that has not started yet, so it is pre-seeded at 0%.
      for (let i = lastEnabled + 1; i < groups.length; i++) {
        try {
          if (groups[i].mainLine.getLine().startTime > t) { hosts.push(groups[i].element); break; }
        } catch (err) {}
      }
      const prev = amllTimeHosts;
      for (const el of prev) {
        if (hosts.indexOf(el) === -1) amllHoldTime(el, t);
      }
      for (const el of hosts) {
        amllReleaseTimeHold(el);
        try { el.style.setProperty("--amll-player-time", String(t)); } catch (err) {}
      }
      amllTimeHosts = hosts;
    } catch (e) {}
  }

  /* The "Jump to current" pill only knew about the built-in scroll box: its
     handler is wired to that element, so Apple-style lyrics could be scrolled
     away with no way back until a line change happened to land inside the
     engine's render buffer. The engine keeps the same state on
     scrollState.isAutoAlignSuspended, and resetScroll() is its way home, so
     mirror that onto the SAME button instead of adding a second one.
     Reading the class back (rather than caching a flag) means anything else
     that hides the pill on a track change is respected on the next frame. */
  function amllSyncJumpButton() {
    if (!amllPlayer || !jumpButton) return;
    let suspended = false;
    try { suspended = !!amllPlayer.scrollState.isAutoAlignSuspended; } catch (e) {}
    const shown = !jumpButton.classList.contains("hidden");
    if (suspended === shown) return;
    setJumpButtonVisible(suspended);
  }

  function amllDrive(positionMs) {
    if (!amllActive || !amllReady || !amllPlayer) return;
    const amllPerfStartedAt = performance.now();
    const now = (typeof performance !== "undefined" ? performance.now() : Date.now());
    const delta = amllLastFrameTime ? Math.min(64, Math.max(0, now - amllLastFrameTime)) : 16;
    amllLastFrameTime = now;
    let off = 0;
    try { off = (typeof getOffsetForPosition === "function") ? getOffsetForPosition(positionMs) : 0; } catch (e) {}
    const t = Number.isFinite(off) ? Math.max(0, positionMs - off) : positionMs;
    amllLastPositionMs = t;
    try {
      const mediaPlaying = amllMediaIsPlaying();
      const advanced = mediaPlaying == null ? t > (amllPrevTime || 0) : mediaPlaying;
      amllPrevTime = t;
      // Compare against the ENGINE's own state, not a cached copy. The cached
      // copy starts as false, so when the media was already playing on the very
      // first frame the two values matched and resume() was never called - the
      // engine stayed "paused" forever. That silently killed the scale spring,
      // the per-word float and the background-vocal slide (all of them are
      // gated on getIsPlaying()), while the time-driven fill kept working
      // because update() writes --amll-player-time before any of that.
      if (advanced !== amllPlayer.getIsPlaying()) {
        if (advanced) { try { amllPlayer.resume(); } catch (e) {} }
        else { try { amllPlayer.pause(); } catch (e) {} }
      }
      amllWasPlaying = advanced;
      // Self-heal. The engine's own ResizeObserver can report 0x0 and never
      // recover, which zeroes defaultLineHeight and makes its in-render-range
      // check bail for every line - silently disabling every committed style
      // while the fill keeps working. Re-seed until the viewport sticks.
      if (amllPlayer.size[1] <= 0) amllSeedEngineSize();
      amllPlayer.setCurrentTime(t, false);
      amllPlayer.update(delta);
      // Keep the mask clock on the active line only - see amllScopePlayerTime.
      amllScopePlayerTime(t);
      // Re-seek the active line's word animations from the media clock.
      amllKickActiveLine(now);
      // Retire lines the playhead has already left, so their fill releases.
      amllRetireFinishedLines();
      // Release lines that have scrolled well out of range, so their per-word
      // animations do not pile up for the whole song.
      amllReapDistantLines(now);
      amllSyncJumpButton();
      amllDriveErrors = 0;
      if (window.__auroraPerf) window.__auroraPerf.addAmll(performance.now() - amllPerfStartedAt);
    } catch (e) {
      // A drive failure is per-frame, so do NOT tear the engine down on the
      // first one: a single hiccup (a half-built line, a mid-track line swap)
      // would otherwise drop Simple lyrics into the fallback for the rest of
      // the session. Retry, and only give up after ~1s of solid failures.
      amllDriveErrors++;
      if (amllDriveErrors === 1) {
        console.warn("[AuroraLyrics] AMLL drive failed; retrying.", e);
      }
      if (amllDriveErrors > 60) {
        console.warn("[AuroraLyrics] AMLL drive failed repeatedly; falling back.", e);
        amllFailed = true;
        amllHide();
        setJumpButtonVisible(false);
      }
    }
  }
