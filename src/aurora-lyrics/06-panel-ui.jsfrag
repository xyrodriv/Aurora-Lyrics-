  /* Options lives beside the song-layout pill in the empty band above the two
     panels, so the tab watcher owns re-mounting it when content.js rebuilds that
     picker. Module scope, like jumpButton. */
  let optionsButton = null;

  function findTabBar() {
    return (
      document.querySelector("ytmusic-player-page tp-yt-paper-tabs.tab-header-container") ||
      document.querySelector("tp-yt-paper-tabs.tab-header-container") ||
      document.querySelector("ytmusic-player-page tp-yt-paper-tabs") ||
      document.querySelector("tp-yt-paper-tabs")
    );
  }

  /* ---- tab watcher -------------------------------------------------------
     YTM re-renders the watch page on track and route changes, which destroys the
     injected SYNCED tab, so a MutationObserver watches for its disappearance.

     Observing `ytmusic-app` with `subtree: true` means the callback fires on
     EVERY mutation anywhere in the app, and during playback YTM mutates
     constantly (progress bar, elapsed time, recommendations, queue). The old
     callback ran `findTabBar()` — up to four document-wide querySelectors — on
     every one of those, so its cost scaled with both YTM's mutation rate and its
     growing DOM. That is a genuine contributor to "FPS falls the longer the
     session runs", and unlike the animation-loop fix it is not bounded per song.

     Narrowing the observed root is NOT safe here: the re-render that removes the
     tab is exactly the one we must not miss. So the coverage stays identical and
     the callback is made cheap instead:
       1. Fast path — if our tab is still a direct child of the bar we mounted it
          into, nothing changed. One property read instead of four querySelectors.
          This is the overwhelmingly common case, so the steady-state cost is
          effectively zero.
       2. Coalesce — bursts of mutations collapse into a single check per frame. */
  let tabWatchRaf = 0;
  function tabWatcherNeedsMount() {
    // Steady state: our Lyrics tab is still mounted where we found it.
    if (tabEl && tabMountParent &&
      tabEl.parentElement === tabMountParent && tabMountParent.isConnected) {
      return false;
    }
    // Otherwise re-mount (initial mount, or YTM re-rendered the bar away). The
    // Lyrics tab is YTM's OWN now, so there is no marker class to look for.
    return true;
  }
  function runTabWatcher() {
    tabWatchRaf = 0;
    if (tabWatcherNeedsMount()) scheduleMountTab();
    // content.js owns the layout picker this pill sits beside. A rebuild takes
    // the pill with it, and a detached pill is the only case that costs a
    // querySelector — connected is one property read per mutation batch.
    if (optionsButton && !optionsButton.isConnected) mountOptionsPill();
  }
  function onWatchMutations() {
    if (tabWatchRaf) return;
    tabWatchRaf = requestAnimationFrame(runTabWatcher);
  }

  /* ---- draggable overlay panel ---- */
  // Pointer events (not mouse events) so a drag works with touch as well, and
  // setPointerCapture on the panel so a fast drag that outruns the cursor still
  // tracks instead of dropping the panel mid-move. The first drag converts the
  // CSS anchor (top/right) into explicit left/top, so the panel continues from
  // wherever it currently sits rather than jumping to the pointer.
  function makeDraggable(panel, handle) {
    let dragging = false;
    let pointerId = null;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;

    handle.addEventListener("pointerdown", (event) => {
      // Let the close button and any real control inside the header behave
      // normally instead of starting a drag.
      if (event.target.closest("button, input, select, textarea, a")) return;
      const rect = panel.getBoundingClientRect();
      dragging = true;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      startLeft = rect.left;
      startTop = rect.top;
      panel.style.left = startLeft + "px";
      panel.style.top = startTop + "px";
      panel.style.right = "auto";
      panel.style.bottom = "auto";
      try { panel.setPointerCapture(pointerId); } catch (_) {}
      event.preventDefault();
    });

    panel.addEventListener("pointermove", (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      panel.style.left = (startLeft + event.clientX - startX) + "px";
      panel.style.top = (startTop + event.clientY - startY) + "px";
    });

    const endDrag = (event) => {
      if (!dragging || (event && event.pointerId !== pointerId)) return;
      dragging = false;
      if (pointerId != null) {
        try { panel.releasePointerCapture(pointerId); } catch (_) {}
      }
      pointerId = null;
    };
    panel.addEventListener("pointerup", endDrag);
    panel.addEventListener("pointercancel", endDrag);
  }

  function buildUI() {
    // On extension reload Chrome re-injects the content script but does NOT remove
    // DOM we created earlier, so a stale (possibly open) panel/style from the previous
    // injection can linger. Clear any orphaned UI first so we always start clean and closed.
    const stalePanel = document.getElementById("ym-sl-panel");
    if (stalePanel) stalePanel.remove();
    const staleStyle = document.getElementById("ym-sl-style");
    if (staleStyle) staleStyle.remove();
    const staleFonts = document.getElementById("ym-sl-fonts");
    if (staleFonts) staleFonts.remove();
    // The options overlay is a <body> child, so it survives a panel rebuild and
    // would otherwise stack up as duplicates on every extension reload.
    const staleOptions = document.querySelector(".ym-sl-options-overlay");
    if (staleOptions) staleOptions.remove();
    // A rebuild (e.g. extension reload) orphaned the old panel; drop the stale
    // search popover reference and any in-flight request so we recreate cleanly.
    if (searchAbortController) {
      searchAbortController.abort();
      searchAbortController = null;
    }
    searchPanelEl = null;

    const style = document.createElement("style");
    style.id = "ym-sl-style";
    style.textContent = CSS;
    document.head.appendChild(style);
    fontLinkEl = document.createElement("link");
    fontLinkEl.id = "ym-sl-fonts";
    fontLinkEl.rel = "stylesheet";
    fontLinkEl.href = SPICY_LYRICS_FONT_CSS;
    document.head.appendChild(fontLinkEl);
    // Segmented control (AJ, 2026-10-19): a compact row of pill buttons for a small
    // set of choices — cleaner than a dropdown for 2-3 options. Exposes `.value`
    // (getter) + `.setValue()` so callers that read `el.value` keep working.
    const buildSegmentedControl = (config) => {
      const options = config.options || [];
      let current = config.value != null ? config.value : (options[0] ? options[0].value : "");
      const root = h("div", { class: "ym-sl-segmented" + (config.class ? " " + config.class : "") });
      const els = options.map((option) => {
        const el = h("button", {
          class: "ym-sl-segmented-option" + (option.value === current ? " active" : ""),
          type: "button",
          "data-value": option.value,
          text: option.label,
        });
        el.addEventListener("click", () => {
          if (current === option.value) return;
          current = option.value;
          els.forEach((x) => x.classList.toggle("active", x.getAttribute("data-value") === current));
          if (config.onChange) config.onChange(current);
        });
        root.appendChild(el);
        return el;
      });
      Object.defineProperty(root, "value", { get() { return current; } });
      root.setValue = (value) => {
        current = value;
        els.forEach((x) => x.classList.toggle("active", x.getAttribute("data-value") === current));
      };
      return root;
    };
    panelEl = h("div", { id: "ym-sl-panel", class: "ym-sl-panel hidden SpicyRenderer" });
    const importButton = h("button", {
      class: "ym-sl-import ym-sl-op-btn ym-sl-op-btn-primary",
      type: "button",
      title: "Import TTML lyrics",
      "aria-label": "Import TTML lyrics",
      text: "Upload",
    });
    const importMode = buildSegmentedControl({
      "aria-label": "TTML import duration",
      value: "permanent",
      options: [
        { value: "permanent", label: "Permanent" },
        { value: "temporary", label: "Temporary" },
      ],
    });
    jumpButton = h("button", {
      class: "ym-sl-jump hidden",
      type: "button",
      title: "Jump to the currently playing lyric",
      "aria-label": "Jump to the currently playing lyric",
      text: "Jump to current",
    });
    jumpButton.addEventListener("click", onJumpButtonClick);
    const fileInput = h("input", {
      id: "ym-sl-file",
      type: "file",
      accept: ".ttml,.xml,application/ttml+xml",
      style: "display:none",
    });
    importButton.addEventListener("click", () => fileInput.click());
    fileInput.addEventListener("change", (event) => {
      const file = event.target.files && event.target.files[0];
      if (file) readFile(file, importMode.value);
      event.target.value = "";
    });

    const videoOffsetWrap = h("div", { class: "ym-sl-video-offset", title: "Shift lyric timing for this track" });
    const videoOffsetLabel = h("span", { text: "Offset" });
    // "Video vs Song" offset-scope picker removed (AJ, 2026-10-19):
    // recomputeActiveOffsetMode() already auto-switches the control between the
    // video/song slot by track type (music video vs audio-only), so the manual
    // override was redundant. The read-only .ym-sl-offset-applied badge still
    // shows which slot is active.
    // (+/- 60s each way — the clamp in setVideoOffsetMs enforces it.)
    // Offset range is +/- 60s — a full minute each way, raised from +/- 30s.
    // The SAME limit is declared in three places and they all have to agree:
    // here, the fullscreen pair in 08-fullscreen-controls.jsfrag, and the clamp
    // in setVideoOffsetMs (12-track-offset-sync.jsfrag). The clamp is the one
    // that actually ENFORCES it, so changing only the sliders would silently cap
    // the value back to 30s.
    const videoOffsetRange = h("input", {
      type: "range",
      min: "-60000",
      max: "60000",
      step: "100",
      value: "0",
      "aria-label": "Lyric offset",
    });
    const videoOffsetNumber = h("input", {
      type: "number",
      class: "ym-sl-offset-number",
      step: "0.1",
      min: "-60",
      max: "60",
      value: "0",
      title: "Offset in seconds (typed)",
      "aria-label": "Lyric offset in seconds",
    });
    const videoOffsetValue = h("span", { class: "ym-sl-video-offset-value", text: "0.0s" });
    const offsetApplied = h("span", { class: "ym-sl-offset-applied", text: "video" });
    videoOffsetWrap.append(videoOffsetLabel, videoOffsetRange, videoOffsetNumber, videoOffsetValue, offsetApplied);
    videoOffsetRange.addEventListener("input", () => {
      setVideoOffsetMs(Number(videoOffsetRange.value) || 0, true);
    });
    attachFineOffsetDrag(videoOffsetRange);
    videoOffsetNumber.addEventListener("input", () => {
      const seconds = parseFloat(videoOffsetNumber.value);
      if (Number.isFinite(seconds)) setVideoOffsetMs(seconds * 1000, true);
    });

    // Community-shared offset. The first person to post claims the track + mode
    // slot; everyone else gets that value on load. The owner token lives only in
    // localStorage, so Undo appears on the poster's own browser. Guests can use
    // a display label; a signed-in maker's public identity replaces that input
    // through the website bridge.
    const communityOffsetWrap = h("div", { class: "ym-sl-community-offset" });
    const communityOffsetHead = h("div", { class: "ym-sl-community-offset-head" });
    communityOffsetHead.append(
      h("span", { class: "ym-sl-options-section-title", text: "Community offset" }),
      h("span", { class: "ym-sl-community-offset-badge", text: "shared" })
    );
    communityOffsetStatus = h("div", {
      class: "ym-sl-community-offset-status",
      role: "status",
      "aria-live": "polite",
      text: "Play a track to share an offset.",
    });
    communityOffsetName = h("input", {
      class: "ym-sl-community-offset-name",
      type: "text",
      maxlength: "24",
      autocomplete: "nickname",
      placeholder: "Your name (optional)",
      "aria-label": "Name shown next to the shared offset",
    });
    try {
      if (window.localStorage) {
        communityOffsetName.value = window.localStorage.getItem(COMMUNITY_OFFSET_NAME_KEY) || "";
      }
    } catch (_) {}
    communityOffsetName.addEventListener("input", () => {
      try {
        if (window.localStorage) {
          window.localStorage.setItem(COMMUNITY_OFFSET_NAME_KEY, communityOffsetName.value.slice(0, 24));
        }
      } catch (_) {}
    });
    // An anchor rather than a div: once the maker identity arrives, both the
    // avatar and the username become one target for the public profile. Without
    // a profile URL the href is removed again and the row stays inert.
    communityOffsetAccount = h("a", {
      class: "ym-sl-community-offset-account hidden",
    });
    communityOffsetAccountAvatar = h("span", {
      class: "ym-sl-community-offset-avatar",
      "aria-hidden": "true",
    });
    const communityOffsetAccountCopy = h("span", {
      class: "ym-sl-community-offset-accountcopy",
    });
    communityOffsetAccountName = h("strong", {
      class: "ym-sl-community-offset-accountname",
    });
    communityOffsetAccountCopy.append(
      communityOffsetAccountName,
      h("span", { class: "ym-sl-community-offset-accountmeta", text: "Aurora maker" })
    );
    communityOffsetAccount.append(communityOffsetAccountAvatar, communityOffsetAccountCopy);
    communityOffsetPostButton = h("button", {
      class: "ym-sl-community-offset-btn ym-sl-community-offset-post",
      type: "button",
      title: "Share the current offset with everyone",
      text: "Post offset",
    });
    communityOffsetUndoButton = h("button", {
      class: "ym-sl-community-offset-btn ym-sl-community-offset-undo hidden",
      type: "button",
      title: "Remove the shared offset you posted",
      text: "Undo",
    });
    communityOffsetReportButton = h("button", {
      class: "ym-sl-community-offset-btn ym-sl-community-offset-report hidden",
      type: "button",
      title: "Report this offset to the moderators",
      text: "Report",
    });
    communityOffsetPostButton.addEventListener("click", () => { postCommunityOffset(); });
    communityOffsetUndoButton.addEventListener("click", () => { undoCommunityOffset(); });
    communityOffsetReportButton.addEventListener("click", () => { reportCommunityOffset(); });
    const communityOffsetActions = h("div", { class: "ym-sl-community-offset-actions" },
      communityOffsetPostButton, communityOffsetUndoButton, communityOffsetReportButton
    );
    communityOffsetWrap.append(
      communityOffsetHead, communityOffsetStatus, communityOffsetAccount, communityOffsetName, communityOffsetActions
    );

    // Options is a pill beside the song-layout switcher, in the empty band
    // above both panels (AJ, 2026-10-26). It used to be a hover-revealed row
    // across the panel's own top edge, which only appeared for people who
    // already knew to sweep the pointer there — AJ's friend went looking and
    // found nothing. Here it is always on screen, on the left of a control
    // that is also about the song view, and it cannot collide with the tab
    // labels or push them aside. content.js builds the container; see
    // mountOptionsPill().
    optionsButton = h("button", {
      class: "ym-sl-options-pill",
      type: "button",
      title: "Lyrics options — offset, import, and more",
      "aria-label": "Open lyrics options",
      "aria-haspopup": "dialog",
      text: "Options",
    });

    // The remaining controls (track, offset, import mode, upload) moved out of
    // the toolbar into a draggable overlay. The overlay is a child of <body> on
    // purpose: .ym-sl-panel sets container-type: size, which makes the panel a
    // containing block for fixed-position descendants and would trap + clip a
    // nested overlay (the panel also has overflow: hidden).
    const optionsOverlay = h("div", { class: "ym-sl-options-overlay ym-sl-op2 hidden" });
    const optionsDivider = h("hr", { class: "ym-sl-options-divider" });
    const optionsTtmlTitle = h("div", { class: "ym-sl-options-section-title", text: "TTML" });
    const optionsBottom = h("div", { class: "ym-sl-options-section" });
    const exportButton = h("button", {
      class: "ym-sl-import ym-sl-export-button",
      type: "button",
      title: "Download the imported TTML without applying the current offset",
      "aria-label": "Export imported TTML",
      text: "Export",
    });
    const exportSyncButton = h("button", {
      class: "ym-sl-import ym-sl-export-sync-button",
      type: "button",
      title: "Download the imported TTML with the current offset applied",
      "aria-label": "Export imported TTML with sync",
      text: "Export + sync",
    });
    const exportActions = h("div", { class: "ym-sl-export-actions hidden" }, exportButton, exportSyncButton);
    exportButton.addEventListener("click", () => exportImportedTTML(false));
    exportSyncButton.addEventListener("click", () => exportImportedTTML(true));
    deletePermanentButton = h("button", {
      class: "ym-sl-import ym-sl-delete-permanent-button hidden",
      type: "button",
      title: "Delete the permanently-saved TTML for this track",
      "aria-label": "Delete permanently saved TTML",
      text: "Delete saved",
    });
    deletePermanentButton.addEventListener("click", deletePermanentTTMLForCurrentTrack);
    optionsBottom.append(importMode, importButton, exportActions, deletePermanentButton);
    /* MV pause re-sync REMOVED entirely on AJ's call (2026-10-19): the section,
       the "Set pause point" picker, its editor, and the pick banner are all gone
       from the panel. The low-level offset machinery in 12-track-offset-sync is
       left in place but dormant — nothing calls enterPausePickMode() now, and
       every pauseUi/pauseBanner consumer is null-safe. */

    // (H) Cache section. Spicy Lyrics and Aurora Community results are cached
    // for up to 30 days; this exposes an explicit purge so a stale or wrong
    // match can be cleared without nuking unrelated LRCLIB data. The community
    // store is separate, so both purge funcs must run here.
    const cacheDivider = h("hr", { class: "ym-sl-options-divider" });
    const cacheTitle = h("div", { class: "ym-sl-options-section-title", text: "Cache" });
    const cacheSection = h("div", { class: "ym-sl-options-section ym-sl-cache-section" });
    const cacheStatus = h("div", { class: "ym-sl-cache-status", text: "Spicy Lyrics and Aurora Community results are cached for up to 30 days." });
    const cacheClear = h("button", {
      class: "ym-sl-import ym-sl-cache-clear",
      type: "button",
      "aria-label": "Clear cached lyrics",
      text: "Clear cache",
    });
    // The button wipes the cache instantly and irreversibly, so gate it behind an
    // explicit confirmation: clicking "Clear cache" reveals an "Are you sure?" row
    // with a RED delete action (trash icon) + a Cancel. The user expected a
    // confirm step here and was surprised it fired immediately (AJ, 2026-10-19).
    const cacheConfirm = h("div", { class: "ym-sl-cache-confirm hidden" });
    const cacheConfirmText = h("div", {
      class: "ym-sl-cache-confirm-text",
      text: "Clear all cached lyrics? This cannot be undone.",
    });
    const cacheConfirmRow = h("div", { class: "ym-sl-cache-confirm-row" });
    const cacheDelete = h("button", {
      class: "ym-sl-cache-delete",
      type: "button",
      "aria-label": "Delete cached lyrics",
      title: "Delete cached lyrics",
    });
    // Trash-can icon (SVG, white on the red button via currentColor).
    const trashNS = "http://www.w3.org/2000/svg";
    const trashSvg = document.createElementNS(trashNS, "svg");
    trashSvg.setAttribute("viewBox", "0 0 24 24");
    trashSvg.setAttribute("class", "ym-sl-trash-icon");
    trashSvg.setAttribute("aria-hidden", "true");
    trashSvg.setAttribute("focusable", "false");
    const trashPath = document.createElementNS(trashNS, "path");
    trashPath.setAttribute("d", "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z");
    trashPath.setAttribute("fill", "currentColor");
    trashSvg.appendChild(trashPath);
    cacheDelete.append(trashSvg, document.createTextNode("Delete"));
    const cacheCancel = h("button", {
      class: "ym-sl-cache-cancel",
      type: "button",
      text: "Cancel",
      "aria-label": "Cancel clearing the cache",
    });
    cacheConfirmRow.append(cacheDelete, cacheCancel);
    cacheConfirm.append(cacheConfirmText, cacheConfirmRow);

    function showCacheConfirm() {
      cacheClear.classList.add("hidden");
      cacheConfirm.classList.remove("hidden");
      cacheDelete.focus();
    }
    function hideCacheConfirm() {
      cacheConfirm.classList.add("hidden");
      cacheClear.classList.remove("hidden");
    }
    cacheClear.addEventListener("click", () => {
      if (cacheClear.disabled) return;
      showCacheConfirm();
    });
    cacheCancel.addEventListener("click", () => hideCacheConfirm());
    cacheDelete.addEventListener("click", async () => {
      if (cacheDelete.disabled) return;
      cacheDelete.disabled = true;
      cacheCancel.disabled = true;
      cacheStatus.textContent = "Clearing…";
      try {
        const [spicyCount, communityCount] = await Promise.all([
          spicyCacheEntryCount(),
          communityCacheEntryCount(),
        ]);
        await Promise.all([
          clearSpicyLyricsCache(),
          clearCommunityLyricsCache(),
        ]);
        const count = spicyCount + communityCount;
        cacheStatus.textContent = count
          ? `Cleared ${count} cached ${count === 1 ? "entry" : "entries"}.`
          : "Nothing to clear — the cache was already empty.";
      } catch (error) {
        cacheStatus.textContent = "Could not clear the cache.";
        alWarn("clear cache failed:", error);
      }
      cacheDelete.disabled = false;
      cacheCancel.disabled = false;
      hideCacheConfirm();
    });
    cacheSection.append(cacheStatus, cacheClear, cacheConfirm);

    // ---- Options body: ADAPTIVE SHELL (AJ, 2026-11-14) -------------------
    // The add-ons panel's split, reused here: one rail, one scrolling pane,
    // and a single red marker that slides between rows. The old build stacked
    // absolutely positioned pages inside a height it measured itself; one missed
    // measurement left the visible page blank or put its controls under an
    // invisible sibling. Here only the active page is in flow, so there is
    // nothing to measure and nothing to overlap.
    // YouTube Music enforces Trusted Types: assigning SVG markup with innerHTML
    // throws and aborts buildUI, taking the Options pill and the Lyrics tab with
    // it. Build the icons as real SVG nodes instead.
    const OP_SVG_NS = "http://www.w3.org/2000/svg";
    const opSvgNode = (tag, attrs) => {
      const node = document.createElementNS(OP_SVG_NS, tag);
      for (const key in attrs) node.setAttribute(key, attrs[key]);
      return node;
    };
    const opIcon = (draw, className) => {
      const el = h("span", { class: className, "aria-hidden": "true" });
      const svg = opSvgNode("svg", {
        viewBox: "0 0 24 24",
        fill: "none",
        stroke: "currentColor",
        "stroke-width": "1.8",
        "stroke-linecap": "round",
        "stroke-linejoin": "round",
        focusable: "false",
        "aria-hidden": "true",
      });
      draw(svg);
      el.appendChild(svg);
      return el;
    };
    const OP_ICON = {
      sliders: (svg) => {
        svg.appendChild(opSvgNode("path", { d: "M4 7h9M17 7h3M4 17h3M11 17h9" }));
        svg.appendChild(opSvgNode("circle", { cx: "15", cy: "7", r: "2" }));
        svg.appendChild(opSvgNode("circle", { cx: "9", cy: "17", r: "2" }));
      },
      sync: (svg) => {
        ["M12 7v5l3 2", "M20 12a8 8 0 1 1-2.34-5.66", "M20 4v4h-4"]
          .forEach((d) => svg.appendChild(opSvgNode("path", { d })));
      },
      file: (svg) => {
        ["M7 3h7l4 4v14H7z", "M14 3v5h5", "M9 13h6M9 17h5"]
          .forEach((d) => svg.appendChild(opSvgNode("path", { d })));
      },
      cache: (svg) => {
        svg.appendChild(opSvgNode("ellipse", { cx: "12", cy: "6", rx: "7", ry: "3" }));
        ["M5 6v6c0 1.66 3.13 3 7 3s7-1.34 7-3V6", "M5 12v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"]
          .forEach((d) => svg.appendChild(opSvgNode("path", { d })));
      },
      close: (svg) => {
        svg.appendChild(opSvgNode("path", { d: "M6 6l12 12M18 6L6 18", "stroke-width": "2" }));
      },
    };
    const optionPageId = (id) => "ym-sl-op-page-" + id;
    const optionTabId = (id) => "ym-sl-op-tab-" + id;
    const optionPageHead = (title, copy) => h("header", { class: "ym-sl-op-pagehead" },
      h("h2", { class: "ym-sl-op-pagetitle", text: title }),
      h("p", { class: "ym-sl-op-pagesub", text: copy })
    );
    const optionCard = (title, copy, ...children) => h("section", { class: "ym-sl-op-card" },
      title ? h("div", { class: "ym-sl-op-cardhead" },
        h("h3", { class: "ym-sl-op-cardtitle", text: title }),
        copy ? h("p", { class: "ym-sl-op-cardcopy", text: copy }) : null
      ) : null,
      ...children
    );

    const panelSync = h("section", {
      class: "ym-sl-op-page",
      id: optionPageId("sync"),
      role: "tabpanel",
      "aria-labelledby": optionTabId("sync"),
      tabindex: "-1",
    },
      optionPageHead(
        "Sync & timing",
        "Nudge the lyrics into place for this track, then share the fix with everyone."
      ),
      optionCard(
        "Offset",
        "Nudge the lyrics earlier or later for this track, then post the fix to share it with everyone.",
        videoOffsetWrap,
        communityOffsetWrap
      )
    );

    // Per-SONG cache controls, in the File tab next to the import buttons. The
    // global purge lives in the Cache tab; this one only ever touches the track
    // that is on screen, and it cannot run while that track is playing — see
    // queueSongCacheClear() in 12-track-offset-sync.
    fileImportedNote = h("div", { class: "ym-sl-file-note hidden" });
    songCacheStatus = h("div", { class: "ym-sl-file-note ym-sl-song-cache-status" });
    songCacheClearButton = h("button", {
      class: "ym-sl-import ym-sl-song-cache-clear hidden",
      type: "button",
      title: "Drop this song's cached lyrics once it has finished playing",
      "aria-label": "Clear this song's cached lyrics",
      text: "Clear cache for this song",
    });
    songCacheClearButton.addEventListener("click", () => {
      if (songCacheClearButton.disabled) return;
      queueSongCacheClear();
    });
    const panelFile = h("section", {
      class: "ym-sl-op-page",
      id: optionPageId("file"),
      role: "tabpanel",
      "aria-labelledby": optionTabId("file"),
      tabindex: "-1",
    },
      optionPageHead(
        "Lyrics file",
        "Bring your own TTML, export the current sync, or clear this song's lookup."
      ),
      optionCard(
        "Import",
        "Choose a TTML file and whether it should stay for this session or permanently.",
        importMode,
        h("div", { class: "ym-sl-options-file-actions" }, importButton, deletePermanentButton),
        exportActions,
        fileImportedNote
      ),
      optionCard(
        "This song's cache",
        "The cached lookup is dropped only after this track has finished playing.",
        songCacheStatus,
        songCacheClearButton
      )
    );

    const panelCache = h("section", {
      class: "ym-sl-op-page",
      id: optionPageId("cache"),
      role: "tabpanel",
      "aria-labelledby": optionTabId("cache"),
      tabindex: "-1",
    },
      optionPageHead(
        "Cache",
        "Spicy Lyrics and Aurora Community results are kept for up to 30 days so repeats load instantly."
      ),
      optionCard(
        "Stored results",
        "Clearing is immediate and cannot be undone.",
        cacheSection
      )
    );

    const optionSections = [
      { id: "sync", label: "Sync & timing", hint: "Offset & community", icon: OP_ICON.sync, panel: panelSync },
      { id: "file", label: "Lyrics file", hint: "Import & export", icon: OP_ICON.file, panel: panelFile },
      { id: "cache", label: "Cache", hint: "Stored results", icon: OP_ICON.cache, panel: panelCache },
    ];
    // Options opens on Sync, the reason the panel exists (offset + community).
    const DEFAULT_OPTION_TAB = 0;
    let activeOptionIndex = DEFAULT_OPTION_TAB;
    let optionsSwapFinish = null;
    let optionsLayoutRaf = 0;
    let optionsEntrancePending = false;
    let optionsFocusBefore = null;

    const optionsMotionOK = () =>
      !(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);

    const optionsTabs = h("div", {
      class: "ym-sl-op-tabs",
      role: "tablist",
      "aria-label": "Options sections",
    });
    const optionsIndicator = h("span", { class: "ym-sl-op-ind", "aria-hidden": "true" });
    optionsTabs.appendChild(optionsIndicator);

    const optionTabs = optionSections.map((section, index) => {
      const tab = h("button", {
        class: "ym-sl-op-tab" + (index === DEFAULT_OPTION_TAB ? " is-active" : ""),
        type: "button",
        role: "tab",
        id: optionTabId(section.id),
        "aria-controls": optionPageId(section.id),
        "aria-selected": index === DEFAULT_OPTION_TAB ? "true" : "false",
        tabindex: index === DEFAULT_OPTION_TAB ? "0" : "-1",
      },
        opIcon(section.icon, "ym-sl-op-tabicon"),
        h("span", { class: "ym-sl-op-tabcopy" },
          h("strong", { text: section.label }),
          h("small", { text: section.hint })
        )
      );
      tab.addEventListener("click", () => switchOptionTab(index, { focusTab: true }));
      tab.addEventListener("keydown", (event) => {
        const key = event.key;
        let next = null;
        if (key === "ArrowDown" || key === "ArrowRight") next = (index + 1) % optionSections.length;
        else if (key === "ArrowUp" || key === "ArrowLeft") next = (index - 1 + optionSections.length) % optionSections.length;
        else if (key === "Home") next = 0;
        else if (key === "End") next = optionSections.length - 1;
        if (next == null) return;
        event.preventDefault();
        switchOptionTab(next, { focusTab: true });
      });
      optionsTabs.appendChild(tab);
      return tab;
    });

    optionSections.forEach((section, index) => {
      const active = index === DEFAULT_OPTION_TAB;
      section.panel.hidden = !active;
      section.panel.inert = !active;
      section.panel.setAttribute("aria-hidden", active ? "false" : "true");
    });

    const optionsReel = h("div", { class: "ym-sl-op-reel" });
    optionSections.forEach((section) => optionsReel.appendChild(section.panel));
    const optionsScroll = h("div", { class: "ym-sl-op-scroll", tabindex: "-1" }, optionsReel);
    const optionsPane = h("main", { class: "ym-sl-op-pane" }, optionsScroll);
    const optionsRail = h("aside", { class: "ym-sl-op-rail" },
      h("div", { class: "ym-sl-op-railhead", text: "Settings" }),
      optionsTabs,
      h("div", { class: "ym-sl-op-railfoot", text: "Changes save as you go." })
    );
    const optionsBody = h("div", { class: "ym-sl-op-body" }, optionsRail, optionsPane);

    const optionsHeading = h("span", { class: "ym-sl-op-title", id: "ym-sl-op-heading", text: "Options" });
    const optionsShellClose = h("button", {
      class: "ym-sl-op-close",
      type: "button",
      title: "Close options",
      "aria-label": "Close options",
    }, opIcon(OP_ICON.close, "ym-sl-op-closesvg"));
    const optionsShellHead = h("header", { class: "ym-sl-op-head" },
      h("div", { class: "ym-sl-op-brand" },
        opIcon(OP_ICON.sliders, "ym-sl-op-mark"),
        h("div", { class: "ym-sl-op-brandcopy" }, optionsHeading)
      ),
      optionsShellClose
    );
    const optionsShell = h("section", {
      class: "ym-sl-op-shell",
      role: "dialog",
      "aria-labelledby": "ym-sl-op-heading",
    }, optionsShellHead, optionsBody);

    function positionOptionIndicator(instant) {
      const tab = optionTabs[activeOptionIndex];
      if (!tab) return;
      if (instant) {
        optionsIndicator.classList.remove("ready");
        void optionsIndicator.offsetWidth;
      }
      optionsIndicator.style.height = tab.offsetHeight + "px";
      optionsIndicator.style.transform = "translateY(" + tab.offsetTop + "px)";
      optionsIndicator.style.opacity = tab.offsetHeight ? "1" : "0";
      optionsIndicator.classList.add("ready");
    }

    function syncOptionEdges() {
      const max = optionsScroll.scrollHeight - optionsScroll.clientHeight;
      optionsPane.classList.toggle("has-top", optionsScroll.scrollTop > 2);
      optionsPane.classList.toggle("has-bottom", max > 2 && optionsScroll.scrollTop < max - 2);
    }

    function settleOptionSwap() {
      const finish = optionsSwapFinish;
      optionsSwapFinish = null;
      if (finish) finish();
    }

    function reelOptionPages(oldPage, newPage, dir) {
      const span = Math.max(optionsScroll.clientHeight, 260);
      const dur = 380;
      const ease = "cubic-bezier(.32,.72,0,1)";
      oldPage.style.position = "absolute";
      oldPage.style.top = "0";
      oldPage.style.left = "0";
      oldPage.style.right = "0";
      oldPage.style.width = "100%";
      oldPage.style.pointerEvents = "none";
      newPage.style.position = "absolute";
      newPage.style.top = "0";
      newPage.style.left = "0";
      newPage.style.right = "0";
      newPage.style.width = "100%";
      newPage.style.pointerEvents = "none";
      optionsScroll.style.overflowY = "hidden";
      const out = oldPage.animate(
        [{ opacity: 1, transform: "translateY(0px)" },
         { opacity: 0, transform: "translateY(" + (-span * dir) + "px)" }],
        { duration: dur, easing: ease }
      );
      const inn = newPage.animate(
        [{ opacity: 0, transform: "translateY(" + (span * dir) + "px)" },
         { opacity: 1, transform: "translateY(0px)" }],
        { duration: dur, easing: ease }
      );
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        try { out.cancel(); inn.cancel(); } catch (_) {}
        oldPage.hidden = true;
        oldPage.removeAttribute("style");
        newPage.hidden = false;
        newPage.removeAttribute("style");
        optionsScroll.style.overflowY = "";
        if (optionsSwapFinish === finish) optionsSwapFinish = null;
        syncOptionEdges();
      };
      optionsSwapFinish = finish;
      out.onfinish = finish;
      inn.onfinish = finish;
      window.setTimeout(finish, dur + 90);
    }

    function switchOptionTab(next, opts) {
      if (next < 0 || next >= optionSections.length) return;
      if (next === activeOptionIndex) {
        if (opts && opts.focusTab) optionTabs[next].focus({ preventScroll: true });
        return;
      }
      settleOptionSwap();
      const oldIndex = activeOptionIndex;
      const dir = next > oldIndex ? 1 : -1;
      const oldPage = optionSections[oldIndex].panel;
      const newPage = optionSections[next].panel;
      activeOptionIndex = next;
      optionTabs.forEach((tab, i) => {
        const on = i === next;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
      });
      optionSections.forEach((section, i) => {
        const on = i === next;
        section.panel.inert = !on;
        section.panel.setAttribute("aria-hidden", on ? "false" : "true");
      });
      newPage.hidden = false;
      optionsScroll.scrollTop = 0;
      positionOptionIndicator(false);
      if (optionsMotionOK() && typeof oldPage.animate === "function") {
        reelOptionPages(oldPage, newPage, dir);
      } else {
        oldPage.hidden = true;
        syncOptionEdges();
      }
      if (opts && opts.focusTab) {
        optionTabs[next].focus({ preventScroll: true });
      }
    }

    function playOptionEntrance() {
      if (!optionsMotionOK() || optionsOverlay.classList.contains("ym-sl-options-docked")) return;
      optionTabs.forEach((tab, i) => {
        if (!tab.animate) return;
        tab.animate(
          [{ opacity: 0, transform: "translateX(-12px)" }, { opacity: 1, transform: "none" }],
          { duration: 420, delay: 30 + i * 45, easing: "cubic-bezier(.34,1.4,.5,1)", fill: "backwards" }
        );
      });
      const page = optionSections[activeOptionIndex].panel;
      if (page && page.animate) {
        page.animate(
          [{ opacity: 0, transform: "translateY(16px)" }, { opacity: 1, transform: "none" }],
          { duration: 420, delay: 70, easing: "cubic-bezier(.22,1,.36,1)", fill: "backwards" }
        );
      }
    }

    function queueOptionLayout(entrance) {
      if (entrance) optionsEntrancePending = true;
      if (optionsLayoutRaf) return;
      optionsLayoutRaf = requestAnimationFrame(() => {
        optionsLayoutRaf = 0;
        if (optionsOverlay.classList.contains("hidden")) return;
        positionOptionIndicator(true);
        syncOptionEdges();
        if (optionsEntrancePending) {
          optionsEntrancePending = false;
          playOptionEntrance();
        }
      });
    }

    function openOptionsPanel() {
      if (!optionsOverlay.classList.contains("hidden")) return;
      optionsFocusBefore = document.activeElement;
      settleOptionSwap();
      optionsOverlay.classList.remove("hidden");
      refreshFileTabState();
      optionsScroll.scrollTop = 0;
      queueOptionLayout(true);
      requestAnimationFrame(() => {
        optionTabs[activeOptionIndex].focus({ preventScroll: true });
      });
    }

    function closeOptionsPanel() {
      if (optionsOverlay.classList.contains("hidden")) return;
      if (optionsOverlay.classList.contains("ym-sl-options-docked")) return;
      optionsOverlay.classList.add("hidden");
      if (optionsFocusBefore && optionsFocusBefore.isConnected) {
        optionsFocusBefore.focus({ preventScroll: true });
      }
    }

    optionsOverlay.replaceChildren(optionsShell);
    makeDraggable(optionsOverlay, optionsShellHead);
    optionsOverlay._staggerOpen = () => {
      if (optionsOverlay.classList.contains("hidden")) return;
      settleOptionSwap();
      refreshFileTabState();
      optionsScroll.scrollTop = 0;
      queueOptionLayout(true);
      optionTabs[activeOptionIndex].focus({ preventScroll: true });
    };
    optionsOverlay._exportActions = exportActions;
    if (window.MutationObserver) {
      // Other features (fullscreen, PiP) show this overlay by removing the
      // hidden class themselves. Re-measure on that class change instead of
      // assuming our own button is the only way in.
      const optionsVisibilityObserver = new MutationObserver(() => {
        if (!optionsOverlay.classList.contains("hidden")) queueOptionLayout(true);
      });
      optionsVisibilityObserver.observe(optionsOverlay, { attributes: true, attributeFilter: ["class"] });
    }
    optionsButton.addEventListener("click", () => {
      if (optionsOverlay.classList.contains("hidden")) openOptionsPanel();
      else closeOptionsPanel();
    });
    optionsShellClose.addEventListener("click", closeOptionsPanel);
    optionsOverlay.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeOptionsPanel();
      }
    });
    optionsScroll.addEventListener("scroll", syncOptionEdges, { passive: true });
    window.addEventListener("resize", () => {
      if (!optionsOverlay.classList.contains("hidden")) queueOptionLayout(false);
    });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        if (!optionsOverlay.classList.contains("hidden")) queueOptionLayout(false);
      }).catch(() => {});
    }
    if (window.ResizeObserver) {
      // Sizing the rail marker from a single frame can leave it a few pixels
      // taller than the active row when Satoshi swaps in after measurement.
      // Watching the tab stack catches that reflow without reintroducing any
      // page-height measuring or animation.
      const optionsTabObserver = new ResizeObserver(() => {
        if (!optionsOverlay.classList.contains("hidden")) positionOptionIndicator(true);
      });
      optionsTabObserver.observe(optionsTabs);
    }
    document.body.appendChild(optionsOverlay);

    const lyricsContainer = h("div", { class: "LyricsContainer" });
    const content = h("div", { class: "LyricsContent offline" });
    const scrollContainer = h("div", {
      class: "SpicyLyricsScrollContainer",
      "data-lyrics-type": "Syllable",
    });
    linesRoot = h("div", { class: "VirtualLyricsContainer" });
    linesRoot.appendChild(h("div", {
      class: "ym-sl-empty",
      text: "Drop a .ttml file here, or use Upload to load synced lyrics.",
    }));
    scrollContainer.appendChild(linesRoot);
    content.appendChild(scrollContainer);
    lyricsContainer.appendChild(content);
    panelEl.append(fileInput, lyricsContainer, jumpButton);
    // Ad notice. A child of the panel (not the lyrics container) so it covers
    // whichever renderer is mounted — Spicy lines or the AMLL host — without
    // touching either one's DOM. Hidden until an ad actually starts.
    adBreakOverlayEl = h("div", {
      class: "ym-sl-ad hidden",
      role: "status",
      "aria-live": "polite",
    });
    adBreakTitleEl = h("div", { class: "ym-sl-ad-title", text: "An ad is playing" });
    adBreakSubEl = h("div", { class: "ym-sl-ad-sub", text: "Lyrics will resume after this ad" });
    adBreakSourceEl = h("div", { class: "ym-sl-ad-source", text: "" });
    adBreakOverlayEl.append(adBreakTitleEl, adBreakSubEl, adBreakSourceEl);
    panelEl.appendChild(adBreakOverlayEl);
    // Top-of-lyrics notice for LRCLIB's machine-generated word timing (see
    // loadLRCLyrics). It is a sibling of the lyrics surface rather than a line,
    // so rebuilding the renderer never drops it. The timer line is restarted by
    // syncWordSyncQualityNotice each time the notice is shown.
    wordSyncQualityNoticeEl = h("div", {
      class: "ym-sl-mv-sync-chip ym-sl-lrclib-word-note hidden",
      role: "note",
      "aria-label": "LRCLIB word-by-word timing may be less accurate than hand-synced lyrics",
    },
      h("span", { text: "LRCLIB word-by-word timing may be less accurate" }),
      h("span", { class: "ym-sl-mv-sync-chip-timer", "aria-hidden": "true" })
    );
    panelEl.appendChild(wordSyncQualityNoticeEl);
    panelEl.addEventListener("dragover", (event) => {
      event.preventDefault();
      panelEl.classList.add("drag");
    });
    panelEl.addEventListener("dragleave", () => panelEl.classList.remove("drag"));
    panelEl.addEventListener("drop", (event) => {
      event.preventDefault();
      panelEl.classList.remove("drag");
      const file = event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0];
      if (file) readFile(file, importMode.value);
    });

    lineScrollEl = content;
    lineScrollEl.addEventListener("wheel", handleManualScrollIntent, { passive: true });
    lineScrollEl.addEventListener("touchstart", handleManualScrollIntent, { passive: true });
    lineScrollEl.addEventListener("pointerdown", handleManualScrollIntent, { passive: true });
    lineScrollEl.addEventListener("keydown", handleManualScrollKey);
    applySettings(currentSettings);
    document.body.appendChild(panelEl);
    refreshTrack();
    mountTab();
    mountOptionsPill();
    startTick();

    const watchRoot = document.querySelector("ytmusic-app") ||
      document.querySelector("ytmusic-player-page");
    if (watchRoot) {
      wpObserver = new MutationObserver(onWatchMutations);
      wpObserver.observe(watchRoot, { childList: true, subtree: true });
    }
  }

  function mountOptionsPill() {
    const host = document.querySelector(".ym-song-layout");
    if (!host || !optionsButton) return;
    if (optionsButton.parentElement === host) return;
    // First child, so the pill sits to the LEFT of the layout switcher.
    host.insertBefore(optionsButton, host.firstChild);
  }

  function mountPanel(bar) {
    // Inject INTO YTM's own tab content node (#tab-renderer), like the Better
    // Lyrics extension, so the lyrics sit truly inside the native Lyrics tab
    // rather than in a sibling panel. Falls back to the tab bar's parent.
    const renderer = document.querySelector("#tab-renderer");
    const host = renderer || (bar && bar.parentElement);
    // Never yank the panel back into the YTM tab while fullscreen is active —
    // it currently lives inside the fullscreen overlay. Same while the NPV
    // snippet has docked it into its own rail.
    if (!host || !panelEl || fsActive || externalHostActive) return;
    panelHost = host;
    if (panelEl.parentElement !== host) host.appendChild(panelEl);
  }

