      color: rgba(255, 255, 255, .48);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--spicy .ym-sl-credit-writers .ym-sl-credits-names {
      font-size: 12.5px;
      line-height: 1.4;
      color: rgba(255, 255, 255, .62);
    }
    /* Compact credit rail. The wide rail is built around a
       roomy pane: 64px people avatars, a 72px Apple mark, and a provider pinned
       to the right. On a small monitor the lyric pane is narrower than those
       pieces, so the credits collide and the card wraps mid-credit. The query
       measures the panel instead of the viewport, because YTM's side panel can
       be narrow even on a wide screen. Every provider keeps its own
       skin; only geometry, type scale and wrapping change. The hierarchy stays
       the one in the reference: people left, provider right, writers as the
       quiet bottom note. */
    @container ym-sl-credit-rail (max-width: 600px) {
      #ym-sl-panel.SpicyRenderer .ym-sl-credits {
        gap: 8px 14px;
        padding: 12px 14px;
        margin: 32px 0 16px;
        border-radius: 12px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credit-box { gap: 3px; }
      #ym-sl-panel.SpicyRenderer .ym-sl-credit-writers {
        order: 3;
        flex: 1 0 100%;
        padding: 8px 0 0;
        border-bottom: 0;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credit-provider {
        order: 2;
        align-self: flex-start;
        margin-left: auto;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credit-people {
        order: 1;
        align-self: flex-start;
        gap: 6px 12px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits-label,
      #ym-sl-panel.SpicyRenderer .ym-sl-provider-label,
      #ym-sl-panel.SpicyRenderer .ym-sl-uploader-label {
        font-size: 10px;
        line-height: 1.2;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits-names {
        font-size: 12.5px;
        line-height: 1.3;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credit-writers .ym-sl-credits-names {
        font-size: 14px;
        line-height: 1.3;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-provider {
        gap: 4px;
        font-size: 12px;
        flex-wrap: wrap;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-provider-icon {
        width: 14px;
        height: 14px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-provider-name { font-size: 13px; }
      #ym-sl-panel.SpicyRenderer .ym-sl-provider-date {
        font-size: 9.5px;
        line-height: 1.2;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-uploader {
        gap: 4px;
        font-size: 12px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-uploader-link {
        gap: 4px;
        padding: 1px 7px 1px 2px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-uploader-avatar {
        width: 16px;
        height: 16px;
      }
      /* Unison, Spicy and Aurora share the portrait people block. Shrink the
         avatar grid as one unit so the level badge, arrow overlay and the two
         text rows stay aligned to the same 40px circle. */
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) > .ym-sl-credit-provider {
        position: static;
        top: auto;
        right: auto;
        left: auto;
        order: 2;
        margin-right: 0;
        margin-left: auto;
        align-self: flex-start;
        text-align: left;
        transform: none;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).align-right > .ym-sl-credit-provider {
        position: static;
        top: auto;
        right: auto;
        left: auto;
        order: 2;
        margin-right: 0;
        margin-left: auto;
        align-self: flex-start;
        text-align: left;
        transform: none;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--unison.ym-sl-credits--no-writers > .ym-sl-credit-provider {
        position: static;
        top: auto;
        transform: none;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).align-right > .ym-sl-credit-people {
        order: 1;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-provider .ym-sl-provider {
        gap: 4px;
        font-size: 13px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-provider .ym-sl-provider-label,
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader-label {
        font-size: 10px;
        color: rgba(255, 255, 255, .58);
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-provider .ym-sl-provider-name {
        font-size: 14px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-provider .ym-sl-provider-icon {
        width: 15px;
        height: 15px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader {
        grid-template-columns: 40px minmax(0, max-content);
        column-gap: 8px;
        row-gap: 1px;
        min-height: 40px;
        font-size: 13px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).align-right .ym-sl-credit-people .ym-sl-uploader {
        grid-template-columns: minmax(0, max-content) 40px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).align-right .ym-sl-credit-people .ym-sl-uploader.ym-sl-uploader--no-avatar,
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader.ym-sl-uploader--no-avatar {
        grid-template-columns: minmax(0, max-content);
        min-height: 0;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader-avatar {
        width: 40px;
        height: 40px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader-name {
        max-width: 150px;
        font-size: 14px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader-label {
        font-size: 10px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader-name,
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader-label {
        transform: translateY(1px);
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader::after {
        width: 40px;
        height: 40px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-people .ym-sl-uploader[data-level]::before {
        left: 14px;
        top: -6px;
        width: 16px;
        height: 16px;
        font-size: 8px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).align-right .ym-sl-credit-people .ym-sl-uploader[data-level]::before {
        left: auto;
        right: 14px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-provider-date {
        font-size: 9.5px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).ym-sl-credits--no-writers > .ym-sl-provider-date {
        right: 14px;
        bottom: 10px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).ym-sl-credits--no-writers.align-right > .ym-sl-provider-date {
        left: 14px;
        right: auto;
      }
      /* A source with no writers puts the submitted date straight into the
         rail. Keep it after the provider instead of letting flex order 0 pull
         it above the credit it belongs to. */
      #ym-sl-panel.SpicyRenderer .ym-sl-credits > .ym-sl-provider-date {
        order: 3;
        flex: 1 0 100%;
        margin-top: 2px;
      }
      /* Apple and LRCLIB have no people block. Keep the provider as the lead
         line, but replace the oversized 72px mark with a compact one and let
         the writers close the card underneath. */
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple > .ym-sl-credit-provider {
        order: 1;
        margin-right: auto;
        margin-left: 0;
        align-self: flex-start;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple > .ym-sl-credit-writers {
        order: 3;
        flex: 1 0 100%;
        padding: 8px 0 0;
        border: 0;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple > .ym-sl-credit-artist {
        order: 3;
        flex: 1 0 100%;
        padding: 8px 0 0;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-provider .ym-sl-provider {
        gap: 3px;
        font-size: 13px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-provider .ym-sl-provider-icon {
        width: 44px;
        height: 44px;
        margin-right: 7px;
        border-radius: 11px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-provider .ym-sl-provider-label {
        font-size: 10px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-provider .ym-sl-provider-name {
        font-size: 15px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-writers .ym-sl-credits-label,
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-artist .ym-sl-credits-label {
        font-size: 9.5px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-writers .ym-sl-credits-names,
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-artist .ym-sl-credits-names {
        font-size: 12px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--lrclib {
        padding: 10px 12px;
        border: 0;
        background: transparent;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--lrclib .ym-sl-credit-provider .ym-sl-provider-name {
        font-size: 13px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--lrclib .ym-sl-credit-provider .ym-sl-provider-label {
        font-size: 10px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) .ym-sl-credit-brand {
        width: 150px;
        height: 150px;
        left: -28px;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison).align-right .ym-sl-credit-brand {
        left: auto;
        right: -28px;
      }
      #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-brand {
        width: 150px;
        height: 150px;
        left: -28px;
      }
      /* People across the top; writers and provider share the bottom row.
         This is deliberate rather than relying on flex wrap: once the provider
         no longer fits beside the people it used to drop into a lone row in the
         middle right of the card. A two-row grid keeps it anchored to the
         bottom-right corner at every compact width. */
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          "people people"
          "writers provider";
        align-items: end;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) > .ym-sl-credit-people {
        grid-area: people;
        align-self: start;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) > .ym-sl-credit-writers {
        grid-area: writers;
        align-self: end;
        padding: 0;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) > .ym-sl-credit-provider {
        grid-area: provider;
        position: static;
        top: auto;
        right: auto;
        left: auto;
        align-self: end;
        justify-self: end;
        margin: 0;
        transform: none;
      }
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) > .ym-sl-credit-artist {
        grid-column: 1 / -1;
      }
      /* A source with no writers has no bottom-left cell, and its date would
         otherwise land under the provider. Park it in that empty cell. */
      #ym-sl-panel.SpicyRenderer :is(.ym-sl-credits--spicy, .ym-sl-credits--unison) > .ym-sl-provider-date {
        grid-column: 1;
        grid-row: 2;
        position: static;
        right: auto;
        bottom: auto;
        justify-self: start;
        align-self: end;
        text-align: left;
      }
    }
    tp-yt-paper-tab.ym-sl-tab { position: relative; cursor: pointer; }
    tp-yt-paper-tab.ym-sl-tab .tab-content { pointer-events: none; }
    /* YTM disables the native Lyrics tab (pointer-events:none, disabled, tabindex
       -1, and a 0.3-alpha label) when the track has no lyrics on YTM. Aurora
       re-enables it so its own lyrics live in the REAL tab. */
    tp-yt-paper-tab.ym-sl-lyrics-tab {
      pointer-events: auto !important;
      cursor: pointer !important;
      color: rgba(255, 255, 255, .7) !important;
    }
    tp-yt-paper-tab.ym-sl-lyrics-tab .tab-content {
      pointer-events: auto !important;
      color: rgba(255, 255, 255, .7) !important;
    }
    tp-yt-paper-tab.ym-sl-lyrics-tab[aria-selected="true"],
    tp-yt-paper-tab.ym-sl-lyrics-tab[aria-selected="true"] .tab-content {
      color: #fff !important;
    }
    /* The SYNCED tab is a clone of the selected LYRICS tab, so its label
       inherited the selected tab's styling. Force the same label colour and
       opacity as the other (unselected) tabs. */
    /* Colour-only dimming with opacity pinned to 1: our cloned tab nests a
       SECOND .tab-content, so an opacity here stacked with itself (0.8 x 0.8 =
       0.64) and made SYNCED read darker than the native tabs(verified with the browser bridge). The native unselected label is
       rgba(255,255,255,.7) at opacity .8, i.e. an effective 0.56 white — bake
       that into the colour and leave opacity alone so it cannot stack. */
    tp-yt-paper-tab.ym-sl-tab .tab-content {
      color: rgba(255,255,255,.56) !important;
      opacity: 1 !important;
    }
    /* Selected-state parity. Verified live with the browser
       bridge: YTM marks the selected tab with the class iron-selected and its
       label renders rgb(255,255,255) / opacity 1, while unselected labels are
       rgba(255,255,255,.7) / .8. Clicking SYNCED does NOT move that native
       selection (our tab is not part of YTM's iron-pages), so the previously
       selected tab stayed bright and SYNCED stayed dim. While our tab is the
       active one (.ym-sl-custom-active on the bar) brighten SYNCED and dim the
       native selected tab, so the highlight follows the visible panel.
       NO BACKTICKS ANYWHERE IN THIS COMMENT BLOCK — it lives inside the CSS
       template literal, so one stray backtick terminates the whole stylesheet
       (and node --check does NOT catch it). */
    tp-yt-paper-tab.ym-sl-tab.ym-sl-active .tab-content {
      color: #fff !important;
      opacity: 1 !important;
    }
    tp-yt-paper-tabs.ym-sl-custom-active
      tp-yt-paper-tab.iron-selected:not(.ym-sl-tab) .tab-content {
      color: rgba(255,255,255,.7) !important;
      opacity: .8 !important;
    }
    /* Crossfade the label colours with the panel swap instead of snapping. */
    tp-yt-paper-tab.ym-sl-tab .tab-content,
    tp-yt-paper-tabs.ym-sl-custom-active
      tp-yt-paper-tab.iron-selected:not(.ym-sl-tab) .tab-content {
      transition: color .18s ease, opacity .18s ease;
    }
    /* The bar ships with NO CSS transition of its own (verified live: computed
       transition-duration 0s, animation-name none — YTM drives it in JS), so a
       transform WE set would snap while the native tabs glide. Give it one so
       the SYNCED underline animates the same way. This cannot
       disturb the native tabs: YTM's own animation takes precedence over a CSS
       transition. */
    tp-yt-paper-tabs #selectionBar {
      transition: transform .25s ease;
    }
    /* The tab underline is YTM's OWN #selectionBar — a full-width element whose
       1px white border-bottom is moved + resized onto the selected tab via
       transform: translateX(%) scaleX(fraction) (verified live with the browser
       bridge). We used to hide it and draw a per-tab ::after instead, but that
       animated as a centre-out scaleX "zoom". We now keep the
       real bar and drive it from JS (syncSelectionBar), so the underline moves
       exactly like a native tab switch — same element, same transition. */
    tp-yt-paper-tabs.ym-sl-custom-active
      tp-yt-paper-tab.iron-selected:not(.ym-sl-tab)::after,
    tp-yt-paper-tabs.ym-sl-custom-active
      tp-yt-paper-tab.iron-selected:not(.ym-sl-tab) .tab-content::after {
      opacity: 0 !important;
      visibility: hidden !important;
    }

    /* Final fullscreen geometry rules. These intentionally come after the
       short-viewport media queries above: the mode selectors carry higher
       specificity, so layout switches win over the media queries instead of
       snapping. */
    /* The redesigned fullscreen controls are layout-agnostic: the chrome lives
       top-right (see .ym-sl-fs-controls at the top of this block) and the play
       chip + scrubber sit inside the full-size .ym-sl-fs-player-controls layer
       (see .ym-sl-fs-player-controls above). In the side layouts every position
       is a FIXED length — nothing is measured off the media any more.
       The legacy per-layout repositioning that used to live here pushed the
       chrome to bottom-center and shrank the player-controls anchor to content
       width, which squeezed the play chip into the bottom-left corner on the
       side and video-background layouts. It is removed; only the lyrics scroll
       clearance that genuinely still applies is kept. */

    /* ===== STATIC SIDE STACK =============================
       Every control position is a fixed length. This block used to re-anchor the
       title, chip and scrubber to --ym-sl-fs-band-top (measured from the media's
       live rect and transitioned over .35s), which is what made the controls
       drift on every aspect-ratio change, art swap and metadata arrival.
       The base rules above already carry the static bottom values
       (title 170/150, chip 74/72), so nothing is overridden here — the measured
       system is simply gone. Animations are rebuilt from this base. */

    /* ===== side: transport chip + scrubber never hide ========
        wants the transport chip and the scrubber permanently visible in the
       video-left / lyrics-right (side) layout instead of fading in on hover
       and the same applies to Lyrics Only. The EXIT +
       LAYOUT controls DO hide on idle in every layout now (see the
       .ym-sl-fs-idle controls rule above). The MOUSE still hides on idle in
       EVERY layout (see the .ym-sl-fs-idle cursor rule above). Placed last in
       the block so it also wins over the .ym-sl-fs-idle rules, which carry the
       same specificity for the scrubber. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-play-chip,
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber {
      opacity: 1;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background).ym-sl-fs-idle .ym-sl-fs-play-chip,
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background).ym-sl-fs-idle .ym-sl-fs-scrubber {
      opacity: 1;
      pointer-events: auto;
    }

    /* ===== PORTRAIT SIDE LAYOUT =========================
       The side composition assumes the artwork is SHORTER than the column it
       sits in. That holds at 16:9 and stops holding on a tall window: the art
       is sized min(50%, 54vh), so past roughly 0.78 the art grows wider than
       the fixed 44% lyric inset and the words paint on top of it (measured on
       1080x1920: art ends at x=562, lyric text starts at x=518). The chrome
       stack is pinned to that same 2% / 50% column, so the words crossed that
       too (controls at x=22-562, lyrics from x=475, full height).
       Rather than add more offsets to a horizontal idea, square and taller
       windows get their own composition: the WORDS keep the screen, the art
       shrinks to a now-playing card in the bottom-left corner, and the
       transport sits beside it in one bottom band. Scoped to the cover-art
       side layout - Video Background is an overlay by design and Lyrics Only
       has no media at all. */
    @media (max-aspect-ratio: 1 / 1) {
      /* Both portrait compositions share one edge treatment: the lyric pane
         has real top/bottom edges here (unlike the thin side columns), and a
         clipped line at either one reads as broken, so the words dissolve
         before they reach them. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) {
        --ym-sl-fs-portrait-fade-top: clamp(64px, 10vh, 190px);
        --ym-sl-fs-portrait-fade-bottom: clamp(88px, 14vh, 270px);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) {
        /* One number drives both the card and the chrome's left inset, so the
           two can never drift apart. */
        --ym-sl-fs-portrait-art: clamp(96px, 14vh, 176px);
      }
      /* Lyrics first: full width, and the pane STOPS above the bottom band so
         no line can be painted under the transport (the other half of the
         overlap). The reserve tracks the chrome, whose title is vh-sized. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics {
        left: 0;
        width: 100%;
        bottom: clamp(190px, calc(22vh + 18px), 320px);
        /* MUST be explicit: the later .ym-sl-fs-lyrics rule sets height:100%,
           and a non-auto height wins over top+bottom, so the inset was being
           ignored and the pane stayed full-screen (verified live: bottom did
           not shorten the box). */
        height: auto;
        padding: clamp(44px, 7vh, 96px) clamp(40px, 7vw, 120px);
        /* Top and bottom dissolve instead of ending on a cut line. The bottom
           fade is taller because it is what keeps approaching lines from
           crowding the transport below the pane. */
        -webkit-mask-image: linear-gradient(
          to bottom,
          transparent 0,
          rgba(0, 0, 0, .55) calc(var(--ym-sl-fs-portrait-fade-top) * .5),
          #000 var(--ym-sl-fs-portrait-fade-top),
          #000 calc(100% - var(--ym-sl-fs-portrait-fade-bottom)),
          rgba(0, 0, 0, .55) calc(100% - var(--ym-sl-fs-portrait-fade-bottom) * .5),
          transparent 100%
        );
        mask-image: linear-gradient(
          to bottom,
          transparent 0,
          rgba(0, 0, 0, .55) calc(var(--ym-sl-fs-portrait-fade-top) * .5),
          #000 var(--ym-sl-fs-portrait-fade-top),
          #000 calc(100% - var(--ym-sl-fs-portrait-fade-bottom)),
          rgba(0, 0, 0, .55) calc(100% - var(--ym-sl-fs-portrait-fade-bottom) * .5),
          transparent 100%
        );
      }
      /* The artwork, demoted to a small square card. top:auto matters: the base
         pane is stretched top-to-bottom, and leaving that in place would keep
         a full-height flex box behind the card. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
        top: auto;
        bottom: 24px;
        left: 24px;
        width: var(--ym-sl-fs-portrait-art);
        height: var(--ym-sl-fs-portrait-art);
        border-radius: 14px;
      }
      /* The card must FILL its new box: the landscape rules still ask for
         min(100%, 54vh), which would crop it to a short strip. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media > img {
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        transform: none;
        border-radius: 14px;
        object-fit: cover;
      }
      /* Chrome: one bottom band, starting to the right of the art. Same 24px
         bottom as the card, so the two sit on one line. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
        top: auto;
        bottom: 24px;
        left: calc(48px + var(--ym-sl-fs-portrait-art));
        right: clamp(24px, 5vw, 72px);
        width: auto;
        height: auto;
      }
      /* A full-band volume slider reads as a stray line at this width; cap it
         and keep it with the transport. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group {
        max-width: 320px;
        align-self: flex-start;
      }

      /* ===== music video in portrait ======================================
         A 16:9 video has nowhere to go in a vertical window: the side split
         gives it half the width and the words start before it ends. Portrait
         puts the video across the FULL width at the very top (its own aspect
         ratio decides the height, capped for tall clips), the words fill the
         space under it, and the transport becomes a player overlay that fades
         in when the video is hovered - like every other video player. */
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) {
        --ym-sl-fs-portrait-video-h: min(calc(100vw / var(--ym-sl-fs-video-ratio, 1.7777778)), 46vh);
        /* The seam under the video is a real edge; the bottom fade is shorter
           here because nothing sits below the pane. */
        --ym-sl-fs-portrait-fade-top: clamp(40px, 5vh, 90px);
        --ym-sl-fs-portrait-fade-bottom: clamp(56px, 9vh, 160px);
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
        top: 0;
        left: 0;
        width: 100%;
        height: var(--ym-sl-fs-portrait-video-h);
        bottom: auto;
        transform: none;
        max-height: none;
        border-radius: 0;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media > video {
        border-radius: 0;
      }
      /* The words own everything below the video. */
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics {
        left: 0;
        width: 100%;
        top: calc(var(--ym-sl-fs-portrait-video-h) + 28px);
        bottom: 0;
        height: auto;
        padding: clamp(24px, 4vh, 56px) clamp(40px, 7vw, 120px) clamp(64px, 10vh, 180px);
        -webkit-mask-image: linear-gradient(
          to bottom,
          transparent 0,
          rgba(0, 0, 0, .55) calc(var(--ym-sl-fs-portrait-fade-top) * .5),
          #000 var(--ym-sl-fs-portrait-fade-top),
          #000 calc(100% - var(--ym-sl-fs-portrait-fade-bottom)),
          rgba(0, 0, 0, .55) calc(100% - var(--ym-sl-fs-portrait-fade-bottom) * .5),
          transparent 100%
        );
        mask-image: linear-gradient(
          to bottom,
          transparent 0,
          rgba(0, 0, 0, .55) calc(var(--ym-sl-fs-portrait-fade-top) * .5),
          #000 var(--ym-sl-fs-portrait-fade-top),
          #000 calc(100% - var(--ym-sl-fs-portrait-fade-bottom)),
          rgba(0, 0, 0, .55) calc(100% - var(--ym-sl-fs-portrait-fade-bottom) * .5),
          transparent 100%
        );
      }
      /* The horizontal readability shade is for a COLUMN of words beside a
         picture. Both portrait compositions abandon the column (video on top
         with the words full-width under it; cover art as a corner card), so the
         half-width band has nothing left to protect. Video Background keeps
         its shade - there the video is still the full-bleed backdrop. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics-shade {
        display: none;
      }
      /* Player-style scrim: only under the controls, only on hover, so the
         video stays untouched at rest. */
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 45%;
        background: linear-gradient(to top, rgba(0, 0, 0, .68), rgba(0, 0, 0, 0));
        opacity: 0;
        transition: opacity .2s ease;
        pointer-events: none;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle):has(.ym-sl-fs-media:hover) .ym-sl-fs-media::after {
        opacity: 1;
      }
      /* Transport over the video's bottom edge, hidden until the pointer is on
         the video (or on the controls themselves, which is what keeps them
         alive while moving down to the seek bar). Nothing invisible may eat
         clicks on the video, so the children are inert while hidden too. */
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
        top: auto;
        bottom: calc(100% - var(--ym-sl-fs-portrait-video-h) + 24px);
        left: clamp(24px, 4vw, 64px);
        right: clamp(24px, 4vw, 64px);
        width: auto;
        height: auto;
        opacity: 0;
        transition: opacity .2s ease;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls * {
        pointer-events: none;
      }
      /* The idle class must WIN over hover: the pointer can rest on the video
         while the overlay hides the cursor, and chrome that stays up after the
         cursor has gone is the exact thing the idle state exists to prevent. */
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle):has(.ym-sl-fs-media:hover) .ym-sl-fs-player-controls,
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle) .ym-sl-fs-player-controls:hover,
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle) .ym-sl-fs-player-controls:focus-within {
        opacity: 1;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle):has(.ym-sl-fs-media:hover) .ym-sl-fs-player-controls *,
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle) .ym-sl-fs-player-controls:hover *,
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle) .ym-sl-fs-player-controls:focus-within * {
        pointer-events: auto;
      }
    }

    /* ===== media-mode swap: NO CROSSFADE ==================
       The .ym-sl-fs-swapping class and its two rules (title filter fade +
       player-controls opacity fade) are REMOVED. syncFsVideoMode() no longer
       hides the pane either, so a cover <-> music-video switch is a hard cut:
       the outgoing image stays up until the incoming one can paint (the cover
       card is held until the video is ready), then both swap in one frame.
       Nothing to fade, nothing to time. */

    /* NOTE: the page-wide YouTube font swap now lives in content/styles.css
       (html.ym-yt-font) and is driven by the panel's own YouTube page, so it no
       longer depends on this add-on running at all. */

    /* ===== PiP control surface ==========================================
       While the lyrics float in a Document Picture-in-Picture window, the
       panel's lyric surface would just be a second, hidden copy. Instead the
       panel becomes the control surface: a status block, with the REAL Options
       card docked underneath so sync/offset stay editable while the window is
       open. The card is the same node the Options button shows; pip-lyrics.js
       moves it in from <body> and puts it back on close.
       NO BACKTICKS ANYWHERE IN THIS BLOCK -- it lives inside a template literal. */
    .ym-sl-panel.ym-pip-open .LyricsContainer,
    .ym-sl-panel.ym-pip-open .ym-sl-jump { display: none !important; }
    .ym-pip-open-view {
      position: absolute;
      inset: 0;
      z-index: 30;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      box-sizing: border-box;
      padding: clamp(22px, 4.4cqw, 38px) clamp(18px, 4.4cqw, 34px) 26px;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .ym-pip-open-view::-webkit-scrollbar { display: none; width: 0; height: 0; }
    /* Centred like the header. text-align lives on the two text blocks, not on
       the view, or the docked Options card would inherit it. */
    .ym-pip-open-title {
      text-align: center;
      font-family: "SpicyLyrics", "Noto Sans Georgian", "Vazirmatn",
        "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif;
      /* Big on purpose: the panel is now a status surface, not a lyric sheet. */
      font-size: clamp(25px, 5.2cqw, 36px);
      font-weight: 700;
      line-height: 1.06;
      letter-spacing: -.02em;
      color: #fff;
      max-width: 22ch;
      text-wrap: balance;
    }
    .ym-pip-open-note {
      text-align: center;
      font-family: "SpicyLyrics", "Noto Sans Georgian", "Vazirmatn",
        "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      line-height: 1.5;
      color: rgba(255, 255, 255, .56);
      max-width: 52ch;
      margin-bottom: 2px;
    }
    /* The floating Options card, docked. Every fixed/anchor/drag style is
       neutralised (the card is moved out of <body> while docked), but its
       frosted shell and tabbed body are kept so it reads as the same surface. */
    .ym-sl-options-overlay.ym-sl-options-docked {
      position: relative !important;
      inset: auto !important;
      left: auto !important;
      top: auto !important;
      right: auto !important;
      bottom: auto !important;
      z-index: auto !important;
      flex: 0 0 auto;
      width: 100%;
      max-width: 620px;
      /* The floating card had no border-box need; docked, width:100% would add
         its 1px borders on top of the content box and overflow the pane by 2px. */
      box-sizing: border-box;
      margin: 0 auto 4px;
      transform: none !important;
      border-radius: 18px;
      background: rgba(14, 16, 21, .5);
      -webkit-backdrop-filter: blur(18px) saturate(1.5);
      backdrop-filter: blur(18px) saturate(1.5);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1), 0 24px 60px -40px rgba(0, 0, 0, .7);
    }
    /* The header is the drag handle + close button; neither makes sense docked. */
    .ym-sl-options-docked .ym-sl-options-header { display: none; }
    /* Docked, the card is part of the surface, not a dismissible popover. Other
       code closes the floating overlay (e.g. entering fullscreen); that must not
       leave the PiP state with a status block and no controls. */
    .ym-sl-options-overlay.ym-sl-options-docked.hidden {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none !important;
    }
    .ym-sl-options-overlay.ym-sl-options-docked.hidden .ym-sl-options-panel.active {
      visibility: visible;
      pointer-events: auto;
    }

    /* ===== artwork hover button =========================================
       Pointing at the cover dims it and fades in ONE round button at its top
       edge. The button is a toggle, not a menu: its glyph shows the two panes
       and which side the words are on, and clicking it swaps them. The hover
       box IS the artwork's own box - same min(100%, 54vh) square, same 4vh
       downward nudge, same 16px radius as .ym-sl-fs-media > img - so the dim
       ends exactly at the art's edge instead of tinting the empty column
       around it. Cover-art side layout only: the button switches a
       composition nothing else has, and landscape only - the portrait layout
       turns the art into a corner card the side swap does not apply to, so the
       button is not rendered there at all. */
    .ym-sl-fs-art-ui { display: none; }
    @media (min-aspect-ratio: 1 / 1) {
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media > .ym-sl-fs-art-ui {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(100%, 54vh);
        aspect-ratio: 1 / 1;
        max-width: 100%;
        max-height: 100%;
        padding-top: 12px;
        box-sizing: border-box;
        transform: translate(-50%, calc(-50% + 4vh));
        border-radius: 16px;
        background: rgba(0, 0, 0, 0);
        transition: background .22s ease;
        z-index: 4;
      }
      /* Idle is exempt on purpose: the class lands after 2s without input, and
         a pointer resting on the art still reports :hover - without this the
         button would stay up over a hidden cursor forever.
         Stage is exempt too: its artwork is the composition (full-height, with
         the dock over it), so the hover scrim darkened the whole picture. The
         stage's own transparent rule could not win - this selector carries one
         more compound (:not-idle) - so the exclusion belongs here. Every other
         cover-art layout keeps the dim. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-stage):not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background):not(.ym-sl-fs-idle) .ym-sl-fs-media > .ym-sl-fs-art-ui:hover {
        background: rgba(0, 0, 0, .42);
      }
      /* A click pins both for the length of the move: the artwork slides out
         from under the pointer, so a hover-only reveal blinked the button away
         on the first frame of the transition. When the helper class drops the
         base transition takes over and fades the button out over .18s instead
         of cutting it. */
      .ym-sl-fs-overlay.ym-sl-fs-flipping:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media > .ym-sl-fs-art-ui {
        background: rgba(0, 0, 0, .42);
      }
      .ym-sl-fs-overlay.ym-sl-fs-flipping:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-swap {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition-delay: 0s;
      }
    }
    .ym-sl-fs-art-swap {
      -webkit-appearance: none;
      appearance: none;
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      margin: 0;
      padding: 0;
      border: 1px solid rgba(255, 255, 255, .18);
      border-radius: 50%;
      background: rgba(14, 14, 18, .46);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      backdrop-filter: blur(16px) saturate(1.4);
      color: #fff;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px) scale(.92);
      transition:
        opacity .18s ease,
        transform .24s cubic-bezier(.22, .61, .36, 1),
        background .15s ease,
        border-color .15s ease,
        visibility 0s linear .18s;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-idle) .ym-sl-fs-media > .ym-sl-fs-art-ui:hover .ym-sl-fs-art-swap {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
    .ym-sl-fs-art-swap:hover {
      background: rgba(32, 32, 38, .62);
      border-color: rgba(255, 255, 255, .28);
    }
    .ym-sl-fs-art-swap:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .72);
      outline-offset: 2px;
    }
    .ym-sl-fs-art-swap-icon {
      display: block;
      width: 22px;
      height: 22px;
      transform-origin: 50% 50%;
      transition: transform .18s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-art-swap:active .ym-sl-fs-art-swap-icon { transform: scale(.86); }
    /* The glyph swap runs on the SAME clock and curve as the layout move (0.45s
       cubic-bezier(.22,.61,.36,1)), so the icon and the cover art travel as one
       gesture. The two panes cross over each other in the middle - the filled
       one is always the words - which is what makes the direction readable
       without a label. */
    .ym-sl-fs-art-swap-art,
    .ym-sl-fs-art-swap-words {
      transition: transform .45s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-art-swap-art {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      opacity: .62;
    }
    .ym-sl-fs-art-swap-words {
      fill: currentColor;
      stroke: none;
    }
    .ym-sl-fs-art-swap.is-left .ym-sl-fs-art-swap-words { transform: translateX(-9.5px); }
    .ym-sl-fs-art-swap.is-left .ym-sl-fs-art-swap-art { transform: translateX(9.5px); }
    /* The like affordance sits in the middle of the cover. It shares the
       art-ui reveal with the swap button, so both appear from one hover; the
       spring curve on the scale is unchanged, only the glyph is new (a
       thumbs-up drawn in the same stroke language as the other icons). */
    .ym-sl-fs-art-like {
      -webkit-appearance: none;
      appearance: none;
      position: absolute;
      left: 50%;
      top: 50%;
      width: 68%;
      max-width: 300px;
      min-width: 120px;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      color: #fff;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translate(-50%, -50%) scale(.92);
      transition:
        opacity .18s ease,
        transform .24s cubic-bezier(.22, .61, .36, 1),
        visibility 0s linear .18s;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-idle) .ym-sl-fs-media > .ym-sl-fs-art-ui:hover .ym-sl-fs-art-like,
    .ym-sl-fs-overlay.ym-sl-fs-flipping:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-like {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, -50%) scale(1);
      transition-delay: 0s;
    }
    .ym-sl-fs-art-like svg {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
      filter: drop-shadow(0 4px 14px rgba(0, 0, 0, .35));
      transition: scale .85s
        linear(
          0, 0.009 0.9%, 0.037 1.9%, 0.088 3%, 0.155 4.1%, 0.307 6.1%,
          0.783 11.7%, 1.007 15%, 1.088 16.6%, 1.146 18.1%, 1.189 19.7%,
          1.215 21.4%, 1.224 23.6%, 1.207 26%, 1.171 28.4%, 1.057 34.4%,
          1.009 37.4%, 0.971 40.8%, 0.953 44.2%, 0.953 49.1%, 0.997 60.4%,
          1.01 66.8%, 1
        );
    }
    .ym-sl-fs-thumb-fill { opacity: 0; transition: opacity .25s; }
    .ym-sl-fs-art-like:not(.is-liked):hover .ym-sl-fs-thumb-fill { opacity: .25; }
    .ym-sl-fs-art-like.is-liked .ym-sl-fs-thumb-fill { opacity: 1; }
    .ym-sl-fs-art-like:hover svg { scale: .925; }
    .ym-sl-fs-art-like.is-press svg { scale: 1.245; }
    .ym-sl-fs-art-like.is-release svg { scale: .755; }
    .ym-sl-fs-art-like:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .72);
      outline-offset: 6px;
      border-radius: 50%;
    }

    /* ===== cover-art flip: lyrics on the left ===========================
       Every number here is the mirror image of the rule it overrides - the
       2/50 art column, the 44/54 lyric column and the 27% art midpoint - so
       change them together. The transport column is pinned to the art's own
       box (left 27% minus half, width two halves), which is why the mirror is
       the same expression measured from 73%.
       Landscape only: the portrait composition shrank the art to a corner
       card, where there is no side left to swap. */
    @media (min-aspect-ratio: 1 / 1) {
      .ym-sl-fs-overlay.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
        left: 48%;
      }
      .ym-sl-fs-overlay.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics {
        left: 2%;
      }
      .ym-sl-fs-overlay.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
        left: calc(73% - min(25%, 27vh));
      }
      /* The readability shade lives on the lyric side and fades towards the
         art, so the mirror flips its box AND its gradient. Those two are NOT
         part of the layout flip: it gets its own class, applied by JS once the
         panel has faded out (see setFsShadeSide in 07). Flipping them with the
         layout swung the gradient's dark end from the screen edge to 44% - the
         middle of the frame - on the first frame, while the panel was still
         fully visible, and that read as the shadow darting to the centre. */
      .ym-sl-fs-overlay.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics-shade.ym-sl-fs-shade-left {
        left: 0;
        right: 44%;
        background: linear-gradient(
          270deg,
          transparent 0%,
          rgba(0, 0, 0, .16) 14%,
          rgba(0, 0, 0, .62) 52%,
          rgba(0, 0, 0, .9) 100%
        );
        -webkit-mask-image: linear-gradient(270deg, transparent 0, rgba(0, 0, 0, .5) 8%, #000 24%, #000 100%);
        mask-image: linear-gradient(270deg, transparent 0, rgba(0, 0, 0, .5) 8%, #000 24%, #000 100%);
      }
    }
    /* The flip helper class only exists for the 480ms the JS holds it. The two
       panes and the cover art already transition left; the transport column
       does not, so without this it would snap while the picture glided. */
    .ym-sl-fs-overlay.ym-sl-fs-flipping:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
      transition: left .45s cubic-bezier(.22, .61, .36, 1);
    }
    /* The media host's own transition is opacity-only (set by the track-change
       dissolve further up, which deliberately overrides the base left/width
       list), so the ARTWORK needs its left handed back for the length of the
       flip or the cover would snap to the other side while the words glided. */
    .ym-sl-fs-overlay.ym-sl-fs-flipping:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
      transition:
        opacity .25s ease,
        left .45s cubic-bezier(.22, .61, .36, 1);
    }
    /* A side swap is not a layout move: the shade must go, not travel. The
       left transition armed above for the layout switches is taken back here,
       or the flip at 240ms dragged a half-faded black band across the picture
       instead of the band simply being gone. */
    .ym-sl-fs-overlay.ym-sl-fs-flipping:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics-shade {
      transition: opacity .22s ease;
    }
    /* The readability shade is LIGHT, not an object: it does not slide, drop,
       stretch or pop. It fades out where it is, waits for the columns to
       finish crossing, and only then fades back in on its new side - the move
       itself is the only motion in the frame, which is what keeps the swap
       readable. Any travel at all would drag a dark frosted band across the
       artwork at the midpoint, where the two columns overlap completely.
       The fade-out is FAST and front-loaded - gone in about 96ms - because the
       columns start moving on the first frame and their curve is front-loaded
       too: a slow fade left a half-visible band sitting around the middle of
       the screen while the words had already left it. It does NOT change sides
       here either: JS applies the shade's side class at 120ms, once the panel
       is invisible (see setFsShadeSide). The fade-in waits until 58% - the
       0.45s layout move has landed by then - and runs over ~220ms, which is why
       this lives on its own longer class instead of the flip's: the flip is
       over long before the shadow comes back. */
    .ym-sl-fs-overlay.ym-sl-fs-shade-swap:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics-shade {
      animation: ym-sl-fs-shade-dissolve .8s linear both;
    }
    @keyframes ym-sl-fs-shade-dissolve {
      0% {
        opacity: var(--ym-sl-fs-lyrics-shade-opacity, 0);
        animation-timing-function: cubic-bezier(.25, .4, .4, 1);
      }
      12%, 58% { opacity: 0; }
      86%, 100% { opacity: var(--ym-sl-fs-lyrics-shade-opacity, 0); }
    }

    /* ===== APPLE MUSIC cover-art layout ==================================
       The no-video side composition, rebuilt on Spicy Lyrics' Player Below
       the Cover geometry: one left-aligned cover, then title, progress,
       transport and volume directly beneath it, with the words in a separate
       right column. Every length that should scale with the artwork is a
       fraction of --ym-am-cover, so a 900p monitor and a 1440p monitor keep
       the same proportions instead of drifting apart at breakpoints.
       Music videos keep the existing side layout untouched. */
    @media (min-aspect-ratio: 1 / 1) {
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) {
        --ym-am-cover: min(34vw, 57vh);
        /* The artwork column is centred between the monitor's left edge and
           the first pixel of lyric text (44% pane + 4vw inset). This keeps
           the air on both sides of the cover equal instead of hugging the
           screen edge. */
        --ym-am-inset: calc((44vw + clamp(24px, 4vw, 72px) - var(--ym-am-cover)) * .5);
        /* Spicy centres the whole ~1.47-cover stack: 50cqh - cover * .735. */
        --ym-am-top: calc(max(clamp(20px, 6.4vh, 80px),
          calc(50vh - var(--ym-am-cover) * .735)) + 2vh);
        /* One gap for cover -> title and title -> progress. The metadata block
           reads as one unit instead of floating halfway down the page. */
        --ym-am-gap: calc(var(--ym-am-cover) * .024);
        --ym-am-bar: max(3px, calc(var(--ym-am-cover) * .0115));
        --ym-am-bar-hover: max(4px, calc(var(--ym-am-cover) * .0155));
        --ym-am-thumb: max(11px, calc(var(--ym-am-cover) * .028));
      }
      /* The media pane IS the cover box now: no 50% flex column and no
         vertical centring. The artwork fills it exactly, which also gives the
         hover swap surface the same edges as the image. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
        left: var(--ym-am-inset);
        top: var(--ym-am-top);
        bottom: auto;
        width: var(--ym-am-cover);
        height: var(--ym-am-cover);
        display: block;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media > img {
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        aspect-ratio: 1 / 1;
        transform: none;
        border-radius: 18px;
        object-fit: cover;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media > .ym-sl-fs-art-ui {
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        padding: 12px;
        align-items: flex-start;
        justify-content: flex-end;
        transform: none;
        border-radius: 18px;
      }
      /* Title, then progress + times, then transport, then volume. The 8%
         gap under the cover and the 2.2% under the title are Spicy's values. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
        /* The artwork -> title gap is pulled in slightly; the title -> progress
           gap keeps the full --ym-am-gap. */
        top: calc(var(--ym-am-top) + var(--ym-am-cover) + (var(--ym-am-gap) * .82));
        left: var(--ym-am-inset);
        width: var(--ym-am-cover);
        gap: 0;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title {
        margin: 0 0 var(--ym-am-gap);
        padding-right: calc(var(--ym-am-cover) * .075);
        font-size: calc(var(--ym-am-cover) * .0465);
        line-height: 1.3;
        letter-spacing: -.012em;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-inner {
        gap: 0;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-track {
        font-weight: 700;
        letter-spacing: -.012em;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-artist {
        font-size: .82em;
        font-weight: 500;
        opacity: .62;
        letter-spacing: 0;
      }
      /* The artwork heart joins the title row, at the cover's right edge. It
         stays out of the art hover surface so it is visible without pointing
         at the cover, exactly like the reference. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls > .ym-sl-fs-art-like {
        position: absolute;
        /* Centre the heart in the whole artwork-bottom -> progress-top band,
           including the two-line title and the asymmetric top gap. */
        top: calc(var(--ym-am-cover) * .0345 + (var(--ym-am-gap) * .09));
        right: 0;
        left: auto;
        display: block;
        width: calc(var(--ym-am-cover) * .052);
        height: calc(var(--ym-am-cover) * .052);
        min-width: 0;
        min-height: 0;
        max-width: none;
        margin: 0;
        padding: 0;
        opacity: 1;
        visibility: visible;
        transform: none;
        pointer-events: auto;
        color: #fff;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls > .ym-sl-fs-art-like svg {
        width: 100%;
        height: 100%;
        filter: none;
      }
      /* Progress: a bare rail, white travelled section, faint remaining one.
         No inset highlight, no hover slab. The bar gains one pixel of weight
         while hovered and the handle is the only round thing that appears. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber {
        gap: calc(var(--ym-am-cover) * .012) 10px;
        padding: 0;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-time {
        min-width: 4.8ch;
        font-size: max(10px, calc(var(--ym-am-cover) * .025));
        font-weight: 500;
        color: rgba(255, 255, 255, .64);
        letter-spacing: .01em;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek {
        height: var(--ym-am-bar);
        border-radius: 999px;
        background: transparent;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek::-webkit-slider-runnable-track {
        height: var(--ym-am-bar);
        background: linear-gradient(to right,
          rgba(255, 255, 255, .96) 0%,
          rgba(255, 255, 255, .96) var(--slider-fill),
          rgba(255, 255, 255, .28) var(--slider-fill),
          rgba(255, 255, 255, .28) 100%);
        box-shadow: none;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek::-moz-range-track {
        height: var(--ym-am-bar);
        background: rgba(255, 255, 255, .28);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek::-moz-range-progress {
        height: var(--ym-am-bar);
        background: rgba(255, 255, 255, .96);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek::-webkit-slider-thumb {
        width: var(--ym-am-thumb);
        height: var(--ym-am-thumb);
        margin-top: calc((var(--ym-am-bar) - var(--ym-am-thumb)) / 2);
        box-shadow: none;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek::-moz-range-thumb {
        width: var(--ym-am-thumb);
        height: var(--ym-am-thumb);
        box-shadow: none;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek:focus {
        height: var(--ym-am-bar-hover);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-webkit-slider-runnable-track,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek:focus::-webkit-slider-runnable-track {
        height: var(--ym-am-bar-hover);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-moz-range-track,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek:focus::-moz-range-track,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-moz-range-progress,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek:focus::-moz-range-progress {
        height: var(--ym-am-bar-hover);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-webkit-slider-thumb,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek:focus::-webkit-slider-thumb {
        margin-top: calc((var(--ym-am-bar-hover) - var(--ym-am-thumb)) / 2);
      }
      /* Volume: the same rail language as the progress bar, bracketed by the
         two speaker glyphs. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group {
        width: 100%;
        margin-top: calc(var(--ym-am-cover) * .019);
        gap: calc(var(--ym-am-cover) * .022);
        padding: 0;
        border: 0;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-icon {
        width: max(14px, calc(var(--ym-am-cover) * .0415));
        height: max(14px, calc(var(--ym-am-cover) * .0415));
        color: rgba(255, 255, 255, .9);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-volume {
        height: max(10px, calc(var(--ym-am-cover) * .034));
      }
      /* The transport used to sit flush under the time row, which left a hole
         above the volume. Give the chip a matching lead-in and take it from
         the volume gap, so the icons land midway between both rails. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-play-chip {
        margin-top: calc(var(--ym-am-cover) * .019);
      }
      /* Enlarge the transport glyphs inside their existing button slots: the
         controls stay on the same centre lines, but read fuller and closer to
         the cover's scale. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-prev svg,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-next svg,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-shuffle svg,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-repeat svg {
        width: max(26px, calc(var(--ym-am-cover) * .053));
        height: max(26px, calc(var(--ym-am-cover) * .053));
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-play svg {
        width: max(32px, calc(var(--ym-am-cover) * .064));
        height: max(32px, calc(var(--ym-am-cover) * .064));
      }
      /* Apple Music sliders: suppress the floating thumb dot. The rail's
         hover thickness is the only affordance, matching the bigger controls. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek::-webkit-slider-thumb {
        opacity: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-seek::-moz-range-thumb {
        opacity: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-knob {
        opacity: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-volume::before,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-fill {
        height: var(--ym-am-bar);
        box-shadow: none;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-volume::before {
        background: rgba(255, 255, 255, .28);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-fill {
        background: rgba(255, 255, 255, .96);
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-knob {
        width: var(--ym-am-thumb);
        height: var(--ym-am-thumb);
        box-shadow: none;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group:hover .ym-sl-fs-player-volume::before,
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group:hover .ym-sl-fs-volume-fill {
        height: var(--ym-am-bar-hover);
      }
      /* Mirror the whole column when the artwork/words are swapped. */
      .ym-sl-fs-overlay.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media,
      .ym-sl-fs-overlay.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
        left: calc(100% - var(--ym-am-inset) - var(--ym-am-cover));
      }
      .ym-sl-fs-overlay.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics {
        left: 2%;
        width: 54%;
      }
    }

    /* ===== HITS ===========================================
       The default fullscreen composition: a centred header with the artwork,
       title, metadata chips and the song actions, then the lyrics in the same
       centred column beneath it. The header owns the top of the screen; its
       measured height is published by JS as --ym-sl-fs-hits-head-h, which is
       what positions the lyrics column. Kawarp is the backdrop and uses the
       live Aurora Bloom settings; the blurred cover is only the fallback.
       No backticks in this comment: the sheet is a template literal. */

    /* Kawarp owns the backdrop. It already applies Bloom's saturation, warp,
       blur, brightness and contrast through startFullscreenKawarp(), so Hits
       adds no filter of its own. The blurred art shows only when Kawarp could
       not start (no WebGL / no Dynamic add-on). */
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits:not(.ym-sl-fs-has-kawarp) .ym-sl-fs-bg-img {
      display: block !important;
      filter: blur(46px) saturate(1.7) brightness(.62) !important;
      transform: scale(1.18);
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-bg-canvas {
      display: none !important;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-bg-tint {
      background:
        radial-gradient(120% 90% at 50% 0%, transparent 48%, rgba(0, 0, 0, .2) 100%),
        linear-gradient(180deg, rgba(8, 8, 10, .08) 0%, rgba(8, 8, 10, .22) 52%, rgba(8, 8, 10, .55) 100%);
    }

    /* The media stays in the tree (it owns the playing video/audio) but is
       never part of the composition. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-media {
      left: 0;
      width: 100%;
      opacity: 0;
      /* visibility, not just opacity: the track-change dissolve writes inline
         opacity on the media host, and an inline value would beat a plain
         opacity rule. The video keeps decoding and playing while hidden. */
      visibility: hidden;
      pointer-events: none;
    }

    /* Classic top chrome is replaced by the Hits header. The player-controls
       layer is hidden too: the header owns the track details, while a dedicated
       dock carries the transport, seek, volume and utility controls. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-controls,
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-player-controls,
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-title,
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-nextup {
      display: none !important;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-lyrics-shade {
      display: none !important;
    }

    /* ---- header ---------------------------------------------------------- */
    .ym-sl-fs-hits {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 19;
      display: none;
      pointer-events: none;
      color: #fff;
      font-family: "SpicyLyrics", "Noto Sans Georgian", "Vazirmatn",
        "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif;
      /* No halo behind the title/byline: the Kawarp backdrop already gives the
         text enough separation, and the soft shadow read as a smudge on bright
         frames. */
      text-shadow: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits { display: block; }
    /* Same width and centring as the lyrics column below, so the meta block's
       left edge and the artwork's right edge both line up with the lyrics. */
    .ym-sl-fs-hits-inner {
      width: min(900px, calc(100% - 2 * clamp(24px, 4.5vw, 64px)));
      margin: 0 auto;
      padding-top: clamp(24px, 3.2vh, 38px);
      box-sizing: border-box;
    }
    .ym-sl-fs-hits-head {
      display: flex;
      align-items: flex-start;
      gap: clamp(16px, 2vw, 28px);
    }
    .ym-sl-fs-hits-artwrap {
      position: relative;
      flex: 0 0 auto;
      width: clamp(92px, 10.5vw, 148px);
      aspect-ratio: 1;
      border-radius: 16px;
      overflow: hidden;
      background: rgba(255, 255, 255, .06);
      box-shadow: 0 18px 50px rgba(0, 0, 0, .48), inset 0 0 0 1px rgba(255, 255, 255, .08);
      transition: opacity .3s ease, border-radius .25s ease;
    }
    .ym-sl-fs-hits-artwrap.is-empty { opacity: 0; }
    .ym-sl-fs-hits-art {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Hits: the artwork's hover cluster moves onto the header card. Only the
       two layout affordances — swap the columns, and the stage. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-artwrap > .ym-sl-fs-art-ui {
      display: flex;
      position: absolute;
      inset: 0;
      z-index: 2;
      align-items: flex-start;
      justify-content: space-between;
      gap: 4px;
      padding: 5px;
      box-sizing: border-box;
      background: transparent;
      opacity: 0;
      transition: opacity .16s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-artwrap:hover > .ym-sl-fs-art-ui,
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-artwrap > .ym-sl-fs-art-ui:focus-within {
      opacity: 1;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-artwrap > .ym-sl-fs-art-ui .ym-sl-fs-art-swap {
      position: static;
      flex: none;
      width: 26px;
      height: 26px;
      min-width: 26px;
      transform: none;
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-artwrap > .ym-sl-fs-art-ui .ym-sl-fs-art-swap-icon {
      width: 15px;
      height: 15px;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-artwrap > .ym-sl-fs-art-ui .ym-sl-fs-art-like {
      display: none;
    }
    /* Animated cover inside the Hits card (the add-on reparents its one host
       between this card, the stage pane and the page square). */
    .ym-sl-fs-hits-artwrap > .ym-aa-host {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      z-index: 1;
    }
    .ym-sl-fs-hits-meta {
      flex: 1 1 auto;
      min-width: 0;
      padding-top: 2px;
      text-align: left;
    }
    .ym-sl-fs-hits-title {
      margin: 0;
      font-size: clamp(28px, 3.5vw, 46px);
      font-weight: 800;
      line-height: 1.03;
      letter-spacing: -.035em;
      color: #fff;
      overflow-wrap: anywhere;
    }
    .ym-sl-fs-hits-byline-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
      min-width: 0;
    }
    .ym-sl-fs-hits-byline {
      margin-top: 0;
      min-width: 0;
      flex: 0 1 auto;
      font-size: clamp(13px, 1.25vw, 17px);
      font-weight: 500;
      color: rgba(255, 255, 255, .72);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ym-sl-fs-hits-byline-divider {
      display: none;
      flex: none;
      width: 1px;
      height: 13px;
      background: rgba(255, 255, 255, .2);
    }
    .ym-sl-fs-hits-byline-row.has-writers .ym-sl-fs-hits-byline-divider {
      display: block;
    }
    .ym-sl-fs-hits-writers {
      display: none;
      flex: 0 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: clamp(12px, 1.1vw, 15px);
      font-weight: 500;
      color: rgba(255, 255, 255, .55);
    }
    .ym-sl-fs-hits-writers.has-writers { display: block; }
    .ym-sl-fs-hits-chips {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
    }
    /* Attribution folded into the header. Same footer markup as the one under
       the lyrics, but compact and card-free so it reads as part of the track
       details instead of a second panel. Hits is the one layout where the
       header is the attribution surface for BOTH renderers, so any copy under
       the lyrics is suppressed (see the AMLL rule below). */
    .ym-sl-fs-hits-credits {
      margin-top: 10px;
      max-width: 100%;
      box-sizing: border-box;
      color: rgba(255, 255, 255, .66);
      font-family: "Satoshi", Avenir, -apple-system, BlinkMacSystemFont,
        "Segoe UI", Roboto, sans-serif;
      pointer-events: auto;
      text-align: left;
    }
    .ym-sl-fs-hits-credits:empty { display: none; }
    /* AMLL draws its own footer inside the lyric engine. Hits keeps attribution
       in the header for both renderers, so hide that under-lyrics copy in this
       mode only; every other layout still shows it. */
    body.amll-active .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-lyrics .ym-sl-credits,
    body.amll-active .ym-sl-fs-overlay.ym-sl-fs-mode-hits #ym-sl-amll-host .ym-sl-credits {
      display: none !important;
    }
    /* The original footer stays in the scroll content for every other layout.
       In Hits + Spicy its header copy is the visible one, so the below-lyrics
       copy is suppressed rather than shown twice. */
    body:not(.amll-active) .ym-sl-fs-overlay.ym-sl-fs-mode-hits.ym-sl-fs-hits-has-credits #ym-sl-panel.SpicyRenderer .ym-sl-credits {
      display: none !important;
    }
    .ym-sl-fs-hits-credits .ym-sl-credits {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      gap: 8px;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      overflow: visible;
      pointer-events: none;
      user-select: none;
    }
    .ym-sl-fs-hits-credits .ym-sl-credit-box {
      display: flex;
      flex-direction: column;
      flex: 0 1 auto;
      gap: 3px;
      min-width: 0;
      max-width: 100%;
      padding: 7px 10px;
      box-sizing: border-box;
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 10px;
      background: rgba(255, 255, 255, .04);
    }
    .ym-sl-fs-hits-credits .ym-sl-credit-writers {
      flex: 0 1 auto;
    }
    /* Uploaded by / Made by ride in the chip row, immediately after the provider
       chip. The wrapper and the footer's people box both collapse so the two
       person pills become siblings of the chips. */
    .ym-sl-fs-hits-people,
    .ym-sl-fs-hits-people .ym-sl-credit-people {
      display: contents;
    }
    .ym-sl-fs-hits-people .ym-sl-uploader {
      max-width: 100%;
    }
    .ym-sl-fs-hits-people .ym-sl-uploader-label {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: .005em;
      line-height: 1.25;
      color: rgba(255, 255, 255, .5);
    }
    .ym-sl-fs-hits-people .ym-sl-uploader-link {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-width: 0;
      overflow: hidden;
      color: #fff;
      font-weight: 600;
      text-decoration: none;
    }
    .ym-sl-fs-hits-people .ym-sl-uploader-link.no-link { pointer-events: none; }
    .ym-sl-fs-hits-people .ym-sl-uploader-avatar {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      object-fit: cover;
      flex: none;
      background: rgba(255, 255, 255, .12);
    }
    .ym-sl-fs-hits-people .ym-sl-uploader-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      overflow-wrap: anywhere;
    }
    .ym-sl-fs-hits-people .ym-sl-uploader-arrow {
      display: block;
      width: 9px;
      height: 9px;
      flex: none;
      margin-left: 1px;
      color: #ff5a63;
      opacity: .9;
      transition: transform .18s ease;
    }
    .ym-sl-fs-hits-people .ym-sl-uploader-link:hover .ym-sl-uploader-arrow {
      transform: translate(1px, -1px);
    }
    .ym-sl-fs-hits-credits :is(.ym-sl-credits-label, .ym-sl-provider-label, .ym-sl-uploader-label) {
      margin: 0;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: .005em;
      line-height: 1.25;
      color: rgba(255, 255, 255, .5);
    }
    .ym-sl-fs-hits-credits .ym-sl-credits-names {
      font-size: 12px;
      font-weight: 500;
      line-height: 1.35;
      letter-spacing: -.005em;
      color: rgba(255, 255, 255, .9);
      overflow-wrap: anywhere;
    }
    .ym-sl-fs-hits-credits .ym-sl-credit-writers .ym-sl-credits-names {
      font-size: 14px;
      line-height: 1.3;
      letter-spacing: -.01em;
    }
    .ym-sl-fs-hits-credits :is(.ym-sl-uploader, .ym-sl-provider) {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 5px;
      margin: 0;
      min-width: 0;
      font-size: 12px;
      color: rgba(255, 255, 255, .66);
    }
    .ym-sl-fs-hits-credits .ym-sl-provider-name { color: #fff; font-weight: 500; }
    .ym-sl-fs-hits-credits .ym-sl-provider-icon {
      width: 14px;
      height: 14px;
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-link {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      max-width: 100%;
      min-width: 0;
      padding: 1px 7px 1px 3px;
      border: 1px solid rgba(255, 255, 255, .09);
      border-radius: 999px;
      background: rgba(255, 255, 255, .07);
      color: #fff;
      text-decoration: none;
      transition: background-color .18s ease, border-color .18s ease;
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-link:hover {
      background: rgba(255, 255, 255, .13);
      border-color: rgba(255, 255, 255, .16);
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-link.no-link {
      pointer-events: none;
      background: rgba(255, 255, 255, .05);
      border-color: transparent;
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-avatar {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      object-fit: cover;
      flex: none;
      background: rgba(255, 255, 255, .12);
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-name {
      font-weight: 500;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-arrow {
      display: block;
      width: 9px;
      height: 9px;
      flex: none;
      margin-left: 1px;
      color: #ff5a63;
      opacity: .9;
      transition: transform .18s ease;
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-link:hover .ym-sl-uploader-arrow {
      transform: translate(1px, -1px);
    }
    /* Profiles in the chip row and the credit block answer the pointer with a
       brighter border and a small spring scale. Transform-only, so the row's
       layout never moves. */
    .ym-sl-fs-hits-people .ym-sl-uploader.ym-sl-fs-hits-chip {
      transform-origin: left center;
      transition: background-color .18s ease, border-color .18s ease,
        transform .2s cubic-bezier(.34, 1.56, .64, 1);
    }
    .ym-sl-fs-hits-people .ym-sl-uploader.ym-sl-fs-hits-chip:hover {
      border-color: rgba(255, 255, 255, .38);
      background: rgba(255, 255, 255, .13);
      transform: scale(1.04);
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-link {
      transform-origin: left center;
      transition: background-color .18s ease, border-color .18s ease,
        transform .2s cubic-bezier(.34, 1.56, .64, 1);
    }
    .ym-sl-fs-hits-credits .ym-sl-uploader-link:hover {
      border-color: rgba(255, 255, 255, .38);
      background: rgba(255, 255, 255, .13);
      transform: scale(1.04);
    }
    .ym-sl-fs-hits-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 30px;
      padding: 0 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, .12);
      background: rgba(255, 255, 255, .045);
      color: rgba(255, 255, 255, .86);
      font-size: 12px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: .005em;
      white-space: nowrap;
    }
    .ym-sl-fs-hits-chip-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
    }
    .ym-sl-fs-hits-chip-icon .ym-sl-provider-icon {
      width: 16px;
      height: 16px;
    }
    /* ---- Hits control dock (retired) -------------------------------------
       The nodes stay in the tree for the live state sync, but cover-art Hits
       hides the dock: no seek, transport or volume row. Playback is driven by
       the keyboard, and the header carries only the track details. */
    .ym-sl-fs-hits-dock {
      display: none;
      margin-top: 14px;
      padding: 0;
      box-sizing: border-box;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      color: #fff;
      font-family: "SpicyLyrics", "Noto Sans Georgian", "Vazirmatn",
        "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif;
      pointer-events: auto;
    }
    .ym-sl-fs-hits-seek {
      display: flex;
      align-items: center;
      gap: 9px;
      width: 100%;
      min-width: 0;
    }
    .ym-sl-fs-hits-time {
      flex: 0 0 auto;
      min-width: 32px;
      color: rgba(255, 255, 255, .5);
      font-family: inherit;
      font-size: 10px;
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      letter-spacing: .02em;
      user-select: none;
    }
    .ym-sl-fs-hits-time[data-time="total"] { text-align: right; }
    .ym-sl-fs-hits-range {
      flex: 1 1 auto;
      min-width: 0;
      height: 3px;
      margin: 0;
      border: 0;
      border-radius: 999px;
      background: transparent;
      outline: none;
      appearance: none;
      -webkit-appearance: none;
      cursor: pointer;
    }
    .ym-sl-fs-hits-range:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .5);
      outline-offset: 4px;
    }
    /* The classic seek skin supplies the fill gradient; these make the thumb
       visible without the hidden classic scrubber's hover class. */
    .ym-sl-fs-hits-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 10px;
      height: 10px;
      margin-top: -3.5px;
      border: 0;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .45);
      opacity: .65;
    }
    .ym-sl-fs-hits-range::-moz-range-thumb {
      width: 10px;
      height: 10px;
      border: 0;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .45);
      opacity: .65;
    }
    .ym-sl-fs-hits-dock:hover .ym-sl-fs-hits-range::-webkit-slider-thumb { opacity: 1; }
    .ym-sl-fs-hits-dock:hover .ym-sl-fs-hits-range::-moz-range-thumb { opacity: 1; }
    .ym-sl-fs-hits-dock-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
    }
    .ym-sl-fs-hits-transport {
      display: flex;
      align-items: center;
      gap: 2px;
      flex: 0 0 auto;
    }
    .ym-sl-fs-hits-dock .ym-sl-fs-hits-btn.is-icon {
      width: 34px;
      min-height: 34px;
      padding: 0;
    }
    .ym-sl-fs-hits-transport .ym-sl-fs-hits-btn svg,
    .ym-sl-fs-hits-transport .ym-sl-fs-hits-btn .ym-sl-fs-hits-icon {
      width: 17px;
      height: 17px;
    }
    .ym-sl-fs-hits-volume-group {
      display: flex;
      align-items: center;
      gap: 7px;
      flex: 1 1 100px;
      min-width: 82px;
      max-width: 160px;
    }
    .ym-sl-fs-hits-volume-icon {
      width: 16px;
      height: 16px;
      flex: 0 0 auto;
      display: block;
      color: rgba(255, 255, 255, .58);
      fill: none;
      stroke: currentColor;
    }
    .ym-sl-fs-hits-volume-icon.is-muted { opacity: .45; }
    .ym-sl-fs-hits-volume { max-width: 150px; }
    .ym-sl-fs-hits-btn {
      -webkit-appearance: none;
      appearance: none;
      position: relative;
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 38px;
      padding: 0 12px;
      box-sizing: border-box;
      overflow: visible;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: rgba(255, 255, 255, .84);
      font: inherit;
      font-size: 12.5px;
      font-weight: 500;
      line-height: 1;
      cursor: pointer;
      pointer-events: auto;
      white-space: nowrap;
      text-shadow: none;
      transition: background-color .16s ease, color .16s ease,
        transform .16s ease;
    }
    .ym-sl-fs-hits-btn:hover {
      background: rgba(255, 255, 255, .1);
      color: #fff;
    }
    .ym-sl-fs-hits-btn:active { transform: scale(.96); }
    .ym-sl-fs-hits-btn:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .55);
      outline-offset: 2px;
    }
    .ym-sl-fs-hits-btn.is-icon { width: 38px; padding: 0; }
    .ym-sl-fs-hits-btn.is-on { color: #ffd98a; }
    /* The custom thumb is one closed outline; the pressed state fills it. */
    .ym-sl-fs-hits-btn.is-on .ym-sl-fs-hits-icon path { fill: currentColor; }
    .ym-sl-fs-hits-btn.is-done { color: #9ff0b5; }
    /* Icon-only controls get a floating confirmation; labeled copy buttons
       swap their label instead. */
    .ym-sl-fs-hits-btn[data-flash]::after {
      content: attr(data-flash);
      position: absolute;
      right: 0;
      bottom: calc(100% + 7px);
      z-index: 2;
      padding: 4px 8px;
      border-radius: 7px;
      background: rgba(18, 18, 20, .94);
      color: #fff;
      font-size: 10px;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
      pointer-events: none;
    }
    .ym-sl-fs-hits-btn svg,
    .ym-sl-fs-hits-btn .ym-sl-fs-hits-icon {
      width: 16px;
      height: 16px;
      flex: 0 0 auto;
      display: block;
      fill: none;
      stroke: currentColor;
      transform-origin: center;
      transition: transform .24s cubic-bezier(.34, 1.56, .64, 1);
    }
    .ym-sl-fs-hits-btn svg * { vector-effect: non-scaling-stroke; }
    /* Secondary actions sit in their own row under the metadata chips. They
       reuse the provider-chip box so the old Copy link / Copy lyrics buttons
       read the same as Uploaded by / Made by. */
    .ym-sl-fs-hits-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
    }
    .ym-sl-fs-hits-actions .ym-sl-fs-hits-btn {
      min-height: 30px;
      padding: 0 12px;
      gap: 7px;
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 8px;
      background: rgba(255, 255, 255, .045);
      color: rgba(255, 255, 255, .86);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: .005em;
      transition: background-color .16s ease, border-color .16s ease,
        color .16s ease, transform .16s ease;
    }
    .ym-sl-fs-hits-actions .ym-sl-fs-hits-btn:hover {
      border-color: rgba(255, 255, 255, .38);
      background: rgba(255, 255, 255, .13);
      color: #fff;
    }
    .ym-sl-fs-hits-actions .ym-sl-fs-hits-btn.is-done {
      color: #9ff0b5;
      border-color: rgba(159, 240, 181, .3);
    }
    .ym-sl-fs-hits-actions .ym-sl-fs-hits-btn svg,
    .ym-sl-fs-hits-actions .ym-sl-fs-hits-btn .ym-sl-fs-hits-icon {
      width: 15px;
      height: 15px;
    }
    .ym-sl-fs-hits-actions .ym-sl-fs-hits-btn-label {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* ---- top-right layout control ----------------------------------------
       The old Hits layout button lives at the viewport's top-right; the
       secondary actions now sit in the header row under the chips. */
    .ym-sl-fs-hits-top-utils {
      position: fixed;
      top: clamp(18px, 2.4vh, 28px);
      right: clamp(18px, 2vw, 28px);
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 4px;
      opacity: .72;
      transition: opacity .2s ease;
      pointer-events: auto;
    }
    .ym-sl-fs-hits-top-utils:hover,
    .ym-sl-fs-hits-top-utils:focus-within {
      opacity: 1;
    }
    /* Keep the cluster compact once the header column starts to reach it. */
    @media (max-width: 1400px) {
      .ym-sl-fs-hits-top-utils .ym-sl-fs-hits-layout .ym-sl-fs-hits-btn-label {
        display: none;
      }
      .ym-sl-fs-hits-top-utils .ym-sl-fs-hits-layout {
        width: 34px;
        padding: 0;
        justify-content: center;
      }
    }
    /* ---- lyrics column --------------------------------------------------- */
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-lyrics {
      left: 50% !important;
      top: calc(var(--ym-sl-fs-hits-head-h, 360px) + clamp(16px, 2.6vh, 28px)) !important;
      /* No reserved bottom band: the dock lives in the header flow (or the
         left column for MV), so the column runs all the way to the screen
         edge and only the top mask fades. The old 52px inset + 48px padding
         stacked into ~100px of dead air that read as clipped lyrics. */
      bottom: 0 !important;
      /* The base pane is height:100%; with top+bottom set, that height would
         beat the insets and stop the column ending cleanly at the bottom. */
      height: auto !important;
      width: min(900px, calc(100% - 2 * clamp(24px, 4.5vw, 64px))) !important;
      transform: translateX(-50%) !important;
      padding: 0 !important;
      box-sizing: border-box;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      /* The column starts directly under the header and runs to the bottom
         edge. Only the top fades into the backdrop: the old bottom fade began
         ~30px above the edge and read as lyrics being cut off too early
. Lines now stay lit all the way to the screen edge. */
      -webkit-mask-image: linear-gradient(to bottom,
        transparent 0,
        rgba(0, 0, 0, .35) clamp(14px, 4vh, 34px),
        #000 clamp(56px, 12vh, 104px));
      mask-image: linear-gradient(to bottom,
        transparent 0,
        rgba(0, 0, 0, .35) clamp(14px, 4vh, 34px),
        #000 clamp(56px, 12vh, 104px));
      transition: opacity .35s ease;
    }
    /* The general fullscreen scrollport carries its own mask that fades the
       bottom 18% to transparent. Hits already runs to the screen edge, so that
       inner fade made the last lines dissolve well above the bottom and read
       as clipped. The pane's top-only mask above is the one
       fade Hits keeps; suppress the inner one here. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-lyrics .LyricsContent {
      -webkit-mask-image: none !important;
      mask-image: none !important;
    }

    /* ---- Hits -> Video + Lyrics handoff (cover art) -----------------------
       The header thumbnail becomes a fixed flying card and lands on the side
       artwork's box; the header copy lifts and fades, and the lyrics column
       keeps a real geometry transition instead of snapping right. JS adds this
       class only for the handoff and removes it when the card lands. */
    .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-hits { display: block; }
    .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-hits-meta {
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity .38s ease, transform .38s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-hits-artwrap {
      opacity: 0;
    }
    .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-hits-top-utils {
      opacity: 0;
    }
    .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-hits-btn {
      pointer-events: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-lyrics {
      /* Auto height lets the pane grow with the animated top inset; height:100%
         would jump to its final box on the first frame. */
      height: auto;
      transition:
        left .55s cubic-bezier(.22, .61, .36, 1),
        width .55s cubic-bezier(.22, .61, .36, 1),
        top .55s cubic-bezier(.22, .61, .36, 1),
        transform .55s cubic-bezier(.22, .61, .36, 1),
        padding .55s cubic-bezier(.22, .61, .36, 1),
        opacity .35s ease;
    }
    .ym-sl-fs-art-fly {
      position: fixed;
      z-index: 30;
      display: block;
      transform-origin: top left;
      object-fit: cover;
      border: 0;
      background: #000;
      pointer-events: none;
      will-change: transform;
      backface-visibility: hidden;
      contain: paint;
      box-shadow: none;
    }
    /* ---- Video + Lyrics -> Hits handoff (cover art) -----------------------
       The reverse trip: the side card becomes the flying clone, shrinks into
       the header thumbnail, and the lyrics return to the centred column. The
       header copy fades in while the side chrome fades out. */
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-hits { display: block; }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-hits-meta {
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity .38s ease, transform .38s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits.ym-sl-fs-mode-hits .ym-sl-fs-hits-meta {
      opacity: 1;
      transform: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-hits-artwrap {
      /* No opacity transition: the clone is the only cover until it lands,
         then the real thumbnail appears in the same frame. */
      visibility: hidden;
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-hits-top-utils {
      opacity: 0;
      transition: opacity .32s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits.ym-sl-fs-mode-hits .ym-sl-fs-hits-top-utils {
      opacity: .72;
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-hits-btn {
      pointer-events: none;
    }
    /* Hits normally hides the classic chrome. Keep it in the tree for the
       reverse handoff so the side title/controls fade out instead of blinking
       away under the incoming header. */
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-controls,
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-player-controls {
      display: flex !important;
      opacity: 1;
      pointer-events: none;
      transition: opacity .32s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-title {
      display: block !important;
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits.ym-sl-fs-mode-hits .ym-sl-fs-controls,
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits.ym-sl-fs-mode-hits .ym-sl-fs-player-controls {
      opacity: 0;
    }
    .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-lyrics {
      height: auto;
      transition:
        left .55s cubic-bezier(.22, .61, .36, 1),
        width .55s cubic-bezier(.22, .61, .36, 1),
        top .55s cubic-bezier(.22, .61, .36, 1),
        transform .55s cubic-bezier(.22, .61, .36, 1),
        padding .55s cubic-bezier(.22, .61, .36, 1),
        opacity .35s ease;
    }
    /* Spicy is real DOM text: animating the column's width, padding or height
       rewraps every line on every frame of the handoff, which is the panel-only
       stutter. 07 adds this class and FLIPs a transform from the old box instead;
       disabling the geometry transition lets the final layout land in one frame.
       AMLL is a canvas and keeps the full geometry glide. */
    body:not(.amll-active) .ym-sl-fs-overlay.ym-sl-fs-lyrics-flip .ym-sl-fs-lyrics {
      transition: none !important;
    }
    /* Hits entrance. The header is display:none until the mode class lands, so
       a normal transition has no first painted frame to start from and the
       title/buttons just appear. A keyframe animation starts from the explicit
       0 state once the header is shown, which gives the reverse handoff a real
       fade-in instead of a pop. */
    @keyframes ym-sl-fs-hits-fade-in {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-meta > * {
      animation: ym-sl-fs-hits-fade-in .42s cubic-bezier(.22, .61, .36, 1) both;
    }
    @media (prefers-reduced-motion: reduce) {
      .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-hits-meta,
      .ym-sl-fs-overlay.ym-sl-fs-hits-to-side .ym-sl-fs-lyrics,
      .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-hits-meta,
      .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-lyrics,
      .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-controls,
      .ym-sl-fs-overlay.ym-sl-fs-side-to-hits .ym-sl-fs-player-controls {
        transition: none;
      }
      .ym-sl-fs-overlay.ym-sl-fs-mode-hits .ym-sl-fs-hits-meta > * {
        animation: none;
      }
    }

    @media (max-width: 860px) {
      .ym-sl-fs-hits-inner { padding-top: 20px; }
      .ym-sl-fs-hits-head { align-items: center; gap: 16px; }
      .ym-sl-fs-hits-artwrap { width: 84px; border-radius: 12px; }
      .ym-sl-fs-hits-title { font-size: clamp(24px, 5.8vw, 34px); }
      .ym-sl-fs-hits-byline-row { margin-top: 6px; gap: 8px; }
      .ym-sl-fs-hits-chips { margin-top: 10px; gap: 6px; }
      .ym-sl-fs-hits-credits { margin-top: 10px; }
      .ym-sl-fs-hits-chip { min-height: 26px; padding: 0 9px; font-size: 11px; }
      .ym-sl-fs-hits-actions { margin-top: 12px; gap: 6px; }
      .ym-sl-fs-hits-btn { min-height: 34px; padding: 0 11px; font-size: 12px; }
      .ym-sl-fs-hits-btn.is-icon { width: 34px; padding: 0; }
      .ym-sl-fs-hits-dock { margin-top: 12px; }
      .ym-sl-fs-hits-dock .ym-sl-fs-hits-btn.is-icon { width: 32px; min-height: 32px; }
    }
    @media (max-height: 760px) {
      .ym-sl-fs-hits-inner { padding-top: 20px; }
      .ym-sl-fs-hits-artwrap { width: clamp(76px, 9vw, 104px); }
      .ym-sl-fs-hits-title { font-size: clamp(26px, 3vw, 38px); }
      .ym-sl-fs-hits-credits { margin-top: 8px; }
      .ym-sl-fs-hits-actions { margin-top: 10px; }
      .ym-sl-fs-hits-dock { margin-top: 12px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ym-sl-fs-hits-btn,
      .ym-sl-fs-hits-artwrap { transition: none; }
      .ym-sl-fs-hits-actions .ym-sl-fs-hits-btn { transition: none; }
      .ym-sl-fs-hits-btn:active { transform: none; }
      .ym-sl-fs-hits-btn svg,
      .ym-sl-fs-hits-btn .ym-sl-fs-hits-icon { transition: none; }
      .ym-sl-fs-hits-btn:hover,
      .ym-sl-fs-hits-btn:hover svg,
      .ym-sl-fs-hits-btn:hover .ym-sl-fs-hits-icon,
      .ym-sl-fs-hits-btn:active svg,
      .ym-sl-fs-hits-btn:active .ym-sl-fs-hits-icon { transform: none; }
      .ym-sl-fs-hits-people .ym-sl-uploader.ym-sl-fs-hits-chip,
      .ym-sl-fs-hits-credits .ym-sl-uploader-link { transition: none; }
      .ym-sl-fs-hits-people .ym-sl-uploader.ym-sl-fs-hits-chip:hover,
      .ym-sl-fs-hits-credits .ym-sl-uploader-link:hover { transform: none; }
    }

    /* ===== Options, rebuilt as a scrolling card ==========================
       The add-ons panel's split, reused here: one rail, one scrolling pane,
       and a single red marker that slides between rows. The shell is fixed
       size and the pane scrolls; no page height is measured or animated.
       Scoped to .ym-sl-op2 so the older Options rules cannot leak in. */
    .ym-sl-options-overlay.ym-sl-op2 {
      --op-panel: #17171a;
      --op-panel-top: #1b1b1f;
      --op-text: rgba(255, 255, 255, .92);
      --op-body: rgba(255, 255, 255, .85);
      --op-muted: rgba(255, 255, 255, .55);
      --op-dim: rgba(255, 255, 255, .4);
      --op-line: rgba(255, 255, 255, .07);
      --op-line-strong: rgba(255, 255, 255, .1);
      --op-surface: rgba(255, 255, 255, .05);
      --op-surface-hover: rgba(255, 255, 255, .08);
      --op-red: #e01040;
      --op-red-soft: #ff4d6a;
      --op-red-wash: rgba(224, 16, 64, .12);
      --op-ease: cubic-bezier(.22, 1, .36, 1);
      --op-ease-reel: cubic-bezier(.32, .72, 0, 1);
      position: fixed;
      top: 88px;
      right: 24px;
      bottom: auto;
      left: auto;
      z-index: 2147483200;
      display: block;
      width: min(640px, calc(100vw - 32px));
      height: min(480px, calc(100vh - 112px));
      max-width: none;
      max-height: none;
      padding: 0;
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
      color: var(--op-text);
      font-family: "Satoshi", Avenir, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 14px;
      line-height: 1.45;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity .2s ease, visibility 0s linear 0s;
    }
    .ym-sl-options-overlay.ym-sl-op2.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: none;
      transition: opacity .16s ease, visibility 0s linear .16s;
    }
    .ym-sl-options-overlay.ym-sl-op2,
    .ym-sl-options-overlay.ym-sl-op2 *,
    .ym-sl-options-overlay.ym-sl-op2 *::before,
    .ym-sl-options-overlay.ym-sl-op2 *::after {
      box-sizing: border-box;
    }
    .ym-sl-options-overlay.ym-sl-op2 button,
    .ym-sl-options-overlay.ym-sl-op2 input {
      font: inherit;
    }

    .ym-sl-op-shell {
      display: grid;
      grid-template-columns: minmax(196px, 220px) minmax(0, 1fr);
      grid-template-rows: 60px minmax(0, 1fr);
      width: 100%;
      height: 100%;
      min-height: 0;
      overflow: hidden;
      border-radius: 18px;
      background: linear-gradient(180deg, var(--op-panel-top) 0%, #161619 100%);
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, .08),
        0 48px 120px -48px rgba(0, 0, 0, .92);
      color: var(--op-text);
      opacity: 1;
      transform: none;
      transition: transform .34s var(--op-ease), opacity .22s ease;
    }
    .ym-sl-options-overlay.ym-sl-op2.hidden .ym-sl-op-shell {
      opacity: 0;
      transform: translateY(14px) scale(.985);
    }

    .ym-sl-op-head {
      grid-column: 1 / -1;
      grid-row: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 18px 0 22px;
      border-bottom: 1px solid var(--op-line);
      cursor: grab;
      user-select: none;
      touch-action: none;
    }
    .ym-sl-op-head:active { cursor: grabbing; }
    .ym-sl-op-brand {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }
    .ym-sl-op-mark {
      width: 32px;
      height: 32px;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--op-red-wash);
      box-shadow: inset 0 0 0 1px rgba(224, 16, 64, .18);
      color: var(--op-red-soft);
    }
    .ym-sl-op-mark svg {
      width: 16px;
      height: 16px;
    }
    .ym-sl-op-brandcopy {
      display: grid;
      gap: 1px;
      min-width: 0;
    }
    .ym-sl-op-title {
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -.01em;
      line-height: 1.25;
    }
    .ym-sl-op-close {
      width: 34px;
      height: 34px;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      padding: 0;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: var(--op-muted);
      cursor: pointer;
      transition: background .15s ease, color .15s ease, scale .15s ease;
    }
    .ym-sl-op-close:hover {
      background: var(--op-surface-hover);
      color: #fff;
    }
    .ym-sl-op-close:active { scale: .96; }
    .ym-sl-op-close svg {
      width: 16px;
      height: 16px;
    }

    .ym-sl-op-body { display: contents; }

    .ym-sl-op-rail {
      grid-column: 1;
      grid-row: 2;
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 18px 12px 14px;
      border-right: 1px solid var(--op-line);
      background: rgba(255, 255, 255, .018);
    }
    .ym-sl-op-railhead {
      padding: 0 12px 10px;
      color: var(--op-dim);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: .12em;
      line-height: 1.2;
      text-transform: uppercase;
    }
    .ym-sl-op-tabs {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    .ym-sl-op-ind {
      position: absolute;
      top: 0;
      left: 3px;
      width: 2px;
      height: 0;
      /* Square on the pane-facing right edge; the two left corners follow the
         rail's rounded edge instead of making the whole marker a capsule. */
      border-radius: 2px 0 0 2px;
      background: var(--op-red);
      opacity: 0;
      pointer-events: none;
      transition: opacity .18s linear;
    }
    .ym-sl-op-ind.ready {
      /* Height snaps; only the glide between rows animates. The rows share one
         height, so animating height only ever left the marker trailing the tab
         while a font swap settled. */
      transition:
        transform .32s var(--op-ease-reel),
        opacity .18s linear;
    }
    .ym-sl-op-tab {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr);
      align-items: center;
      gap: 11px;
      width: 100%;
      padding: 11px 12px 11px 15px;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: var(--op-muted);
      text-align: left;
      cursor: pointer;
      transition: background .16s ease, color .16s ease, box-shadow .16s ease;
    }
    .ym-sl-op-tab:hover {
      background: rgba(255, 255, 255, .035);
      color: var(--op-text);
    }
    .ym-sl-op-tab.is-active {
      background: var(--op-surface);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .055);
      color: var(--op-text);
    }
    .ym-sl-op-tabicon {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      background: rgba(255, 255, 255, .045);
      color: var(--op-muted);
      transition: background .18s ease, color .18s ease, box-shadow .18s ease;
    }
    .ym-sl-op-tabicon svg {
      width: 16px;
      height: 16px;
    }
    .ym-sl-op-tab.is-active .ym-sl-op-tabicon {
      background: var(--op-red-wash);
      box-shadow: inset 0 0 0 1px rgba(224, 16, 64, .18);
      color: var(--op-red-soft);
    }
    .ym-sl-op-tabcopy {
      display: grid;
      gap: 2px;
      min-width: 0;
    }
    .ym-sl-op-tabcopy strong {
      overflow: hidden;
      color: inherit;
      font-size: 13px;
      font-weight: 650;
      letter-spacing: -.005em;
      line-height: 1.25;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .ym-sl-op-tabcopy small {
      overflow: hidden;
      color: var(--op-dim);
      font-size: 11px;
      font-weight: 400;
      line-height: 1.3;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .ym-sl-op-tab.is-active .ym-sl-op-tabcopy small { color: var(--op-muted); }
    .ym-sl-op-railfoot {
      margin-top: auto;
      padding: 14px 12px 4px;
      color: var(--op-dim);
      font-size: 11px;
      line-height: 1.45;
    }

    .ym-sl-op-pane {
      position: relative;
      grid-column: 2;
      grid-row: 2;
      display: flex;
      min-width: 0;
      min-height: 0;
      background: rgba(255, 255, 255, .008);
    }
    .ym-sl-op-pane::before,
    .ym-sl-op-pane::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      z-index: 2;
      height: 28px;
      opacity: 0;
      pointer-events: none;
      transition: opacity .18s ease;
    }
    .ym-sl-op-pane::before {
      top: 0;
      background: linear-gradient(180deg, #19191c 0%, rgba(25, 25, 28, 0) 100%);
    }
    .ym-sl-op-pane::after {
      bottom: 0;
      background: linear-gradient(0deg, #161619 0%, rgba(22, 22, 25, 0) 100%);
    }
    .ym-sl-op-pane.has-top::before,
    .ym-sl-op-pane.has-bottom::after { opacity: 1; }
    .ym-sl-op-scroll {
      flex: 1;
      min-width: 0;
      min-height: 0;
      overflow-x: hidden;
      overflow-y: auto;
      padding: 24px 28px 30px;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .ym-sl-op-scroll::-webkit-scrollbar { display: none; }
    .ym-sl-op-reel {
      position: relative;
      max-width: 640px;
    }
    .ym-sl-op-page {
      display: grid;
      gap: 18px;
    }
    .ym-sl-op-page[hidden] { display: none !important; }
    /* Chrome can leave the active page inheriting the overlay's hidden
       visibility after a fast close/open or page swap. The page then keeps
       display:grid and full height while painting nothing. Re-assert the
       visible value whenever the overlay is open. */
    .ym-sl-options-overlay.ym-sl-op2:not(.hidden) .ym-sl-op-page:not([hidden]) {
      visibility: visible !important;
    }
    .ym-sl-op-pagehead {
      display: grid;
      gap: 6px;
      padding: 0 2px;
    }
    .ym-sl-op-pagetitle {
      margin: 0;
      color: #fff;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -.025em;
      line-height: 1.15;
    }
    .ym-sl-op-pagesub {
      max-width: 58ch;
      margin: 0;
      color: var(--op-muted);
      font-size: 12.5px;
      line-height: 1.55;
    }
    .ym-sl-op-card {
      display: grid;
      gap: 13px;
      padding: 16px 16px 18px;
      border-radius: 14px;
      background: rgba(255, 255, 255, .032);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .065);
    }
    .ym-sl-op-cardhead {
      display: grid;
      gap: 3px;
    }
    .ym-sl-op-cardtitle {
      margin: 0;
      color: var(--op-text);
      font-size: 13.5px;
      font-weight: 650;
      letter-spacing: -.005em;
      line-height: 1.3;
    }
    .ym-sl-op-cardcopy {
      margin: 0;
      color: var(--op-dim);
      font-size: 11.5px;
      line-height: 1.5;
    }

    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset {
      display: grid;
      grid-template-columns: auto minmax(80px, 1fr) 64px 52px auto;
      align-items: center;
      gap: 10px;
      width: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      color: var(--op-muted);
      font-size: 12px;
      line-height: 1.2;
      white-space: normal;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset input[type="range"] {
      width: 100%;
      min-width: 0;
      accent-color: var(--op-red);
      cursor: pointer;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset .ym-sl-offset-number {
      width: 64px;
      height: 34px;
      padding: 0 8px;
      border: 0;
      border-radius: 8px;
      outline: none;
      background: rgba(255, 255, 255, .055);
      box-shadow: inset 0 0 0 1px var(--op-line);
      color: #fff;
      font-size: 12px;
      font-variant-numeric: tabular-nums;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset .ym-sl-offset-number:focus {
      box-shadow: inset 0 0 0 1px rgba(224, 16, 64, .55);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset .ym-sl-video-offset-value {
      min-width: 0;
      color: var(--op-text);
      font-size: 12px;
      font-variant-numeric: tabular-nums;
      text-align: right;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset .ym-sl-offset-applied {
      justify-self: end;
      padding: 3px 7px;
      border-radius: 999px;
      background: var(--op-red-wash);
      color: #ff8a9c;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset {
      gap: 10px;
      margin: 0;
      padding: 0;
      border: 0;
    }
    /* The shared-offset controls now live in the same card as the track
       offset, separated by a rule instead of a second frosted card. */
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-card > .ym-sl-community-offset {
      margin-top: 1px;
      padding-top: 16px;
      border-top: 1px solid var(--op-line);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-head .ym-sl-options-section-title {
      padding: 0;
      color: var(--op-dim);
      font-size: 11px;
      letter-spacing: .08em;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-badge {
      padding: 2px 7px;
      background: rgba(63, 224, 197, .1);
      color: rgba(63, 224, 197, .9);
      font-size: 9px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-status {
      color: var(--op-muted);
      font-size: 12px;
      line-height: 1.5;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-status[data-state="shared"],
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-status[data-state="owned"] {
      color: var(--op-body);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-status[data-state="error"] {
      color: #ff9a8c;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-account {
      min-height: 40px;
      padding: 6px 10px;
      border: 0;
      border-radius: 9px;
      background: rgba(255,255,255,.04);
      box-shadow: inset 0 0 0 1px var(--op-line);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-avatar {
      width: 26px;
      height: 26px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-accountname {
      color: var(--op-text);
      font-size: 12px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-accountmeta {
      color: var(--op-dim);
      font-size: 9px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-name {
      width: 100%;
      height: 36px;
      padding: 0 11px;
      border: 0;
      border-radius: 9px;
      outline: none;
      background: rgba(255, 255, 255, .04);
      box-shadow: inset 0 0 0 1px var(--op-line);
      color: #fff;
      font-size: 12px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-name::placeholder {
      color: var(--op-dim);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-name:focus-visible {
      border-color: transparent;
      box-shadow: inset 0 0 0 1px rgba(224, 16, 64, .55);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-btn {
      min-height: 34px;
      padding: 0 13px;
      border: 0;
      border-radius: 9px;
      background: rgba(255, 255, 255, .06);
      box-shadow: inset 0 0 0 1px var(--op-line);
      color: var(--op-text);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: background .15s ease, box-shadow .15s ease, color .15s ease;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-btn:hover {
      background: rgba(255, 255, 255, .09);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .18);
      color: #fff;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-post {
      background: rgba(224, 16, 64, .16);
      box-shadow: inset 0 0 0 1px rgba(224, 16, 64, .32);
      color: #ff9aac;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-post:hover {
      background: rgba(224, 16, 64, .24);
      box-shadow: inset 0 0 0 1px rgba(224, 16, 64, .46);
      color: #ffd0d8;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-report {
      background: rgba(255, 120, 105, .12);
      box-shadow: inset 0 0 0 1px rgba(255, 120, 105, .2);
      color: #ffb4a8;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-btn:disabled {
      opacity: .45;
      cursor: default;
    }

    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-segmented {
      display: flex;
      width: 100%;
      padding: 3px;
      border: 0;
      border-radius: 10px;
      background: rgba(0, 0, 0, .24);
      box-shadow: inset 0 0 0 1px var(--op-line);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-segmented-option {
      flex: 1 1 0;
      min-height: 32px;
      padding: 0 12px;
      border-radius: 8px;
      color: var(--op-muted);
      font-size: 12px;
      text-align: center;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-segmented-option:hover {
      color: #fff;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-segmented-option.active {
      background: rgba(255, 255, 255, .92);
      color: #141416;
      font-weight: 650;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-import {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: 0 14px;
      border: 0;
      border-radius: 10px;
      background: rgba(255, 255, 255, .06);
      box-shadow: inset 0 0 0 1px var(--op-line);
      color: var(--op-text);
      font-size: 12.5px;
      font-weight: 600;
      text-align: center;
      cursor: pointer;
      transition: background .15s ease, box-shadow .15s ease, color .15s ease, transform .12s ease;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-import:hover {
      background: rgba(255, 255, 255, .09);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .18);
      color: #fff;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-import:active {
      transform: scale(.97);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-import:disabled {
      opacity: .38;
      cursor: not-allowed;
      transform: none;
    }
    /* The new button rule is more specific than the old .hidden rules, and it
       sets display. Without these, Delete saved, Export, the per-song cache
       action and the cache confirmation could all paint while still marked
       hidden. Keep every conditional control genuinely out of the layout. */
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-import.hidden,
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-file-note.hidden,
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-export-actions.hidden,
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-confirm.hidden,
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-account.hidden,
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-name.hidden,
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-community-offset-btn.hidden {
      display: none !important;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-op-btn-primary {
      background: var(--op-red);
      box-shadow: none;
      color: #fff;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-op-btn-primary:hover {
      background: #c80e39;
      box-shadow: none;
      color: #fff;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-options-file-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-options-file-actions:has(.ym-sl-delete-permanent-button.hidden) {
      grid-template-columns: 1fr;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-options-file-actions .ym-sl-import {
      width: 100%;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-export-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 0;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-export-actions .ym-sl-import {
      width: 100%;
      min-width: 0;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-file-note {
      padding: 0 2px;
      color: var(--op-muted);
      font-size: 11.5px;
      line-height: 1.5;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-song-cache-status.pending {
      color: var(--op-text);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-song-cache-clear {
      width: 100%;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-section {
      gap: 12px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-status {
      padding: 0 2px;
      color: var(--op-muted);
      font-size: 12px;
      line-height: 1.5;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-clear {
      justify-self: start;
      align-self: flex-start;
      background: rgba(255, 255, 255, .06);
      box-shadow: inset 0 0 0 1px var(--op-line);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-confirm {
      gap: 10px;
      padding: 12px;
      border: 1px solid rgba(224, 16, 64, .28);
      border-radius: 12px;
      background: rgba(224, 16, 64, .09);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-confirm-text {
      color: var(--op-body);
      font-size: 12px;
      line-height: 1.5;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-confirm-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-delete {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 34px;
      padding: 0 13px;
      border: 0;
      border-radius: 9px;
      background: var(--op-red);
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-delete:hover { background: #c80e39; }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-delete:disabled {
      opacity: .55;
      cursor: default;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-trash-icon {
      width: 15px;
      height: 15px;
      display: block;
      fill: currentColor;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-cancel {
      min-height: 34px;
      padding: 0 13px;
      border: 0;
      border-radius: 9px;
      background: rgba(255, 255, 255, .07);
      box-shadow: inset 0 0 0 1px var(--op-line);
      color: var(--op-text);
      font-size: 12px;
      cursor: pointer;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-cancel:hover {
      background: rgba(255, 255, 255, .1);
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-cache-cancel:disabled {
      opacity: .5;
      cursor: default;
    }

    .ym-sl-options-overlay.ym-sl-op2 button:focus-visible,
    .ym-sl-options-overlay.ym-sl-op2 input:focus-visible,
    .ym-sl-options-overlay.ym-sl-op2 [tabindex]:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .38);
      outline-offset: 2px;
    }
    .ym-sl-options-overlay.ym-sl-op2 .ym-sl-video-offset input[type="range"]:focus-visible {
      outline-offset: 4px;
    }

    /* The same shell in PiP: a normal block inside the floating window, with
       the rail flattened to a row and the pane capped so the window keeps its
       own scroll. The header is the floating card's drag handle, not useful
       here, so it goes away. */
    .ym-sl-options-overlay.ym-sl-op2.ym-sl-options-docked {
      position: relative !important;
      inset: auto !important;
      z-index: auto !important;
      display: block;
      width: 100%;
      max-width: 620px;
      height: auto;
      max-height: none;
      margin: 0 auto 4px;
      padding: 0;
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none !important;
    }
    .ym-sl-options-overlay.ym-sl-op2.ym-sl-options-docked.hidden {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none !important;
    }
    .ym-sl-options-docked .ym-sl-op-shell {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
      min-height: 0;
      max-height: none;
      border-radius: 14px;
      background: rgba(255, 255, 255, .035);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08);
    }
    .ym-sl-options-docked .ym-sl-op-head { display: none; }
    .ym-sl-options-docked .ym-sl-op-body {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .ym-sl-options-docked .ym-sl-op-rail {
      display: block;
      padding: 8px;
      border-right: 0;
      border-bottom: 1px solid var(--op-line);
      background: transparent;
    }
    .ym-sl-options-docked .ym-sl-op-railhead,
    .ym-sl-options-docked .ym-sl-op-railfoot,
    .ym-sl-options-docked .ym-sl-op-ind { display: none; }
    .ym-sl-options-docked .ym-sl-op-tabs {
      flex-direction: row;
      gap: 3px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .ym-sl-options-docked .ym-sl-op-tabs::-webkit-scrollbar { display: none; }
    .ym-sl-options-docked .ym-sl-op-tab {
      grid-template-columns: auto;
      width: auto;
      min-width: max-content;
      padding: 7px 10px;
      border-radius: 8px;
    }
    .ym-sl-options-docked .ym-sl-op-tabicon { display: none; }
    .ym-sl-options-docked .ym-sl-op-tabcopy small { display: none; }
    .ym-sl-options-docked .ym-sl-op-tabcopy strong { font-size: 12px; }
    .ym-sl-options-docked .ym-sl-op-pane {
      display: block;
      min-height: 0;
    }
    .ym-sl-options-docked .ym-sl-op-pane::before,
    .ym-sl-options-docked .ym-sl-op-pane::after { display: none; }
    .ym-sl-options-docked .ym-sl-op-scroll {
      max-height: 46vh;
      padding: 16px 14px 18px;
    }
    .ym-sl-options-docked .ym-sl-op-reel { max-width: none; }
    .ym-sl-options-docked .ym-sl-op-pagetitle { font-size: 18px; }
    .ym-sl-options-docked .ym-sl-op-pagesub { font-size: 11.5px; }
    .ym-sl-options-docked .ym-sl-op-card {
      gap: 10px;
      padding: 12px;
      border-radius: 11px;
    }
    .ym-sl-options-docked .ym-sl-op-page .ym-sl-video-offset {
      grid-template-columns: auto minmax(60px, 1fr) 60px;
      row-gap: 8px;
    }
    .ym-sl-options-docked .ym-sl-op-page .ym-sl-video-offset .ym-sl-video-offset-value {
      grid-column: 2;
      text-align: left;
    }
    .ym-sl-options-docked .ym-sl-op-page .ym-sl-video-offset .ym-sl-offset-applied {
      grid-column: 3;
      justify-self: end;
    }
    .ym-sl-options-docked .ym-sl-options-file-actions,
    .ym-sl-options-docked .ym-sl-export-actions { grid-template-columns: 1fr; }

    @media (max-width: 780px) {
      .ym-sl-options-overlay.ym-sl-op2 {
        top: 64px;
        right: 10px;
        width: calc(100vw - 20px);
        height: calc(100vh - 84px);
        padding: 0;
      }
      .ym-sl-op-shell {
        grid-template-columns: 1fr;
        grid-template-rows: 60px auto minmax(0, 1fr);
        width: 100%;
        height: 100%;
        min-height: 0;
        border-radius: 18px;
      }
      .ym-sl-op-head { padding: 0 12px 0 16px; }
      .ym-sl-op-rail {
        flex-direction: row;
        align-items: center;
        padding: 8px 10px;
        overflow: hidden;
        border-right: 0;
        border-bottom: 1px solid var(--op-line);
      }
      .ym-sl-op-railhead,
      .ym-sl-op-railfoot,
      .ym-sl-op-ind { display: none; }
      .ym-sl-op-tabs {
        flex-direction: row;
        gap: 4px;
        width: 100%;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .ym-sl-op-tabs::-webkit-scrollbar { display: none; }
      .ym-sl-op-tab {
        grid-template-columns: 20px auto;
        gap: 7px;
        width: auto;
        min-width: max-content;
        padding: 7px 10px;
        border-radius: 9px;
      }
      .ym-sl-op-tabicon {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        background: transparent;
      }
      .ym-sl-op-tabicon svg { width: 14px; height: 14px; }
      .ym-sl-op-tabcopy small { display: none; }
      .ym-sl-op-tabcopy strong { font-size: 12.5px; }
      .ym-sl-op-pane {
        grid-column: 1;
        grid-row: 3;
      }
      .ym-sl-op-scroll { padding: 22px 20px 28px; }
      .ym-sl-op-pagetitle { font-size: 22px; }
      .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset {
        grid-template-columns: auto minmax(60px, 1fr) 64px;
        row-gap: 10px;
      }
      .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset .ym-sl-video-offset-value {
        grid-column: 2;
        text-align: left;
      }
      .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-video-offset .ym-sl-offset-applied {
        grid-column: 3;
        justify-self: end;
      }
    }
    @media (max-width: 480px) {
      .ym-sl-options-overlay.ym-sl-op2 {
        top: 56px;
        right: 8px;
        width: calc(100vw - 16px);
        height: calc(100vh - 72px);
      }
      .ym-sl-op-shell {
        grid-template-rows: 58px auto minmax(0, 1fr);
        width: 100%;
        height: 100%;
        min-height: 0;
        border-radius: 15px;
      }
      .ym-sl-op-scroll { padding: 18px 14px 24px; }
      .ym-sl-op-page { gap: 14px; }
      .ym-sl-op-pagetitle { font-size: 20px; }
      .ym-sl-op-card { padding: 14px; border-radius: 12px; }
      .ym-sl-op-brand { gap: 9px; }
      .ym-sl-op-mark { width: 30px; height: 30px; }
      .ym-sl-options-overlay.ym-sl-op2 .ym-sl-options-file-actions,
      .ym-sl-options-overlay.ym-sl-op2 .ym-sl-export-actions { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ym-sl-op-shell,
      .ym-sl-op-close,
      .ym-sl-op-tab,
      .ym-sl-op-tabicon,
      .ym-sl-op-ind,
      .ym-sl-op-ind.ready,
      .ym-sl-op-scroll,
      .ym-sl-options-overlay.ym-sl-op2,
      .ym-sl-options-overlay.ym-sl-op2.hidden {
        transition: none;
      }
      .ym-sl-options-overlay.ym-sl-op2.hidden .ym-sl-op-shell { transform: none; }
      .ym-sl-options-overlay.ym-sl-op2 .ym-sl-op-page .ym-sl-import:active,
      .ym-sl-op-close:active { transform: none; }
    }

    /* ---- stage layout (07-fullscreen-layout) -----------------------------
       Cover art stops being a card: it fills the overlay's full height on its
       side and dissolves into the Kawarp behind it. COVER ART ONLY — every rule
       is gated on :not(.ym-sl-fs-has-video), so a music video keeps its own
       layout and its saved side untouched.

       The blend is a MASK, not a fade to transparent, and it uses eased stops
       (Spicy's recipe): a straight ramp leaves a visible line where the picture
       reaches full strength. One mask per element, so the side feather lives on
       the pane and the top feather on the picture itself. */
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background):not(.ym-sl-fs-mode-hits) .ym-sl-fs-media {
      left: 0;
      right: auto;
      top: 0;
      bottom: 0;
      width: 52vw;
      height: 100%;
      max-height: none;
      border-radius: 0;
      -webkit-mask-image: linear-gradient(to right, #000 0, #000 58%, rgba(0,0,0,.85) 70%, rgba(0,0,0,.36) 82%, rgba(0,0,0,.10) 92%, transparent 100%);
      mask-image: linear-gradient(to right, #000 0, #000 58%, rgba(0,0,0,.85) 70%, rgba(0,0,0,.36) 82%, rgba(0,0,0,.10) 92%, transparent 100%);
    }
    /* Cover on the right: mirror the feather.
       The pane is moved with left (52vw wide at 48vw = the right edge), NOT
       with right:0 / left:auto. 'auto' has nothing to interpolate from, so the
       side switch snapped the artwork across the screen instead of gliding it
       - the stage's own feather then had to jump with it. */
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background):not(.ym-sl-fs-mode-hits) .ym-sl-fs-media {
      left: 48vw;
      right: auto;
      -webkit-mask-image: linear-gradient(to left, #000 0, #000 58%, rgba(0,0,0,.85) 70%, rgba(0,0,0,.36) 82%, rgba(0,0,0,.10) 92%, transparent 100%);
      mask-image: linear-gradient(to left, #000 0, #000 58%, rgba(0,0,0,.85) 70%, rgba(0,0,0,.36) 82%, rgba(0,0,0,.10) 92%, transparent 100%);
    }
    /* The picture fills the pane, with a top feather so it rises out of the
       backdrop instead of starting on a hard edge. */
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art,
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-aa-host {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 0;
      object-fit: cover;
      object-position: 50% 50%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, rgba(0,0,0,.28) 9%, #000 18%);
      mask-image: linear-gradient(to bottom, transparent 0, rgba(0,0,0,.28) 9%, #000 18%);
    }
    /* Stage: the buttons are part of the composition, always on top of the
       picture. A full-height artwork has no hover margin at its top edge —
       moving the pointer up to the buttons crossed the boundary, :hover ended
       and the cluster vanished mid-click. */
    .ym-sl-fs-overlay.ym-sl-fs-stage .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-swap {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity .4s ease,
        background .15s ease,
        border-color .15s ease;
    }
    /* Idle (the existing "pointer stopped" state that already hides the queue and
       the chrome): the buttons stay put but recede, and any movement brings them
       back on the same .4s curve. */
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-idle .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-swap {
      opacity: .28;
    }
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-idle .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-swap:hover,
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-idle .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-swap:focus-visible {
      opacity: 1;
    }
    /* The hover cluster follows the picture, anchored to its top-left corner so
       the two layout buttons sit where the eye starts reading the artwork. */
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ui {
      inset: 0;
      width: 100%;
      height: 100%;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 6px;
      padding: 10px 0 0 10px;
      box-sizing: border-box;
    }
    /* Next up sits in the bottom-right corner in stage as well. It used to be
       parked under the top-right chrome, which put it in the middle of the
       lyrics column on a wide pane; the bottom corner is empty in every stage
       composition (the dock owns bottom-left, mirrored chrome the left edge). */
    .ym-sl-fs-overlay.ym-sl-fs-stage .ym-sl-fs-nextup {
      left: auto;
      right: 22px;
      top: auto;
      bottom: 22px;
    }
    /* Cover on the right: the chrome moves to the free (lyrics) side. */
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-cover-left .ym-sl-fs-controls {
      left: max(18px, env(safe-area-inset-left, 0px));
      right: auto;
    }
    /* Mirror image: the cluster follows the picture to its outer edge (screen
       right) instead of hugging the pane's left edge, which put it mid-screen
       under the lyrics column. */
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ui {
      justify-content: flex-end;
      padding-left: 0;
      padding-right: 10px;
    }
    .ym-sl-fs-stage-frame {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
    }
    .ym-sl-fs-stage-fade { fill: currentColor; }
    .ym-sl-fs-stage-toggle.is-on { color: #fff; }
    /* Readability veil over the picture, UNDER the hover cluster: a black wash
       at low alpha, not a per-frame brightness filter, so the video/artwork
       keeps its own colour and only the region behind the words darkens. */
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background):not(.ym-sl-fs-mode-hits) .ym-sl-fs-media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      background: linear-gradient(to right, rgba(0,0,0,.20) 0%, rgba(0,0,0,.34) 48%, rgba(0,0,0,.12) 100%);
    }
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video) .ym-sl-fs-media::after {
      background: linear-gradient(to left, rgba(0,0,0,.20) 0%, rgba(0,0,0,.34) 48%, rgba(0,0,0,.12) 100%);
    }
    /* Layer order: picture, animated cover, outgoing ghost, veil, buttons. */
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art { z-index: 0; }
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-aa-host { z-index: 1; }
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ghost {
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      height: 100%;
      border-radius: 0;
      object-fit: cover;
      object-position: 50% 50%;
      pointer-events: none;
      opacity: 1;
      transition: opacity .4s ease;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, rgba(0,0,0,.28) 9%, #000 18%);
      mask-image: linear-gradient(to bottom, transparent 0, rgba(0,0,0,.28) 9%, #000 18%);
    }
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ghost.is-out { opacity: 0; }
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ui { z-index: 4; }
    /* Transport docks in the stage's bottom-left, the way Spicy stacks its dock
       on the NowBar: title, scrubber, chip, volume reading bottom-up inside the
       picture instead of spread across the full frame. */
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background):not(.ym-sl-fs-mode-hits) .ym-sl-fs-player-controls {
      top: auto;
      bottom: clamp(16px, 3vh, 40px);
      left: clamp(16px, 3vw, 44px);
      right: auto;
      /* Stretched past the old 620px cap so the progress bar, title and volume
         span the artwork column instead of stopping mid-picture. The max-width
         is the guard the request asked for: the lyric column starts at 44% here,
         so the dock stops 64px before it (dock inset + breathing room) and can
         never sit under the words at any viewport width. */
      width: min(46vw, 820px);
      max-width: calc(44vw - 64px);
      height: auto;
    }
    /* ---- stage + music video ------------------------------------------------
       A video gets the same full-height stage, but never mirrors: the side
       switch is artwork-only, so the pane is pinned left and the feather always
       faces the lyrics. */
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
      left: 0;
      right: auto;
      top: 0;
      bottom: 0;
      width: 52vw;
      height: 100%;
      border-radius: 0;
      /* The video layout centres its pane with a transform; left in place it
         shifted this one up by half its height (measured live: 998x880 at
         y = -440), so only a band of picture showed at the top. Its
         max-height: calc(100% - 200px) also stopped the pane 200px short of
         the bottom (880 of 1080). Stage owns its geometry. */
      transform: none;
      translate: 0 0;
      margin: 0;
      max-height: none;
      -webkit-mask-image: linear-gradient(to right, #000 0, #000 58%, rgba(0,0,0,.85) 70%, rgba(0,0,0,.36) 82%, rgba(0,0,0,.10) 92%, transparent 100%);
      mask-image: linear-gradient(to right, #000 0, #000 58%, rgba(0,0,0,.85) 70%, rgba(0,0,0,.36) 82%, rgba(0,0,0,.10) 92%, transparent 100%);
    }
    /* Same dock as the cover stage, stretched the same way. A video's lyric
       column starts at 52.5% (it sits further right than cover art's 44%), so
       the dock gets the extra room that column leaves: it ends 64px before the
       column's left edge rather than at an arbitrary pixel cap. */
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background):not(.ym-sl-fs-mode-hits) .ym-sl-fs-player-controls {
      left: 38px;
      right: auto;
      top: auto;
      bottom: 32px;
      width: min(48vw, 920px);
      max-width: calc(52.5vw - 64px);
      height: auto;
    }
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media > video {
      border-radius: 0;
      object-fit: cover !important;
      object-position: 50% 40%;
    }
    /* Armed only while the stage toggle animates: the pane's corners are the
       one part of that switch CSS can interpolate by itself (14px card -> 0).
       Kept off the steady state so nothing repaints a radius on a timer. */
    .ym-sl-fs-overlay.ym-sl-fs-stage-anim .ym-sl-fs-media > video {
      transition: border-radius .52s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: linear-gradient(to right, rgba(0,0,0,.20) 0%, rgba(0,0,0,.34) 48%, rgba(0,0,0,.12) 100%);
    }
    /* Stage: the cluster is a hover target, not a scrim. The side layout dims
       the cover while the pointer is on it; the stage's whole point is the
       picture, so it stays at full brightness. */
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ui,
    .ym-sl-fs-overlay.ym-sl-fs-stage:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ui:hover,
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-flipping:not(.ym-sl-fs-has-video) .ym-sl-fs-media > .ym-sl-fs-art-ui {
      background: transparent;
    }
    /* A video's only hover control is the stage toggle: the side swap is
       artwork-only, and the artwork like button lives on still art. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-media > .ym-sl-fs-art-ui {
      display: flex;
      inset: 0;
      width: 100%;
      height: 100%;
      /* The pane's <video> is appended AFTER this cluster and carries its own
         stacking, so without an explicit level the buttons were painted under
         the picture — present in the DOM, invisible on screen. */
      z-index: 4;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-swap:not(.ym-sl-fs-stage-toggle),
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-art-like {
      display: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-media > .ym-sl-fs-art-ui .ym-sl-fs-stage-toggle {
      display: block;
    }
    .ym-sl-fs-overlay.ym-sl-fs-stage.ym-sl-fs-cover-left:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background):not(.ym-sl-fs-mode-hits) .ym-sl-fs-player-controls {
      left: auto;
      right: clamp(16px, 3vw, 44px);
    }

  `;

