    #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-writers .ym-sl-credits-names,
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple .ym-sl-credit-artist .ym-sl-credits-names {
