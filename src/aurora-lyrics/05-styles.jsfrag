        180deg,
        transparent,
        rgba(255,255,255,.38) 12%,
        rgba(255,255,255,.38) 88%,
        transparent
      );
      box-shadow: 0 0 8px rgba(255,255,255,.1);
      opacity: .56;
    }
    .ym-sl-page-bg-root ytmusic-app-layout,
    .ym-sl-page-bg-root ytmusic-nav-bar,
    .ym-sl-page-bg-root ytmusic-player-page,
    .ym-sl-page-bg-root ytmusic-watch-page,
    .ym-sl-page-bg-root ytmusic-player-bar,
    .ym-sl-page-bg-root ytmusic-guide-renderer,
    .ym-sl-page-bg-root ytmusic-left-nav-bar,
    .ym-sl-page-bg-root #layout,
    .ym-sl-page-bg-root #nav-bar,
    .ym-sl-page-bg-root #nav-bar-background,
    .ym-sl-page-bg-root #guide,
    .ym-sl-page-bg-root #guide-spacer,
    .ym-sl-page-bg-root #mini-guide,
    .ym-sl-page-bg-root #mini-guide-background,
    .ym-sl-page-bg-root #guide-wrapper,
    .ym-sl-page-bg-root #left-content,
    .ym-sl-page-bg-root #player-bar {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    .ym-sl-page-bg-root #player-bar-background {
      background: rgba(6,6,10,.22) !important;
      background-color: rgba(6,6,10,.22) !important;
      background-image: none !important;
      -webkit-backdrop-filter: blur(28px) saturate(1.45) brightness(.94);
      backdrop-filter: blur(28px) saturate(1.45) brightness(.94);
      border-top: 1px solid rgba(255,255,255,.1);
      box-shadow: 0 -10px 30px rgba(0,0,0,.12);
    }
    .ym-sl-page-bg-root.ym-sl-topbar-scrolled #nav-bar-background {
      background: rgba(6,6,10,.22) !important;
      background-color: rgba(6,6,10,.22) !important;
      background-image: none !important;
      -webkit-backdrop-filter: blur(28px) saturate(1.45) brightness(.94);
      backdrop-filter: blur(28px) saturate(1.45) brightness(.94);
      border-bottom: 1px solid rgba(255,255,255,.1);
      box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }
    .ym-sl-page-bg-root ytmusic-nav-bar::before,
    .ym-sl-page-bg-root ytmusic-nav-bar::after,
    .ym-sl-page-bg-root ytmusic-guide-renderer::before,
    .ym-sl-page-bg-root ytmusic-guide-renderer::after,
    .ym-sl-page-bg-root ytmusic-player-bar::before,
    .ym-sl-page-bg-root ytmusic-player-bar::after {
      background: transparent !important;
    }
    .ym-sl-page-bg-root ytmusic-player-page .html5-video-container,
    .ym-sl-page-bg-root ytmusic-player-page video.html5-main-video {
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 2px;
      box-shadow:
        0 0 0 1px rgba(0,0,0,.28),
        0 18px 42px rgba(0,0,0,.38);
    }
    .ym-sl-page-bg-root.ym-sl-song-mode {
      --ym-sl-left-rail-width: 245px;
    }
    .ym-sl-page-bg-root.ym-sl-song-mode
      :is(ytmusic-guide-renderer, ytmusic-left-nav-bar, #guide-wrapper, #guide, #left-content) {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode
      :is(ytmusic-guide-renderer, ytmusic-left-nav-bar, #guide-wrapper, #guide, #left-content) {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode
      :is(
        ytmusic-browse-response,
        ytmusic-homepage,
        ytmusic-browse-page,
        ytmusic-section-list-renderer,
        ytmusic-carousel-shelf-renderer,
        ytmusic-shelf-renderer,
        ytmusic-music-shelf-renderer,
        ytmusic-grid-renderer,
        #page-manager,
        #main-panel,
        #content,
        #content-page,
        #browse-page,
        #home-page,
        #contents
      ) {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode
      :is(ytmusic-fullbleed-thumbnail-renderer, ytmusic-fullbleed-thumbnail-renderer img) {
      opacity: 0 !important;
      visibility: hidden !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode ytmusic-browse-response > *,
    .ym-sl-page-bg-root.ym-sl-home-mode ytmusic-section-list-renderer > #contents,
    .ym-sl-page-bg-root.ym-sl-home-mode ytmusic-section-list-renderer > #contents > * {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode
      :is(
        ytmusic-browse-response,
        ytmusic-homepage,
        ytmusic-section-list-renderer,
        ytmusic-carousel-shelf-renderer,
        ytmusic-shelf-renderer,
        ytmusic-music-shelf-renderer
      )::before,
    .ym-sl-page-bg-root.ym-sl-home-mode
      :is(
        ytmusic-browse-response,
        ytmusic-homepage,
        ytmusic-section-list-renderer,
        ytmusic-carousel-shelf-renderer,
        ytmusic-shelf-renderer,
        ytmusic-music-shelf-renderer
      )::after {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode .ym-sl-kawarp-shade {
      background: rgba(5,5,8,.16);
    }
    .ym-sl-page-bg-root:not(.ym-sl-song-mode) .ym-sl-page-divider {
      display: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode
      ytmusic-search-page > ytmusic-tabbed-search-results-renderer > ytmusic-tabs {
      background: rgba(6,6,10,.18) !important;
      background-color: rgba(6,6,10,.18) !important;
      background-image: none !important;
      -webkit-backdrop-filter: blur(24px) saturate(1.35);
      backdrop-filter: blur(24px) saturate(1.35);
    }
    .ym-sl-page-bg-root.ym-sl-home-mode
      ytmusic-search-page > ytmusic-tabbed-search-results-renderer > ytmusic-tabs > #tabs {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-song-mode ytmusic-player-bar {
      left: var(--ym-sl-left-rail-width) !important;
      right: 0 !important;
      width: auto !important;
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    .ym-sl-page-bg-root.ym-sl-home-mode ytmusic-player-bar {
      left: 0 !important;
      right: 0 !important;
      width: auto !important;
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
    }
    */
    .ym-sl-native-hidden { display: none !important; }
    /* When Aurora's panel owns the Lyrics tab: hide EVERY native child of
       #tab-renderer — including ones YTM adds LATER, like the "Lyrics not
       available" message (ytmusic-message-renderer) — and drop the host's
       always-on scrollbar (overflow-y:scroll), which is redundant with the
       panel's own internal scroll. */
    #tab-renderer.ym-sl-panel-active > :not(.ym-sl-panel) {
      display: none !important;
    }
    #tab-renderer.ym-sl-panel-active {
      overflow: hidden !important;
    }
    .ym-sl-panel.hidden { display: none !important; }
    .ym-sl-panel.drag { outline: 2px dashed rgba(255,255,255,.6); outline-offset: -4px; }
    /*
    .ym-sl-kawarp-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100%;
      opacity: 0;
      pointer-events: none;
      transform: scaleX(1.08);
      transform-origin: center center;
      filter: saturate(1.7) brightness(.72);
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0%,
        rgba(0,0,0,.5) 3%,
        #000 9%,
        #000 91%,
        rgba(0,0,0,.5) 97%,
        transparent 100%
      );
      mask-image: linear-gradient(
        90deg,
        transparent 0%,
        rgba(0,0,0,.5) 3%,
        #000 9%,
        #000 91%,
        rgba(0,0,0,.5) 97%,
        transparent 100%
      );
      transition: opacity .65s ease;
    }
    .ym-sl-kawarp-bg.ready { opacity: .98; }
    .ym-sl-kawarp-shade {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(
          90deg,
          rgba(5,5,8,.26) 0%,
          rgba(5,5,8,.07) 9%,
          rgba(5,5,8,.07) 91%,
          rgba(5,5,8,.26) 100%
        ),
        linear-gradient(
          180deg,
          rgba(5,5,8,.14),
          transparent 26%,
          transparent 72%,
          rgba(5,5,8,.24)
        );
      pointer-events: none;
    }
    */
    /* Options: a pill beside content.js's song-layout switcher, in the empty
       band above both panels. It replaces the hover-revealed
       row that used to live on the panel's own top edge, where nobody who had
       not already found it would look. Every metric is the layout button's own
       (styles.css: .ym-song-layout-btn) so the pair reads as one control group
       instead of two different systems sitting next to each other. */
    .ym-sl-options-pill {
      display: flex;
      align-items: center;
      gap: 7px;
      height: 28px;
      padding: 0 8px;
      border: 0;
      border-radius: 9px;
      background: rgba(255, 255, 255, .06);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .09);
      color: rgba(255, 255, 255, .72);
      font: inherit;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: .01em;
      line-height: 1;
      cursor: pointer;
      transition: background .18s ease, color .18s ease, box-shadow .18s ease;
    }
    .ym-sl-options-pill:hover {
      background: rgba(255, 255, 255, .1);
      color: #fff;
    }
    .ym-sl-options-pill:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .6);
      outline-offset: 2px;
    }
    /* Consolidated options overlay. Holds track / offset / import so the toolbar
       is just [Options] [Fullscreen]. Lives on <body> (see buildUI). The fullscreen
       options overlay reuses the same chrome but with a higher z-index so it
       floats above the fullscreen overlay. */
    .ym-sl-options-overlay,
    .ym-sl-fs-options-overlay {
      position: fixed;
      top: 96px;
      right: 28px;
      z-index: 2147483200;
      width: 430px;
      max-width: calc(100vw - 32px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,.12);
      /* FROSTED GLASS: a blurred translucent shell so
         the panel floats over the lyrics instead of being a solid dark slab.
         The inset top highlight still keeps a crisp top edge. */
      background: rgba(16,18,24,.55);
      -webkit-backdrop-filter: blur(24px) saturate(1.7);
      backdrop-filter: blur(24px) saturate(1.7);
      box-shadow: 0 40px 120px -40px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.15);
      color: #fff;
      /* The panel is appended to body, so inheriting gave it YTM's Roboto rather
         than the panel face. Same stack the marketplace uses. */
      font-family: "SpicyLyrics", "Roboto", "YouTube Sans", system-ui, -apple-system, sans-serif;
    }
    /* Fullscreen variant: sit above the fullscreen overlay (also 2147483000)
       and anchor to the top-right where the controls normally live. */
    .ym-sl-fs-options-overlay {
      z-index: 2147483100;
      top: 64px;
      right: 24px;
      width: 360px;
    }
    .ym-sl-options-overlay.hidden,
    .ym-sl-fs-options-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-8px) scale(.97);
    }
    /* ⭐ A closed overlay was still INTERACTIVE. pointer-events:none
       on a parent does NOT block a child that sets pointer-events:auto — and
       .ym-sl-options-panel.active does. So the active tab's slider and toggles
       stayed clickable while invisible, swallowing hover over the lyrics underneath
       and changing the offset at random. These selectors carry the extra class
       specifically to out-rank .active. Panel visibility now comes from the
       overlay (panels no longer set it), so only pointer-events needs forcing. */
    .ym-sl-options-overlay.hidden .ym-sl-options-panel,
    .ym-sl-fs-options-overlay.hidden .ym-sl-options-panel,
    .ym-sl-options-overlay.hidden .ym-sl-options-panel.active,
    .ym-sl-fs-options-overlay.hidden .ym-sl-options-panel.active {
      visibility: hidden;
      pointer-events: none;
    }
    .ym-sl-options-overlay,
    .ym-sl-fs-options-overlay {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
      transition:
        opacity .2s ease,
        transform .28s cubic-bezier(.22,.61,.36,1),
        visibility 0s linear 0s;
    }
    .ym-sl-options-overlay.hidden,
    .ym-sl-fs-options-overlay.hidden {
      transition:
        opacity .16s ease,
        transform .22s cubic-bezier(.4,0,1,1),
        visibility 0s linear .22s;
    }
    .ym-sl-options-header,
    .ym-sl-fs-options-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 14px 16px;
      cursor: grab;
      user-select: none;
      touch-action: none;
      background: transparent;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .ym-sl-options-header:active,
    .ym-sl-fs-options-header:active { cursor: grabbing; }
    .ym-sl-options-title,
    .ym-sl-fs-options-title {
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -.01em;
      color: #f4f1ee;
    }
    .ym-sl-options-close,
    .ym-sl-fs-options-close {
      appearance: none;
      background: transparent;
      border: 0;
      padding: 0 4px;
      font: inherit;
      font-size: 20px;
      line-height: 1;
      color: rgba(255,255,255,.7);
      cursor: pointer;
    }
    .ym-sl-options-close:hover,
    .ym-sl-fs-options-close:hover { color: #fff; }
    .ym-sl-options-body,
    .ym-sl-fs-options-body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 18px;
    }
    .ym-sl-options-section,
    .ym-sl-options-body .ym-sl-options-section {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .ym-sl-options-body .ym-sl-video-offset {
      margin-top: 2px;
      padding-top: 4px;
      border-top: 1px solid rgba(255,255,255,.07);
    }
    /* Community offset: a compact share card under the timing rail. The status
       line carries the poster name and the short offset id; the buttons change
       with ownership, so a non-owner sees Report and never Undo. */
    .ym-sl-community-offset {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 4px;
      padding-top: 12px;
      border-top: 1px solid rgba(255,255,255,.07);
    }
    .ym-sl-community-offset-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .ym-sl-community-offset-badge {
      flex: 0 0 auto;
      padding: 2px 6px;
      border-radius: 999px;
      background: rgba(63,224,197,.12);
      color: rgba(63,224,197,.9);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .ym-sl-community-offset-status {
      color: rgba(255,255,255,.62);
      font-size: 12px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }
    .ym-sl-community-offset-status[data-state="shared"],
    .ym-sl-community-offset-status[data-state="owned"] {
      color: rgba(255,255,255,.82);
    }
    .ym-sl-community-offset-status[data-state="error"] {
      color: rgba(255,164,150,.92);
    }
    .ym-sl-community-offset-account {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 38px;
      box-sizing: border-box;
      padding: 6px 9px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 9px;
      background: rgba(255,255,255,.045);
      color: inherit;
      text-decoration: none;
    }
    /* Only a maker with a profile URL gets the link affordance. The whole row
       is the hit target, so hovering either the avatar or the username lights
       up the same link. */
    .ym-sl-community-offset-account[href] {
      cursor: pointer;
      transition: background-color .16s ease, border-color .16s ease;
    }
    .ym-sl-community-offset-account[href]:hover {
      background: rgba(255,255,255,.075);
      border-color: rgba(255,255,255,.18);
    }
    .ym-sl-community-offset-account[href]:focus-visible {
      outline: 2px solid rgba(63, 224, 197, .72);
      outline-offset: 2px;
    }
    .ym-sl-community-offset-account[href]:hover .ym-sl-community-offset-accountname {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .ym-sl-community-offset-account[href]:hover .ym-sl-community-offset-avatar {
      box-shadow: 0 0 0 2px rgba(63, 224, 197, .45);
    }
    .ym-sl-community-offset-avatar {
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      width: 28px;
      height: 28px;
      overflow: hidden;
      border-radius: 50%;
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,.2), transparent 45%),
        linear-gradient(145deg, #8d2a3e, #1d1c2c 76%);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
    }
    .ym-sl-community-offset-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .ym-sl-community-offset-initial {
      line-height: 1;
    }
    .ym-sl-community-offset-accountcopy {
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-width: 0;
    }
    .ym-sl-community-offset-accountname {
      overflow: hidden;
      color: rgba(255,255,255,.9);
      font-size: 12px;
      font-weight: 650;
      line-height: 1.25;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .ym-sl-community-offset-accountmeta {
      color: rgba(63,224,197,.78);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .07em;
      line-height: 1.2;
      text-transform: uppercase;
    }
    .ym-sl-community-offset-name {
      width: 100%;
      box-sizing: border-box;
      padding: 7px 9px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      background: rgba(255,255,255,.08);
      color: #fff;
      font: inherit;
      font-size: 12px;
      outline: none;
    }
    .ym-sl-community-offset-name::placeholder { color: rgba(255,255,255,.4); }
    .ym-sl-community-offset-name:focus-visible {
      border-color: rgba(255,255,255,.45);
      box-shadow: 0 0 0 2px rgba(255,255,255,.1);
    }
    .ym-sl-community-offset-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .ym-sl-community-offset-btn {
      appearance: none;
      border: 0;
      border-radius: 8px;
      padding: 7px 11px;
      background: rgba(255,255,255,.1);
      color: #fff;
      font: inherit;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      transition: background .15s ease, opacity .15s ease;
    }
    .ym-sl-community-offset-btn:hover { background: rgba(255,255,255,.18); }
    .ym-sl-community-offset-post {
      background: rgba(255,255,255,.16);
    }
    .ym-sl-community-offset-undo {
      background: rgba(255,255,255,.1);
    }
    .ym-sl-community-offset-report {
      background: rgba(255,120,105,.14);
      color: rgba(255,190,180,.95);
    }
    .ym-sl-community-offset-report:hover { background: rgba(255,120,105,.22); }
    .ym-sl-community-offset-btn:disabled {
      opacity: .45;
      cursor: default;
    }
    .ym-sl-community-offset-account.hidden,
    .ym-sl-community-offset-name.hidden,
    .ym-sl-community-offset-btn.hidden { display: none; }
    /* Divider + section title separate the lyrics controls (track, offset)
       from the TTML import controls (mode, upload). */
    .ym-sl-options-divider {
      appearance: none;
      height: 1px;
      width: calc(100% + 36px);
      margin: 2px -18px 0;
      border: 0;
      background: rgba(255,255,255,.1);
    }
    .ym-sl-options-section-title {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: rgba(244,241,238,.6);
      padding: 4px 2px 0;
    }
    /* Grouped settings-list cards. Each concern lives in a
       frosted inset panel with a title + comfortable rows; replaces the old flat
       <hr>-separated stack. */
    .ym-sl-options-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 12px 12px 14px;
      border-radius: 14px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.09);
    }
    .ym-sl-options-group > .ym-sl-options-section-title {
      padding: 0;
      color: rgba(244,241,238,.5);
      font-size: 10.5px;
      letter-spacing: .09em;
    }
    .ym-sl-options-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ym-sl-options-row-actions {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .ym-sl-options-row .ym-sl-import {
      flex: 0 0 auto;
    }
    /* Tabbed side-rail layout: vertical tab rail on the LEFT,
       the active section's controls on the RIGHT, one panel visible at a time. */
    .ym-sl-options-body.ym-sl-options-tabbed {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      padding: 0;
    }
    .ym-sl-options-rail {
      display: flex;
      flex-direction: column;
      gap: 3px;
      flex: 0 0 126px;
      width: 126px;
      padding: 12px 9px;
      border-right: 1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.035);
    }
    .ym-sl-options-tab {
      appearance: none;
      background: transparent;
      border: 0;
      border-radius: 10px;
      padding: 9px 11px;
      text-align: left;
      font: inherit;
      font-size: 12.5px;
      line-height: 1.2;
      color: rgba(255,255,255,.62);
      cursor: pointer;
      transition: background .16s ease, color .16s ease;
    }
    .ym-sl-options-tab:hover { background: rgba(255,255,255,.07); color: #fff; }
    .ym-sl-options-tab.active {
      background: rgba(255,255,255,.13);
      color: #fff;
      font-weight: 600;
    }
    .ym-sl-options-panels {
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
      min-height: 120px;
      transition: height .34s cubic-bezier(.34,1.4,.5,1);
    }
    .ym-sl-options-panel {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 6px 18px 18px;
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px);
      transition: opacity .24s ease, transform .24s ease;
    }
    /* Incoming panel is opaque instantly — its children do the spring (staggerIn);
       the panel being left fades out via the base transition above. */
    .ym-sl-options-panel.active {
      opacity: 1;
      pointer-events: auto;
      transform: none;
      transition: opacity 0s, transform 0s;
    }
    .ym-sl-options-panel-title {
      font-size: 15px;
      font-weight: 650;
      letter-spacing: -.01em;
      color: #f4f1ee;
      padding: 14px 0 2px;
    }
    /* Custom dropdown: styled button + popup menu instead of a
       native <select>, matching the frosted panel. */
    .ym-sl-select { position: relative; }
    .ym-sl-select-button {
      appearance: none;
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 128px;
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.18);
      background: rgba(255,255,255,.08);
      color: #fff;
      font: inherit;
      font-size: 13px;
      cursor: pointer;
    }
    .ym-sl-select-button:hover { background: rgba(255,255,255,.13); }
    .ym-sl-select.open .ym-sl-select-button { border-color: rgba(255,255,255,.35); }
    .ym-sl-select-label { flex: 1 1 auto; white-space: nowrap; }
    .ym-sl-select-caret {
      flex: 0 0 auto;
      width: 0;
      height: 0;
      margin-left: auto;
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 5px solid rgba(255,255,255,.6);
      transition: transform .2s ease, border-top-color .2s ease;
    }
    .ym-sl-select.open .ym-sl-select-caret {
      transform: rotate(180deg);
      border-top-color: #fff;
    }
    .ym-sl-select-menu {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 2147483100;
      min-width: 100%;
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 6px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(22,24,30,.92);
      -webkit-backdrop-filter: blur(18px) saturate(1.6);
      backdrop-filter: blur(18px) saturate(1.6);
      box-shadow: 0 22px 55px -22px rgba(0,0,0,.75);
    }
    .ym-sl-select-menu.hidden { display: none; }
    .ym-sl-select-option {
      padding: 8px 10px;
      border-radius: 8px;
      font-size: 13px;
      color: rgba(255,255,255,.82);
      cursor: pointer;
      white-space: nowrap;
    }
    .ym-sl-select-option:hover { background: rgba(255,255,255,.08); color: #fff; }
    .ym-sl-select-option.selected { background: rgba(255,255,255,.14); color: #fff; font-weight: 600; }
    /* Segmented control (pill row) — the cleaner replacement for the dropdown. */
    .ym-sl-segmented {
      display: inline-flex;
      gap: 3px;
      padding: 3px;
      border-radius: 11px;
      background: rgba(0,0,0,.28);
      border: 1px solid rgba(255,255,255,.14);
    }
    .ym-sl-segmented-option {
      appearance: none;
      background: transparent;
      border: 0;
      border-radius: 8px;
      padding: 6px 14px;
      font: inherit;
      font-size: 12.5px;
      line-height: 1.2;
      color: rgba(255,255,255,.72);
      cursor: pointer;
      transition: background .16s ease, color .16s ease;
      white-space: nowrap;
    }
    .ym-sl-segmented-option:hover { color: #fff; }
    .ym-sl-segmented-option.active {
      background: rgba(255,255,255,.92);
      color: #14161a;
      font-weight: 600;
    }
    /* File tab: full-width segmented track so each pill lines up with the action
       buttons below; Upload + Delete saved share a 2-col row at the same width. */
    .ym-sl-options-panel .ym-sl-segmented { width: 100%; }
    .ym-sl-options-panel .ym-sl-segmented-option { flex: 1 1 0; text-align: center; }
    .ym-sl-options-file-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .ym-sl-options-file-actions .ym-sl-import {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
    /* This stylesheet has NO global .hidden rule, so the class the JS toggles on
       this button was cosmetic and "Delete saved" stayed on screen even with a
       track saved. Made it real here, scoped to the button. */
    .ym-sl-delete-permanent-button.hidden { display: none; }
    /* With nothing saved to delete, Upload must not sit in half of a two-column
       row next to an empty cell. */
    .ym-sl-options-file-actions:has(.ym-sl-delete-permanent-button.hidden) {
      grid-template-columns: 1fr;
    }
    /* File tab: the per-song cache row under the import actions. One caption
       line whose copy carries the state (cached · N days / queued), plus the
       full-width action. */
    .ym-sl-file-note {
      font-size: 12px;
      line-height: 1.45;
      color: rgba(255,255,255,.6);
      padding: 0 2px;
    }
    .ym-sl-file-note.hidden { display: none; }
    /* Queued state reads as a commitment, not as dim helper copy. */
    .ym-sl-song-cache-status.pending { color: rgba(255,255,255,.82); }
    .ym-sl-options-panel .ym-sl-song-cache-clear {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
    .ym-sl-song-cache-clear.hidden { display: none; }
    .ym-sl-options-body .ym-sl-track { width: 100%; }
    /* The offset row is a wide horizontal rail; let it wrap and give the slider
       its own line so nothing overflows the 340px panel. */
    .ym-sl-options-body .ym-sl-video-offset { flex-wrap: wrap; row-gap: 8px; }
    .ym-sl-options-body .ym-sl-video-offset input[type="range"] { width: 100%; min-width: 0; }
    /* Cache section: a short status line above the purge button. */
    .ym-sl-cache-section { gap: 10px; }
    .ym-sl-cache-status {
      font-size: 12px;
      line-height: 1.4;
      color: rgba(255,255,255,.6);
      padding: 0 2px;
    }
    .ym-sl-options-body .ym-sl-cache-clear {
      align-self: flex-start;
    }
    .ym-sl-cache-clear.hidden { display: none; }
    /* Confirmation step for "Clear cache": a red delete action
       so the irreversible wipe is never a single accidental click. */
    .ym-sl-cache-confirm {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      background: rgba(229,72,77,.10);
      border: 1px solid rgba(229,72,77,.30);
    }
    .ym-sl-cache-confirm.hidden { display: none; }
    .ym-sl-cache-confirm-text {
      font-size: 12px;
      line-height: 1.45;
      color: rgba(255,255,255,.82);
    }
    .ym-sl-cache-confirm-row {
      display: flex;
      gap: 10px;
    }
    .ym-sl-cache-delete {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 14px;
      border: none;
      border-radius: 10px;
      background: #e5484d;
      color: #fff;
      font: inherit;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    .ym-sl-cache-delete:hover { background: #d23b40; }
    .ym-sl-cache-delete:disabled { opacity: .55; cursor: default; }
    .ym-sl-trash-icon {
      width: 16px;
      height: 16px;
      display: block;
      fill: currentColor;
    }
    .ym-sl-cache-cancel {
      padding: 8px 14px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.2);
      background: transparent;
      color: rgba(255,255,255,.8);
      font: inherit;
      font-size: 13px;
      cursor: pointer;
    }
    .ym-sl-cache-cancel:hover { background: rgba(255,255,255,.06); }
    .ym-sl-cache-cancel:disabled { opacity: .5; cursor: default; }
    .ym-sl-export-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding-top: 2px;
    }
    .ym-sl-export-actions.hidden {
      display: none;
    }
    .ym-sl-export-actions .ym-sl-import {
      flex: 1 1 140px;
      min-width: 0;
    }
    /* Fullscreen overlay is always block; media + lyrics are absolute so
       layout changes (side / background / lyrics-only) animate via CSS
       transitions instead of snapping. */
    /* ⭐ STATIC CHROME MODEL.
       The title / transport chip / scrubber used to be positioned from
       --ym-sl-fs-band-top and --ym-sl-fs-title-h, both measured in JS off the
       media pane's live rect and both transitioned over .35s. That made the
       whole stack chase the media: every aspect-ratio change, every art swap and
       every video-metadata arrival moved the anchor, so the controls drifted and
       then settled ("moves a lot, then goes back to normal").
       The band vars, their @property registrations and the transition on them
       are GONE. Every chrome position is now a fixed CSS length below, identical
       on every track. Nothing measures the media to place the controls any more.
       Animations are being rebuilt from this static base. */
    .ym-sl-fs-overlay {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: block;
      padding: 0;
      box-sizing: border-box;
      background: #0a0a0c;
      color: #fff;
      overflow: hidden;
      /* Same pin as .ym-sl-panel: the overlay is appended to <body>, which
         inherits YouTube's scaled root size. */
      font-size: var(--ym-yt-root-fs, 10px);
    }
    /* Media and lyrics are ALWAYS absolute and animate their geometry. The
       transition list covers every property that changes between layouts.
       Media gets a 3% padding in background mode; the video's inline 100%
       sizing fills the padding box, producing the rounded-card look without
       a per-layout video rule, and animating the padding smoothly resizes
       the video inside. */
    .ym-sl-fs-media,
    .ym-sl-fs-lyrics {
      position: absolute;
      top: 0;
      bottom: 0;
      overflow: hidden;
      transition:
        left .45s cubic-bezier(.22, .61, .36, 1),
        width .45s cubic-bezier(.22, .61, .36, 1),
        transform .45s cubic-bezier(.22, .61, .36, 1),
        opacity .35s ease,
        padding .45s cubic-bezier(.22, .61, .36, 1);
      will-change: left, width, transform, opacity, padding;
    }
    /*: on entry the layout is applied while this class is present,
       so the panes jump straight to their final geometry instead of sliding in
       from the CSS default (the "side layout" cover-art flash). buildFullscreen
       Controls drops the class via a double-rAF once the overlay has painted, so
       layout cycling on the cycle button still animates normally. */
    .ym-sl-fs-overlay.ym-sl-fs-no-anim .ym-sl-fs-media,
    .ym-sl-fs-overlay.ym-sl-fs-no-anim .ym-sl-fs-lyrics {
      transition: none;
    }
    .ym-sl-fs-media { z-index: 2; }
    .ym-sl-fs-lyrics { z-index: 3; }

    /* ===== no-lyrics fullscreen composition ===============
       Nothing to read means nothing for the cover to sit beside: the lyrics
       column fades out, the composition centres, and the Search CTA appears.
       Hits centres its whole block (header + dock) as one unit, because the
       dock is inside .ym-sl-fs-hits; the side layouts centre the media pane
       instead, since there the cover IS the composition. No backticks here: the
       sheet is a template literal. */
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics .ym-sl-fs-lyrics-shade {
      opacity: 0 !important;
    }
    /* Hide the lyrics CONTENT, never the host: the Search sheet is a child of
       #ym-sl-panel, so fading the host made the sheet open inside an opacity:0,
       pointer-events:none subtree - invisible and unclickable. */
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics .ym-sl-fs-lyrics .LyricsContainer,
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics .ym-sl-fs-lyrics .LyricsContent {
      opacity: 0 !important;
      pointer-events: none !important;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-hits.ym-sl-fs-no-lyrics .ym-sl-fs-hits {
      top: 50%;
      transform: translateY(-50%);
      transition:
        top .45s cubic-bezier(.22, .61, .36, 1),
        transform .45s cubic-bezier(.22, .61, .36, 1);
    }
    /* The offset is measured in JS (distance from the pane's normal column to
       the middle) and applied as a transform, so the cover AND the transport
       travel the same distance. A transform also composites, where changing
       left relayouts every frame of the slide. */
    /* The translate property, NOT transform: .ym-sl-fs-media already carries
       its own vertical-centring transform, and a transform here would replace
       it (which is why a video track never moved - the pane is excluded from the
       horizontal rule by the media's own transform, and the controls are not).
       Serving both panes through translate composes with whatever transform
       each one already has. Music videos in the side-by-side composition are
       included; Video Background is not, because there the media is the whole
       frame and there is nothing to centre against. */
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics:not(.ym-sl-fs-mode-hits):not(.ym-sl-fs-mode-background) .ym-sl-fs-media,
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics:not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
      translate: var(--ym-sl-fs-nolyr-dx, 0px) 0;
    }
    /* The base .ym-sl-fs-media rule lower down declares transition: opacity
       only, which is why the first pass snapped: a later single-class rule beat
       the pane list. These carry the transition for the slide. */
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics .ym-sl-fs-media {
      transition:
        translate .45s cubic-bezier(.22, .61, .36, 1),
        transform .45s cubic-bezier(.22, .61, .36, 1),
        left .45s cubic-bezier(.22, .61, .36, 1),
        width .45s cubic-bezier(.22, .61, .36, 1),
        opacity .25s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics .ym-sl-fs-player-controls {
      transition:
        translate .45s cubic-bezier(.22, .61, .36, 1),
        transform .45s cubic-bezier(.22, .61, .36, 1),
        opacity .35s ease;
    }
    /* The way out, bottom-right: pill, no loud fill, always above the backdrop. */
    .ym-sl-fs-search-cta {
      position: absolute;
      right: clamp(18px, 2.4vw, 36px);
      bottom: clamp(18px, 2.6vh, 34px);
      z-index: 30;
      display: none;
      align-items: center;
      gap: 8px;
      padding: 11px 18px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, .18);
      background: rgba(16, 16, 20, .62);
      color: #fff;
      font: inherit;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      transition: opacity .22s ease, background-color .16s ease, border-color .16s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics .ym-sl-fs-search-cta { display: inline-flex; }
    /* While its sheet is open the CTA steps aside; it fades back in only if the
       listener closes the sheet without picking anything. */
    .ym-sl-fs-overlay.ym-sl-fs-search-open .ym-sl-fs-search-cta {
      opacity: 0;
      pointer-events: none;
    }
    /* The sheet normally drops from the panel's top edge, which in fullscreen
       lands it under the header. With the composition cleared there is nothing
       up there, so it opens from the bottom instead, where the CTA was. */
    .ym-sl-fs-overlay.ym-sl-fs-no-lyrics .ym-sl-search {
      top: auto !important;
      bottom: clamp(18px, 2.6vh, 34px) !important;
    }
    /* The sheet is a descendant of .ym-sl-fs-lyrics (z-index 3), so its own
       z-index 30 was trapped in that stacking context and it painted UNDER the
       transport layer (z-index 21). Lift the host for as long as the sheet is
       open - the lyrics content is hidden in this state, so nothing else moves
       with it. */
    .ym-sl-fs-overlay.ym-sl-fs-search-open .ym-sl-fs-lyrics {
      z-index: 25;
    }
    .ym-sl-fs-search-cta:hover {
      background: rgba(30, 30, 36, .82);
      border-color: rgba(255, 255, 255, .3);
    }
    .ym-sl-fs-search-cta:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .8);
      outline-offset: 2px;
    }

    /* Legibility backdrop (Synced Lyrics setting "Legibility backdrop"): a very
       dark, slightly transparent panel with a light frost behind the lyrics so
       they stay readable over bright artwork / video. Body-level class so it
       survives renderer rebuilds. */
    .ym-sl-legibility-backdrop .LyricsContainer {
      background: rgba(0, 0, 0, 0.55);
      -webkit-backdrop-filter: blur(8px) saturate(1.1);
      backdrop-filter: blur(8px) saturate(1.1);
      border-radius: 12px;
    }
    .ym-sl-legibility-backdrop .ym-sl-fs-lyrics {
      background: rgba(0, 0, 0, 0.45);
      -webkit-backdrop-filter: blur(10px) saturate(1.1);
      backdrop-filter: blur(10px) saturate(1.1);
    }

    /* Default "side" layout: video left, lyrics right. No padding on the media
       host — padding here would push the element's padding-box past the lyrics
       panel's left edge and create a dark sliver that reads as "video under the
       lyrics". Clean position + clean width keeps the video fully inside its
       own column. */
    .ym-sl-fs-overlay .ym-sl-fs-media {
      left: 2%;
      width: 50%;
    }
    .ym-sl-fs-overlay .ym-sl-fs-lyrics {
      /* 52.5% hugs the media column: its box is 2% + 50% wide at EVERY video
         aspect ratio (aspect-ratio only drives the height, and max-height
         clamps that instead of the width), so the pane's right edge is a flat
         52% and 0.5% (~10px at 1920) is the whole safety margin. The lyrics
         can therefore never sit on top of the video, no matter what the video
         is shaped like — that is the "push it right if it would overlap"
         requirement, guaranteed by construction rather than measured.
         If the media column moves, this number moves with it (51% + 50%).
         The visible air between the two is the left padding below (asked
         for the words to sit near the video with a little space). */
      left: 52.5%;
      /* Runs to the right edge, exactly as the old 57.4% / 42.6% pair did, so
         the wider pane only buys space for the words instead of leaving a
         dead strip at the screen edge. */
      width: 47.5%;
      /* No vertical inset. The pane used to start 84px inside
         the screen, so the scrollport ended on a padded edge and a line leaving
         it read as chopped off rather than as leaving the monitor. With the
         inset gone the words run edge to edge and the mask does the fading. */
      padding: 0 clamp(24px, 4vw, 72px);
      box-sizing: border-box;
    }
    /* Music videos only: the words start just past the video's own edge instead
       of the standard 4vw inset, which is what put the old 176px void there.
       Scoped to has-video so cover art keeps its 4vw text inset. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics {
      padding-left: clamp(18px, 2vw, 36px);
    }
    /* "Background" layout: media fills the overlay (3% padding = card inset
       via the video's inline padding-box sizing); lyrics float on the right
       with a backdrop blur and a left-edge fade. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-media {
      left: 0;
      width: 100%;
      padding: 0;
      box-sizing: border-box;
      z-index: 1;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-media > video {
      border-radius: 0;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-lyrics {
      left: 61%;
      width: 39%;
      min-width: 320px;
      /* Asymmetric padding so lyric text starts past the left-edge fade.
         No vertical inset, same as the side layout: the column owns the full
         screen height and dissolves at the monitor's own edges. */
      padding: 0 clamp(24px, 4vw, 72px) 0 clamp(80px, 6vw, 120px);
      box-sizing: border-box;
      /* No permanent black surface: the shade layer below is the readability
         layer (shade + blur), and it is always on while the lyrics are. */
      background: transparent;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, rgba(0,0,0,.5) 4%, #000 16%, #000 100%);
      mask-image: linear-gradient(90deg, transparent 0, rgba(0,0,0,.5) 4%, #000 16%, #000 100%);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      transition:
        opacity 1.1s ease,
        left .45s cubic-bezier(.22, .61, .36, 1),
        width .45s cubic-bezier(.22, .61, .36, 1),
        transform .45s cubic-bezier(.22, .61, .36, 1),
        padding .45s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-lyrics-shade {
      display: none;
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      /* Starts just left of the lyric pane (which begins at 61%), not out in the
         middle of the video: a deep blur that begins 4% early reads as a haze
         over the picture rather than a frost behind the words. */
      left: 57%;
      z-index: 2;
      pointer-events: none;
      opacity: var(--ym-sl-fs-lyrics-shade-opacity, 0);
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(0,0,0,.16) 14%,
        rgba(0,0,0,.62) 52%,
        rgba(0,0,0,.9) 100%
      );
      -webkit-mask-image: linear-gradient(90deg, transparent 0, rgba(0,0,0,.5) 8%, #000 24%, #000 100%);
      mask-image: linear-gradient(90deg, transparent 0, rgba(0,0,0,.5) 8%, #000 24%, #000 100%);
      /* The blur rides ON this layer, so it fades exactly with the black
         gradient: the layer's opacity scales the backdrop-filter output and the
         background together, and the mask clips both to the same left-edge
         fade. No separate element, no second timing to keep in sync. Radius is
         deliberately LIGHT: tuned it down three times (30-56px, then 24-46px,
         then 16-30px all still read as too much frost over the picture), so this
         is a soft-focus veil rather than a deep blur. Saturation stays lifted so
         colour survives it - a plain blur greys the video out. */
      -webkit-backdrop-filter: blur(clamp(8px, 0.75vw, 18px)) saturate(1.3);
      backdrop-filter: blur(clamp(8px, 0.75vw, 18px)) saturate(1.3);
      /* left rides with the lyric column on a layout switch: the two are the
         same visual edge, so a snapped shade under a sliding column reads as a
         torn mask. It is a plain gradient layer (no backdrop-filter over video,
         see the has-video rule), so animating it costs nothing. */
      transition: opacity .22s ease, left .52s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-lyrics-shade {
      display: block;
      opacity: var(--ym-sl-fs-lyrics-shade-opacity, 0);
    }
    /* Video + Lyrics: the lyric column floats over the ambient backdrop too
       (Kawarp for songs and still uploads, a blurred frame for live MVs), and
       that backdrop can be just as bright as a full-bleed video. Same shade and
       blur, sized to each variant's own column: cover art starts at 44%, MVs at
       52.5%. Portrait hides it further down, where both compositions drop the
       column and the words no longer sit beside the picture. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics-shade {
      display: block;
      left: 44%;
      opacity: var(--ym-sl-fs-lyrics-shade-opacity, 0);
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics-shade {
      left: 52.5%;
    }
    /* Low performance mode: the shade keeps its darkening and loses its blur.
       backdrop-filter is a render surface that has to be re-rasterized whenever
       anything underneath changes, and in the video background layout what is
       underneath is a live 24fps picture - so this single rule is the most
       expensive effect left in fullscreen (see DEVELOPERS/RENDERING-CPU-VS-GPU.txt,
       "backdrop-filter (GPU, but expensive)"). The black gradient is what carries
       readability; the frost is the part that costs. */
    body.ym-sl-perf-low .ym-sl-fs-lyrics-shade {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    /* Low mode had the right idea for every mode. The shade is a full-column
       backdrop-filter, so it has to re-blur its backdrop whenever that backdrop
       changes - and in fullscreen the backdrop is the Kawarp canvas, which is
       an ANIMATED surface (fed by the live video on a music video). Measured
       on the reference machine, dropping it moved the median frame from 23.3ms
       to 17.7ms. The black gradient is what carries readability; the frost is
       the part that costs, so it only survives over a still backdrop. */
    .ym-sl-fs-overlay.ym-sl-fs-has-kawarp .ym-sl-fs-lyrics-shade,
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-lyrics-shade {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    /* The fullscreen overlay is opaque and covers the page chrome completely,
       but Dynamic's player-bar frost and the nav-bar frost keep reading and
       blurring their backdrop underneath it - live video included. Nothing
       behind the overlay is visible, so that work is switched off for as long
       as the overlay exists. */
    body:has(> .ym-sl-fs-overlay) #player-bar-background,
    body:has(> .ym-sl-fs-overlay) .ym-dynamic-bar-blur,
    body:has(> .ym-sl-fs-overlay) #nav-bar-background {
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-lyrics > * {
      position: relative;
      z-index: 3;
    }
    /* The readability layer is constant (see syncFullscreenLyricsShade); only
       its state - lyrics visible or not - moves its opacity. */
    /* During a long intro or instrumental gap, dim rather than remove the
       lyrics so the video remains the visual focus. The hidden-toggle rule
       below still wins when the user explicitly hides lyrics. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-gap-dim .ym-sl-fs-lyrics {
      opacity: 0;
    }
    /* Let the user preview the hidden lyric area without fully bringing it
       back. Opacity 0 still participates in hit testing, so hovering the
       lyric panel can reveal it at a quiet 60% while the gap continues. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-gap-dim .ym-sl-fs-lyrics:hover {
      opacity: .6;
    }
    /* Intro lyrics stay completely hidden until the first real line begins,
       including on hover. Later instrumental gaps retain the 60% hover preview. */
    /* TTML credits stay visible while the lyrics auto-hide.
       The panel is no longer faded out WHOLESALE, because the credits footer lives
       INSIDE it, after the last line — fading the panel took the attribution with
       it. Instead only the LINE elements are hidden, so the credits survive.
       - visibility, not display: the renderer measures line boxes for scrolling,
         and display:none would collapse them all to zero.
       - the credits are stuck to the bottom of the scrollport, because their
         natural position is below the fold while the lines still occupy space. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-intro-dim .ym-sl-fs-lyrics,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-intro-dim .ym-sl-fs-lyrics:hover,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-final-dim .ym-sl-fs-lyrics,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-final-dim .ym-sl-fs-lyrics:hover {
      opacity: 1;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-intro-dim .VirtualLyricsContainer > *:not(.ym-sl-credits),
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-final-dim .VirtualLyricsContainer > *:not(.ym-sl-credits) {
      visibility: hidden;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-intro-dim .ym-sl-credits,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-final-dim .ym-sl-credits {
      position: sticky;
      bottom: 0;
    }
    /* Background-mode toggle state: the live lyrics stay mounted so timing
       continues, but the whole lyric surface fades away smoothly. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-lyrics-hidden .ym-sl-fs-lyrics {
      opacity: 0;
      pointer-events: none;
      transform: translateX(18px);
    }
    /* Fullscreen playback controls use the same chrome as the layout controls,
       but their placement follows the selected layout. */
    /* ===== fullscreen playback chrome: floating play chip + bottom scrubber =====
       The container is a full-overlay layer (inset: 0) and the chip and
       scrubber are positioned absolutely inside it. It MUST be full size, not
       a zero-height anchor pinned to the bottom: an absolutely-positioned
       child resolves top against its containing block, so with the old
       inset: auto 0 0 0 anchor a top of 775px put the chip at y=1855, off
       the bottom of the screen — out of view.
       Full size also keeps every existing bottom value resolving to the same
       pixel, since the container's bottom edge was already the overlay's.
       pointer-events stays none so the layer never blocks the lyrics; the chip
       and scrubber re-enable it for themselves. */
    .ym-sl-fs-player-controls {
      position: absolute;
      inset: 0;
      z-index: 21;
      pointer-events: none;
      /* The fade-IN of a mode change. .22s out / .32s in — a deliberate, visible
         dissolve so the controls read as "polished" rather than snapping. The out
         is a touch quicker than the in so the restructure settles while the layer
         is already near-invisible, and the reveal eases back in with the media. */
      transition: opacity .32s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-idle .ym-sl-fs-player-controls {
      opacity: 1;
      pointer-events: none;
    }
    /* ===== chrome dissolve on a MODE CHANGE ================
       Between cover and MV the whole control column restructures — the credit
       moves from under the artwork to under the video, the transport changes from
       a spread row to a centred one, the volume changes rows. None of that can be
       interpolated, so the column fades out, the swap happens while it is
       invisible, and it fades back in with the media.
       MV -> MV never gets this class: nothing restructures, so the chrome must
       stay perfectly still and only the media dissolves.
       MUST stay AFTER the .ym-sl-fs-idle rule above: same specificity (0,3,0), so
       source order decides — and the idle rule forces opacity 1, which is the
       state the overlay is in most of the time. */
    .ym-sl-fs-overlay.ym-sl-fs-chrome-out .ym-sl-fs-player-controls {
      opacity: 0;
      transition: opacity .22s ease;
    }
    /* Floating play chip (prev / play / next + volume), centered just above the
       scrubber.
       NO SURFACE AT ALL (then x3): the border was
       removed, then the inset shadows, then the fill was cut from 7% to 2.5%
       (measured: the 7% fill read as a hard 49 -> 66 step, and
       0.93*49 + 0.07*255 = 63.6 pinned it exactly on the fill). At 2.5% the
       step is still ~8/255 against a bright backdrop, which is still visible,
       because ANY fill over a backdrop IS an edge - there is no alpha that
       shows a surface without also showing its boundary. So the fill, the
       backdrop filter and the drop shadow are all gone. The transport buttons
       keep their own circles, so the group still reads as controls; only the
       container outline disappears.
       If a surface is ever wanted back, the two options that do not draw a
       line are a radial-gradient fill that fades to zero AT the box edge
       (radial-gradient(closest-side, ...)) or a dark scrim - not a flat tint. */
    .ym-sl-fs-play-chip {
      position: absolute;
      left: 50%;
      bottom: 46px;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 10px 16px;
      border-radius: 999px;
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 0;
      pointer-events: auto;
      transition: opacity .22s ease, background-color .3s ease,
        transform .35s cubic-bezier(.22,.61,.36,1);
    }
    .ym-sl-fs-overlay:hover .ym-sl-fs-play-chip,
    .ym-sl-fs-overlay:focus-within .ym-sl-fs-play-chip {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-idle .ym-sl-fs-play-chip {
      opacity: 0;
      pointer-events: none;
    }
    /* The three transport buttons as one group. Spaced 14px to match the chip's
       own gap, so wrapping them changed nothing visually — it exists so the side
       layout can centre THIS group on the title. */
    .ym-sl-fs-transport {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    /* Transient "no lyrics" notice — fullscreen Video Background only. The lyrics
       panel there stays hidden until the first line actually plays, so a track
       with no lyrics used to fail completely silently. Sits dead
       centre, non-interactive, and self-dismissing, so it can never block the
       video it is reporting on. */
    .ym-sl-fs-notice {
      position: absolute;
      /* Right-hand side, aligned with the lyrics column's own right padding so it
         reads as part of that surface rather than a floating banner, and keeps
         the middle of the video clear. */
      top: 50%;
      right: clamp(24px, 4vw, 72px);
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 20px;
      border-radius: 14px;
      background: rgba(10, 11, 14, .74);
      -webkit-backdrop-filter: blur(14px) saturate(120%);
      backdrop-filter: blur(14px) saturate(120%);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: .01em;
      /* The load-failure line is far longer than "No lyrics found.", so wrap
         instead of running off the screen. */
      max-width: min(560px, 80vw);
      line-height: 1.4;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-50%) scale(.97);
      transition: opacity .3s ease, transform .3s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-notice.show {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }
    /* Dismissal countdown. Tabular figures so the pill does not twitch as the
       digit's width changes. */
    .ym-sl-fs-notice-count {
      flex: 0 0 auto;
      min-width: 1.1em;
      text-align: right;
      font-size: 13px;
      font-weight: 700;
      color: rgba(255, 255, 255, .6);
      font-variant-numeric: tabular-nums;
    }
    @media (prefers-reduced-motion: reduce) {
      .ym-sl-fs-notice,
      .ym-sl-fs-notice.show {
        transform: translateY(-50%);
        transition: opacity .3s ease;
      }
    }
    .ym-sl-fs-options-button {
      white-space: nowrap;
    }
    /* Volume: a thin bar beside the chip (the mute button was removed) */
    .ym-sl-fs-volume-group {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-left: 6px;
      padding-right: 0; /* the chip's own 16px right padding absorbs the hover grow */
      margin-left: 4px;
      border-left: 1px solid rgba(255,255,255,.16);
      /* No reserved width on the chip: the custom <div> slider expands via a
         composited transform, which never reflows the chip and leaves no gap. */
      flex: 0 0 auto;
    }
    /* Scale glyphs bracketing the volume bar. They are markers, not controls:
       the slider itself stays the only thing that takes a drag or a key. Only the
       cover-art column reveals them (see its layout block) - the video and
       video-background layouts keep the bare bar beside the time row. */
    .ym-sl-fs-volume-icon {
      display: none;
      fill: none;
      stroke: currentColor;
      /* 2.6 on the 24-grid draws at ~2.4px once the glyph is 22px, which is the
         weight of the transport's redrawn shuffle / repeat strokes. At 1.7 the
         speaker vanished beside the 3px bar. */
      stroke-width: 2.6;
      stroke-linecap: round;
      stroke-linejoin: round;
      pointer-events: none;
    }
    /* Bottom scrubber: a full-width thin line pinned to the bottom edge. It is
       hidden by default and only appears while the overlay is hovered/focused,
       so the video stays clean when the pointer is away. */
    .ym-sl-fs-scrubber {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 18px;
      pointer-events: auto;
      opacity: 0;
      transition: opacity .25s ease, background-color .3s ease;
    }
    .ym-sl-fs-overlay:hover .ym-sl-fs-scrubber,
    .ym-sl-fs-overlay:focus-within .ym-sl-fs-scrubber {
      opacity: 1;
    }
    .ym-sl-fs-time {
      flex: 0 0 auto;
      min-width: 38px;
      color: rgba(255,255,255,.82);
      /* SpicyLyrics, same family the credit and the lyrics themselves use, so the
         progress readouts are part of the composition rather than browser chrome
. Written as longhands instead of the font shorthand:
         the shorthand RESETS font-variant-numeric, which would drop the
         tabular-nums below and make the clock twitch as the digits change.
         600 maps to the bundled LyricsSemibold face. */
      font-family: "SpicyLyrics", "Noto Sans Georgian", "Vazirmatn",
        "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif;
      font-weight: 600;
      font-size: 11px;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      letter-spacing: .02em;
      user-select: none;
      /* NO shadow: the times sit in the dark band under the
         media, so they never need one - and it read as a smudge behind the
         numerals. Spelled out as none rather than deleting the line, because
         text-shadow INHERITS and an ancestor could reintroduce it. */
      text-shadow: none;
    }
    .ym-sl-fs-time[data-time="total"] { text-align: right; }
    /* thin range track for the seek bar (volume is a custom <div> slider) */
    .ym-sl-fs-scrubber input[type="range"] {
      appearance: none;
      -webkit-appearance: none;
      height: 3px;
      margin: 0;
      border: 0;
      border-radius: 999px;
      background: transparent;
      outline: none;
      cursor: pointer;
      transition: height .18s ease;
    }
    .ym-sl-fs-scrubber .ym-sl-fs-player-seek { flex: 1 1 auto; min-width: 0; }
    /* seek fill driven by --slider-fill (percent) and --ym-sl-fs-accent. The
       accent defaults to soft white; an artwork-derived color can override it
       by setting --ym-sl-fs-accent on the overlay. */
    .ym-sl-fs-player-seek {
      --slider-fill: 0%;
      --seek-played: var(--ym-sl-fs-accent, rgba(255,255,255,.92));
      --seek-unplayed: rgba(255,255,255,.18);
    }
    .ym-sl-fs-player-seek::-webkit-slider-runnable-track {
      height: 3px;
      border-radius: 999px;
      background: linear-gradient(to right,
        var(--seek-played) 0%, var(--seek-played) var(--slider-fill),
        var(--seek-unplayed) var(--slider-fill), var(--seek-unplayed) 100%);
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.16),
        inset 0 1px 0 rgba(255,255,255,.22);
      transition: height .18s ease;
    }
    .ym-sl-fs-player-seek::-moz-range-track { height: 3px; border-radius: 999px; background: var(--seek-unplayed); }
    .ym-sl-fs-player-seek::-moz-range-progress { height: 3px; border-radius: 999px; background: var(--seek-played); }
    .ym-sl-fs-player-seek::-webkit-slider-thumb {
      -webkit-appearance: none; appearance: none;
      width: 12px; height: 12px; margin-top: -4.5px;
      border: 0; border-radius: 50%;
      background: #fff; box-shadow: 0 1px 5px rgba(0,0,0,.5);
      opacity: 0; transition: opacity .2s ease;
    }
    .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-webkit-slider-thumb,
    .ym-sl-fs-player-seek:focus::-webkit-slider-thumb { opacity: 1; }
    .ym-sl-fs-player-seek::-moz-range-thumb {
      width: 12px; height: 12px; border: 0; border-radius: 50%;
      background: #fff; box-shadow: 0 1px 5px rgba(0,0,0,.5); opacity: 0;
    }
    .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-moz-range-thumb,
    .ym-sl-fs-player-seek:focus::-moz-range-thumb { opacity: 1; }
    /* Progress bar grows a little thicker while hovered for easier seeking. */
    .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek { height: 9px; }
    .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-webkit-slider-runnable-track { height: 9px; }
    .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-moz-range-track { height: 9px; }
    .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-moz-range-progress { height: 9px; }
    .ym-sl-fs-scrubber:hover .ym-sl-fs-player-seek::-webkit-slider-thumb { margin-top: -1.5px; }
    /* Slider drag state (the "for tmr" note): while a slider is
       being dragged the cursor hides — an accident found and liked. Scoped
       to the overlay so the rest of the page keeps its normal cursor. */
    .ym-sl-fs-overlay.ym-sl-fs-dragging,
    .ym-sl-fs-overlay.ym-sl-fs-dragging * {
      cursor: none !important;
    }
    /* Scrub time bubble: while dragging the seek bar, a small readout floats
       above the thumb showing the timestamp at that position. Absolutely
       positioned against .ym-sl-fs-player-controls (inset:0 over the overlay),
       with JS writing left/top from the live thumb ratio. */
    .ym-sl-fs-scrub-tip {
      position: absolute;
      transform: translateX(-50%);
      background: rgba(18, 18, 20, .92);
      color: #fff;
      font: inherit;
      font-size: 13px;
      font-weight: 600;
      line-height: 1;
      padding: 7px 10px;
      border-radius: 8px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transition: opacity .15s ease;
      z-index: 23;
    }
    .ym-sl-fs-scrub-tip.ym-sl-fs-scrub-tip-on { opacity: 1; }
    .ym-sl-fs-volume-tip {
      min-width: 2.4ch;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }
    /* Transient arrow-key readout. Same dark pill as the scrub tip, with a
       hairline border so it still reads over bright artwork. JS writes its
       left/top from the live scrubber or volume rect. */
    .ym-sl-fs-hud {
      position: absolute;
      transform: translate(-50%, 4px);
      background: rgba(18, 18, 20, .92);
      color: #fff;
      font: inherit;
      font-size: 13px;
      font-weight: 600;
      line-height: 1;
      padding: 8px 12px;
      border: 1px solid rgba(255, 255, 255, .08);
      border-radius: 9px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, .35);
      white-space: nowrap;
      letter-spacing: .01em;
      font-variant-numeric: tabular-nums;
      pointer-events: none;
      opacity: 0;
      transition: opacity .16s ease, transform .2s cubic-bezier(.22, .61, .36, 1);
      z-index: 23;
    }
    .ym-sl-fs-hud.ym-sl-fs-hud-on {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    /* Custom <div> volume slider. The track is the hit area; the unplayed line is
       drawn with ::before, the white fill with .ym-sl-fs-volume-fill, the knob with
       .ym-sl-fs-volume-knob. On hover the track GROWS IN THICKNESS (3px -> 9px),
       the same way the seek bar does, so the two bars read as one family. The knob
       stays round and simply appears on hover/focus (no counter-scale needed). */
    .ym-sl-fs-player-volume {
      --vol-fill: 100%;
      position: relative;
      width: 150px;            /* long at rest; hover grows to 159px (stays short of pill edge) */
      height: 14px;            /* generous hit area */
      border-radius: 999px;
      cursor: pointer;
      touch-action: none;
      transform-origin: left center;
      transition: transform .28s cubic-bezier(.22,.61,.36,1);
    }
    .ym-sl-fs-player-volume::before {
      content: "";
      position: absolute;
      left: 0; right: 0; top: 50%; transform: translateY(-50%);
      height: 3px; border-radius: 999px;
      background: rgba(255,255,255,.18);
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.16),
        inset 0 1px 0 rgba(255,255,255,.22);
      transition: height .18s ease;
    }
    .ym-sl-fs-volume-fill {
      position: absolute;
      left: 0; top: 50%; transform: translateY(-50%);
      height: 3px; width: var(--vol-fill, 100%);
      border-radius: 999px;
      background: #fff;
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.16),
        inset 0 1px 0 rgba(255,255,255,.22);
      pointer-events: none;
      transition: height .18s ease;
    }
    .ym-sl-fs-volume-knob {
      position: absolute;
      top: 50%; left: var(--vol-fill, 100%);
      width: 12px; height: 12px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 4px rgba(0,0,0,.5);
      transform: translate(-50%, -50%);
      transform-origin: center;
      opacity: 0;
      transition: opacity .2s ease;
      pointer-events: none;
    }
    /* Grow the volume track in thickness on hover, matching the seek bar (3px -> 9px).
       The knob shows on hover and for KEYBOARD focus only (:focus-visible) — the
       plain :focus trigger is gone: pointerdown calls .focus(), which used to fade
       the knob in right as the drag hid the cursor, reading as a random circle
       animation. While a slider is being dragged the knob is
       suppressed outright: the moving fill edge is the indicator, and with the
       cursor hidden a fading-in circle reads as a glitch. */
    .ym-sl-fs-volume-group:hover .ym-sl-fs-player-volume::before,
    .ym-sl-fs-volume-group:hover .ym-sl-fs-volume-fill { height: 9px; }
    .ym-sl-fs-volume-group:hover .ym-sl-fs-volume-knob,
    .ym-sl-fs-player-volume:focus-visible .ym-sl-fs-volume-knob { opacity: 1; }
    .ym-sl-fs-overlay.ym-sl-fs-dragging .ym-sl-fs-volume-knob { opacity: 0 !important; }
    .ym-sl-fs-player-volume:focus-visible { outline: none; }
    .ym-sl-fs-player-volume:focus-visible::after {
      content: "";
      position: absolute;
      left: 0; right: 0; top: 50%; transform: translateY(-50%);
      height: 14px; border-radius: 999px;
      box-shadow: 0 0 0 2px rgba(255,255,255,.55);
    }
    /* NO SURFACE: the transport buttons float on the backdrop
       without a background, border or shadow. The translucent fill was the
       last layer of chrome - removed so they read as icons, not as buttons
       with skins. The hit target keeps its circular min-width/min-height.
       Bumped up a size (34->40, play 50->56) so they sit comfortably as the
       only thing in the row. */
    .ym-sl-fs-player-controls button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      min-width: 40px;
      min-height: 40px;
      padding: 0;
      border: 0;
      /* No focus ring. Chrome draws a default focus outline on click, which
         appeared as a "circle border" behind the like/dislike buttons. These are fullscreen transport buttons with a dedicated
         active pill, so the focus ring is redundant. */
      outline: none;
      -webkit-tap-highlight-color: transparent;
      border-radius: 50%;
      position: relative;
      background: none;
      color: rgba(255, 255, 255, .88);
      font: inherit;
      font-size: 14px;
      line-height: 1;
      cursor: pointer;
      box-shadow: none;
      transition: transform .22s cubic-bezier(.34,1.56,.64,1),
        color .22s ease;
    }
    .ym-sl-fs-player-controls button:focus,
    .ym-sl-fs-player-controls button:focus-visible,
    .ym-sl-fs-player-controls button:focus-within { outline: none; }
    .ym-sl-fs-player-controls button:hover {
      transform: scale(1.08);
      background: none;
      color: #fff;
      box-shadow: none;
    }
    /* The transport reads better as a fixed-size row: hover changes colour
       only on these, never size. Likes/options keep their existing feedback. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle:hover,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat:hover,
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev:hover,
    .ym-sl-fs-player-controls .ym-sl-fs-player-next:hover,
    .ym-sl-fs-player-controls .ym-sl-fs-player-play:hover {
      transform: none;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle:active,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat:active,
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev:active,
    .ym-sl-fs-player-controls .ym-sl-fs-player-next:active,
    .ym-sl-fs-player-controls .ym-sl-fs-player-play:active {
      transform: scale(.92);
    }
    .ym-sl-fs-player-controls button:active { transform: scale(.92); }
    /* Prev / Next flank the play button and wants them BIGGER than the
       40px shuffle/repeat pair, but still smaller than play. Play/pause is the
       primary control so it stays the largest. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev,
    .ym-sl-fs-player-controls .ym-sl-fs-player-next {
      width: 48px;
      height: 48px;
      min-width: 48px;
      min-height: 48px;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-play {
      width: 64px;
      height: 64px;
      min-width: 64px;
      min-height: 64px;
      font-size: 22px;
      background: none;
    }
    /* The play/pause morph is two overlapping fills. currentColor is
       translucent, so stacking the paths makes the overlap brighter; paint the
       paths opaque and fade the whole SVG to the same .88 / 1 hover weight. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-play .ym-sl-fs-play-morph {
      fill: #fff;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-play svg {
      opacity: .88;
      transition: opacity .22s ease;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-play:hover svg { opacity: 1; }
    /* Spicy transport glyphs. Prev / Next use a 35x20 viewBox (a wide double
       triangle) and Play / Pause a narrow one, so each is sized on its own
       instead of inheriting a single font-size. pointer-events:none keeps the
       button itself the only hit target. Sizes bumped to match the larger
       hit targets. */
    .ym-sl-fs-player-controls button svg {
      width: 22px;
      height: 22px;
      display: block;
      pointer-events: none;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-next svg {
      width: 26px;
      height: 26px;
    }
    /* Skip conveyor: the pair shifts by one triangle, while a clipped copy of
       the left triangle grows into the slot it vacated. The SVG clips the
       departing triangle at its right edge; the button never moves. Prev uses
       the same local animation on a 180deg-rotated glyph, so it runs left. */
    .ym-sl-fs-player-controls .ym-sl-fs-skip-icon { overflow: hidden; }
    .ym-sl-fs-player-controls .ym-sl-fs-skip-new {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: left center;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-next.is-skipping .ym-sl-fs-skip-shift,
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev.is-skipping .ym-sl-fs-skip-shift {
      animation: ym-sl-fs-skip-shift .34s cubic-bezier(.22,.61,.36,1) both;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-next.is-skipping .ym-sl-fs-skip-new,
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev.is-skipping .ym-sl-fs-skip-new {
      animation: ym-sl-fs-skip-new .24s cubic-bezier(.22,.61,.36,1) .12s both;
    }
    @keyframes ym-sl-fs-skip-shift {
      from { transform: translateX(0); }
      to   { transform: translateX(17.5px); }
    }
    @keyframes ym-sl-fs-skip-new {
      from { opacity: 0; transform: scaleX(.2); }
      to   { opacity: 1; transform: scaleX(1); }
    }
    /* Shuffle / repeat are redrawn as thick strokes, so they need a little more
       room than the old solid 22px glyphs to carry the same weight beside the
       prev/next triangles and the play button. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat svg {
      width: 26px;
      height: 26px;
      transform-box: view-box;
      transform-origin: 50% 50%;
      transition: filter .25s ease, color .25s ease;
    }
    /* The click hands the two rails off to two dashes on one rounded-square
       track. Those dashes are strokes of the path itself, so they turn and bend
       through every corner instead of sliding as straight bars. */
    /* The repeat motion animates stroke-dashoffset and offset-distance, both
       paint properties. Without its own layer that repaint walks the fullscreen
       overlay and the SVG undersamples the display (~40-70fps). Promoting this
       26px SVG keeps the repaint local, so the same keyframes follow the
       display's actual refresh cadence. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat > svg {
      overflow: visible;
      transform: translateZ(0);
      will-change: transform;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping > svg {
      color: #fff;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-repeat-track {
      opacity: 0;
      stroke-dasharray: 32.15 17.85;
      stroke-dashoffset: 0;
      transition: opacity .06s linear;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-repeat-rail {
      transition: opacity .06s linear;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-repeat-head {
      opacity: 0;
      transform-box: fill-box;
      offset-distance: 0%;
      transition: opacity .06s linear;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-repeat-head-top {
      offset-path: path("M20.2 5A1.6 1.6 0 0 1 21.8 6.6V14.5H21V15.5A3.5 3.5 0 0 1 17.5 19H3.8A1.6 1.6 0 0 1 2.2 17.4V9.5H3V8.5A3.5 3.5 0 0 1 6.5 5H20.2Z");
      offset-anchor: 100% 50%;
      offset-rotate: auto;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-repeat-head-bottom {
      offset-path: path("M3.8 19A1.6 1.6 0 0 1 2.2 17.4V9.5H3V8.5A3.5 3.5 0 0 1 6.5 5H20.2A1.6 1.6 0 0 1 21.8 6.6V14.5H21V15.5A3.5 3.5 0 0 1 17.5 19H3.8Z");
      offset-anchor: 0% 50%;
      offset-rotate: auto -180deg;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping .ym-sl-fs-repeat-rail {
      opacity: 0;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping .ym-sl-fs-repeat-track,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping .ym-sl-fs-repeat-head {
      opacity: 1;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping .ym-sl-fs-repeat-track {
      animation: ym-sl-fs-repeat-track .62s cubic-bezier(.65, 0, .35, 1) both;
      will-change: stroke-dashoffset;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping .ym-sl-fs-repeat-head {
      animation: ym-sl-fs-repeat-head .62s cubic-bezier(.65, 0, .35, 1) both;
      will-change: offset-distance;
    }
    @keyframes ym-sl-fs-repeat-track {
      from { stroke-dashoffset: 0; }
      to   { stroke-dashoffset: -100; }
    }
    @keyframes ym-sl-fs-repeat-head {
      from { offset-distance: 0%; }
      to   { offset-distance: 100%; }
    }
    /* The numeral is always present and crossfades with the repeat mode, so
       entering and leaving repeat-one never swaps the icon. */
    .ym-sl-fs-player-controls .ym-sl-fs-repeat-one {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: 50% 50%;
      transform: scale(.55);
      transition: opacity .28s ease,
        transform .36s cubic-bezier(.34, 1.56, .64, 1);
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat[data-repeat-one="true"] .ym-sl-fs-repeat-one {
      opacity: 1;
      transform: scale(1);
    }
    /* Repeat-one keeps a quiet halo after the loop lands. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat[data-repeat-one="true"] > svg {
      color: #fff;
      filter: drop-shadow(0 0 4px rgba(255, 255, 255, .38));
    }
    /* A faint glyph-shaped hover halo, not a button surface. The repeat-one
       halo is kept underneath it so engaging repeat-one doesn't lose its cue. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle:hover > svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat:hover > svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev:hover > svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-next:hover > svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-play:hover > svg {
      filter: drop-shadow(0 0 5px rgba(255, 255, 255, .4));
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat[data-repeat-one="true"]:hover > svg {
      filter: drop-shadow(0 0 4px rgba(255, 255, 255, .38)) drop-shadow(0 0 5px rgba(255, 255, 255, .4));
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-prev svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-next svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-play svg {
      transition: filter .22s ease;
    }
    /* Shuffle keeps the simple, readable idea: the engaged dot fades in and
       the icon gives one soft glow pulse. No spinning picture. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle.active > svg {
      color: #fff;
      filter: drop-shadow(0 0 3px rgba(255, 255, 255, .32));
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle.active:hover > svg {
      filter: drop-shadow(0 0 5px rgba(255, 255, 255, .4));
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle.is-glowing > svg {
      animation: ym-sl-fs-shuffle-glow .52s ease-in-out both;
    }
    @keyframes ym-sl-fs-shuffle-glow {
      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 0 rgba(255, 255, 255, 0)); }
      48%      { transform: scale(1.08); filter: drop-shadow(0 0 7px rgba(255, 255, 255, .65)); }
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-play svg {
      width: 32px;
      height: 32px;
    }
    /* Active shuffle/repeat: no fill (the buttons float), so the engaged signal
       is the full-white icon + the dot under it (see ::after below). Do NOT put
       a permanent scale here - it would make the button look hovered forever and
       swallow the click/press animation (the scale is a hover/press thing only,
       on the generic :hover / :active rules). */
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle.active,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.active {
      background: none;
      color: #fff;
      box-shadow: none;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle.active:hover,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.active:hover {
      background: none;
    }
    /* YTM-style "engaged" dot under the icon. With no fill on the buttons now,
       the active state was only a faint whitening of the glyph (.88 -> #fff),
       which reads as "no change". This dot is the unambiguous ON signal for
       shuffle and for repeat-all (repeat-one already carries the "1" in its
       glyph, so it needs no extra cue). The dot is always present but
       opacity-gated so it fades in/out instead of popping. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle::after,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat::after {
      content: "";
      position: absolute;
      bottom: 2px;
      left: 50%;
      transform: translateX(-50%);
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #fff;
      opacity: 0;
      transition: opacity .2s ease;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle.active::after,
    .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.active::after {
      opacity: 1;
    }
    @media (prefers-reduced-motion: reduce) {
      .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping .ym-sl-fs-repeat-track,
      .ym-sl-fs-player-controls .ym-sl-fs-player-repeat.is-looping .ym-sl-fs-repeat-head,
      .ym-sl-fs-player-controls .ym-sl-fs-player-shuffle.is-glowing > svg {
        animation: none;
      }
    }
    /* Like / Dislike are OUR OWN buttons. Inactive = outline thumb; active =
       the GLYPH itself fills (CSS fills the path) — there is NO background pill
       / circle highlight (evening: "take away the little circle
       highlight"). Container-agnostic selectors so the rule works regardless of
       which layer the button is parented to. */
    .ym-sl-fs-player-like.active,
    .ym-sl-fs-player-dislike.active {
      background: none;
      color: #fff;
      box-shadow: none;
    }
    .ym-sl-fs-player-like.active:hover,
    .ym-sl-fs-player-dislike.active:hover {
      background: none;
    }
    /* Filled glyph when engaged: CSS fill overrides the path's presentation
       fill="none", turning the outline thumb into a solid filled thumb. The
       stroke stays currentColor (set by fsThumbSvg) so the edges read cleanly. */
    .ym-sl-fs-player-like.active svg path,
    .ym-sl-fs-player-dislike.active svg path {
      fill: currentColor;
    }
    /* Edge placement: the buttons live in the CONTROLS LAYER (inset:0,
       z-index 21) so they paint ABOVE the lyrics pane (z-index 3) instead of
       being hidden behind it in side layout. JS (positionFsEdgeButtons) pins
       them to the media pane's left/right edges and to the transport row's
       vertical centre, so they sit on the same line as the controls. */
    .ym-sl-fs-player-controls .ym-sl-fs-player-like--edge,
    .ym-sl-fs-player-controls .ym-sl-fs-player-dislike--edge {
      position: absolute;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: none;
      outline: none;
      color: rgba(255, 255, 255, .88);
      cursor: pointer;
      pointer-events: auto;
      box-shadow: none;
      -webkit-tap-highlight-color: transparent;
      transition: transform .22s cubic-bezier(.34, 1.56, .64, 1), color .22s ease;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-like--edge:hover,
    .ym-sl-fs-player-controls .ym-sl-fs-player-dislike--edge:hover {
      transform: scale(1.08);
      color: #fff;
      background: none;
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-like--edge:active,
    .ym-sl-fs-player-controls .ym-sl-fs-player-dislike--edge:active {
      transform: scale(.92);
    }
    .ym-sl-fs-player-controls .ym-sl-fs-player-like--edge svg,
    .ym-sl-fs-player-controls .ym-sl-fs-player-dislike--edge svg {
      width: 24px;
      height: 24px;
      display: block;
      pointer-events: none;
    }
    /* Cover-art-only songs: NO rating buttons at all. The
       Apple Music stack already carries title, progress, transport and volume;
       two more edge controls read as clutter, and there is no video edge to
       anchor them to. Music videos keep them. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-player-like--edge,
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-player-dislike--edge {
      display: none;
    }
    /* Video Background layout: the video IS the backdrop, so the edge rating
       buttons would float over it with nothing to anchor to. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-player-like--edge,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-player-dislike--edge {
      display: none;
    }
    /* offset rail (inside the options overlay) — keep the original look */
    .ym-sl-fs-control-offset input[type="range"] {
      appearance: none;
      -webkit-appearance: none;
      height: 6px;
      width: 104px;
      border: 0;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(255,255,255,.96) 0 var(--slider-fill, 50%), rgba(255,255,255,.18) var(--slider-fill, 50%) 100%);
      outline: none;
      accent-color: #fff;
      cursor: pointer;
      transition: none;
    }
    .ym-sl-fs-options-body .ym-sl-fs-control-offset {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .ym-sl-fs-options-body .ym-sl-fs-control-offset input[type="range"] {
      width: 100%;
      min-width: 0;
    }
    .ym-sl-fs-control-offset input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 14px;
      height: 14px;
      margin-top: -4px;
      border: 2px solid rgba(255,255,255,.94);
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 5px rgba(0,0,0,.45);
    }
    .ym-sl-fs-control-offset input[type="range"]::-moz-range-thumb {
      width: 12px;
      height: 12px;
      transform: translateY(-1px);
      border: 2px solid rgba(255,255,255,.94);
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 5px rgba(0,0,0,.45);
    }
    .ym-sl-fs-controls {
      position: absolute;
      top: 18px;
      right: 18px;
      left: auto;
      bottom: auto;
      z-index: 20;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 10px;
      /* No surface at all - same defect as the play chip, same fix. */
      border: 0;
      border-radius: 10px;
      background: none;
      box-shadow: none;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity .18s ease, background-color .3s ease,
        transform .35s cubic-bezier(.22,.61,.36,1);
    }
    .ym-sl-fs-overlay:hover .ym-sl-fs-controls,
    .ym-sl-fs-overlay:focus-within .ym-sl-fs-controls {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
    /* Idle state: after a couple of seconds without input, hide the pointer in
       EVERY layout, and hide the hover controls in EVERY layout too: Side / Lyrics Only used to keep the chrome,
       but the EXIT + LAYOUT buttons need to clear on idle there as well; they
       were the only chrome that stayed). The play chip and scrubber still stay
       put in those layouts (see the end-of-sheet block). Placed AFTER the
       :hover rule above so it wins on equal specificity. Any input clears it. */
    .ym-sl-fs-overlay.ym-sl-fs-idle,
    .ym-sl-fs-overlay.ym-sl-fs-idle * {
      cursor: none !important;
    }
    .ym-sl-fs-overlay.ym-sl-fs-idle .ym-sl-fs-controls {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
    }
    /* Bright-video controls scrim (QoL). The chrome is
       surface-less by design, so over a bright / near-white music video it
       washes out completely — worst once the lyrics (and their readability
       shade) are hidden. In Video Background only, a high sampled video
       brightness adds a soft dark fill so the transport stays legible. Toggled
       from setFullscreenBrightVideo() with hysteresis; the fill is transitioned
       so crossing the threshold is not a hard pop. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-bright-video .ym-sl-fs-controls,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-bright-video .ym-sl-fs-play-chip,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-bright-video .ym-sl-fs-scrubber {
      background: rgba(0,0,0,.45);
    }
    /* ===== idle "fill ring" cursor indicator ==============================
       Shown in fullscreen once the pointer STOPS moving: a hollow white ring
       at the cursor that draws itself over the idle delay (a stroke-dashoffset
       tween on an SVG circle, so it reads as a ring filling — NOT a solid
       disc), then fades out and shrinks as the chrome auto-hides. An
       affordance that the cursor is about to vanish. Driven
       by resetFsIdleRing() / leaveFsIdleRing(); position via CSS vars. */
    .ym-sl-fs-idle-ring {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 30;
      width: 36px;
      height: 36px;
      margin: -18px 0 0 -18px;
      pointer-events: none;
      opacity: 0;
      transform: translate(var(--ym-sl-fs-idle-ring-x, 0px), var(--ym-sl-fs-idle-ring-y, 0px)) scale(1);
      transition: opacity .3s ease, transform .3s ease;
    }
    .ym-sl-fs-idle-ring.visible { opacity: 1; }
    .ym-sl-fs-idle-ring.leaving {
      opacity: 0;
      transform: translate(var(--ym-sl-fs-idle-ring-x, 0px), var(--ym-sl-fs-idle-ring-y, 0px)) scale(.55);
    }
    .ym-sl-fs-idle-ring-svg { display: block; width: 36px; height: 36px; }
    .ym-sl-fs-idle-ring-track {
      fill: none;
      stroke: rgba(255,255,255,.25);
      stroke-width: 2.5;
    }
    .ym-sl-fs-idle-ring-fill {
      fill: none;
      stroke: #fff;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-dasharray: var(--ym-sl-fs-idle-ring-circ, 94.25);
      stroke-dashoffset: var(--ym-sl-fs-idle-ring-circ, 94.25);
      transform-box: fill-box;
      transform-origin: center;
      transform: rotate(-90deg);
    }
    .ym-sl-fs-idle-ring.visible .ym-sl-fs-idle-ring-fill {
      animation: ym-sl-fs-idle-ring-fill var(--ym-sl-fs-idle-ring-fill-ms, 1740ms) linear forwards;
    }
    @keyframes ym-sl-fs-idle-ring-fill {
      from { stroke-dashoffset: var(--ym-sl-fs-idle-ring-circ, 94.25); }
      to   { stroke-dashoffset: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      /* Keep the indicator (it is informative) but drop the shrink travel. */
      .ym-sl-fs-idle-ring, .ym-sl-fs-idle-ring.leaving { transition: opacity .2s ease; }
      .ym-sl-fs-idle-ring.leaving {
        transform: translate(var(--ym-sl-fs-idle-ring-x, 0px), var(--ym-sl-fs-idle-ring-y, 0px)) scale(1);
      }
    }
    .ym-sl-fs-controls button,
    .ym-sl-fs-controls select {
      min-height: 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      /* Borderless. */
      border: 0;
      border-radius: 7px;
      background: rgba(255,255,255,.08);
      color: rgba(255,255,255,.9);
      font: inherit;
      font-size: 11px;
      cursor: pointer;
    }
    .ym-sl-fs-controls button { padding: 0 10px; }
    .ym-sl-fs-controls select {
      padding: 0 24px 0 8px;
      /* Tell Chrome to paint the native dropdown popup in dark mode; without
         this it falls back to a white panel and the option text becomes
         white-on-white / unreadable. */
      color-scheme: dark;
    }
    .ym-sl-fs-controls select option {
      /* Explicit fallback for browsers that ignore color-scheme on <option>. */
      background: #1a1a1a;
      color: #fff;
    }
    .ym-sl-fs-controls button:hover,
    .ym-sl-fs-controls select:hover { background: rgba(255,255,255,.15); }
    /* The generic fullscreen button rule has higher specificity than a plain
       class selector, so keep the hidden state equally specific. */
    /* The Hide lyrics button is always in the flex row, but collapses to zero
       width outside Video Background. This makes appearance/disappearance
       interpolate instead of snapping between display:none and inline-flex. */
    .ym-sl-fs-controls button.ym-sl-fs-lyrics-toggle {
      display: inline-flex !important;
      overflow: hidden;
      max-width: 0;
      min-width: 0;
      width: 0;
      padding-left: 0 !important;
      padding-right: 0 !important;
      border-left-width: 0;
      border-right-width: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* Collapse the gap before the zero-width button, so the visible row is
         still Exit · Options · Layout when this sits before Layout. */
      margin-left: -8px;
      transform: scale(.88) translateY(4px);
      transition:
        max-width .32s cubic-bezier(.22,.61,.36,1),
        width .32s cubic-bezier(.22,.61,.36,1),
        margin-left .32s cubic-bezier(.22,.61,.36,1),
        padding .32s cubic-bezier(.22,.61,.36,1),
        border-width .32s cubic-bezier(.22,.61,.36,1),
        opacity .22s ease, visibility 0s linear .32s,
        transform .32s cubic-bezier(.22,.61,.36,1);
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video.ym-sl-fs-mode-background .ym-sl-fs-lyrics-toggle {
      max-width: 120px;
      width: auto;
      padding-left: 10px !important;
      padding-right: 10px !important;
      border-left-width: 1px;
      border-right-width: 1px;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      margin-left: 0;
      transform: scale(1) translateY(0);
      transition-delay: 0s;
    }
    /* Keep the reverse transition symmetric. The hidden state waits only for
       opacity/geometry to finish before becoming non-interactive, instead of
       instantly removing the button from layout. */
    .ym-sl-fs-controls button.ym-sl-fs-lyrics-toggle:not(:hover) {
      transition-delay: 0s;
    }
    /* ===== no-video fullscreen: icon-pill chrome =====
       Audio-only tracks get the Ableton-parity look: a pill control row of
       circular icon buttons plus a pill progress bar. Music videos keep their
       original text buttons and thin hover-only scrubber; per spec they gain
       the title and nothing else. So every control carries BOTH a text label
       and a glyph, and the variant decides which one is visible. */
    .ym-sl-fs-controls .ym-sl-fs-btn-icon { display: none; }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-controls .ym-sl-fs-btn-label {
      display: none;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-controls .ym-sl-fs-btn-icon {
      display: block;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-controls button.ym-sl-fs-icon-btn {
      width: 36px;
      height: 36px;
      min-width: 36px;
      max-width: 36px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: rgba(255,255,255,.85);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      cursor: pointer;
      transition: background .18s ease, color .18s ease, transform .18s ease;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-controls button.ym-sl-fs-icon-btn svg {
      width: 18px;
      height: 18px;
      display: block;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-controls button.ym-sl-fs-icon-btn:hover {
      background: rgba(255,255,255,.14);
      color: #fff;
      transform: scale(1.06);
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-controls button.ym-sl-fs-icon-btn:focus-visible {
      outline: 2px solid rgba(255,255,255,.7);
      outline-offset: 1px;
    }
    /* Hide-lyrics only expands in Video Background mode, which requires a live
       video. With no video it stays collapsed, sized for the round icon
       button; the music-video variant keeps its original text collapse above.
       NO BACKTICKS IN THIS COMMENT BLOCK - it sits inside a template literal. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video)
      .ym-sl-fs-controls button.ym-sl-fs-icon-btn.ym-sl-fs-lyrics-toggle {
      width: 0;
      min-width: 0;
      max-width: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: scale(.88);
      /* Cancel the pill's 2px flex gap; the hidden slot now sits between
         Options and Layout rather than after Layout. */
      margin-left: -2px;
      transition:
        width .32s cubic-bezier(.22,.61,.36,1),
        max-width .32s cubic-bezier(.22,.61,.36,1),
        margin-left .32s cubic-bezier(.22,.61,.36,1),
        opacity .22s ease, visibility 0s linear .32s,
        transform .32s cubic-bezier(.22,.61,.36,1);
    }
    /* Pill surface for the control row, no-video only. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-controls {
      border-radius: 999px;
      padding: 6px 8px;
      gap: 2px;
    }
    /* Pill progress bar, no-video only: always visible and substantial,
       replacing the thin hover-only line the music-video variant keeps.
       Sits at the very bottom of the stack, under the transport chip. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-scrubber {
      bottom: 24px;
      left: 50%;
      right: auto;
      width: min(620px, calc(100% - 48px));
      transform: translateX(-50%);
      opacity: 1;
      gap: 10px;
      padding: 10px 16px;
      /* No surface at all - see the long note on .ym-sl-fs-play-chip: any fill
         is an edge. */
      border: 0;
      border-radius: 999px;
      background: none;
      box-shadow: none;
    }
    /* Idle auto-hide is scoped to Video Background only: the
       transport chrome stays put in Side and Lyrics Only. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background:not(.ym-sl-fs-has-video).ym-sl-fs-idle .ym-sl-fs-scrubber {
      opacity: 0;
      pointer-events: none;
    }
    /* The MUSIC-VIDEO counterpart of the rule above. Without it
       the playbar stayed up on idle whenever the track HAS a video: the rule above
       is scoped to :not(.ym-sl-fs-has-video), and with the pointer still sitting
       inside the window the overlay's own :hover rule kept re-asserting opacity 1.
       So the transport chip faded out on the idle timer and the scrubber did not.
       Leaving the window already hid it — that drops :hover — which is why the bug
       only showed up when the mouse was parked inside the browser. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-has-video.ym-sl-fs-idle .ym-sl-fs-scrubber {
      opacity: 0;
      pointer-events: none;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-scrubber input[type="range"] {
      height: 4px;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-scrubber:hover input[type="range"] {
      height: 6px;
    }
    /* ===== fullscreen overlay title =====
       Both variants get a title, and in both it sits DIRECTLY UNDER the media
       (cover art / video), with the playback chrome under it. The media host
       is inset at the bottom by the mode rules further down so this band is
       always clear - the title never overlaps the artwork. */
    .ym-sl-fs-title {
      position: absolute;
      left: 50%;
      z-index: 22;
      pointer-events: none;
      display: block;
      text-align: center;
      max-width: 92%;
      color: #fff;
      /* Same family the lyrics themselves use, so the title reads as part of
         the same composition rather than as browser chrome. */
      font-family: "SpicyLyrics", "Noto Sans Georgian", "Vazirmatn",
        "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif;
      /* NO shadow. The credit sits in the dark band UNDER the
         media - over the overlay's own backdrop, never over the video itself -
         so it does not need one, and even the tight 3px version read as a smudge
         behind the text. It had already been cut down once, from an 18px blurred
         layer that read as a dark BACKDROP on bright art. */
      text-shadow: none;
      opacity: 0;
      transform: translateX(-50%) translateY(6px);
      animation: ym-sl-fs-title-in .34s cubic-bezier(.22,.61,.36,1) .08s forwards;
      /* Crossfade on a track change - see .ym-sl-fs-title-leaving below.
         NO top/bottom here: the position is static now, and
         transitioning it was what made the credit glide after the media. */
      transition: opacity .24s ease, transform .24s ease,
        font-size .35s cubic-bezier(.22,.61,.36,1),
        filter .3s ease;
    }
    .ym-sl-fs-title-artist { font-weight: 800; }
    .ym-sl-fs-title-track { font-weight: 400; opacity: .82; }
    /* The title and its release year are ONE flex item. In the fullscreen
       compositions .ym-sl-fs-title-inner is a column-reverse stack, so any bare
       sibling takes a row of its own - a year appended next to the title
       therefore appeared on the line ABOVE it, reversed. This inline row keeps
       "Title • 2026" on a single baseline. */
    .ym-sl-fs-title-line {
      display: inline-flex;
      align-items: baseline;
      min-width: 0;
      max-width: 100%;
      white-space: nowrap;
    }
    /* Release year, sitting next to the title as "Title • 2026". It carries the
       TITLE'S weight and brightness rather than the track's default 400/.82, so
       the year reads as the end of the title instead of a second, dimmer label.
       The bullet is full white and only a touch larger than the digits - enough
       to separate them, not enough to become a shape of its own. Read from the
       player-bar byline - see syncFsTitleYear() in 11-fullscreen-next-up - and
       absent (no spans at all) on tracks with no album year. */
    .ym-sl-fs-title-year-sep {
      margin: 0 .3em;
      font-size: .78em;
      font-weight: 700;
      color: #fff;
      /* Dimmer than the year either side of it: the separator only has to
         register as a break, not as a glyph. */
      opacity: .55;
      /* OPTICAL nudge, not a layout fix. The bullet's box is already centred on
         the year's (both report the same centre in the same baseline row), but a
         bullet's ink sits around the middle of the x-height while digits centre
         on cap height, so it reads ~1.3px low at this size. -0.07em lands the ink
         on the digits' middle. */
      transform: translateY(-.07em);
    }
    .ym-sl-fs-title-year {
      font-weight: 800;
      /* A step under the title's own brightness and size: the year is
         secondary information and should read after the song name. */
      opacity: .48;
      font-size: .8em;
      /* Years are compared down the page, not inside a sentence. */
      font-variant-numeric: tabular-nums;
    }
    /* Artist + writers share one baseline. The writers have their own viewport
       so a long list never wraps the credit; CSS hides them for MVs, leaving
       the compact artist + track line untouched. */
    .ym-sl-fs-title-byline {
      display: inline-flex;
      align-items: baseline;
      min-width: 0;
      max-width: 100%;
      vertical-align: baseline;
    }
    .ym-sl-fs-title-sep,
    .ym-sl-fs-title-writers { display: none; }
    .ym-sl-fs-title-sep {
      flex: none;
      margin: 0 .42em;
      font-size: .7em;
      font-weight: 500;
      opacity: .38;
    }
    /* Registered lengths let the edge fades interpolate instead of snapping
       when the marquee reaches or leaves an endpoint. */
    @property --ym-sl-fs-writers-fade-left {
      syntax: "<length>";
      inherits: false;
      initial-value: 0px;
    }
    @property --ym-sl-fs-writers-fade-right {
      syntax: "<length>";
      inherits: false;
      initial-value: 0px;
    }
    .ym-sl-fs-title-writers {
      --ym-sl-fs-writers-opacity: 1;
      --ym-sl-fs-writers-fade-left: 0px;
      --ym-sl-fs-writers-fade-right: 0px;
      min-width: 0;
      max-width: 100%;
      /* Fade only the edge that has text moving under it. JS keeps the fade at
         0 on whichever side the track is currently resting against, so the
         first/last name stays crisp at the turn-around point. */
      overflow: hidden;
      white-space: nowrap;
      transition: opacity .2s ease,
        --ym-sl-fs-writers-fade-left .26s ease,
        --ym-sl-fs-writers-fade-right .26s ease;
      -webkit-mask-image: linear-gradient(to right,
        transparent 0,
        #000 var(--ym-sl-fs-writers-fade-left),
        #000 calc(100% - var(--ym-sl-fs-writers-fade-right)),
        transparent 100%);
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-size: 100% 100%;
      mask-image: linear-gradient(to right,
        transparent 0,
        #000 var(--ym-sl-fs-writers-fade-left),
        #000 calc(100% - var(--ym-sl-fs-writers-fade-right)),
        transparent 100%);
      mask-repeat: no-repeat;
      mask-size: 100% 100%;
    }
    .ym-sl-fs-title-writers.is-writers-out { opacity: 0; }
    .ym-sl-fs-title-writers-track {
      display: inline-block;
      white-space: nowrap;
      will-change: transform;
    }
    .ym-sl-fs-title-writers.is-writers-in,
    .ym-sl-fs-hits-writers.is-writers-in {
      animation: ym-sl-fs-writers-in .28s ease both;
    }
    @keyframes ym-sl-fs-writers-in {
      from { opacity: 0; }
      to { opacity: var(--ym-sl-fs-writers-opacity, 1); }
    }
    .ym-sl-fs-title-writers-track.is-scrolling {
      animation: ym-sl-fs-writers-scroll var(--ym-sl-fs-writers-duration, 22s)
        ease-in-out infinite alternate;
    }
    @keyframes ym-sl-fs-writers-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(var(--ym-sl-fs-writers-shift, 0px)); }
    }
    /* Rendered empty when there is no track yet: take up no space at all. */
    .ym-sl-fs-title:empty { display: none; }
    /* Fullscreen "Next up" list, bottom-right. Native queue-row look (rounded
       thumb + bold track + dimmer artist) in the Spicy Lyrics family. Anchored
       by its BOTTOM edge: the container is bottom-pinned, so the panel grows
       upward as rows unfurl and never drifts when it does. */
    .ym-sl-fs-nextup {
      position: absolute;
      right: 22px;
      bottom: 22px;
      z-index: 22;
      display: flex;
      flex-direction: column;
      /* A FIXED box, not shrink-to-fit. The resting row is pushed to the right
         edge of this box (see the shift below), so the box has to exist before
         the content does: with max-width the panel would hug the text and the
         push would have nowhere to go. */
      width: min(340px, 42vw);
      color: #fff;
      /* Hoverable: the extra tracks reveal on hover. */
      pointer-events: auto;
      opacity: 0;
      /* Rises into place from below the screen edge, never drops in. */
      transform: translateY(10px);
      transition: opacity .3s cubic-bezier(.22,.61,.36,1),
        transform .3s cubic-bezier(.22,.61,.36,1);
    }
    .ym-sl-fs-nextup.ym-sl-fs-nextup-in {
      opacity: 1;
      transform: translateY(0);
    }
    /* Frost panel behind the list, on HOVER only. At rest the
       list is one row and clears the artwork; unfurling it to four rows makes it
       overlap the cover art on smaller monitors, and white text over bright art
       is unreadable. So the surface appears with the unfurl.
       A PSEUDO-ELEMENT, not a background + padding on the list itself: padding
       would reflow the rows the moment the class flips, so the unfurl would jump
       before it animated. Bleeding outward (-14px / -16px) also gives the text
       real breathing room instead of hugging the panel edge.
       z-index: -1 sits behind the rows; .ym-sl-fs-nextup carries z-index 22 so it
       is its own stacking context and the -1 cannot escape behind the artwork. */
    .ym-sl-fs-nextup::before {
      content: "";
      position: absolute;
      inset: -14px -16px;
      z-index: -1;
      border-radius: 16px;
      background: rgba(10, 11, 14, .55);
      border: 1px solid rgba(255, 255, 255, .09);
      -webkit-backdrop-filter: blur(18px) saturate(130%);
      backdrop-filter: blur(18px) saturate(130%);
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s cubic-bezier(.22, .61, .36, 1);
    }
    .ym-sl-fs-nextup:hover::before {
      opacity: 1;
    }
    /* Hide with the cursor. The overlay drops into
       .ym-sl-fs-idle after FS_IDLE_HIDE_MS (2s) without input - the same state
       that hides the cursor - so the list goes with it and the corner is clean.
       It sinks back to its entry offset (+10px) so leaving mirrors arriving.
       pointer-events: none matters as much as opacity: without it the list stays
       hoverable while invisible, and a pointer left resting on it would pop the
       frost back in on an empty corner. (0,3,0) beats the (0,2,0) -in rule. */
    .ym-sl-fs-overlay.ym-sl-fs-idle .ym-sl-fs-nextup {
      opacity: 0;
      transform: translateY(10px);
      pointer-events: none;
    }
    /* Next-up rows are display-only (click-to-jump abandoned): strip
       any UA chrome so they keep the box the old rows had. margin is deliberately
       NOT reset - the row rule below supplies margin-top: 10px. */
    .ym-sl-fs-nextup-row {
      -webkit-appearance: none;
      appearance: none;
      background: none;
      border: 0;
      padding: 0;
      color: inherit;
      font: inherit;
      text-align: left;
      width: 100%;
    }

    /* "See all" queue-panel CSS removed with the panel itself
       (click-to-jump was abandoned). The Next up list above is display-only.
       No "Next up" heading any more: the thumbs read as the queue on their own,
       and the label was just chrome in the corner of the screen.

       RESTING vs HOVER. At rest the row's CONTENT is shifted right by the
       panel's spare width, so the track title ends at the panel's right edge -
       i.e. barely off the screen edge. Hovering slides it back to 0, putting
       the thumb in the panel's top-left corner next to the unfurled rows. The
       shift is measured in JS (syncFsNextUpShift) because only the browser
       knows how wide the title renders; it is applied to the row's CHILDREN,
       not the row, so it does not fight the fold-away transform on rows 2-4. */
    .ym-sl-fs-nextup-thumb,
    .ym-sl-fs-nextup-meta {
      transform: translateX(var(--ym-sl-fs-nu-shift, 0px));
      transition: transform .34s cubic-bezier(.22,.61,.36,1);
    }
    .ym-sl-fs-nextup:hover .ym-sl-fs-nextup-thumb,
    .ym-sl-fs-nextup:hover .ym-sl-fs-nextup-meta {
      transform: translateX(0);
    }
    .ym-sl-fs-nextup-row {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }
    .ym-sl-fs-nextup-thumb {
      width: 42px;
      height: 42px;
      flex: 0 0 auto;
      border-radius: 6px;
      object-fit: cover;
      background: rgba(255, 255, 255, .08);
      box-shadow: 0 1px 6px rgba(0, 0, 0, .4);
    }
    .ym-sl-fs-nextup-meta { min-width: 0; display: flex; flex-direction: column; }
    .ym-sl-fs-nextup-title {
      font-size: 15px;
      font-weight: 800;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-shadow: 0 1px 3px rgba(0, 0, 0, .6);
    }
    .ym-sl-fs-nextup-artist {
      font-size: 13px;
      font-weight: 400;
      line-height: 1.3;
      color: rgba(255, 255, 255, .72);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-shadow: 0 1px 3px rgba(0, 0, 0, .6);
    }
    /* Every row AFTER the first is folded away at rest; hovering the list
       unfurls them, staggered, so only ONE track shows by default. */
    .ym-sl-fs-nextup-row ~ .ym-sl-fs-nextup-row {
      max-height: 0;
      margin-top: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(10px) scale(.96);
      transform-origin: bottom left;
      transition: max-height .34s cubic-bezier(.22,.61,.36,1),
        margin-top .34s cubic-bezier(.22,.61,.36,1),
        opacity .26s ease,
        transform .34s cubic-bezier(.22,.61,.36,1);
    }
    .ym-sl-fs-nextup:hover .ym-sl-fs-nextup-row ~ .ym-sl-fs-nextup-row {
      max-height: 64px;
      margin-top: 10px;
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .ym-sl-fs-nextup:hover .ym-sl-fs-nextup-row ~ .ym-sl-fs-nextup-row:nth-of-type(3) {
      transition-delay: .05s;
    }
    .ym-sl-fs-nextup:hover .ym-sl-fs-nextup-row ~ .ym-sl-fs-nextup-row:nth-of-type(4) {
      transition-delay: .10s;
    }
    .ym-sl-fs-nextup:hover .ym-sl-fs-nextup-row ~ .ym-sl-fs-nextup-row:nth-of-type(5) {
      transition-delay: .15s;
    }
    /* ===== cover-art fullscreen: Apple Music-style stack ===================
       Title, then progress + time, then transport, then volume — one
       left-aligned column under the artwork, spanning its width. Scoped to
       NO-VIDEO side mode; music videos keep their own layout. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title {
      /* FLOW ITEM, not an overlay child. stackFsChrome() moves
         the credit INTO .ym-sl-fs-player-controls for this layout, so the block
         is one column: art -> 16px -> title -> 14px -> seek -> transport ->
         volume. That is what makes "title directly under the art, controls
         directly under the title" exact — as a separate absolutely-positioned
         element its gap to the controls depended on the column's unknown content
         height. */
      position: static;
      order: 0;
      left: auto;
      bottom: auto;
      width: auto;
      max-width: none;
      /* MUST match the 16px the column is offset from the artwork's bottom edge
         (see .ym-sl-fs-player-controls), or the two gaps read as different by a
         couple of pixels — which spotted immediately. */
      margin: 0 0 16px;
      text-align: left;
      /* Explicit, viewport-relative size so it scales on smaller monitors. */
      font-size: clamp(20px, 2.9vh, 36px);
      transform: translateY(6px);
      /* MUST override the base keyframe: ym-sl-fs-title-in bakes in
         translateX(-50%), which dragged the left-aligned title off-screen. */
      animation-name: ym-sl-fs-title-in-l;
    }
    /* COVER ART ONLY: pull the lyrics column in beside the artwork. The base rule
       keeps MVs at 57.4%. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-lyrics {
      left: 44%;
      width: 54%;
    }
    /* Stacked credit: track on top (bold), artist under it (dimmer). The inner is
       authored artist-then-track, so column-REVERSE puts the track on top. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-inner {
      display: flex;
      flex-direction: column-reverse;
      align-items: flex-start;
      white-space: normal;
      padding-inline: 0;
      gap: 1px;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-track {
      font-weight: 800;
      opacity: 1;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-artist {
      font-weight: 500;
      opacity: .55;
      font-size: .82em;
      flex: none;
    }
    /* Cover-art credit: artist | writers on the line under the track. The
       byline fills the title width so the writer viewport has a real right
       edge to fade against; it never becomes a second row. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline {
      display: flex;
      width: 100%;
      max-width: 100%;
      align-items: baseline;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-artist.has-writers .ym-sl-fs-title-sep {
      display: inline-block;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-writers .ym-sl-fs-title-writers {
      --ym-sl-fs-writers-opacity: .34;
      display: inline-block;
      flex: 1 1 auto;
      font-size: .66em;
      font-weight: 500;
      opacity: .34;
      letter-spacing: 0;
    }
    /* The separator and writer line use smaller type than the artist, so
       baseline alignment leaves their optical centres about 1px low. Lift just
       those two pieces; the artist stays put. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-writers .ym-sl-fs-title-sep,
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-writers .ym-sl-fs-title-writers {
      transform: translateY(-1px);
    }
    /* Cover-art credit swap is a SCROLL-UP, not a fade: the old credit lifts out
       upward and the new one rises up into its place, so the track + artist read
       as rolling over rather than dissolving. 22px (was 6px) so
       the direction actually reads at the cover-art font size. */
    @keyframes ym-sl-fs-title-in-l {
      from { opacity: 0; transform: translateY(22px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    /* The leaving state for cover art. It MUST carry the full :not() chain PLUS
       the leaving class (0,6,0): the cover rule above sets animation-name at
       (0,5,0), so a plain .ym-sl-fs-title.ym-sl-fs-title-leaving (0,2,0) loses
       to it. That is exactly why MVs animated on a track change and cover art
       did not - MV has no cover rule to outrank.
       Ease-IN on the way out: the credit accelerates away, so the new one
       rising from below reads as one continuous roll. Duration matches
       FS_TITLE_SWAP_MS (240ms). */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title.ym-sl-fs-title-leaving {
      animation: ym-sl-fs-title-out-l .24s cubic-bezier(.4, 0, 1, 1) forwards;
    }
    @keyframes ym-sl-fs-title-out-l {
      from { opacity: 1; transform: translateY(0); }
      to   { opacity: 0; transform: translateY(-22px); }
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      /* No uniform gap: the transport chip owns the space BELOW it (see its
         margin-bottom) so it can be optically centred between the seek bar and
         the volume. The scrubber's time row sits ABOVE the chip and adds height
         on that side, so a symmetric 12px gap left the transport ~12px low
. gap:0 + chip margin-bottom:24px keeps the same total
         stack height while equalising the two distances. */
      gap: 0;
      /* STATIC: pinned to the bottom of the overlay instead of
         being stacked off the measured band + title height. 18px matches the
         old gap to the scrubber, so the column composition is unchanged — it
         just no longer moves when the artwork changes size. */
      /* Anchored to the ARTWORK's bottom edge, not the overlay's.
         The art is 54vh tall, centred in a pane that stops 218px above the bottom
         and nudged down 4vh, so its bottom edge is at
             (100% - 218px) / 2 + 31vh
         The block then flows DOWN from 16px below it. 218px mirrors the pane's
         own bottom: 218px rule — if that changes, change it here too.
         Width/left are the art's box: min(50%, 54vh) starting at
         27% - min(25%, 27vh) (27% is the column midpoint). */
      top: calc((100% - 218px) / 2 + 31vh + 16px);
      bottom: auto;
      left: calc(27% - min(25%, 27vh));
      right: auto;
      width: min(50%, 54vh);
      height: auto;
    }
    /* order: progress+times, then the transport chip, then the volume. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber {
      order: 1;
      position: static;
      width: auto;
      transform: none;
      /* GRID, not a column: the seek spans row 1 and the two time labels sit
         left/right on row 2 (a column stacked them, which read wrong). */
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 6px 10px;
      padding: 0;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-player-seek {
      grid-row: 1;
      grid-column: 1 / -1;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-time {
      grid-row: 2;
      line-height: 1;
      font-size: clamp(12px, 1.5vh, 18px);
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-time:nth-of-type(1) {
      grid-column: 1;
      justify-self: start;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-time:nth-of-type(2) {
      grid-column: 2;
      justify-self: end;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-play-chip {
      order: 2;
      position: static;
      width: auto;
      transform: none;
      display: flex;
      justify-content: center;
      padding: 0;
      /* The whole gap below the transport. Paired with gap:0 on the stack above,
         this centres the transport between the seek bar and the volume even
         though the time row adds height on the seek side. */
      margin-bottom: 16px;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group {
      order: 3;
      margin: 0;
      padding-left: 0;
      border-left: 0;
      width: 100%;
      /* Room for the two scale glyphs: they sit INSIDE the artwork's width, so
         the bar shortens by their size and gaps rather than spilling past the
         cover. */
      gap: 12px;
      pointer-events: auto;
    }
    /* The glyphs ride the bar's own line: quiet speaker on the left, loud one on
       the right, both at the low opacity of unplayed chrome. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-icon {
      display: block;
      flex: 0 0 auto;
      width: 22px;
      height: 22px;
      color: rgba(255, 255, 255, .62);
      pointer-events: none;
    }
    /* No hover grow on the volume bar here. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group:hover .ym-sl-fs-player-volume,
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-volume {
      transform: none !important;
    }
    /* Transport spans the row: shuffle hard left, repeat hard right. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-transport {
      width: 100%;
    }
    /* Only SHUFFLE (first) and REPEAT (last) go to the edges; the skip buttons stay
       grouped around play. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-transport > :first-child {
      margin-right: auto;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-transport > :last-child {
      margin-left: auto;
    }
    /* The volume slider must FILL the row rather than keep its 150px default. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-player-volume {
      flex: 1 1 auto;
      width: auto;
      min-width: 0;
    }
    @keyframes ym-sl-fs-title-in {
      from { opacity: 0; transform: translateX(-50%) translateY(6px); }
      to   { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    /* Track change: the old credit lifts and fades out, refreshFsTitle() swaps
       the text, then dropping this class re-arms the entrance animation above,
       which fades the new credit back in from opacity 0 with a small rise.
       The fade-out runs as its OWN animation instead of animation:none plus a
       transition. The entrance animation ends with a forwards fill that keeps
       forcing opacity:1, and releasing that fill in the SAME style recalc as a
       class change did NOT reliably start the opacity transition in Chrome, so
       the old credit just snapped away instead of fading, so the title
       never appeared to fade out at the end of a song. A dedicated ym-sl-fs-title-out
       animation overrides the entrance animation outright, so the fade-out
       always runs; its forwards fill holds opacity 0 until paint() drops the
       class and re-arms the entrance. */
    .ym-sl-fs-title.ym-sl-fs-title-leaving {
      animation: ym-sl-fs-title-out .24s ease forwards;
    }
    @keyframes ym-sl-fs-title-out {
      from { opacity: 1; transform: translateX(-50%) translateY(0); }
      to   { opacity: 0; transform: translateX(-50%) translateY(-8px); }
    }
    /* Long-title marquee + edge fade. Long artist + title
       strings used to wrap to two lines. The inner wrapper is forced
       to one line with white-space:nowrap; the container clips and
       edge-fades when overflow is detected. The marquee is a ping-pong
       with two 3s pauses: pause at the LEFT, scroll to show the END at
       the RIGHT, pause there, scroll back to LEFT, repeat. Shift =
       -(textWidth - containerWidth) puts the END of the text right at
       the container's right edge so the right fade can take it out
       smoothly. Duration stays a flat 12s so the scroll speed scales
       naturally with how much the title overflows; preferred a
       constant-pause feel over a constant-speed scroll. */
    .ym-sl-fs-title {
      overflow: hidden;
    }
    .ym-sl-fs-title.ym-sl-fs-title-overflow {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 32px,
        black calc(100% - 32px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 32px,
        black calc(100% - 32px),
        transparent 100%
      );
    }
    .ym-sl-fs-title-inner {
      display: inline-block;
      white-space: nowrap;
      padding-inline: .35em;
      will-change: transform;
    }
    .ym-sl-fs-title-inner.ym-sl-fs-title-marquee {
      animation: ym-sl-fs-title-marquee 12s linear infinite;
    }
    @keyframes ym-sl-fs-title-marquee {
      0%, 25%   { transform: translateX(0); }
      50%, 75%  { transform: translateX(var(--ym-sl-fs-title-shift, 0px)); }
      100%      { transform: translateX(0); }
    }
    /* ===== fullscreen loading spinner =====================================
       Only appears when a track change runs past FS_SPINNER_DELAY_MS (2s).
       It stretches over whichever host it was placed in at show time (see
       fsSpinnerTargetHost()): the lyrics column when the lyrics are the thing
       loading, or the media pane when the VIDEO is the sole thing still
       buffering. inset: 0 fills that host, so it follows the host's geometry
       (layout mode + video aspect ratio) with no extra math. Icon is Spicy
       Lyrics' own; the spin is slowed to 1.4s from their 0.8s by request.
       Fades in and out via the opacity transition below. Deliberately no
       backdrop: any fill is an edge (see the play chip note), so legibility
       comes from a drop shadow instead. */
    .ym-sl-fs-spinner {
      position: absolute;
      inset: 0;
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,.92);
      opacity: 0;
      pointer-events: none;
      filter: drop-shadow(0 2px 10px rgba(0,0,0,.7));
      transition: opacity .4s ease-in-out;
    }
    .ym-sl-fs-spinner.visible {
      opacity: 1;
    }
    .ym-sl-fs-spinner-icon {
      display: block;
      width: 46px;
      height: 46px;
    }
    /* Only animated while visible, so a hidden spinner costs nothing. */
    .ym-sl-fs-spinner.visible .ym-sl-fs-spinner-icon {
      animation: ym-sl-fs-spin 1.4s linear infinite;
    }
    @keyframes ym-sl-fs-spin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }
    /* ===== Video Background: the title rides the chrome's reveal ==========
       In this layout the media is the full-bleed backdrop, so the title has
       nothing to sit under and used to stay on screen permanently over the
       video (found by). It now follows exactly the
       pattern .ym-sl-fs-controls uses: hidden at rest, fades in on
       hover/focus-within, and hides again on idle - so the hover rule comes
       first and the idle rule after it, since they carry equal specificity.
       animation:none is REQUIRED, not cosmetic: the entrance animation ends
       with a forwards fill that keeps forcing opacity 1, and an animation-origin
       value outranks a normal declaration, so without it the title would never
       hide. Side and Lyrics Only are untouched - there the title is part of the
       composition. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-fs-title {
      animation: none;
      opacity: 0;
      transform: translateX(-50%) translateY(-4px);
      transition: opacity .24s ease, transform .24s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background:hover .ym-sl-fs-title,
    .ym-sl-fs-overlay.ym-sl-fs-mode-background:focus-within .ym-sl-fs-title {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-idle .ym-sl-fs-title {
      opacity: 0;
      transform: translateX(-50%) translateY(-4px);
    }
    /* ===== bottom stack: title -> transport chip -> scrubber pill =========
       BOTH variants put the title under the media and the chrome under the
       title, and BOTH align horizontally to the media pane instead of the
       overlay centre. reported the group sitting in the middle of the screen
       while the cover art was off to the left - the earlier pass
       only applied the pane alignment to the music-video branch, which is why
       the no-video case stayed centred.
       Video Background is excluded: there the media is the full-bleed backdrop
       and a centred title is correct. The title keeps its translateX(-50%)
       centring, so only the left value changes.
       The title anchors to the pane's MIDPOINT, NOT a hard 29%. 29% was the
       midpoint of the OLD pane (left: 4% + 50% / 2); the pane has since moved to
       left: 2%, and the stale anchor left the title ~2% (38px at 1920) to the
       RIGHT of the video - and of the transport, which IS centred on the pane
       , putting the title visibly off-centre. Deriving it
       from the published pane box keeps it centred for any pane width.
       The chip is deliberately NOT listed here: it anchors to the pane's own
       left/width further down (.ym-sl-fs-play-chip), which already outranked
       this rule. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-title {
      /* 27% = the midpoint of the fixed 2% / 50% media column (2 + 50/2).
         STATIC — it used to be derived from the measured pane
         box, so it re-centred itself whenever the pane's reported width moved. */
      left: 27%;
      max-width: 50%;
    }
    /* No-video: hero title, cover art sits directly above it.
       210px clears the bottom-anchored control column (seek row + transport +
       volume, height is content-driven) and keeps the art -> title gap at ~64px.
       Tuned DOWN from 190px + a 14px column in one pass for "slightly more
       compact": title up 20, column up 10, transport->volume
       gap 24 -> 16. These three numbers are the whole vertical rhythm. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-title {
      bottom: 210px;
      font-size: 42px;
      line-height: 1.1;
      letter-spacing: -.015em;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-play-chip {
      bottom: 74px;
    }
    /* Music video: smaller caption under the video pane. The POSITION comes from
       the flow block further down (the whole chrome is one column anchored to the
       video's bottom edge), so no bottom offset here. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-title {
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: 0;
    }
    @media (max-height: 700px) {
      /* Same stacking ORDER as the full-size rules above (title, then chip, then
         scrubber), just compressed. The previous values were written for the old
         measured band, where the chip sat below the title by construction — kept
         as-is they overlapped once the positions became fixed. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-title {
        bottom: 176px;
        font-size: 32px;
      }
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-play-chip {
        bottom: 66px;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-title {
        font-size: 18px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .ym-sl-fs-title { animation: none; opacity: 1; transition: none; }
      .ym-sl-fs-title-writers-track.is-scrolling { animation: none; transform: none; }
      .ym-sl-fs-title-writers { transition: none; }
      .ym-sl-fs-title-writers.is-writers-in,
      .ym-sl-fs-hits-writers.is-writers-in {
        animation: none;
        opacity: var(--ym-sl-fs-writers-opacity, 1);
      }
      .ym-sl-fs-title-writers.is-writers-out { opacity: 0; }
      /* Keep the track-change swap, but make it an instant cut. */
      .ym-sl-fs-title.ym-sl-fs-title-leaving { animation: none; opacity: 0; }
      /* SAME specificity as the cover-art leaving rule (0,6,0) - without this
         that rule beats this whole media block and animates anyway. */
      .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-title.ym-sl-fs-title-leaving {
        animation: none;
        opacity: 0;
      }
    }

    .ym-sl-fs-control-offset {
      display: none;
      align-items: center;
      gap: 5px;
      color: rgba(255,255,255,.72);
      white-space: nowrap;
    }
    .ym-sl-fs-control-offset.visible { display: inline-flex; }
    .ym-sl-fs-control-offset input[type="range"] {
      width: 104px;
      accent-color: #fff;
      cursor: pointer;
      transition: none;
    }
    .ym-sl-fs-options-body .ym-sl-fs-control-offset {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .ym-sl-fs-options-body .ym-sl-fs-control-offset input[type="range"] {
      width: 100%;
      min-width: 0;
    }
    .ym-sl-fs-control-offset-value { min-width: 42px; text-align: right; font-variant-numeric: tabular-nums; }
    .ym-sl-fs-control-offset .ym-sl-offset-scope {
      background: rgba(255,255,255,.12); color: #fff; border: 0; border-radius: 6px;
      font-size: 10px; padding: 2px 4px; cursor: pointer;
    }
    .ym-sl-fs-control-offset .ym-sl-offset-number {
      width: 52px; font-size: 11px; color: #fff; background: rgba(255,255,255,.12);
      border: 0; border-radius: 6px; padding: 2px 4px;
      -moz-appearance: textfield;
    }
    .ym-sl-fs-control-offset .ym-sl-offset-scope {
      background: rgba(255,255,255,.12); color: #fff; border: 0; border-radius: 6px;
      font-size: 10px; padding: 2px 4px; cursor: pointer;
    }
    .ym-sl-fs-control-offset .ym-sl-offset-number::-webkit-outer-spin-button,
    .ym-sl-fs-control-offset .ym-sl-offset-number::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .ym-sl-fs-control-offset .ym-sl-offset-applied {
      font-size: 9px; text-transform: uppercase; letter-spacing: .05em; color: rgba(255,255,255,.5);
    }
    /* The range is useful on any track: on cover-art tracks it remains a
       harmless manual lyric timing nudge, while music videos use the same
       persisted per-track offset as the normal panel. */
    .ym-sl-fs-control-offset.force-visible { display: inline-flex; }
    .ym-sl-video-offset {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex: 0 0 auto;
      color: rgba(255,255,255,.78);
      font-size: 11px;
      white-space: nowrap;
    }
    .ym-sl-video-offset.visible { display: inline-flex; }
    .ym-sl-video-offset input[type="range"] {
      width: 92px;
      accent-color: #fff;
      cursor: pointer;
    }
    .ym-sl-video-offset-value {
      min-width: 48px;
      text-align: right;
      font-variant-numeric: tabular-nums;
      color: rgba(255,255,255,.66);
    }
    .ym-sl-video-offset .ym-sl-offset-scope {
      background: rgba(255,255,255,.1); color: #fff; border: 0; border-radius: 6px;
      font-size: 10px; padding: 2px 4px; cursor: pointer;
    }
    .ym-sl-video-offset .ym-sl-offset-number {
      width: 52px; font-size: 11px; color: #fff; background: rgba(255,255,255,.1);
      border: 0; border-radius: 6px; padding: 2px 4px;
      -moz-appearance: textfield;
    }
    .ym-sl-video-offset .ym-sl-offset-number::-webkit-outer-spin-button,
    .ym-sl-video-offset .ym-sl-offset-number::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .ym-sl-video-offset .ym-sl-offset-applied {
      font-size: 9px; text-transform: uppercase; letter-spacing: .05em; color: rgba(255,255,255,.45);
    }
    /* Fullscreen view: YTM's real <video> on the left, the live lyrics panel on
       the right. Nothing is re-created — both are the existing live elements, so
       playback, timing and scroll state all keep working. No artwork fetching,
       no blurred backdrop, and no extension controls in this view. */
    /* Geometry comes from the mode rules (.ym-sl-fs-mode-* / default "side")
       higher up; only the visual treatment and overflow are pinned here. */
    .ym-sl-fs-media {
      position: absolute;
      display: block;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      background: transparent !important;
    }
    .ym-sl-fs-media > video {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      max-height: none !important;
      /* Fill the media pane edge-to-edge so the 16:9 video never leaves the
         two horizontal black bars reported. The video is
         cropped instead of letterboxed - matches what Ableton / Spicy do for
         their fullscreen MV pane, and the host already has rounded corners
         so the cropped edges look intentional rather than truncated. */
      object-fit: cover !important;
      border-radius: 14px;
      background: transparent;
      /* No drop shadow: .ym-sl-fs-media has overflow:hidden and the pane's
         bottom edge IS the video's bottom edge, so the shadow was cut off dead
         straight under the media. The blurred ambient backdrop
         already separates the frame from its surroundings. */
      box-shadow: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-media > video {
      /* Restore the pre-letterbox presentation. */
      background: transparent;
    }
    /* Music videos: rounding only; column geometry comes from the layout mode. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-media {
      border-radius: 14px;
    }
    /* Smooth fade when the backdrop swaps between cover-art and the live video
       mid-fullscreen. syncFsVideoMode toggles fsMediaHost opacity around the
       swap so the transition (cover art fading out / new backdrop fading in)
       replaces the snap reported. */
    .ym-sl-fs-media {
      transition: opacity .25s ease;
    }
    /* Leaving Video Background: restore the media host's geometry transition for
       the length of the switch, so the full-bleed video shrinks back into the
       side column instead of cutting there. The class is applied before the
       mode class is removed and cleared once the transition has run. */
    /* .52s to match the chrome FLIP and the lyric column's own transition, so
       the picture, the words and the controls all come to rest on the same
       frame instead of three slightly different ones. */
    .ym-sl-fs-overlay.ym-sl-fs-media-layout-out .ym-sl-fs-media {
      transition:
        left .52s cubic-bezier(.22, .61, .36, 1),
        width .52s cubic-bezier(.22, .61, .36, 1),
        top .52s cubic-bezier(.22, .61, .36, 1),
        transform .52s cubic-bezier(.22, .61, .36, 1),
        padding .52s cubic-bezier(.22, .61, .36, 1),
        opacity .25s ease;
    }
    .ym-sl-fs-overlay.ym-sl-fs-media-layout-out .ym-sl-fs-media > video {
      transition: border-radius .52s cubic-bezier(.22, .61, .36, 1);
    }
    /* ===== track-change dissolve ==========================
       ⭐ Fading ONLY .ym-sl-fs-media was invisible for music videos. The ambient
       backdrop behind it (Kawarp / the blurred-video canvas) is a blurred copy of
       the SAME frame, so dropping the sharp layer to opacity 0 just revealed a
       blurry version of itself — it read as "music videos don't fade at all".
       The backdrop fades WITH the media now, so the pane genuinely goes dark
       between tracks and the incoming one fades up into place.
       This is a class, not an inline opacity, on purpose: the OUT is .22s, while
       the IN falls back to each element's own transition (media .25s, Kawarp
       .6s), which is exactly the asymmetry we want and cannot express with a
       single inline value. */
    .ym-sl-fs-overlay.ym-sl-fs-dissolving .ym-sl-fs-media,
    .ym-sl-fs-overlay.ym-sl-fs-dissolving .ym-sl-fs-kawarp,
    .ym-sl-fs-overlay.ym-sl-fs-dissolving .ym-sl-fs-bg-canvas,
    .ym-sl-fs-overlay.ym-sl-fs-dissolving .ym-sl-fs-bg-img {
      opacity: 0;
      transition: opacity .22s ease;
    }
    /* Music videos: the hero on the left is the unblurred live video (the
       clone behind supplies the blurred light). Remove any softening filter
       so the left video stays crisp. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-media > video {
      filter: none;
    }
    /* Music videos: give the left column more room so the unblurred hero is
       visually prominent instead of feeling offset inside a narrow slice.
       (Dead code now that the overlay is display:block — left here as a
       no-op anchor in case we ever reintroduce a grid track for side mode.)
       Grid-template-columns rule removed. */
    /* Cover art: a centered square card sized off the viewport height so it
       never dwarfs the lyrics column. The blurred backdrop fills the space
       around it, so there are no black bars. Reduced 70vh -> 50vh: the cover
       read too large beside the lyrics. Music videos are a
       <video>, and this <img> is only created for cover-art tracks, so MVs are
       untouched by this rule. */
    .ym-sl-fs-media > img {
      display: block;
      width: min(100%, 54vh);
      height: auto;
      max-width: 100%;
      max-height: 54vh;
      aspect-ratio: 1 / 1;
      /* Nudge the centred cover very slightly DOWN: the pane it centres in stops
         short of the overlay bottom (the 218px title/controls band), so pure
         centring reads a touch high. */
      transform: translateY(4vh);
      object-fit: cover;
      border-radius: 16px;
      background: #000;
      /* No drop shadow, same reason as the video: the pane has overflow:hidden
         and the cover is bottom-aligned in it, so the shadow was sliced off
         immediately below the artwork. */
      box-shadow: none;
    }
    /* In side mode, center the square cover in the media column without
       stretching it to the full column height. The old height:100% override
       made the square's contain box span the entire screen, creating huge
       black bars above and below the artwork. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-media > img {
      /* MORE specific than the base .ym-sl-fs-media > img rule, so in side mode
         THIS is what actually sizes the cover art — keep it in step with the
         base. */
      width: min(100%, 54vh);
      max-height: 54vh;
      flex: 0 1 auto;
    }
    /* ===== bottom band: reserve room for the title + playback chrome ======
       the spec: everything lives UNDER the media, so the media
       pane stops short of the overlay bottom and the title/controls occupy
       the band that is left. Scoped to side mode only - in Video Background
       the video IS the backdrop and must stay full-bleed, and Lyrics Only has
       no media at all. The media host transition does not list bottom, so
       this inset snaps between layouts rather than animating; that is
       deliberate (animating a host that carries JS-measured media is what
       produced the stale-size black bars noted in the project memory). */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
      bottom: 218px;
    }
    /* Music video: size the pane to the video's OWN aspect ratio, and centre it
       on the viewport's vertical middle.
       ASPECT: the pane used to be 50% wide but nearly full height (AR ~1.2)
       while the video is 1.78, so object-fit: cover cropped the sides and
       contain left letterbox bars - hit both, one round apart. Matching the
       ratios makes cover a no-op: full frame AND filled pane. The var comes
       from the real videoWidth/videoHeight in drawBgFrame(); 16/9 is the
       fallback for the frames before metadata arrives.
       POSITION: centred on 50% - the pane's height is width/AR, so a 16:9 video
       in a 50%-wide column is only 540px tall. Bottom-pinning it left a 340px
       void above, which read as too low; centring on the band midpoint instead
       put it 100px above the screen's middle, which read as too high. Dead
       centre is the intended position. Measured clearance: the title's top edge sits at
       y=904, and a 16:9 pane centred at 540 ends at 810, so there is 94px of
       air; a 4:3 pane ends at 900 and just clears it.
       max-height keeps a very tall / vertical video from covering the whole
       screen and the band; it is a no-op for anything wider than ~1.09.
       Nothing else writes transform on this host (only opacity does), so the
       translateY cannot collide with the layout-switch animation. */
    /* Video side metadata row: hidden until a music video is in side mode. */
    .ym-sl-fs-video-meta { display: none; }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
      top: 45%;
      bottom: auto;
      height: auto;
      transform: translateY(-50%);
      aspect-ratio: var(--ym-sl-fs-video-ar, 16 / 9);
      max-height: calc(100% - 200px);
    }
    /* Cover art must shrink into the shortened pane instead of overflowing
       the band. aspect-ratio keeps it square; max-height:100% clamps it. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-media > img {
      max-height: 100%;
    }
    /* CENTRE the cover inside the shortened pane. The title / controls are at
       fixed offsets from the overlay bottom, so they no longer
       follow the art's bottom edge. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video):not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
      align-items: center;
    }
    /* Both variants: the scrubber spans the MEDIA COLUMN, not the overlay centre,
       so it sits exactly under the cover art / video. STATIC:
       the column is a fixed 2% / 50% box, so the bar reads those numbers directly
       instead of the measured pane rect. box-sizing MUST be border-box: this rule
       is content-box by default, so the base padding of 0 18px used to ADD 36px
       and push the bar 36px past the video's right edge. transform must be reset
       because the no-video pill base centres itself with translateX(-50%), which
       would drag a column-anchored bar off the column. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber {
      left: 2%;
      right: auto;
      width: 50%;
      box-sizing: border-box;
      transform: none;
      bottom: auto;
      /* NO side padding: the base rule's 0 18px inset the row from the video's
         edges by 18px each side, so the seek bar never lined up with the pane
         (the same length as the video). The row now spans the pane
         exactly and the time labels sit flush against its edges. */
      padding: 0;
    }

    /* ===== MV side layout: ONE flow under the video ========
       Credit, transport and scrubber are a single flex column starting 20px below
       the VIDEO's bottom edge, not the viewport's. The pane is 50% wide, centred,
       and aspect-ratio'd, so its bottom edge is
           50% + 25vw / var(--ym-sl-fs-video-ratio)
       That is why the ratio is published as a NUMBER: CSS can divide by a number
       but not by a "1920 / 960" token. Anchoring to the viewport instead is what
       made the gap under the video change with its shape.
       LIMIT: max-height clamps very tall videos, so for those the real bottom
       edge is higher than this formula and the gap grows. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
      display: flex;
      flex-direction: column;
      /* STRETCH, not center, and the column IS the media column (2% / 50%). A
         full-width column with align-items:center centred the transport and the
         scrubber on the SCREEN while the title sat under the video — two
         different axes. */
      align-items: stretch;
      justify-content: flex-start;
      top: calc(45% + 25vw / var(--ym-sl-fs-video-ratio, 1.7777778) + 20px);
      bottom: auto;
      left: 2%;
      right: auto;
      width: 50%;
      height: auto;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title {
      position: static;
      order: 0;
      left: auto;
      bottom: auto;
      width: 100%;
      max-width: none;
      margin: 0;
      text-align: left;
      font-size: clamp(22px, 3vh, 32px);
      line-height: 1.16;
      letter-spacing: -.012em;
      transform: none;
      /* ⭐ MUST swap the KEYFRAMES, not just the property. The base entrance
         animation bakes translateX(-50%) into every frame and ends with a
         forwards fill, so it keeps forcing the shift forever and outranks a
         plain transform: none — that is why the caption sat 480px to the left
         (measured: box x -442 with translateX(-480)). The -l
         variant is the same rise without the translate. */
      animation-name: ym-sl-fs-title-in-l;
    }
    /* Same for the leave animation, which also carries translateX(-50%). */
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title.ym-sl-fs-title-leaving {
      animation: ym-sl-fs-title-out-l .24s cubic-bezier(.4, 0, 1, 1) forwards;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-meta {
      display: flex;
      order: 0;
      width: 100%;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin: 0 0 14px;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-meta .ym-sl-fs-title {
      flex: 1 1 auto;
      min-width: 0;
      width: auto;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-inner {
      display: flex;
      flex-direction: column-reverse;
      align-items: flex-start;
      width: 100%;
      white-space: normal;
      padding-inline: 0;
      gap: 2px;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-track {
      font-weight: 700;
      opacity: 1;
      letter-spacing: -.012em;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-artist {
      font-weight: 500;
      opacity: .62;
      font-size: 14px;
      line-height: 1.2;
      letter-spacing: 0;
      flex: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline {
      display: flex;
      width: 100%;
      max-width: 100%;
      align-items: baseline;
    }
    /* The cover-art credit line, reused under a music video: artist | writers,
       with the writer viewport fading at whichever edge has hidden text. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-artist.has-writers .ym-sl-fs-title-sep {
      display: inline-block;
      font-size: 12px;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-writers .ym-sl-fs-title-writers {
      --ym-sl-fs-writers-opacity: .34;
      display: inline-block;
      flex: 1 1 auto;
      min-width: 0;
      font-size: 12px;
      font-weight: 500;
      opacity: .34;
      letter-spacing: 0;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-writers .ym-sl-fs-title-sep,
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-byline.has-writers .ym-sl-fs-title-writers {
      transform: translateY(-1px);
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-actions {
      display: flex;
      align-items: center;
      gap: 2px;
      flex: 0 0 auto;
      padding-bottom: 2px;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-actions .ym-sl-fs-player-like--edge,
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-actions .ym-sl-fs-player-dislike--edge {
      position: static;
      z-index: auto;
      width: 40px;
      height: 40px;
      min-width: 40px;
      min-height: 40px;
      margin: 0;
    }
    /* The edge thumbs are not the video rating control any more; the cover-art
       heart takes their place. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-actions .ym-sl-fs-player-like--edge,
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-actions .ym-sl-fs-player-dislike--edge {
      display: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-actions .ym-sl-fs-art-like {
      position: static;
      left: auto;
      top: auto;
      width: 40px;
      height: 40px;
      min-width: 40px;
      max-width: 40px;
      margin: 0;
      padding: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      pointer-events: auto;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-actions .ym-sl-fs-art-like svg {
      width: 24px;
      height: 24px;
      display: block;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-play-chip {
      position: static;
      order: 2;
      left: auto;
      bottom: auto;
      width: 100%;
      /* The seek's time row sits above the transport, so a symmetric gap would
         leave the transport visually low. The cover layout uses 24px below its
         chip for the same reason; keep the two compositions on one rhythm. */
      margin: 0 0 24px;
      transform: none;
      display: flex;
      justify-content: center;
      padding: 0;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber {
      position: static;
      order: 1;
      left: auto;
      right: auto;
      bottom: auto;
      width: 100%;
      margin: 0 0 10px;
      transform: none;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 6px 10px;
      padding: 0;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-player-seek {
      grid-row: 1;
      grid-column: 1 / -1;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-time {
      grid-row: 2;
      font-size: 12px;
      line-height: 1;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-time:nth-of-type(1) {
      grid-column: 1;
      justify-self: start;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber .ym-sl-fs-time:nth-of-type(2) {
      grid-column: 2;
      justify-self: end;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-transport {
      width: 100%;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-transport > :first-child {
      margin-right: auto;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-transport > :last-child {
      margin-left: auto;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group {
      order: 3;
      width: 100%;
      margin: 0;
      padding: 0;
      border-left: 0;
      gap: 12px;
      pointer-events: auto;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-icon {
      display: block;
      flex: 0 0 auto;
      width: 18px;
      height: 18px;
      color: rgba(255, 255, 255, .62);
      pointer-events: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-player-volume {
      flex: 1 1 auto;
      width: auto;
      min-width: 0;
      transform: none !important;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-knob {
      display: none;
    }
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group:hover .ym-sl-fs-player-volume::before,
    .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group:hover .ym-sl-fs-volume-fill {
      height: 9px;
    }
    /* Short landscape screens cannot fit four rows under a 16:9 video at the
       normal 45% centre, so tighten the stack, drop the volume row (the same
       rule the cover layout uses for short screens) and lift the video a little
       more. The full four-row composition stays on 900px+ displays. */
    @media (max-height: 860px) and (min-aspect-ratio: 1 / 1) {
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-meta {
        margin-bottom: 10px;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-meta .ym-sl-fs-title {
        font-size: 24px;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-title-artist {
        font-size: 13px;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group {
        display: none;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-play-chip {
        margin-bottom: 0;
      }
    }
    @media (max-height: 820px) and (min-aspect-ratio: 1 / 1) {
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-media {
        top: 43%;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-player-controls {
        top: calc(43% + 25vw / var(--ym-sl-fs-video-ratio, 1.7777778) + 20px);
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-meta .ym-sl-fs-title {
        font-size: 22px;
      }
    }
    @media (max-height: 700px) and (min-aspect-ratio: 1 / 1) {
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-meta {
        margin-bottom: 8px;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-video-meta .ym-sl-fs-title {
        font-size: 20px;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-scrubber {
        margin-bottom: 8px;
      }
      .ym-sl-fs-overlay.ym-sl-fs-has-video:not(.ym-sl-fs-mode-background) .ym-sl-fs-play-chip {
        margin-bottom: 0;
      }
    }
    /* The SEPARATOR sits dead under the title. The chip spans the
       pane and lays out as 1fr / auto / 1fr: the transport is pushed to the END of
       the left column and the volume to the START of the right one, so whatever
       either side weighs, the middle column — the divider — lands on the chip's
       midpoint, which is the pane's midpoint, which is the title's.
       The divider is the chip's own ::after rather than the volume group's
       border-left, because it has to be its own grid item to hold that column.
       Equal 14px gutters keep it centred IN the gap instead of hugging either side.
       minmax(0, 1fr) not plain 1fr: a plain 1fr keeps an auto minimum, so a wide
       volume would widen its own column and drag the divider off centre. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-play-chip {
      left: 2%;
      width: 50%;
      max-width: none;
      transform: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 0;
      padding: 10px 0;
    }
    /* TRANSPORT CENTRED ON THE PANE, VOLUME ON THE SCRUBBER ROW.
       Shuffle and Repeat made the transport five buttons wide — wide enough that
       centring the chip AS A UNIT left the transport visibly left of the title. So
       the middle column carries the transport, and the volume left the chip
       entirely: it now sits on the scrubber row, after the total time. The seek
       range is the flex child that gives up the room, so bar + volume still span
       the media pane together — which is exactly what asked for.
       Every item is pinned to grid-row 1 EXPLICITLY: auto-placement walks items in
       SOURCE order with a cursor that only moves forward, so an item whose column
       sits BEHIND the cursor gets pushed onto the next row. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-transport {
      grid-row: 1;
      grid-column: 2;
      justify-self: center;
    }
    /* A plain flex child of .ym-sl-fs-scrubber now, so it needs no grid placement —
       only the divider separating it from the total time beside it. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-background) .ym-sl-fs-volume-group {
      margin-left: 0;
      padding-left: 14px;
      /* The 1px divider is removed too so the volume sits flush
         against the scrubber row without a line of chrome between them. */
      border-left: 0;
    }

    /* Self-contained blurred backdrop. We render our own (rather than
       reparenting dynamic.js's Kawarp node) because dynamic.js's rootObserver
       actively yanks pageBgHost back to pageBgRoot, stealing it from the overlay
       within a frame. For music videos, a muted clone of the live video plays
       blurred in the background AND the original plays unblurred on the left,
       so the music video actually lights up the background with live motion. */
    .ym-sl-fs-bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.06);
      will-change: transform, filter;
      z-index: 0;
    }
    /* Cover art: brighter than before so the blurred album art reads as a
       proper background, not a near-black veil. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-has-video) .ym-sl-fs-bg-img {
      filter: blur(30px) saturate(1.75) brightness(.78);
    }
    /* Music videos: hide the static artwork backdrop because the live video
       itself fills the fullscreen media layer. */
    .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-bg-img {
      display: none;
    }
    /* Kawarp WebGL backdrop for song fullscreen. Sits behind everything at
       z-index 0; when it owns the backdrop the static blurred cover is hidden.
       The .ready class fades it in once the module + image have loaded. */
    .ym-sl-fs-kawarp {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      transform: scale(1.06);
      transition: opacity .6s ease;
    }
    .ym-sl-fs-kawarp.ready { opacity: 1; }
    .ym-sl-fs-overlay.ym-sl-fs-has-kawarp .ym-sl-fs-bg-img { display: none; }
    /* Music videos normally use the blurred-video canvas, but a still upload
       (Official Audio / Lyric Video) hands the backdrop to Kawarp instead. The
       canvas has to be hidden too: both sit at z-index 0 and the canvas comes
       LATER in DOM order, so it would paint straight over Kawarp. Keeping the
       element (rather than removing it) means the draw loop keeps running,
       which is what publishes --ym-sl-fs-video-ar, and it gives a free fallback
       - if Kawarp fails it drops the class and the canvas is visible again. */
    .ym-sl-fs-overlay.ym-sl-fs-has-kawarp .ym-sl-fs-bg-canvas { display: none; }
    /* Music-video backdrop: a <canvas> holding a very low-res copy of the live
       <video>. The heavy blur is applied by CSS (see the background-mode rule)
       to a static layer, so the browser never re-blurs the live video per
       frame. Overscan is larger than before because a 64px blur would
       otherwise fade out at the element edges. */
    .ym-sl-fs-bg-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Decorative ambient backdrop only. It covers the whole overlay, so it
         must never intercept clicks meant for the lyrics (the sibling
         .ym-sl-fs-bg-tint already sets this; the canvas was missing it). */
      pointer-events: none;
      /* Larger overscan than the old 1.06: ctx.filter's blur fades toward the
         canvas edges, and this scales the faded border outside the viewport. */
      transform: scale(1.3);
      transform-origin: center center;
      will-change: transform;
      z-index: 0;
    }
    .ym-sl-fs-bg-tint {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, .2);
      z-index: 1;
      pointer-events: none;
    }
    /* Cover card. It has NO opacity animation of its own any more. It used to carry a .ym-sl-fs-art-loading modifier that
       dropped it to 0 while a new src decoded, to stop the sharp OLD bitmap
       showing next to the new Kawarp backdrop. That modifier was a second
       opacity animation fighting the track-change dissolve, and reconcile can
       re-set the src up to 2s after a skip — outside any dissolve window — so
       the card blinked by itself. The dissolve now covers every track change
       (the pane is dark while the art swaps), and outside a track change the
       src only changes between resolution variants of the SAME artwork, so the
       old bitmap is never the wrong cover. */
    .ym-sl-fs-art {
      opacity: 1;
    }
    /* .ym-sl-fs-media / .ym-sl-fs-lyrics base position + z-index are set by
       the animated rules higher up. */
    .ym-sl-fs-lyrics {
      min-width: 0;
      min-height: 0;
      height: 100%;
      display: flex;
      overflow: hidden;
    }
    .ym-sl-track { 
      min-width: 0;
      flex: 1 1 auto;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      font-size: 12px;
      font-weight: 600;
      color: rgba(255,255,255,.66);
      pointer-events: none;
    }
    .ym-sl-import {
      flex: 0 0 auto;
      min-height: 30px;
      padding: 0 10px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 7px;
      background: rgba(255,255,255,.07);
      color: rgba(255,255,255,.82);
      font: inherit;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      pointer-events: auto;
      transition: background .15s ease, transform .12s ease;
    }
    .ym-sl-import:hover { background: rgba(255,255,255,.14); }
    .ym-sl-import:active { transform: scale(.97); }
    /* The lyric search button after three empty answers: greyed and inert, with
       the reason spelled out in the status line above it. */
    .ym-sl-import:disabled {
      opacity: .38;
      cursor: not-allowed;
      background: rgba(255,255,255,.05);
      border-color: rgba(255,255,255,.08);
      color: rgba(255,255,255,.6);
    }
    .ym-sl-import:disabled:hover { background: rgba(255,255,255,.05); }
    .ym-sl-import:disabled:active { transform: none; }
    /* Inside the OPTIONS panel, match the selects they sit beside: same radius,
       slightly larger type. Scoped, so the panel's own toolbar buttons keep their
       compact sizing. */
    .ym-sl-options-overlay .ym-sl-import,
    .ym-sl-fs-options-overlay .ym-sl-import {
      min-height: 32px;
      border-radius: 8px;
      font-size: 12px;
    }
    .ym-sl-import.active {
      background: rgba(96,165,250,.28);
      border-color: rgba(96,165,250,.6);
      color: #eaf2ff;
    }
    /* ---- ad break -----------------------------------------------------------
       The notice borrows the "No lyrics found" empty state's exact type metrics
       and sits on the panel's own background — no scrim, no blur. The lyric
       layers keep their layout but are not painted, so the panel reads like any
       other empty state. NO BACKTICKS in this block: it lives inside a JS
       template literal. */
    .ym-sl-ad {
      position: absolute;
      inset: 0;
      z-index: 30;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 0;
      /* The empty state's own base is 14px and its title lands about a fifth
         of the way down the panel; this puts the ad notice on the same line,
         one step larger so it leads the panel. */
      padding: calc(20% + 20px) 8% 0;
      box-sizing: border-box;
      text-align: center;
      color: #fff;
      font-size: 16px;
      pointer-events: none;
      animation: ym-sl-ad-in .32s cubic-bezier(.22,1,.36,1) both;
    }
    #ym-sl-panel.ym-sl-ad-active .LyricsContainer,
    #ym-sl-panel.ym-sl-ad-active #ym-sl-amll-host {
      visibility: hidden !important;
    }
    #ym-sl-panel.ym-sl-ad-active .ym-sl-jump { display: none !important; }
    .ym-sl-ad.hidden { display: none; }
    .ym-sl-ad-title {
      max-width: 34em;
      font-size: 1.35em;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -.025em;
      text-wrap: balance;
      color: rgba(255,255,255,.92);
    }
    .ym-sl-ad-sub {
      margin-top: .85em;
      max-width: 34em;
      font-size: .95em;
      font-weight: 400;
      line-height: 1.55;
      color: rgba(255,255,255,.62);
      text-wrap: pretty;
    }
    .ym-sl-ad-source {
      margin-top: 1.5em;
      max-width: 34em;
      font-size: .9em;
      font-weight: 500;
      letter-spacing: .01em;
      color: rgba(255,255,255,.44);
    }
    @keyframes ym-sl-ad-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    /* Empty / failed state, styled after Spicy Lyrics' .LyricsNotice
       (default.scss): a centred notice with a title-weight message and a pill
       action, rather than the old small grey line. */
    .ym-sl-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: safe center;
      gap: 0;
      padding: 20px 8%;
      text-align: center;
      animation: ym-sl-notice-in .35s cubic-bezier(.22,1,.36,1) both;
    }
    .ym-sl-empty-msg {
      max-width: 34em;
      font-size: 1.35em;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -.025em;
      text-wrap: balance;
      color: rgba(255,255,255,.92);
    }
    .ym-sl-empty-body {
      margin-top: .85em;
      max-width: 34em;
      font-size: .95em;
      font-weight: 400;
      line-height: 1.55;
      color: rgba(255,255,255,.62);
      text-wrap: pretty;
    }
    .ym-sl-empty-search {
      margin-top: 1.6em;
      display: inline-flex;
      align-items: center;
      gap: .5em;
      height: 2.6em;
      padding: 0 1.15em;
      border: 0;
      border-radius: 999px;
      background: rgba(255,255,255,.08);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.14);
      color: rgba(255,255,255,.92);
      font-size: .9em;
      font-weight: 600;
      cursor: pointer;
      transition: background .18s ease, transform .18s ease;
    }
    .ym-sl-empty-search:hover {
      background: rgba(255,255,255,.14);
      transform: translateY(-1px);
    }
    @keyframes ym-sl-notice-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }
    /* Loading skeleton. Sized off --DefaultLyricsSize so it tracks the size
       slider: a real .line rule is font-size: var(--DefaultLyricsSize) at
       line-height 1.4 plus .12em block padding, i.e. ~1.64x, so a 0.6x bar with
       a 0.95x gap puts the placeholder rows on roughly the same pitch as real
       lyrics and the panel does not jump when they arrive.
       Only transform/opacity animate. A background-position shimmer would
       repaint the whole block every frame — the exact cost the skeleton exists
       to hide. */
    .ym-sl-skeleton {
      display: flex;
      flex-direction: column;
      gap: calc(var(--DefaultLyricsSize) * .95);
      padding: calc(var(--DefaultLyricsSize) * .5) 2px;
    }
    .ym-sl-skeleton-row {
      position: relative;
      flex: 0 0 auto;
      height: calc(var(--DefaultLyricsSize) * .6);
      border-radius: 6px;
      background: rgba(255,255,255,.075);
      overflow: hidden;
    }
    .ym-sl-skeleton-row::after {
      content: "";
      position: absolute;
      inset: 0;
      transform: translateX(-100%);
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.10), transparent);
      animation: ym-sl-skeleton-sweep 1.15s ease-in-out infinite;
    }
    @keyframes ym-sl-skeleton-sweep {
      from { transform: translateX(-100%); }
      to   { transform: translateX(100%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .ym-sl-skeleton-row::after { display: none; }
    }
    .ym-sl-search {
      position: absolute;
      top: 48px;
      left: 14px;
      right: 14px;
      z-index: 30;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 14px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 16px;
      background: rgba(20,20,26,.97);
      pointer-events: auto;
      animation: ym-sl-search-in .42s cubic-bezier(.32,.72,0,1) both;
    }
    .ym-sl-search.hidden { display: none !important; }
    .ym-sl-search.closing {
      animation: ym-sl-search-out .2s cubic-bezier(.4,0,1,1) both;
      pointer-events: none;
    }
    @keyframes ym-sl-search-out {
      from { opacity: 1; transform: none; filter: blur(0); }
      to { opacity: 0; transform: translateY(6px) scale(.972); filter: blur(6px); }
    }
    @keyframes ym-sl-search-in {
      from { opacity: 0; transform: translateY(10px) scale(.965); filter: blur(8px); }
      to { opacity: 1; transform: none; filter: blur(0); }
    }
    .ym-sl-search-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .ym-sl-search-title {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -.01em;
      color: rgba(255,255,255,.94);
    }
    .ym-sl-search-close {
      flex: 0 0 auto;
      width: 26px;
      height: 26px;
      border: 0;
      border-radius: 8px;
      background: rgba(255,255,255,.08);
      color: rgba(255,255,255,.7);
      font-size: 13px;
      line-height: 1;
      cursor: pointer;
      transition: background .18s ease, color .18s ease, transform .18s ease;
    }
    .ym-sl-search-close:hover {
      background: rgba(255,255,255,.16);
      color: #fff;
      transform: scale(1.06);
    }
    .ym-sl-search-form { display: flex; gap: 8px; }
    .ym-sl-search-input {
      flex: 1 1 auto;
      min-height: 34px;
      padding: 0 12px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 10px;
      background: rgba(255,255,255,.06);
      color: rgba(255,255,255,.94);
      font: inherit;
      font-size: 12.5px;
      transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
    }
    .ym-sl-search-input:focus {
      outline: none;
      border-color: rgba(63,224,197,.55);
      background: rgba(255,255,255,.09);
      box-shadow: 0 0 0 3px rgba(63,224,197,.14);
    }
    .ym-sl-search-input::placeholder { color: rgba(255,255,255,.4); }
    .ym-sl-search-remember {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 11px;
      color: rgba(255,255,255,.62);
      cursor: pointer;
      user-select: none;
    }
    .ym-sl-search-status {
      min-height: 14px;
      font-size: 11px;
      line-height: 1.45;
      color: rgba(255,255,255,.55);
    }
    /* The empty state's Discord invite: the status line is the only place the
       panel explains a miss, so the link has to read as one at 11px. */
    .ym-sl-search-link {
      color: rgba(63,224,197,.95);
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: pointer;
    }
    .ym-sl-search-link:hover { color: #3fe0c5; }
    /* Shown once the three tries are spent, under the empty-state sentence. */
    .ym-sl-search-empty-note {
      margin-top: 4px;
      color: rgba(255,255,255,.72);
    }
    .ym-sl-search-foot {
      font-size: 10.5px;
      line-height: 1.4;
      letter-spacing: .01em;
      color: rgba(255,140,140,.82);
    }
    .ym-sl-search-foot:empty { display: none; }
    .ym-sl-search-results {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 250px;
      overflow-y: auto;
      margin: 0;
      padding: 2px;
      scrollbar-width: thin;
      scrollbar-color: rgba(255,255,255,.2) transparent;
    }
    .ym-sl-search-results::-webkit-scrollbar { width: 6px; }
    .ym-sl-search-results::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,.18);
      border-radius: 3px;
    }
    /* Each row rises + unblurs in, staggered down the list. --r-op carries the
       per-state opacity so .no-sync can stay dim without the animation's
       fill-mode overriding it. */
    .ym-sl-search-result {
      --r-op: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      text-align: left;
      padding: 9px 11px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 10px;
      background: rgba(255,255,255,.045);
      color: rgba(255,255,255,.92);
      font: inherit;
      cursor: pointer;
      opacity: var(--r-op);
      animation: ym-sl-result-in .44s cubic-bezier(.34,1.3,.5,1) both;
      transition: background .16s ease, border-color .16s ease, transform .16s ease;
    }
    .ym-sl-search-result:nth-child(2) { animation-delay: .04s; }
    .ym-sl-search-result:nth-child(3) { animation-delay: .08s; }
    .ym-sl-search-result:nth-child(4) { animation-delay: .12s; }
    .ym-sl-search-result:nth-child(5) { animation-delay: .16s; }
    .ym-sl-search-result:nth-child(6) { animation-delay: .2s; }
    .ym-sl-search-result:nth-child(n+7) { animation-delay: .24s; }
    @keyframes ym-sl-result-in {
      from { opacity: 0; transform: translateY(9px); filter: blur(5px); }
      to { opacity: var(--r-op, 1); transform: none; filter: blur(0); }
    }
    .ym-sl-search-result:hover {
      background: rgba(255,255,255,.08);
      border-color: rgba(63,224,197,.38);
      transform: translateX(2px);
    }
    .ym-sl-search-result.no-sync {
      --r-op: .42;
      cursor: not-allowed;
      background: rgba(255,255,255,.03);
    }
    .ym-sl-search-result.no-sync:hover {
      background: rgba(255,255,255,.03);
      border-color: rgba(255,255,255,.08);
      transform: none;
    }
    .ym-sl-search-result.no-sync-available {
      --r-op: .62;
      cursor: pointer;
    }
    .ym-sl-search-result.no-sync-available:hover {
      background: rgba(255,255,255,.08);
      border-color: rgba(63,224,197,.38);
      transform: translateX(2px);
    }
    .ym-sl-search-name { font-size: 12.5px; font-weight: 600; }
    .ym-sl-search-meta { font-size: 11px; color: rgba(255,255,255,.55); }
    .ym-sl-jump {
      position: absolute;
      right: 18px;
      bottom: 18px;
      z-index: 25;
      min-height: 32px;
      padding: 0 12px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 8px;
      background: rgba(0,0,0,.88);
      color: rgba(255,255,255,.9);
      font: inherit;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      pointer-events: auto;
      opacity: 1;
      transform: translateY(0);
      transition:
        opacity .18s ease,
        background .15s ease,
        transform .18s ease;
    }
    .ym-sl-jump:hover { background: rgba(0,0,0,.98); }
    .ym-sl-jump:active { transform: scale(.97); }
    .ym-sl-jump.hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(6px);
    }
    /* In Video Background the fullscreen volume bar owns the bottom-right
       corner. Keep the jump pill above it instead of letting the two overlap. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background.ym-sl-fs-has-video .ym-sl-jump {
      bottom: 68px;
    }
    /* Fullscreen: Next up owns the bottom-right corner, and hovering it unfurls
       four rows over a frost panel that bleeds 16px past the box - which buried
       this pill, so the jump was unclickable exactly when the queue was open.
       Park the pill to the LEFT of that column instead: the stack's right inset
       (22px) + its width + the frost bleed (16px) + a 10px gap. Widths mirror
       .ym-sl-fs-nextup's own min(340px, 42vw) so the two stay in step at every
       viewport. Hits has no Next up, so it keeps the corner to itself. */
    .ym-sl-fs-overlay:not(.ym-sl-fs-mode-hits) .ym-sl-jump {
      right: calc(22px + min(340px, 42vw) + 26px);
    }
    /* ---- MV pause re-sync ---------------------------------------------------
       Pick mode: hovering a primary line shows the existing .line::before box in a
       stronger form plus a floating "Sync from here" label (.line::after is unused
       on lines, only .word/.letterGroup use ::after for spacing). The label is
       absolutely positioned, so it is not treated as a flex item of the .line. */
    .ym-sl-pause-mode .line:not(.bg-line):not(.musical-line)::after {
      content: "Sync from here";
      position: absolute;
      right: -4px;
      top: -11px;
      z-index: 3;
      padding: 1px 6px;
      border-radius: 6px;
      background: rgba(0,0,0,.86);
      color: rgba(255,255,255,.88);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .02em;
      line-height: 1.5;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transition: opacity .15s ease;
    }
    .ym-sl-pause-mode .line:not(.bg-line):not(.musical-line):hover::after { opacity: 1; }
    .ym-sl-pause-mode .line:not(.bg-line):not(.musical-line):hover::before {
      opacity: 1;
      transform: scale(1);
      border-color: rgba(255,255,255,.55);
      background: rgba(255,255,255,.10);
    }
    .ym-sl-pause-mode .line.bg-line,
    .ym-sl-pause-mode .line.musical-line { cursor: default; }
    /* Persistently mark the chosen sync point even outside pick mode. */
    .line.ym-sl-pause-mark::before {
      opacity: 1;
      transform: scale(1);
      border-color: rgba(255,255,255,.45);
      background: rgba(255,255,255,.05);
    }
    .ym-sl-pause-banner {
      position: absolute;
      left: 10px;
      right: 10px;
      bottom: 58px;
      z-index: 26;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 8px;
      background: rgba(0,0,0,.9);
      color: rgba(255,255,255,.92);
      font-size: 11px;
      font-weight: 600;
    }
    .ym-sl-pause-banner.hidden { display: none; }
    .ym-sl-pause-banner-text { flex: 1 1 auto; min-width: 0; }
    .ym-sl-pause-cancel {
      flex: 0 0 auto;
      min-height: 24px;
      padding: 0 10px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 6px;
      background: rgba(255,255,255,.08);
      color: rgba(255,255,255,.9);
      font: inherit;
      font-size: 11px;
      cursor: pointer;
    }
    .ym-sl-pause-section { display: flex; flex-direction: column; gap: 6px; }
    .ym-sl-pause-editor { display: flex; flex-direction: column; gap: 6px; }
    .ym-sl-pause-editor.hidden { display: none; }
    .ym-sl-pause-line {
      font-size: 11px;
      color: rgba(255,255,255,.62);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .ym-sl-pause-row { display: flex; align-items: center; gap: 8px; }
    .ym-sl-pause-range { flex: 1 1 auto; min-width: 0; accent-color: #fff; }
    .ym-sl-pause-number {
      flex: 0 0 auto;
      width: 58px;
      min-height: 26px;
      padding: 0 6px;
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 6px;
      background: rgba(0,0,0,.35);
      color: rgba(255,255,255,.9);
      font: inherit;
      font-size: 11px;
    }
    .ym-sl-pause-value { font-size: 11px; color: rgba(255,255,255,.72); }
    .ym-sl-pause-clear { flex: 0 0 auto; min-height: 26px; padding: 0 10px; }
    .ym-sl-pause-pick.hidden { display: none; }
    .ym-sl-pause-pick:disabled { opacity: .45; cursor: not-allowed; }
    .ym-sl-import-mode {
      flex: 0 0 auto;
      min-height: 30px;
      padding: 0 24px 0 8px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 7px;
      background: rgba(255,255,255,.07);
      color: rgba(255,255,255,.82);
      font: inherit;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      pointer-events: auto;
    }
    .ym-sl-import-mode option {
      background: #202020;
      color: #000;
    }
    /* The OPTIONS panel's selects are dark, matching its buttons and the rest of
       the panel. color-scheme: dark (not light) so Chrome also draws the native
       arrow and the open dropdown dark — the white select was the single most
       jarring thing in the panel. */
    .ym-sl-options-overlay select,
    .ym-sl-fs-options-overlay select {
      color-scheme: dark;
      box-sizing: border-box;
      width: 100%;
      padding: 8px 10px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 8px;
      background-color: rgba(255,255,255,.07);
      color: rgba(255,255,255,.9);
      font: inherit;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color .2s ease, border-color .2s ease;
    }
    .ym-sl-options-overlay select option,
    .ym-sl-fs-options-overlay select option {
      background: #14161b;
      color: #f1f1f1;
    }
    .ym-sl-options-overlay select:hover,
    .ym-sl-options-overlay select:focus,
    .ym-sl-fs-options-overlay select:hover,
    .ym-sl-fs-options-overlay select:focus {
      background-color: rgba(255,255,255,.12);
      border-color: rgba(255,255,255,.3);
      outline: none;
    }
    /* The fullscreen layout picker keeps its light treatment — it floats over
       video, where a dark pill disappears. */
    .ym-sl-fs-controls select {
      color-scheme: light;
      background-color: #fff;
      color: #000;
      transition: background-color .2s ease, color .2s ease, border-color .2s ease;
    }
    .ym-sl-fs-controls select option {
      background: #fff;
      color: #000;
    }
    .ym-sl-fs-controls select:hover,
    .ym-sl-fs-controls select:focus {
      background-color: #f2f2f2;
      border-color: rgba(0,0,0,.35);
      color: #000;
      outline: none;
    }

/* Fullscreen controls must stay reachable on short/lower-resolution screens.
       They remain over the overlay but have a safe-area clamp so the native
       fullscreen browser chrome and YTM player bar cannot cover them. */
    .ym-sl-fs-controls {
      top: max(18px, env(safe-area-inset-top, 0px));
      right: max(18px, env(safe-area-inset-right, 0px));
    }
    @media (max-height: 700px) {
      .ym-sl-fs-controls {
        top: max(8px, env(safe-area-inset-top, 0px));
        right: max(8px, env(safe-area-inset-right, 0px));
        transform: translateY(-8px) scale(.92);
        transform-origin: top right;
      }
      .ym-sl-fs-overlay:hover .ym-sl-fs-controls,
      .ym-sl-fs-overlay:focus-within .ym-sl-fs-controls {
        transform: translateY(0) scale(.92);
      }
    }
    @media (max-height: 560px) {
      .ym-sl-fs-controls {
        gap: 4px;
        padding: 5px 6px;
        top: max(4px, env(safe-area-inset-top, 0px));
        right: max(4px, env(safe-area-inset-right, 0px));
        transform: translateY(-4px) scale(.82);
      }
      .ym-sl-fs-overlay:hover .ym-sl-fs-controls,
      .ym-sl-fs-overlay:focus-within .ym-sl-fs-controls {
        transform: translateY(0) scale(.82);
      }
      /* Match the compact 4px row gap so the collapsed Hide lyrics slot does
         not pull Layout into Options on short screens. */
      .ym-sl-fs-overlay.ym-sl-fs-has-video .ym-sl-fs-controls button.ym-sl-fs-lyrics-toggle {
        margin-left: -4px;
      }
    }
    /* Lower-resolution YTM pages can have a short viewport where the native
       tab row is clipped by the player/header stack. Keep the existing panel
       mount, but reserve a compact top-safe position for the tab controls. */
    @media (max-height: 700px) {
      #ym-sl-panel.SpicyRenderer .ym-sl-import,
      #ym-sl-panel.SpicyRenderer .ym-sl-import-mode,
      #ym-sl-panel.SpicyRenderer .ym-sl-video-offset {
        min-height: 26px;
        font-size: 10px;
      }
    }
    @media (max-height: 560px) {
      #ym-sl-panel.SpicyRenderer .ym-sl-import,
      #ym-sl-panel.SpicyRenderer .ym-sl-import-mode,
      #ym-sl-panel.SpicyRenderer .ym-sl-video-offset {
        min-height: 22px;
        font-size: 9px;
      }
    }

    #ym-sl-panel.SpicyRenderer .LyricsContainer {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      z-index: 4;
    }
    #ym-sl-panel.SpicyRenderer .LyricsContent {
      --TextGlowDef: rgba(255,255,255,.15) 0 0 6px;
      --ActiveTextGlowDef: rgba(255,255,255,.4) 0 0 14px;
      --StrongTextGlowDef: rgba(255,255,255,.68) 0 0 16.4px;
      --ym-sl-lyrics-scale: 1;
      --ym-sl-lyrics-offset: 0px;
      /* The glide's sub-pixel remainder (see setScrollFraction). Written by JS as
         a NEGATIVE px value and folded into the transform below, so it needs no
         element of its own. */
      --ym-sl-scroll-frac: 0px;
      /* Background-vocal opacity as a MULTIPLE of a lead line's, so 1 = the
         same dimming a normal line gets (see the .line.bg-line block). Named
         "-scale" and not "-opacity" because it is not used as an opacity value
         directly: calling it --ym-sl-bg-vocal-opacity and then feeding it
         straight to the opacity property is what broke background vocals in
         the first place. applySettings() overwrites this with the user's
         setting.
         NO BACKTICKS ANYWHERE IN THIS COMMENT BLOCK — this CSS lives inside a
         JS template literal, so a stray backtick terminates it early. */
      --ym-sl-bg-vocal-scale: 1;
      /* Container-relative base, RESTORED. A fixed rem base was tried
         for a week to hold the size constant across monitors, but called it
         out: the pane gets narrower and the type does not, so the lyrics crowd
         the panel. The 7cqw term tracks the pane instead.

         Which pane: the query container is .ym-sl-panel (container-type: size,
         above), NOT this element -- a container cannot query itself, so cqw in a
         declaration here resolves against the nearest ANCESTOR container.
         Measured live: panel content box 522px => 7cqw = 36.5px, already past
         the 3.5rem ceiling. So on a normal-size pane this sits AT the ceiling
         (35px) and only starts shrinking once the pane drops below ~500px. That
         is the intended behaviour.

         The fullscreen pane needs no override of its own: it is much wider, so
         its 7cqw is even further past the same ceiling and the two agree.

         The user's size setting still multiplies via --ym-sl-lyrics-scale.
         NO BACKTICKS ANYWHERE IN THIS COMMENT BLOCK -- this CSS lives inside a
         JS template literal, so a stray backtick terminates it early. */
      /* px, not rem: the root font-size is now user-scalable from the panel's
         YouTube page, and the lyrics must not grow with YouTube's own UI —
         their size has its own setting. */
      --DefaultLyricsSize: calc(clamp(17px, calc(1cqw * 7), 35px) * var(--ym-sl-lyrics-scale));
      --amll-lyric-player-font-size: var(--DefaultLyricsSize);
      --vertical-gap: 0px;
      width: 100%;
      height: 100%;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      /* Eases the NON-spring scroll path. "Smooth scrolling off" means the user
         did not ask for our spring; it does not mean the panel should teleport,
         which is what it used to do while "smooth scrolling off" was folded into
         "immediate". Every per-frame writer passes an explicit behavior of
         "instant" so this never fights the spring — see writeScrollTop().
         NO BACKTICKS IN THIS COMMENT BLOCK — it lives inside a template literal. */
      scroll-behavior: smooth;
      font-size: var(--DefaultLyricsSize) !important;
      font-weight: 700;
      font-family: var(--ym-sl-lyric-font, "SpicyLyrics"), "Noto Sans Georgian", "Vazirmatn",
        "SF Pro Display", "SF Pro Text", "SF Pro", -apple-system,
        BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif !important;
      font-kerning: normal;
      scrollbar-width: thin;
      scrollbar-color: transparent transparent;
      container-type: size;
      opacity: 1;
      /* The lyric offset AND the glide's sub-pixel remainder share ONE transform.
         scrollTop is integer-only, so the glide writes whole pixels there and
         carries the fraction here (--ym-sl-scroll-frac, written by
         setScrollFraction) — the same trick upstream uses on their virtual
         container, without needing an extra wrapper element. */
      transform: translateY(calc(var(--ym-sl-lyrics-offset) + var(--ym-sl-scroll-frac, 0px)));
      transform-origin: center center;
      /* No top/bottom dissolve. The 64px fades made every line
         that crossed the panel edge read as DIMMER while the active line played,
         which looks like a state bug, not a fade. The scrollport clips hard now:
         lines stay at full brightness right up to the edge and leave at it. The
         fullscreen rules below still fade, because there the scrollport is the
         whole screen and the controls need the room. */
      -webkit-mask-image: none;
      mask-image: none;
      transition: opacity .25s ease;
    }
    /* Fullscreen: the scrollport is now the whole screen height, so the fade
       belongs to the monitor edge, not to a padded box inside it. Keep the top
       ramp short — it only softens a line climbing out of the top edge — and
       let the bottom keep fading down to the very last pixel, where upcoming
       lines leave for the controls. The active line rests at the halfway point,
       clear of both. */
    .ym-sl-fs-lyrics #ym-sl-panel.SpicyRenderer .LyricsContent {
      -webkit-mask-image: linear-gradient(180deg, transparent 0, rgba(0,0,0,.45) 2.5%, #000 9%, #000 82%, rgba(0,0,0,.5) 93%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0, rgba(0,0,0,.45) 2.5%, #000 9%, #000 82%, rgba(0,0,0,.5) 93%, transparent 100%);
    }
    /* Honour a reduced-motion request: the native ease above is a scroll
       animation like any other. The spring path is already off for these users
       (see applySettings), so this only has to cover the fallback. */
    @media (prefers-reduced-motion: reduce) {
      #ym-sl-panel.SpicyRenderer .LyricsContent { scroll-behavior: auto; }
    }
    #ym-sl-panel.SpicyRenderer .LyricsContent.offline {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* Better Lyrics (Braccato) third renderer. Its container lives inside the
       same .LyricsContent scrollport as the Spicy lines, so the panel mask,
       offset transform, fullscreen reparent and typography variables all keep
       working. The Spicy surface stays in the DOM as a timing model but is not
       painted while Braccato owns the track. */
    #ym-sl-panel .ym-sl-braccato {
      display: none;
      box-sizing: border-box;
      width: 100%;
      padding: 25cqh 28px 45cqh;
      font-size: var(--DefaultLyricsSize);
      --blyrics-font-family: var(--ym-sl-lyric-font, "SpicyLyrics");
      --blyrics-font-size: var(--DefaultLyricsSize);
      --blyrics-font-weight: 700;
      --blyrics-line-height: 1.25;
      --blyrics-padding: .75rem;
      --blyrics-translated-font-size: .5em;
      --blyrics-active-scale: 1;
      --blyrics-scale: .95;
      /* Sit the playing line higher than Better Lyrics' .37 default. */
      --blyrics-target-scroll-pos-ratio: .28;
      /* Keep the engine's timing variables at their bundle defaults; the
         renderer adapter cancels Braccato's built-in 115/150 ms lead in
         braccatoTickOptions so Better Lyrics uses the same timestamp as Spicy
         and Apple. The user's own offset is still applied by Aurora before
         tick(), so these variables are not the place to tune it. */
    }
    #ym-sl-panel.BraccatoRenderer .ym-sl-braccato { display: block; }
    #ym-sl-panel.BraccatoRenderer .SpicyLyricsScrollContainer { display: none !important; }
    /* Better Lyrics owns the panel while it runs, and its own container is empty
       when a lookup comes back with nothing - so a track with no lyrics showed a
       blank panel instead of the shared notice. The notice ("No lyrics found." +
       the LRCLIB Search button) lives in the Spicy scroller that Braccato hides,
       so while a message is up that scroller comes back and the empty Braccato
       container steps aside. showLyricsMessage() sets the class and the next load
       clears it (resetLyricsPanelState). */
    #ym-sl-panel.BraccatoRenderer.ym-sl-empty-state .SpicyLyricsScrollContainer {
      display: flex !important;
    }
    #ym-sl-panel.BraccatoRenderer.ym-sl-empty-state .ym-sl-braccato {
      display: none !important;
    }
    /* Braccato writes scrollTop every frame. The shared smooth-scroll easing
       would restart an animation after each of those writes. */
    #ym-sl-panel.BraccatoRenderer .LyricsContent { scroll-behavior: auto; }
    #ym-sl-panel.BraccatoRenderer .LyricsContent .blyrics-container {
      display: block;
    }
    /* Braccato culls offscreen lines with content-visibility:auto. At the top
       edge that cull can remove a line a frame before it leaves the mask, which
       reads as the top line snapping upward while the lines below glide. Keep
       the lines rendered; the scrollport already clips them and the saved paint
       is not worth the visible edge pop. */
    #ym-sl-panel.BraccatoRenderer .blyrics--line {
      content-visibility: visible !important;
    }
    /* The shared credits card is normally the last child of the lyric
       container. Braccato's generic "direct child" rule gives every line a
       large padding and a 0.95 scale; the footer is a direct child too, so
       undo those here. The engine's own bottom spacer stays AFTER the footer,
       which is what keeps the credits against the last line instead of a
       viewport away from it. */
    #ym-sl-panel.BraccatoRenderer .blyrics-container > .ym-sl-credits.blyrics-credits {
      margin: 48px 0 22px;
      padding: 18px 22px 16px !important;
      transform: none;
      cursor: default;
      /* The .blyrics-credits class opts the card into Braccato's line-scroll
         plan. Its stock credit styling dims the row and the focused-credit
         rule changes opacity again; Aurora's card is a static footer, so keep
         it fully opaque. */
      opacity: 1 !important;
      color: inherit;
    }
    /* Music-video off-sync notice (see syncMvSyncNotice). A pill at the top of
       the panel with a shrinking timer bar: no pointer events, no layout shift,
       fades and removes itself after the 5s countdown. */
    .ym-sl-mv-sync-chip {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 5;
      padding: 5px 12px 8px;
      border-radius: 999px;
      background: rgba(0, 0, 0, .55);
      color: rgba(255, 255, 255, .8);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: .02em;
      white-space: nowrap;
      pointer-events: none;
      opacity: 1;
      transition: opacity .45s ease;
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }
    .ym-sl-mv-sync-chip.ym-sl-fading {
      opacity: 0;
    }
    /* Source warning (lrc.red) — same pill, nudged down so it can coexist with
       the music-video sync chip instead of covering it. */
    .ym-sl-source-chip {
      top: 40px;
    }
    /* LRCLIB word-by-word quality warning. It owns the top slot for its
       five-second countdown, then fades out; the timer line needs the extra
       bottom padding so it never sits on the text. */
    .ym-sl-lrclib-word-note {
      top: 10px;
      max-width: calc(100% - 28px);
      box-sizing: border-box;
      padding: 6px 12px 10px;
      white-space: normal;
      text-align: center;
      line-height: 1.35;
      z-index: 6;
    }
    .ym-sl-lrclib-word-note.hidden { display: none; }
    #ym-sl-panel.ym-sl-word-sync-warning-active .ym-sl-mv-sync-chip:not(.ym-sl-lrclib-word-note) {
      top: 44px;
    }
    #ym-sl-panel.ym-sl-word-sync-warning-active .ym-sl-source-chip {
      top: 74px;
    }
    #ym-sl-panel.ym-sl-word-sync-warning-active .ym-sl-translate-chip {
      top: 44px;
    }
    /* Background mode hides the lyrics chrome; this notice belongs with it. */
    .ym-sl-fs-overlay.ym-sl-fs-mode-background .ym-sl-lrclib-word-note,
    #ym-sl-panel.ym-sl-ad-active .ym-sl-lrclib-word-note {
      display: none;
    }
    .ym-sl-mv-sync-chip-timer {
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 4px;
      height: 2px;
      border-radius: 1px;
      background: rgba(255, 255, 255, .35);
      transform-origin: left center;
      animation: ym-sl-mv-sync-timer 5s linear forwards;
    }
    /* On-device translation setup. Unlike the notice chips above this one can
       carry a button (Chrome needs a click before a language pack may
       download), so it takes pointer events and is its own flex row. */
    .ym-sl-translate-chip {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 6;
      display: flex;
      align-items: center;
      gap: 9px;
      max-width: calc(100% - 28px);
      padding: 6px 6px 6px 12px;
      border-radius: 999px;
      background: rgba(0, 0, 0, .62);
      color: rgba(255, 255, 255, .84);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: .02em;
      white-space: nowrap;
      opacity: 1;
      transition: opacity .45s ease;
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
    .ym-sl-translate-chip.ym-sl-fading {
      opacity: 0;
      pointer-events: none;
    }
    .ym-sl-translate-chip-label {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ym-sl-translate-chip-action {
      flex: none;
      padding: 4px 9px;
      border: 0;
      border-radius: 999px;
      background: rgba(255, 255, 255, .14);
      color: #fff;
      font: inherit;
      letter-spacing: inherit;
      cursor: pointer;
      transition: background .18s ease;
    }
    .ym-sl-translate-chip-action:hover {
      background: rgba(255, 255, 255, .24);
    }
    .ym-sl-translate-chip-action:active {
      background: rgba(255, 255, 255, .3);
    }
    .ym-sl-translate-chip-action:focus-visible {
      outline: 2px solid rgba(255, 255, 255, .8);
      outline-offset: 2px;
    }
    @keyframes ym-sl-mv-sync-timer {
      from { transform: scaleX(1); }
      to   { transform: scaleX(0); }
    }
    #ym-sl-panel.SpicyRenderer .SpicyLyricsScrollContainer {
      width: 100%;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      margin-top: 25cqh;
      margin-bottom: 45cqh;
    }
    #ym-sl-panel.SpicyRenderer .VirtualLyricsContainer {
      position: relative;
      width: 100%;
      box-sizing: border-box;
      /* Clip-safe horizontal inset. .LyricsContent has overflow-x: hidden, so
         lyric glyphs (and the hover highlight box, which bleeds .35em past the
         line) get cut at the panel edge. Widening the inner padding keeps the
         text layout/formatting identical and just reserves a safe band, so the
         right edge clips inside the tab boundary instead of on the glyphs. */
      padding: 0 28px;
      container-type: inline-size;
    }
    #ym-sl-panel.SpicyRenderer .line {
      --font-size: var(--DefaultLyricsSize);
      --BlurAmount: 0px;

      --DefaultLyricsScale: .95;
      --DefaultEmphasisLyricsScale: .95;
      --DefaultLineScale: 1;
      --Vocal-NotSung-opacity: .51;
      --Vocal-Active-opacity: 1;
      --Vocal-Sung-opacity: .497;
      --Vocal-Hover-opacity: 1;
      --ym-sl-line-alpha: var(--Vocal-NotSung-opacity);
      --ym-sl-entry-shadow-alpha: .4;
      --gradient-position: -20%;
      --gradient-color: 255;
      --gradient-alpha: .85;
      --gradient-alpha-end: .5;
      --gradient-degrees: 90deg;
      --gradient-offset: 0%;
      display: flex;
      position: relative;
      flex-wrap: wrap;
      align-items: baseline;
      margin: 1cqw 0;
      opacity: 1;
      /* Fade the gradient paint. Group opacity briefly blanks clipped glyphs
         while their per-word sweep repaints at the line's onset. */
      transition:
        filter .4s cubic-bezier(.22,.61,.36,1),
        --ym-sl-line-alpha .2s cubic-bezier(.61,1,.88,1),
        --ym-sl-entry-shadow-alpha .2s cubic-bezier(.61,1,.88,1);
      /* Depth blur. animate() writes the filter per line with the engine's own
         spacing (1px per line away, capped at 5px) and clears it on the
         playing line, exactly like the Apple-Music renderer, so the sharp line
         never pays for a filter layer. */
      font-size: var(--font-size) !important;
      /* SF Pro's descenders need a little more line-box room than the
         original SpicyLyrics font, especially while the glyphs are lifted. */
      line-height: 1.4 !important;
      letter-spacing: 0;
      direction: ltr;
      cursor: pointer;
      transform-origin: left center;
      isolation: isolate;
      overflow: visible;
      padding-block: .12em;
    }
    /* Static (unsynced) lines: paint at full alpha / opacity and use tighter
       spacing, mirroring Spicy Lyrics' data-lyrics-type="Static" look so an
       unkaraoked LRCLIB result reads like real lyrics rather than dim ghosts.
       Scoped to .line.static only — synced lyrics keep their own rhythm. */
    #ym-sl-panel.SpicyRenderer .line.static {
      opacity: 1 !important;
      --ym-sl-line-alpha: 1 !important;
      --gradient-alpha: 1 !important;
      --gradient-alpha-end: 1 !important;
      margin: .12cqw 0;
      --font-size: calc(var(--DefaultLyricsSize) * .9);
      padding-block: .04em;
      line-height: 1.2 !important;
      cursor: default;
      transition: none;
    }
    #ym-sl-panel.SpicyRenderer .line.static .word,
    #ym-sl-panel.SpicyRenderer .line.static .letter {
      --gradient-alpha: 1 !important;
      --gradient-alpha-end: 1 !important;
      --gradient-position: 100% !important;
      --text-shadow-blur-radius: 4px;
      --text-shadow-opacity: 0%;
      transform: none;
      --ym-sl-base-scale: 1;
    }
    #ym-sl-panel.SpicyRenderer .line::before {
      content: "";
      position: absolute;
      inset: -.08em -.35em;
      z-index: 0;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 10px;
      background: rgba(255,255,255,.055);
      opacity: 0;
      transform: scale(.985);
      pointer-events: none;
      transition:
        opacity .18s ease,
        transform .22s cubic-bezier(.22,.61,.36,1);
    }
    #ym-sl-panel.SpicyRenderer .line > * {
      position: relative;
      z-index: 1;
    }
    /* A singer's name above the first line of their part. Smaller and quieter
       than the lyric so it reads as a heading rather than as something sung,
       and it never takes clicks: seeking belongs to the line under it. */
    #ym-sl-panel.SpicyRenderer .line .line-singer {
      flex-basis: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      order: -1;
      margin-bottom: .1em;
      font-size: .4em;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
      text-transform: none;
      opacity: .78;
      pointer-events: none;
    }
    /* A duet line's part starts on the right, so its name does too. */
    #ym-sl-panel.SpicyRenderer .line.OppositeAligned .line-singer {
      align-items: flex-end;
    }
    #ym-sl-panel.SpicyRenderer .line .line-singer .line-singer-real {
      font-size: .72em;
      font-weight: 600;
      opacity: .8;
    }
    /* On-device English translation of a foreign line (23-auto-translate).
       Deliberately a smaller, quieter line than the lyric it explains: it is
       meaning, not pronunciation, so it must never compete with the sung
       words. Empty until the translation arrives, and display:none while empty
       so a pending line keeps its exact old height. */
    #ym-sl-panel.SpicyRenderer .line .translation {
      flex-basis: 100%;
      width: 100%;
      order: 100;
      font-size: .5em;
      line-height: 1.3;
      font-weight: 500;
      letter-spacing: .01em;
      text-transform: none;
      /* The gloss is English even when the lyric is Hebrew or Arabic. Isolate
         it so an RTL line cannot reverse the order of its words. */
      direction: ltr;
      unicode-bidi: isolate;
      margin-top: .16em;
      color: rgba(255,255,255,.58);
      text-shadow: 0 1px 3px rgba(0,0,0,.45);
      opacity: var(--ym-sl-line-alpha);
      pointer-events: none;
    }
    #ym-sl-panel.SpicyRenderer .line .translation:empty {
      display: none;
    }
    #ym-sl-panel.SpicyRenderer .line.Active .translation {
      opacity: calc(.9 * var(--ym-sl-line-alpha));
      color: rgba(255,255,255,.7);
    }
    /* AMLL draws translations through the engine's own sub-line, which upstream
       keeps at .3 opacity, which is too faint for the line's meaning, so lift it
       one step. */
    #ym-sl-panel #ym-sl-amll-host .FmKaba_lyricSubLine {
      opacity: .4;
      /* Same rule as the Spicy translation above: the sub-line is English. */
      direction: ltr;
      unicode-bidi: isolate;
    }
    #ym-sl-panel.SpicyRenderer .line:hover {
      z-index: 2;
    }
    #ym-sl-panel.SpicyRenderer .line:hover::before {
      opacity: var(--ym-sl-line-alpha);
      transform: scale(1);
    }
    /* Static (unsynced) lines can't be clicked to seek (no time mapping), so the
       hover highlight box is misleading — suppress it for them. */
    #ym-sl-panel.SpicyRenderer .line.static:hover::before {
      opacity: 0;
      transform: scale(.985);
    }
    #ym-sl-panel.SpicyRenderer .line.static:hover {
      z-index: auto;
    }
    #ym-sl-panel.SpicyRenderer .line.OppositeAligned:not(.rtl) {
      transform-origin: right center;
    }
    #ym-sl-panel.SpicyRenderer .line.rtl.OppositeAligned {
      transform-origin: left center !important;
    }
    #ym-sl-panel.SpicyRenderer .line.line-timed {
      transition:
        --ym-sl-line-alpha .2s cubic-bezier(.61,1,.88,1),
        --ym-sl-entry-shadow-alpha .2s cubic-bezier(.61,1,.88,1),
        scale .28s cubic-bezier(.22,.61,.36,1);
    }
    #ym-sl-panel.SpicyRenderer .line.line-timed.Active {
      scale: 1.05;
    }
    #ym-sl-panel.SpicyRenderer
      .SpicyLyricsScrollContainer.HasDuetLines
      .line:not(.OppositeAligned, .rtl) {
      width: 100%;
      box-sizing: border-box;
      padding-right: 14cqw;
    }
    #ym-sl-panel.SpicyRenderer
      .SpicyLyricsScrollContainer.HasDuetLines
      .line.OppositeAligned:not(.rtl) {
      width: 100%;
      box-sizing: border-box;
      justify-content: flex-end;
      padding-left: 14cqw;
      text-align: right;
      transform-origin: right center;
    }
    /* Per-kind weight. The bundled face tops out at 700, so
       extra weight comes from a hairline text-stroke rather than a synthetic
       bold. The stroke is TRANSPARENT on purpose: a stroke is still part of the
       background-clip:text region, so the clipped gradient grows by the stroke
       width and the letters genuinely get heavier, while the stroke itself
       paints nothing. A white stroke (at ANY alpha) is painted OVER the clipped
       gradient, so the glyph edge becomes fill + stroke * (1 - fill): on a dim
       .25-alpha word that is .44, almost double — a white outline around grey
       letters, the "bright outer layer" reported twice.
       Lowering the alpha only scaled that rim down; it cannot remove it.
       #ym-sl-amll-host gets away with a white stroke because its fill is opaque.
       Word-by-word keeps the old, unstroked weight. Line-synced matches AMLL's
       0.6px, and plain (static) TTML only a touch heavier than before. */
    #ym-sl-panel.SpicyRenderer .line:not(.line-timed):not(.static) {
      --ym-sl-lyric-stroke: 0;
    }
    #ym-sl-panel.SpicyRenderer .line.line-timed {
      --ym-sl-lyric-stroke: 0.6px;
    }
    #ym-sl-panel.SpicyRenderer .line.static {
      --ym-sl-lyric-stroke: 0.35px;
    }
    #ym-sl-panel.SpicyRenderer .line .word,
    #ym-sl-panel.SpicyRenderer .line .letter,
    #ym-sl-panel.SpicyRenderer .line .letterGroup {
      position: relative;
      display: inline-block;
      font-weight: 700 !important;
      -webkit-text-stroke: var(--ym-sl-lyric-stroke, 0) transparent;
      transform-origin: center center;
      --gradient-position: -20%;
      --gradient-color: 255;
      --gradient-alpha: .85;
      --gradient-alpha-end: .5;
      --gradient-degrees: 90deg;
      --gradient-offset: 0%;
      --text-shadow-blur-radius: 4px;
      --text-shadow-opacity: 0%;
      --ym-sl-base-scale: 1;
      --ym-sl-adaptive-scale: 1;
      scale: calc(var(--ym-sl-base-scale) * var(--ym-sl-adaptive-scale));
      overflow: visible;
    }
    #ym-sl-panel.SpicyRenderer .line .letterGroup {
      display: inline-flex;
    }
    /* A letter that is just whitespace collapses to a 0px inline-block, which
       glues multi-word syllables together. Keep the space rendered and give it
       a floor. Mirrors upstream Spicy Lyrics Emphasize.ts / Mixed.css. */
    #ym-sl-panel.SpicyRenderer .line .letter.SpaceLetter {
      white-space: pre;
      min-width: 0.3ch;
    }
    /* Register --gradient-position so a bad write can never blank the fill.
       As an UNREGISTERED custom property it accepts ANY token, so a bad value
       stores without complaint and then makes
       calc(var(--gradient-position) + 20% + var(--gradient-offset)) invalid -
       which invalidates the whole background-image declaration and paints the
       glyph transparent for a frame (the black flicker). Registered as a
       percentage, an out-of-syntax value resolves to the initial value instead
       of poisoning the gradient. The JS guards its own writes too (see tick());
       this is the second line of defence.
       Upstream was developing exactly this: default_backup.css:383. */
    @property --gradient-position {
      syntax: "<percentage>";
      inherits: true;
      initial-value: -20%;
    }
    @property --gradient-alpha {
      syntax: "<number>";
      inherits: true;
      initial-value: 1;
    }
    /* Registered so the font can actually FADE between the sung and unsung
       fill strengths. Unregistered custom properties cannot be animated, which
       is why a line's fill used to vanish in one frame when the line ended.
       Only the Apple-style word track opts into the transition below, so no
       other mode changes. */
    @property --gradient-alpha-end {
      syntax: "<number>";
      inherits: true;
      initial-value: .5;
    }
    @property --ym-sl-line-alpha {
      syntax: "<number>";
      inherits: true;
      initial-value: 1;
    }
    @property --ym-sl-entry-shadow-alpha {
      syntax: "<number>";
      inherits: true;
      initial-value: 0;
    }
    /* The scroll glide's sub-pixel remainder. REGISTERED, and inherits:false is the
       whole point: an UNREGISTERED custom property inherits, so writing it on the
       scroller every frame invalidated the computed style of EVERY descendant
       (70 lines + 571 words) — the glide ran but the panel crawled.
       Non-inheriting means only the scroller's own transform is invalidated.
       NO BACKTICKS IN THIS COMMENT — it lives inside a template literal. */
    @property --ym-sl-scroll-frac {
      syntax: "<length>";
      inherits: false;
      initial-value: 0px;
    }
    /* Ease the fill strength when a line crosses Sung/NotSung. The karaoke
       sweep is driven per word, but the STATE flip (bright -> dim) replaced the
       gradient alpha instantly, so the fill snapped off at the line end instead
       of receding. Both vars are registered, so a transition is legal here, and
       neither is ever written per frame (only the state classes set them), so
       this cannot lag the karaoke sweep itself. */
    #ym-sl-panel.SpicyRenderer .line :is(.word, .letter) {
      transition:
        --gradient-alpha .42s cubic-bezier(.61, 1, .88, 1),
        --gradient-alpha-end .42s cubic-bezier(.61, 1, .88, 1);
    }
    /* Simple lyrics — Apple Music / AMLL style. The spring factories are stubbed
       and the splines swapped in JS (applySimpleLyricsSplines). The look is the
       AMLL preview renderer: a per-word white gradient sweep on the active line,
       the active line scaled up with a soft white halo, and depth dimming (lines
       fade AND recede with distance from the active line, injected per-line as
       --ym-sl-line-alpha / --amll-depth-scale in animate()). Word-synced only —
       line-timed and static lines fill as whole blocks, so the AMLL line motion
       would just blur them.: make simple lyrics the apple music style. */
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line:not(.line-timed):not(.static):not(.bg-line) {
      transition:
        transform .5s cubic-bezier(.22, .61, .36, 1),
        --ym-sl-line-alpha .4s cubic-bezier(.61, 1, .88, 1),
        --ym-sl-entry-shadow-alpha .4s cubic-bezier(.61, 1, .88, 1);
      /* AMLL uses a larger, more confident lyric size. */
      --font-size: calc(var(--DefaultLyricsSize) * 1.08);
      /* Per-line scale set in animate() by distance from the active line, so the
         stack recedes like AMLL as it scrolls instead of sitting flat. */
      transform: scale(var(--amll-depth-scale, 1));
      transform-origin: left center;
    }
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line:not(.line-timed):not(.static):not(.bg-line).Active {
      --ym-sl-line-alpha: 1;
    }
    /* No text glow in Simple lyrics: AMLL's "glow" comes from a blurred album-art
       backdrop behind the lyrics, NOT a text-shadow on the glyphs. With no such
       backdrop here the shadow just reads as a fuzzy halo, so kill it — the text
       stays crisp white like AMLL. The !important also overrides the base
       .line.Active .word shadow so nothing glows in this mode. */
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line .word,
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line .letter,
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line .letterGroup,
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line .bg-word {
      text-shadow: none !important;
    }
    /* Depth lines: no blur — AMLL keeps them still and dims them by opacity. The
       exact opacity/scale per distance is injected in animate(); the state
       classes supply the floor when a line is far away. */
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line:not(.line-timed):not(.static):not(.bg-line).Sung,
    body.ym-sl-simple-lyrics #ym-sl-panel.SpicyRenderer .line:not(.line-timed):not(.static):not(.bg-line).NotSung {
      filter: none;
    }
    /* Only the leaf text elements (.word/.letter) carry the gradient clip.
       Putting background-clip:text on the .letterGroup wrapper clips its child
       letters to the (empty) wrapper box and makes them vanish once the active
       gradient is removed — the "long words turn dark after being sung" bug. */
    /* Lines keep their opacity layer stable; words and letters get a transform
       hint only while their springs move. Dot opacity also changes per frame. */
    #ym-sl-panel.SpicyRenderer .line.ym-sl-animating .word,
    #ym-sl-panel.SpicyRenderer .line.ym-sl-animating .letter {
      will-change: transform;
    }
    #ym-sl-panel.SpicyRenderer .line.ym-sl-animating .dot {
      will-change: transform, opacity;
    }
    #ym-sl-panel.SpicyRenderer .line .word,
    #ym-sl-panel.SpicyRenderer .line .letter {
      -webkit-text-fill-color: transparent;
      background-clip: text;
      /* Paint every state with the same gradient-clip technique (only the
         gradient's brightness differs per state). This keeps stroke weight
         identical while a line is Active vs Sung/NotSung; swapping to a solid
         fill on Sung made the glyphs read fuller/bolder (the "thicker after
         the line ends" bug). */
      background-image: linear-gradient(
        var(--gradient-degrees),
        rgba(255,255,255,calc(var(--gradient-alpha) * var(--ym-sl-line-alpha))) var(--gradient-position),
        rgba(255,255,255,calc(var(--gradient-alpha-end) * var(--ym-sl-line-alpha)))
          calc(var(--gradient-position) + 20% + var(--gradient-offset))
      );
    }
    #ym-sl-panel.SpicyRenderer .line .word.PartOfWord,
    #ym-sl-panel.SpicyRenderer .line .letterGroup.PartOfWord {
      transform-origin: right center;
    }
    #ym-sl-panel.SpicyRenderer .line .word.PartOfWord
      + :is(.word.PartOfWord, .letterGroup.PartOfWord),
    #ym-sl-panel.SpicyRenderer .line .letterGroup.PartOfWord
      + :is(.word.PartOfWord, .letterGroup.PartOfWord) {
      transform-origin: center center;
    }
    #ym-sl-panel.SpicyRenderer .line .word.PartOfWord
      + :is(.word, .letterGroup),
    #ym-sl-panel.SpicyRenderer .line .letterGroup.PartOfWord
      + :is(.word, .letterGroup) {
      transform-origin: left center;
    }
    #ym-sl-panel.SpicyRenderer .line.rtl .word.PartOfWord,
    #ym-sl-panel.SpicyRenderer .line.rtl .letterGroup.PartOfWord {
      transform-origin: left center;
    }
    #ym-sl-panel.SpicyRenderer .line.rtl .word.PartOfWord
      + :is(.word, .letterGroup),
    #ym-sl-panel.SpicyRenderer .line.rtl .letterGroup.PartOfWord
      + :is(.word, .letterGroup) {
      transform-origin: right center;
    }
    #ym-sl-panel.SpicyRenderer .line .word:not(.PartOfWord, .dot, .LastWordInLine)::after,
    #ym-sl-panel.SpicyRenderer .line .letterGroup:not(.PartOfWord, .dot, .LastWordInLine)::after {
      content: "";
      margin-right: .32ch;
    }
    #ym-sl-panel.SpicyRenderer .line.Active .word,
    #ym-sl-panel.SpicyRenderer .line.Active .letter,
    #ym-sl-panel.SpicyRenderer .line.Active .letterGroup {
      /* Carry the unsung halo through the state flip while the word glow grows.
         Dropping it in one frame made both lead and background text dip before
         the gradient fade could brighten them. */
      text-shadow:
        0 0 var(--BlurAmount) rgba(255,255,255,calc(var(--ym-sl-entry-shadow-alpha) * var(--Vocal-NotSung-opacity))),
        0 0 var(--text-shadow-blur-radius) rgba(255,255,255,calc(var(--text-shadow-opacity) * var(--ym-sl-line-alpha)));
    }
    #ym-sl-panel.SpicyRenderer .line.NotSung {
      --ym-sl-line-alpha: var(--Vocal-NotSung-opacity);
      --ym-sl-entry-shadow-alpha: .4;
      --gradient-position: -20% !important;
      /* Dim gradient (same clip technique as Active) instead of a solid fill,
         so the stroke weight never changes between states. */
      --gradient-alpha: .4;
      --gradient-alpha-end: .4;
      text-shadow: 0 0 var(--BlurAmount) rgba(255,255,255,calc(var(--gradient-alpha-end) * var(--ym-sl-line-alpha)));
    }
    #ym-sl-panel.SpicyRenderer .line.NotSung .word,
    #ym-sl-panel.SpicyRenderer .line.NotSung .letter {
      --gradient-position: -20% !important;
      --text-shadow-opacity: 0% !important;
      --text-shadow-blur-radius: 4px !important;
    }
    #ym-sl-panel.SpicyRenderer .line.Sung {
      --ym-sl-line-alpha: var(--Vocal-Sung-opacity);
      --ym-sl-entry-shadow-alpha: 0;
      --gradient-position: 100% !important;
      /* Dim gradient (same clip technique as Active) instead of a solid fill,
         so a finished line keeps the exact stroke weight it had while playing.
         (Earlier theory blamed the line-level text-shadow halo; that rests at 0
         on Sung and was not the cause — the solid-fill swap was.) */
      --gradient-alpha: .32;
      --gradient-alpha-end: .32;
      --BlurAmount: 0px !important;
      text-shadow: 0 0 var(--BlurAmount) rgba(255,255,255,calc(var(--gradient-alpha) * var(--ym-sl-line-alpha)));
    }
    #ym-sl-panel.SpicyRenderer .line.Sung .word,
    #ym-sl-panel.SpicyRenderer .line.Sung .letter {
      --gradient-position: 100% !important;
    }
    /* "Fade away previous lines": a finished line fades out over 0.4s and
       recedes to 95%, the motion Apple Music and Spicy's fullscreen Minimal
       mode use. The individual scale property is separate from transform, so
       it composes with the Apple depth scale and the duet origin instead of
       replacing them.

       The fade transition lives on .Sung, not on every line. Keeping opacity
       and scale transitionable on the active and unsung rows made the browser
       hold compositor work for the whole panel; only a row that is actually
       fading needs it.

       Only opacity and scale animate here. The fade used to carry filter and
       the two line-alpha properties as well, so every clipped-gradient glyph
       in the row was repainted for the whole 0.4s - on a row already heading
       to opacity 0, where none of that paint could be seen. */
    body.ym-sl-fade-previous-lines
      #ym-sl-panel.SpicyRenderer
      .line.Sung:not(.static, .musical-line) {
      opacity: 0;
      scale: .95;
      /* A finished row's inline depth blur is invisible behind opacity 0, but
         it still asks the compositor for an offscreen surface. Hover always
         wanted the sharp text, so clearing it costs nothing visually. */
      filter: none !important;
      /* Stop painting and compositing the finished row once it has faded. Its
         box and forced layout size stay in place, so the stack above the
         current line still occupies the same space. visibility is delayed to
         the end of the opacity transition; the ::before hitbox below survives
         it so the empty rows can still be hovered and clicked to seek. */
      visibility: hidden;
      transition:
        opacity .4s linear,
        scale .4s ease-in-out,
        visibility 0s linear .4s;
    }
    /* A row that is fading away never needs its glyph gradients repainted:
       --gradient-alpha and the two line alphas only ever showed through an
       opacity that is on its way to 0. Dropping their transitions removes one
       clipped-gradient repaint per word from every line ending without
       changing a visible frame. */
    body.ym-sl-fade-previous-lines
      #ym-sl-panel.SpicyRenderer
      .line.Sung:not(.static, .musical-line) :is(.word, .letter) {
      transition: none;
    }
    /* The hitbox is a pseudo-element of the line, so it can restore visibility
       inside a hidden line. That keeps the seek target alive without keeping
       the lyric text in the paint/compositing path. */
    body.ym-sl-fade-previous-lines
      #ym-sl-panel.SpicyRenderer
      .line.Sung:not(.static, .musical-line)::before {
      visibility: visible;
      pointer-events: auto;
    }
    /* Finished lines are invisible but still own their rows, so the empty space
       above the current line is the click target for seeking back. Reveal the
       stack as a faint ghost while one of those rows is hovered, and lift the
       row under the pointer a little more so the target is obvious.

       The reveal is driven by .ym-sl-sung-hover on the scroll container, set by
       a delegated pointerover listener, NOT by :has(.line.Sung:hover) on that
       container. The :has() form re-validated the entire lyric subtree every
       time ANY descendant changed style - and the karaoke writes ~11 word
       styles per frame - so the panel paid a full subtree invalidation per
       frame. Measured: 11.8ms/frame with :has(), 5.9ms/frame with this class
       (74 -> 132 fps). Do not reintroduce :has() here. */
    body.ym-sl-fade-previous-lines
      #ym-sl-panel.SpicyRenderer
      .LyricsContent.ym-sl-sung-hover:not(.ym-sl-lines-all-sung)
      .line.Sung:not(.static, .musical-line) {
      opacity: .32;
      visibility: visible;
      /* Hover feedback should be immediate; the fade back out keeps the
         lyric's slower 0.4s timing. Durations follow the transition list
         above; visibility itself is instant. */
      transition-duration: .18s, .4s, 0s;
      transition-delay: 0s;
    }
    body.ym-sl-fade-previous-lines
      #ym-sl-panel.SpicyRenderer
      .LyricsContent.ym-sl-sung-hover:not(.ym-sl-lines-all-sung)
      .line.Sung:not(.static, .musical-line):hover {
      opacity: .6;
    }
    /* When every line is sung there is no next line to fade into. Show the
       finished lyric again at its normal dimmed state instead of leaving the
       panel empty for the outro, matching Spicy's LinesAllSung behaviour. */
    body.ym-sl-fade-previous-lines
      #ym-sl-panel.SpicyRenderer
      .LyricsContent.ym-sl-lines-all-sung
      .line.Sung:not(.static, .musical-line) {
      opacity: 1;
      scale: 1;
      visibility: visible;
      transition-delay: 0s;
    }
    @media (prefers-reduced-motion: reduce) {
      body.ym-sl-fade-previous-lines
        #ym-sl-panel.SpicyRenderer
        .line:not(.static, .musical-line) {
        transition: none !important;
      }
      body.ym-sl-fade-previous-lines
        #ym-sl-panel.SpicyRenderer
        .line.Sung:not(.static, .musical-line) {
        scale: 1;
      }
    }
    /* WordSung keeps the gradient-clip from the base rule; no solid-fill
       override, so weight stays consistent with the active line. */
    /* WordNotSung keeps the gradient-clip from the base rule; no solid-fill
       override, so weight stays consistent with the active line. */
    /* Letter-group words are governed by EXACTLY the same rules as regular
       words (the .line.Sung/.line.NotSung .word,.letter pairs above plus the
       WordSung/WordNotSung pairs), so a long "wavy" word matches its
       neighbours in every state. Do not add letter-specific fill overrides
       here: an author !important declaration outranks a normal inline style,
       which silently makes the animateLetters inline fills dead code.
       Letters must also keep inheriting the line's text-shadow — the
       .letterGroup wrapper must never set 'text-shadow: none', or the letters
       lose the glow layer that regular words get and read dimmer. */
    #ym-sl-panel.SpicyRenderer .line.Active {
      --ym-sl-line-alpha: var(--Vocal-Active-opacity);
      --ym-sl-entry-shadow-alpha: 0;
    }
    #ym-sl-panel.SpicyRenderer .line.bg-line.Active .bg-word.WordNotSung:not(.letterGroup),
    #ym-sl-panel.SpicyRenderer .line.bg-line.Active .bg-word.WordNotSung .letter {
      /* Keep unsung bg words dim and glow-less until they are sung; the sweep
         itself comes from the BASE .word/.letter gradient rule and already
         rests at -20%.
         The gradient-clip must NOT be re-declared here. A state-class rule that
         declares background-image drags that property into the class-toggle
         invalidation set, and re-rasterising a clipped gradient at the instant
         the state class flips is what painted the glyphs black for a frame.
         (when a new word plays the last word gets dimmer - the bg-word
         flicker.) Only custom properties are set here: the per-frame sweep
         already animates those without glitching. */
      --gradient-position: -20%;
      --text-shadow-opacity: 0;
    }
    /* A rule used to live here that re-declared the gradient-clip for
       .bg-word.Active and .bg-word.WordSung with !important. It was pure
       duplication of the base .word/.letter rule - bg words carry BOTH the
       "word" and "bg-word" classes (see appendWords), so the base rule already
       paints them - and the duplication WAS the bug: it put background-image
       into the invalidation set of the Active and WordSung state classes, so
       every Active-to-Sung flip re-rasterised the clipped gradient and flashed
       the glyphs black. Removing it leaves the base rule as the single source
       of the gradient in every state.
       The :not(.letterGroup) exclusion it needed is no longer required either:
       the base rule never targets .letterGroup, so a wrapper can only receive a
       background-image from animateWord()'s inline none, and stays inert. */
    #ym-sl-panel.SpicyRenderer .line.rtl {
      direction: rtl !important;
      transform-origin: right center !important;
    }
    #ym-sl-panel.SpicyRenderer .line.rtl .word,
    #ym-sl-panel.SpicyRenderer .line.rtl .letter { --gradient-degrees: -90deg; }
    #ym-sl-panel.SpicyRenderer .line.line-timed .word,
    #ym-sl-panel.SpicyRenderer .line.line-timed .letter,
    #ym-sl-panel.SpicyRenderer .line.line-timed .letterGroup {
      --gradient-degrees: 180deg;
    }
    #ym-sl-panel.SpicyRenderer .word-group {
      display: inline-flex;
      flex-wrap: wrap;
      white-space: nowrap;
      --ym-sl-base-scale: 1;
      --ym-sl-adaptive-scale: 1;
      scale: calc(var(--ym-sl-base-scale) * var(--ym-sl-adaptive-scale));
      transform-origin: center center;
    }
    #ym-sl-panel.SpicyRenderer .line.bg-line {
      /* The normal line fade also covers background vocals. Scale all three
         states together so the background-vocal setting keeps its meaning. */
      --Vocal-NotSung-opacity: calc(.5 * var(--ym-sl-bg-vocal-scale));
      --Vocal-Sung-opacity: calc(.5 * var(--ym-sl-bg-vocal-scale));
      --Vocal-Active-opacity: calc(.95 * var(--ym-sl-bg-vocal-scale));
      --font-size: calc(var(--DefaultLyricsSize) * 0.75);
      margin: -1cqw 0 1cqw !important;
    }
    #ym-sl-panel.SpicyRenderer .line.bg-line.Sung .word,
    #ym-sl-panel.SpicyRenderer .line.bg-line.Sung .letter,
    #ym-sl-panel.SpicyRenderer .line.bg-line.Sung .letterGroup {
      /* The gradient alphas ride along so a background row's fill recedes at
         the line end instead of vanishing in one frame. Both are driven only by
         state classes (never per frame), so transitioning them cannot lag the
         karaoke sweep. */
      transition:
        text-shadow .3s ease,
        --gradient-alpha .42s cubic-bezier(.61, 1, .88, 1),
        --gradient-alpha-end .42s cubic-bezier(.61, 1, .88, 1);
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line {
      --ym-sl-line-alpha: 1 !important;
      cursor: default;
      margin: 0;
      /* Match the lyric text edge. The old 0.9em side padding pushed the dots
         ~41px inward from the words they sit between. */
      padding: 0 !important;
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition: grid-template-rows .35s ease, opacity .35s ease;
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line.playing {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    /* The dots take 420ms to bounce and shrink, and the next lyric starts
       500ms after this state begins. Hold the row open through the bounce-in,
       then collapse it with the shrink; previously it collapsed immediately,
       so the lyrics below rose while the dots were still growing. */
    #ym-sl-panel.SpicyRenderer .line.musical-line.bounce-out {
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows .25s cubic-bezier(.55, 0, .9, .5) .17s,
        opacity .25s ease .17s;
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line .dotGroup {
      --dot-gap: clamp(.05px, 1.7cqw, 1.8px);
      display: flex;
      flex-direction: row;
      gap: var(--dot-gap);
      /* Shrink the group to the three dots instead of stretching it across the
         whole line. The exit animation scales the group around its own centre;
         on a stretched group that centre sat far to the right of the dots, so
         they slid sideways while zooming. */
      width: max-content;
      max-width: 100%;
      /* Idle dot rows take no vertical space. The dots' breathing room lives on
         .dot below, so this box has no padding that would impose a minimum
         height when the row collapses. */
      padding: 0;
      min-height: 0;
      overflow: hidden;
      /* Keep the cluster centred while the row collapses around it. */
      align-self: center;
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line.OppositeAligned .dotGroup {
      margin-left: auto;
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line.playing .dotGroup {
      overflow: visible;
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line.bounce-out .dotGroup {
      overflow: visible;
      /* No padding here: at 0fr the padding would be a minimum row height and
         leave an 18px gap under the lyrics after the dots are gone. */
      padding: 0;
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line.bounce-out .dotGroup {
      /* The WHOLE GROUP scales, keeping the dots' spacing --: "not the
         individual dots but the group's scale goes down". A small
         bounce-in first, then the group shrinks toward 40% and the line leaves
         with the scroll. Origin pinned centre so the cluster shrinks toward its
         own middle instead of an edge. */
      transform-origin: 50% 50%;
      animation: ymSlDotExit 420ms cubic-bezier(.45, 0, .55, 1) forwards;
    }
    @keyframes ymSlDotExit {
      0%   { transform: scale(1); }
      40%  { transform: scale(1.12); }
      100% { transform: scale(0.4); }
    }
    #ym-sl-panel.SpicyRenderer .line.musical-line .dot {
      --font-size: calc(var(--DefaultLyricsSize) * 1.3);
      --opacity-size: .35;
      display: inline-block;
      /* The old 0.2em vertical padding lived on .dotGroup. There it stayed a
         minimum row height even at 0fr, leaving an 18px gap after the exit; on
         the dot itself it is inside the group content, so the 0fr row can still
         collapse to nothing. .154em of the dot's 1.3x font is the same ~9px
         band the line-sized 0.2em produced. */
      padding-block: .154em;
      min-width: .35ch;
      border-radius: 50%;
      scale: .75;
      font-size: var(--font-size) !important;
      line-height: .65;
      opacity: var(--opacity-size);
      --gradient-position: 100%;
      --ym-sl-base-scale: .75;
      --ym-sl-adaptive-scale: 1;
      scale: calc(var(--ym-sl-base-scale) * var(--ym-sl-adaptive-scale));
    }
    #ym-sl-panel.SpicyRenderer .line.static {
      cursor: default;
      --gradient-position: 100%;
      --gradient-alpha: 1;
      --gradient-alpha-end: 1;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-empty {
      width: min(92%, 34em);
      margin: auto;
      color: inherit;
      font-size: 14px;
      line-height: 1.5;
      text-align: center;
      padding: 20px 6%;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      gap: 10px 24px;
      padding: 18px 22px 16px;
      margin: 48px 0 22px;
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 14px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.015) 58%),
        rgba(34,34,40,.55);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.10);
      -webkit-backdrop-filter: blur(14px) saturate(1.2);
      backdrop-filter: blur(14px) saturate(1.2);
      pointer-events: none;
      user-select: none;
      text-align: left;
      /* Credits are chrome, not lyrics: use the add-ons panel face even though
         the footer sits inside .LyricsContent (which carries the custom lyric
         font). Covers Written by / Provided by / Uploaded by / Made by. */
      font-family: "Satoshi", Avenir, -apple-system, BlinkMacSystemFont,
        "Segoe UI", Roboto, sans-serif;
    }
    /* Liner notes: writers own the top row; source and people share one
       metadata line underneath it. No three-column grid. */
    #ym-sl-panel.SpicyRenderer .ym-sl-credit-box {
      display: flex;
      flex-direction: column;
      flex: 0 1 auto;
      gap: 5px;
      min-width: 0;
      padding: 0;
      border: 0;
      box-sizing: border-box;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credit-writers {
      flex: 1 0 100%;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,.09);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credit-writers:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credit-provider {
      /* The provider row is shorter than the people pill. Centre it on the
         metadata line so "Provided by" sits level with "Submitted by". */
      align-self: center;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credit-people {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 18px;
      max-width: 100%;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits-label,
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-label,
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-label {
      margin: 0;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .005em;
      line-height: 1.25;
      color: rgba(255,255,255,.55);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-arrow {
      display: block;
      width: 9px;
      height: 9px;
      flex: none;
      margin-left: 1px;
      color: #ff5a63;
      opacity: .9;
      transition: transform .18s ease;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-link:hover .ym-sl-uploader-arrow {
      transform: translate(1px, -1px);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits-names {
      font-size: 14px;
      font-weight: 500;
      letter-spacing: -.005em;
      line-height: 1.35;
      color: #fff;
      overflow-wrap: anywhere;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credit-writers .ym-sl-credits-names {
      font-size: 18px;
      line-height: 1.3;
      letter-spacing: -.015em;
    }
    /* "Uploaded by <avatar> <username>" — only present on Spicy Lyrics API
       results. The parent .ym-sl-credits is pointer-events:none, so the link
       opts itself back in; without that the click never reaches it. */
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      margin: 0;
      min-width: 0;
      font-size: 14px;
    }
    /* Pill styling lives on the link itself (v8: v7's clip wrapper
       caused the conic to fill the pill interior; reverting to the direct link). */
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-link {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: 100%;
      min-width: 0;
      padding: 2px 9px 2px 3px;
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 999px;
      background: rgba(255,255,255,.07);
      color: #fff;
      text-decoration: none;
      position: relative;
      isolation: isolate;
      transition: background-color .18s ease, border-color .18s ease, color .18s ease;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-link:hover {
      background: rgba(255,255,255,.13);
      border-color: rgba(255,255,255,.16);
      color: #fff;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-link.no-link {
      pointer-events: none;
      background: rgba(255,255,255,.05);
      border-color: transparent;
      cursor: default;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-avatar {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      object-fit: cover;
      flex: none;
      background: rgba(255,255,255,.12);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-uploader-name {
      font-weight: 500;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
    /* "Provided by <provider>" — shown for EVERY API source, because
       developers.spicylyrics.org/md/attribution makes displaying the provider a
       binding condition (ToS section 6), not a nicety. Plain text: the provider
       carries no url of its own. */
    /* Credits on the same side as the final line, when that line is a duet. */
    #ym-sl-panel.SpicyRenderer .ym-sl-credits.align-right {
      text-align: right;
      justify-content: flex-end;
      margin-left: auto;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-provider {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 6px;
      margin: 0;
      min-width: 0;
      font-size: 14px;
      color: rgba(255,255,255,.67);
      /* Same add-ons face as the rail: the custom lyric font is for the lyrics
         themselves, not attribution. */
      font-family: "Satoshi", Avenir, -apple-system, BlinkMacSystemFont,
        "Segoe UI", Roboto, sans-serif;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-name {
      color: #fff;
      font-weight: 500;
    }
    .ym-sl-provider-icon {
      display: block;
      width: 17px;
      height: 17px;
      flex: none;
      object-fit: contain;
    }
    /* The Aurora Community mark is a square tile; soften its corners wherever
       the shared provider icon appears, not only inside the credits rail. */
    .ym-sl-provider-icon[src*="provider-aurora"] {
      border-radius: 5px;
    }
    /* Provider name as a link (LRCLIB) — keeps the same
       weight and colour, underlines only on hover. */
    #ym-sl-panel.SpicyRenderer a.ym-sl-provider-name {
      text-decoration: none;
      cursor: pointer;
    }
    #ym-sl-panel.SpicyRenderer a.ym-sl-provider-name:hover {
      text-decoration: underline;
    }
    /* Machine-aligned sources (lrc.red) get a persistent red warning pill —
       same family as the transient chip above the lyrics, but it stays. */
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-warn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      width: fit-content;
      padding: 5px 12px 5px 10px;
      border-radius: 999px;
      background: rgba(229, 72, 77, .14);
      border: 1px solid rgba(229, 72, 77, .42);
      color: rgba(255, 255, 255, .9);
      font-size: 12px;
      letter-spacing: .01em;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-warn-icon {
      width: 14px;
      height: 14px;
      flex: 0 0 auto;
      display: block;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-warn .ym-sl-provider-label {
      color: rgba(255, 255, 255, .72);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-warn .ym-sl-provider-name {
      color: #ffffff;
    }
    /* Pill + explanation as one block: the block owns the top margin, so the
       pill sits tight above its note. */
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-block {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 7px;
      margin-top: 0;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-block .ym-sl-provider-warn {
      margin-top: 0;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-provider-note {
      font-size: 11.5px;
      line-height: 1.4;
      color: rgba(255, 255, 255, .42);
      max-width: 42ch;
    }
    /* Unison keeps the shared liner-note rail as a plain dim Better Lyrics red. */
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--unison {
      position: relative;
      overflow: hidden;
      background: #8a1420;
      border: 0;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--unison > .ym-sl-credit-box {
      position: relative;
      z-index: 1;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--unison .ym-sl-credit-brand {
      position: absolute;
      left: -36px;
      top: 50%;
      width: 190px;
      height: 190px;
      flex: none;
      object-fit: contain;
      transform: translateY(-50%);
      opacity: .24;
      filter: blur(20px) saturate(1.1);
      -webkit-mask-image: radial-gradient(ellipse at center, #000 42%, transparent 72%);
      mask-image: radial-gradient(ellipse at center, #000 42%, transparent 72%);
      pointer-events: none;
      z-index: 0;
      border-radius: 50%;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--unison.align-right .ym-sl-credit-brand {
      left: auto;
      right: -36px;
    }

    /* Spicy uses the same frosted rail and clipped watermark as Unison, but
       takes the violet from its mark. Layout stays shared. */
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--spicy {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .012) 58%),
        rgba(46, 27, 72, .28);
      border-color: rgba(157, 126, 209, .34);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .10);
      -webkit-backdrop-filter: blur(22px) saturate(1.25);
      backdrop-filter: blur(22px) saturate(1.25);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--spicy > .ym-sl-credit-box {
      position: relative;
      z-index: 1;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--spicy .ym-sl-credit-brand {
      position: absolute;
      left: -36px;
      top: 50%;
      width: 190px;
      height: 190px;
      flex: none;
      object-fit: contain;
      transform: translateY(-50%);
      opacity: .24;
      filter: blur(20px) saturate(1.1);
      -webkit-mask-image: radial-gradient(ellipse at center, #000 42%, transparent 72%);
      mask-image: radial-gradient(ellipse at center, #000 42%, transparent 72%);
      pointer-events: none;
      z-index: 0;
      border-radius: 50%;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--spicy.align-right .ym-sl-credit-brand {
      left: auto;
      right: -36px;
    }
    /* The supplied Spicy banner is the card surface, cropped to fit. No blur
       and no border tint; Aurora keeps its own ring and is excluded. */
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--spicy:not(.ym-sl-credits--aurora) {
      border: 0;
      background:
        linear-gradient(180deg, rgba(24, 18, 40, .34), rgba(24, 18, 40, .46)),
        var(--ym-sl-spicy-banner-image, none) center / cover no-repeat;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    /* Aurora Community reuses Spicy's rail and layout, but its mark is black
       and red, so the border follows those colours instead of the violet.
       border-image paints ONLY the 1px frame; a border-box background would
       tint the whole interior and kill the glass transparency. */
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--aurora {
      border-color: transparent;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .012) 58%),
        rgba(58, 18, 24, .30);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .10);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--aurora::before {
      content: "";
      position: absolute;
      inset: 0;
      box-sizing: border-box;
      padding: 1px;
      border-radius: inherit;
      background: linear-gradient(90deg, #e11d2e 0%, #3b070b 48%, #050505 100%);
      -webkit-mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
      -webkit-mask-size: 100% 100%;
      -webkit-mask-clip: content-box, border-box;
      -webkit-mask-composite: xor;
      mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
      mask-size: 100% 100%;
      mask-clip: content-box, border-box;
      mask-composite: exclude;
      pointer-events: none;
      z-index: 3;
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--aurora.align-right::before {
      background: linear-gradient(270deg, #e11d2e 0%, #3b070b 48%, #050505 100%);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--aurora .ym-sl-credit-provider .ym-sl-provider-icon {
      border-radius: 5px;
    }
    /* Apple Music has no contributor rows. The provider mark is the whole
       headline, so it gets a large rounded square at the far left and the
       writers become the quiet bottom footnote. */
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple {
      position: relative;
      overflow: hidden;
      color: #fff;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, .14), rgba(255, 255, 255, .035) 58%),
        rgba(20, 22, 26, .28);
      border-color: rgba(255, 255, 255, .28);
      /* No outer shadow: the lyrics player clips at its side gutter, which
         turned both the white halo and the dark drop shadow into a straight
         cutoff. Keep only the inset top highlight on the rounded border. */
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14);
      -webkit-backdrop-filter: blur(22px) saturate(1.1);
      backdrop-filter: blur(22px) saturate(1.1);
    }
    #ym-sl-panel.SpicyRenderer .ym-sl-credits--apple > .ym-sl-credit-box {
      position: relative;
      z-index: 1;
