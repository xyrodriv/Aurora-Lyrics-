/*
 * Aurora Lyrics — YTMod extension (unofficial).
 *
 * Renders lyrics using the Spicy Lyrics Syllable RENDERER, adapted from the
 * original Spicy Lyrics project by Spikerko (AGPL-3.0). Aurora Lyrics is an
 * UNOFFICIAL project: it is not made, endorsed, or supported by Spicy Lyrics
 * or by Spikerko, and is not affiliated with either. Preserve the upstream
 * license and attribution when distributing adapted builds.
 *
 * Community syncs come from the Spicy Lyrics API, Aurora Community and Unison, and are
 * credited ON SCREEN wherever lyrics appear (see buildCreditsFooter /
 * buildProviderRow); API responses are cached for at most 30 days.
 *
 * YTMod-specific boundaries:
 *   - playback position and seeking come from window.YTMod.player,
 *   - lyrics are initially loaded from TTML imports,
 *   - the renderer lives inside YT Music's native side panel.
 */
(function () {
  "use strict";
  // Console branding: a red Aurora badge on every log, shaped like the
  // coloured tags Better Lyrics prints. Bound helpers keep the real call
  // site in DevTools instead of pointing at a wrapper.
  const AURORA_BADGE = "background:#dc2626;color:#fff;padding:1px 5px;border-radius:3px;font-weight:600";
  const alLog = console.log.bind(console, "%cAurora Lyrics", AURORA_BADGE);
  const alWarn = console.warn.bind(console, "%cAurora Lyrics", AURORA_BADGE);


  // Keep the original internal ID so existing installs and saved lyrics remain active.
  const EXT_ID = "ytmod-spicy-lyrics";
  const LRCLIB_API = "https://lrclib.net/api/get";
  const LRCLIB_SEARCH_API = "https://lrclib.net/api/search";
  // One host for both routes: /lyrics/{id} and /tracks/search. The search is
  // how a Spotify id is found in the first place (see resolveSpotifyIdUncached).
  const SPICY_LYRICS_BASE = "https://api.spicylyrics.org/v1";
  const SPICY_LYRICS_API = `${SPICY_LYRICS_BASE}/lyrics`;
  // PUBLISHABLE key only (sl_pk_…). Never embed the secret sl_sk_ here — it is
  // server-side only and would be exposed in this client-side extension.
  const SPICY_LYRICS_PUBLISHABLE_KEY = "sl_pk_R2hLeH1gpObvT6Dugj8pf54sVFMWdtH1vu2w8rWHcMA";
  // Unison — keyless, community-fed synced lyrics keyed by YouTube video id.
  // Requests go through the content-script proxy, like LRCLIB, so a missing
  // CORS header cannot strand the request.
  const UNISON_API = "https://unison.boidu.dev/lyrics";
  // Aurora Community — community TTML and shared offsets, keyed by the exact
  // YouTube video id. TTML uploads are handled by the Discord bot; offsets can
  // be posted from the Sync tab and are reported to the same API.
  const AURORA_COMMUNITY_API = "https://aurora-community-api.mitsyonsp.workers.dev";
  // Public maker profile pages. The website sends an absolute profile URL with
  // the signed-in identity; this origin is the fallback for identities stored
  // before that field existed, whose Discord avatar URL still carries the id.
  const AURORA_PROFILE_ORIGIN = "https://aurora-lyrics.mitsyonsp.workers.dev";
  // YTM -> Spotify id resolver. Song.link/Odesli was shut down
  // (PUBLIC_API_ACCESS_DEPRECATED, HTTP 401). The Spicy Lyrics API is keyed by
  // a Spotify track id, which YouTube Music does not expose, so /tracks/search
  // finds one from the metadata we do have (title, artist, album, duration).
  // It is the only mapping layer now: one request per track, no variant ladder.
  const SPICY_SEARCH_TIMEOUT_MS = 5000;
  const SPICY_SEARCH_LIMIT = 5;
  // A `likely` result matched title and artist but not the duration. Take it
  // only for small padding, never for another cut.
  const SPICY_SEARCH_LIKELY_DELTA_MS = 10_000;
  // The window `exact` itself uses. A `version` inside it is the same recording
  // under another credit spelling ("dropout (feat. blackbear)" vs Spotify's
  // "dropout (w/ blackbear)"), not a live/remix take.
  const SPICY_SEARCH_EXACT_DELTA_MS = 3_500;
  // Set when /tracks/search returns 429. Search and /lyrics share one
  // application window, so backing off here protects the lyrics call too.
  let spicySearchThrottledUntil = 0;
  // The extension script is injected into the page world, where chrome.runtime
  // is unavailable. Resolve the local font CSS from this script's own extension
  // URL instead of resolving it against music.youtube.com.
  const SCRIPT_URL = document.currentScript && document.currentScript.src || "";
  const SPICY_LYRICS_FONT_CSS = SCRIPT_URL
    ? new URL("fonts/spicy-lyrics.css", SCRIPT_URL).href
    : "https://fonts.spikerko.org/spicy-lyrics/source.css";
  // Bundled Kawarp WebGL module (the same one the Dynamic add-on uses). Resolved
  // from this script's own extension URL because the page world cannot fetch
  // chrome-extension:// resources by bare name.
  const KAWARP_CORE_URL = SCRIPT_URL ? new URL("kawarp-core.js", SCRIPT_URL).href : "";
  // Bundled AMLL engine (the real @applemusic-like-lyrics DomLyricPlayer). Same
  // resolution rule as Kawarp: this script runs in the PAGE world, where
  // chrome.runtime does not exist, so chrome.runtime.getURL() throws and the
  // engine silently falls back. document.currentScript.src already points at
  // chrome-extension://<id>/src/extensions/aurora-lyrics.js, so a sibling
  // relative URL is all we need.
  const AMLL_CORE_URL = SCRIPT_URL ? new URL("amll-core.js", SCRIPT_URL).href : "";
  // Bundled Braccato renderer (the Better Lyrics engine, MIT). Same resolution
  // rule as AMLL: the page world cannot use chrome.runtime.getURL().
  const BRACCATO_CORE_URL = SCRIPT_URL ? new URL("braccato-core.js", SCRIPT_URL).href : "";
  // FALLBACK ONLY: the live values come from Aurora Bloom via
  // window.__ymAuroraDynamic.getSettings() — see fullscreenKawarpOptions().
  // These are what the backdrop uses before that handshake lands, and they
  // match Bloom's shipped defaults. animationSpeed is overridden per playback
  // state.
  const FS_KAWARP_OPTIONS = {
    warpIntensity: 1,
    blurPasses: 6,
    animationSpeed: 0.1,
    saturation: 1.2,
    // Dithering is the fixed kawarp-core default, not a user setting.
    transitionDuration: 1000,
    tintIntensity: 0,
    scale: 1,
  };
  const GAP_DOTS_AFTER_SECONDS = 3;
  const PRE_HIDDEN_DOT_LINE_MS = 500;
  const LRCLIB_CACHE_LIMIT = 12;

  const h = (tag, attrs, ...kids) => {
    const e = document.createElement(tag);
    if (attrs) {
      for (const k in attrs) {
        const v = attrs[k];
        if (v == null) continue;
        if (k === "class") e.className = v;
        else if (k === "text") e.textContent = v;
        else if (k.startsWith("on") && typeof v === "function") {
          e.addEventListener(k.slice(2).toLowerCase(), v);
        } else {
          e.setAttribute(k, v);
        }
      }
    }
    for (const kid of kids) {
      if (kid == null) continue;
      e.appendChild(typeof kid === "string" ? document.createTextNode(kid) : kid);
    }
    return e;
  };

  function whenYTMod(cb) {
    if (window.YTMod && window.YTMod.player) return cb();
    setTimeout(() => whenYTMod(cb), 200);
  }

