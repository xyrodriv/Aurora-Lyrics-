  /* ===================== lifecycle ===================== */

  // Named so it can be detached. Every enable injects a NEW <script>, which runs
  // this whole IIFE again; without detaching, each disabled instance keeps a live
  // window listener forever, so repeated toggles stack up closures that all react
  // to every ytmod-ext message.
  let messageListenerAttached = false;

  // Re-run the resolver for whatever track is playing right now. syncTrackLyrics()
  // early-returns when the key is unchanged, so we clear currentTrackKey first to
  // force it past that guard. Used when the lyrics SOURCE ORDER changes: the cached
  // result came from the old priority, so we want a fresh resolve under the new one
  // (AJ, 2026-10-19).
  function reresolveCurrentTrackLyrics() {
    const track = getCurrentTrack();
    if (!track) return;
    const key = getTrackKey(track);
    if (!key) return;
    currentTrackKey = "";
    try { syncTrackLyrics(true); } catch (e) {
      console.warn("[AuroraLyrics] re-resolve after source-order change failed:", e);
    }
  }

  function handleHostMessage(event) {
    const data = event.data;
    if (!data) return;
    // Aurora Bloom (ytmod-dynamic) owns a couple of settings that actually
    // drive things drawn HERE — the MV blurred-backdrop brightness slider and
    // the "prefer Kawarp for music videos" toggle. So accept Bloom's settings
    // payload too and pull out just those keys; everything else in it belongs
    // to the page-wide Kawarp, not to us. applySettings() re-clamps for free.
    if (data.type === "ytmod-settings" && data.id === "ytmod-dynamic") {
      const s = data.settings || {};
      // The fullscreen lyrics view runs its OWN Kawarp (it suspends the page
      // one), so a slider moved while fullscreen is up has to reach that
      // instance too — otherwise the backdrop keeps the values it started with.
      if (fsKawarpActive) applyFullscreenKawarpLook();
      const patch = {};
      if (s.backdropBrightness != null) patch.backdropBrightness = s.backdropBrightness;
      if (s.preferKawarpAlways != null) patch.preferKawarpAlways = s.preferKawarpAlways;
      if (Object.keys(patch).length) {
        applySettings(patch);
        // The Kawarp-vs-canvas choice can change live, so re-decide the
        // backdrop now instead of waiting for the 2s refresh tick.
        if (patch.preferKawarpAlways != null) applyStaticVideoBackdrop();
      }
      return;
    }
    if (data.id !== EXT_ID) return;
    if (data.type === "ytmod-settings") {
      // A source-order change means the cached lyrics came from the OLD priority,
      // so re-resolve the current track once under the new order. The panel only
      // posts settings on close (see content.js pendingOrderPost), so this fires
      // at most once per edit session, never on every drag nudge (AJ, 2026-10-19).
      const prevOrder = Array.isArray(currentSettings.sourceOrder)
        ? currentSettings.sourceOrder.join(",") : "";
      const nextOrder = data.settings && Array.isArray(data.settings.sourceOrder)
        ? data.settings.sourceOrder.join(",") : prevOrder;
      applySettings(data.settings);
      if (nextOrder !== prevOrder) reresolveCurrentTrackLyrics();
      return;
    }
    if (data.type !== "ytmod-ext") return;
    if (data.action === "disable") teardown();
  }

  function attachMessageListener() {
    if (messageListenerAttached) return;
    window.addEventListener("message", handleHostMessage);
    messageListenerAttached = true;
  }
  function detachMessageListener() {
    if (!messageListenerAttached) return;
    window.removeEventListener("message", handleHostMessage);
    messageListenerAttached = false;
  }
  attachMessageListener();

  /* ===================== ad break ===================== */
  // YouTube Music does not swap elements for an ad: the SAME #movie_player
  // gets `ad-showing` while one runs, and the media element's clock is the
  // ad's. That class is the signal — playerAds is also present on tracks that
  // simply HAVE ads available, so it cannot answer "is one playing now".
  function adBreakIsPlaying() {
    const movie = document.querySelector("#movie_player");
    if (!movie) return false;
    return movie.classList.contains("ad-showing") ||
      movie.classList.contains("ad-interrupting");
  }

  function adBreakNoteLookup(key) {
    adBreakLyricsState = "loading";
    adBreakLyricsProvider = "";
    adBreakLyricsKey = key || currentTrackKey;
    if (adBreakActive) adBreakRender();
  }

  function adBreakNoteResult(state, provider) {
    adBreakLyricsState = state;
    adBreakLyricsProvider = state === "found" ? (provider || "") : "";
    if (currentTrackKey) adBreakLyricsKey = currentTrackKey;
    if (adBreakActive) adBreakRender();
  }

  function adBreakSourceText() {
    // A lookup recorded for a different track is stale — report the new one as
    // still loading rather than naming the previous song's source.
    const state = adBreakLyricsKey && adBreakLyricsKey !== currentTrackKey
      ? "loading"
      : adBreakLyricsState;
    if (state === "none") return "No lyrics found for the next track.";
    if (state === "found") {
      return adBreakLyricsProvider
        ? "The next track's lyrics came from " + adBreakLyricsProvider + "."
        : "The next track's lyrics are ready.";
    }
    if (state === "idle" && currentProvider) {
      return "The next track's lyrics came from " + currentProvider + ".";
    }
    return "Looking up the next track's lyrics…";
  }

  function adBreakRender() {
    if (!adBreakSourceEl) return;
    const text = adBreakSourceText();
    if (adBreakSourceEl.textContent !== text) adBreakSourceEl.textContent = text;
  }

  function adBreakSync() {
    const playing = adBreakIsPlaying();
    if (playing === adBreakActive) {
      // While an ad runs the lookup can finish, so the source line needs to keep
      // up; outside one there is nothing to repaint.
      if (playing) adBreakRender();
      return;
    }
    adBreakActive = playing;
    if (panelEl) panelEl.classList.toggle("ym-sl-ad-active", playing);
    if (adBreakOverlayEl) adBreakOverlayEl.classList.toggle("hidden", !playing);
    try {
      if (playing) document.documentElement.dataset.ymAdPlaying = "1";
      else delete document.documentElement.dataset.ymAdPlaying;
    } catch (e) {}
    if (playing) {
      adBreakRender();
      return;
    }
    // The ad is over. If the track's lookup ended with nothing while it played,
    // ask again now: ads often occupy the window in which the first lookup ran,
    // and a transient miss should not leave the panel empty for the whole song.
    if (adBreakLyricsState === "none" &&
      adBreakLyricsKey &&
      adBreakLyricsKey === currentTrackKey) {
      adBreakLyricsState = "loading";
      adBreakLyricsProvider = "";
      currentTrackKey = "";
      try {
        syncTrackLyrics(true);
      } catch (error) {
        console.warn("[AuroraLyrics] ad-end lyric retry failed:", error);
      }
    }
  }

  function teardown() {
    // Immediate: teardown is removing this script's UI, so a 220ms fade could
    // leave the overlay behind if the context goes away first.
    exitFullscreenMode(true);
    if (raf) cancelAnimationFrame(raf);
    raf = 0;
    stopHousekeeping();
    stopScrollGlide();
    if (mountTabTimer) clearTimeout(mountTabTimer);
    mountTabTimer = 0;
    if (wpObserver) wpObserver.disconnect();
    wpObserver = null;
    if (tabWatchRaf) cancelAnimationFrame(tabWatchRaf);
    tabWatchRaf = 0;
    if (activeTrackAbort) activeTrackAbort.abort();
    activeTrackAbort = null;
    cachedFirstRealLyricStartMs = Infinity;
    cachedLastRealLyricEndMs = 0;
    pendingAnimationLines.clear();
    syncNativePanel(false);
    cleanupTabBar(tabBar);
    if (panelEl) panelEl.remove();
    const optsOverlay = document.querySelector(".ym-sl-options-overlay");
    if (optsOverlay) optsOverlay.remove();
    const style = document.getElementById("ym-sl-style");
    if (style) style.remove();
    if (fontLinkEl) fontLinkEl.remove();
    fontLinkEl = null;
    modelLines = [];
    lineElements = [];
    scrollCandidateIndices = [];
    lrclibCache.clear();
    // The Spicy Lyrics cache lives in chrome.storage, so it outlives teardown.
    // Only the in-memory mirror and its pending writes are page-lifetime state:
    // flush anything queued, then drop the mirror so the next enable re-reads.
    flushSpicyCache();
    if (spicyCacheFlushTimer) {
      clearTimeout(spicyCacheFlushTimer);
      spicyCacheFlushTimer = 0;
    }
    spicyCache = null;
    spicyCacheLoad = null;
    spicyCacheDirty = false;
    // Track-identity state must be cleared as well. Re-enabling injects a fresh
    // <script>, so normally this starts clean anyway — but if any of it survived
    // into the next run, syncTrackLyrics would bail at the `key === currentTrackKey`
    // check and the panel would sit empty until the user changed songs. Clearing
    // here guarantees disable -> re-enable reloads lyrics for the current track.
    currentTrackKey = "";
    manualLyricsTrackKey = "";
    manualLyricsIsPermanent = false;
    currentLyricsFromSavedTTML = false;
    currentLyricsIsTTML = false;
    lastObservedTrackKey = "";
    lastObservedPositionMs = null;
    lastActiveLine = -1;
    if (manualScrollReturnTimer) {
      clearTimeout(manualScrollReturnTimer);
      manualScrollReturnTimer = 0;
    }
    currentSongwriters = [];
    panelVisible = false;
    adBreakActive = false;
    adBreakLyricsState = "idle";
    adBreakLyricsProvider = "";
    adBreakLyricsKey = "";
    adBreakOverlayEl = null;
    adBreakTitleEl = null;
    adBreakSubEl = null;
    adBreakSourceEl = null;
    try { delete document.documentElement.dataset.ymAdPlaying; } catch (e) {}
    panelHost = null;
    tabBar = null;
    pauseSync = null;
    pausePickMode = false;
    pauseUi = null;
    pauseBanner = null;
    pauseBannerText = null;
    panelEl = null;
    tabEl = null;
    tabMountParent = null;
    jumpButton = null;
    detachMessageListener();
  }

