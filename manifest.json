{
  "manifest_version": 3,
  "name": "Aurora Lyrics",
  "version": "0.1.0",
  "description": "Aurora Lyrics brings synced lyrics, artwork tools, and themes to YouTube Music.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://itunes.apple.com/*",
    "https://api.deezer.com/*",
    "https://musicbrainz.org/*",
    "https://open.spotify.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Aurora Lyrics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/public-api.js",
        "src/extensions/*",
        "changelog.json",
        "assets/*"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  }
}
